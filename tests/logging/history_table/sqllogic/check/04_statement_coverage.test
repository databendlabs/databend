# MERGE INTO records a single DML edge for the src -> merge_dst pair.
query ITT
SELECT distance, source_object_name, target_object_name
FROM get_lineage('lineage_history_statements.merge_dst', 'TABLE', 'UPSTREAM', 1)
----
1 default.lineage_history_statements.src default.lineage_history_statements.merge_dst

query T
SELECT parse_json(process)['lineage_kind']::STRING
FROM get_lineage('lineage_history_statements.merge_dst', 'TABLE', 'UPSTREAM', 1)
----
DML

# Both MERGE clauses contribute column lineage: merge_dst.m comes from src.c (matched UPDATE) and
# src.b (unmatched INSERT), while merge_dst.k and merge_dst.n come only from the unmatched INSERT.
query ISS rowsort
SELECT distance, source_column_name, target_column_name
FROM get_lineage('lineage_history_statements.merge_dst.m', 'COLUMN', 'UPSTREAM', 1)
----
1 b m
1 c m

query ISS rowsort
SELECT distance, source_column_name, target_column_name
FROM get_lineage('lineage_history_statements.merge_dst.k', 'COLUMN', 'UPSTREAM', 1)
----
1 a k

query ISS rowsort
SELECT distance, source_column_name, target_column_name
FROM get_lineage('lineage_history_statements.merge_dst.n', 'COLUMN', 'UPSTREAM', 1)
----
1 c n

