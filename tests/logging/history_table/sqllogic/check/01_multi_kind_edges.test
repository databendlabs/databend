# Multi-kind edges correspond to setup/01_multi_kind_edges.test.

# The same src -> dst object pair keeps one record per (lineage_kind, column mapping). lineage_kind
# is surfaced in the result instead of being pushed into the WHERE clause, so the assertion proves
# which kinds were retained: one CTAS record and two distinct DML records. The DML repeated with an
# identical column mapping was deduplicated, so DML keeps two records for two distinct mappings.
query TII rowsort
SELECT lineage_kind, count(*), count(DISTINCT column_lineage_hash)
FROM system_history.lineage_unresolved
WHERE source_database = 'lineage_history_multi_kind'
  AND target_database = 'lineage_history_multi_kind'
  AND source_name = 'src'
  AND target_name = 'dst'
GROUP BY lineage_kind
----
CTAS 1 1
DML 2 2

# GET_LINEAGE collapses every retained record for the pair into a single object edge.
query ITT
SELECT distance, source_object_name, target_object_name
FROM get_lineage('lineage_history_multi_kind.dst', 'TABLE', 'UPSTREAM', 1)
----
1 default.lineage_history_multi_kind.src default.lineage_history_multi_kind.dst

# The collapsed edge carries the process of the newest statement, which is the last DML.
query T
SELECT parse_json(process)['lineage_kind']::STRING
FROM get_lineage('lineage_history_multi_kind.dst', 'TABLE', 'UPSTREAM', 1)
----
DML

# Column lineage accumulates every mapping across kinds: dst.x is fed by both src.a (CTAS and the
# last DML) and src.b (the first DML), deduplicated into one row per distinct source column.
query ISS rowsort
SELECT distance, source_column_name, target_column_name
FROM get_lineage('lineage_history_multi_kind.dst.x', 'COLUMN', 'UPSTREAM', 1)
----
1 a x
1 b x

# dst.y is the mirror image: fed by src.b (CTAS and the last DML) and src.a (the first DML).
query ISS rowsort
SELECT distance, source_column_name, target_column_name
FROM get_lineage('lineage_history_multi_kind.dst.y', 'COLUMN', 'UPSTREAM', 1)
----
1 a y
1 b y

statement ok
DROP DATABASE lineage_history_multi_kind
