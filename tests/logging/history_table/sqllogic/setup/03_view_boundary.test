# View boundary: view columns are name-addressed while the view object keeps its stable id. The
# view participates in lineage both as a CREATE_VIEW target (from its base table) and as a source
# for downstream objects, so traversal must cross the view in both directions and keep VIEW vs
# TABLE object domains distinct.

statement ok
DROP DATABASE IF EXISTS lineage_history_views

statement ok
CREATE DATABASE lineage_history_views

statement ok
CREATE TABLE lineage_history_views.src(a INT, b INT)

# v is expression-derived (depends on a and b); p is a passthrough of a. Covering both proves the
# view boundary keeps derived and passthrough column mappings separate.
statement ok
CREATE VIEW lineage_history_views.src_view AS
SELECT a + b AS v, a AS p FROM lineage_history_views.src

statement ok
CREATE TABLE lineage_history_views.view_dst AS
SELECT v AS z, p AS q FROM lineage_history_views.src_view
