query BBB
SELECT query_info['query_text']::STRING LIKE
           'CREATE VIEW `default`.`lineage_history_legacy`.`legacy_view` AS%',
       query_info['backfilled_at']::STRING LIKE '%Z',
       is_null_value(query_info['query_id'])
FROM system_history.lineage_history
WHERE target_database = 'lineage_history_legacy'
  AND target_name = 'legacy_view'
  AND lineage_kind = 'CREATE_VIEW'
