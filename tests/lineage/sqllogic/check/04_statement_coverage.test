# Process metadata matches the selected history edge. Its updated timestamp is stable UTC RFC3339,
# independent of the session timezone used to query GET_LINEAGE.
query BBBBBBBBB
SETTINGS (timezone = 'UTC')
WITH result AS (
  SELECT parse_json(process) AS process
  FROM get_lineage('lineage_history_statements.insert_dst', 'TABLE', 'UPSTREAM', 1)
), history AS (
  SELECT updated_on, user_name, query_parameterized_hash, lineage_kind, query_info
  FROM system_history.lineage_history
  WHERE source_database = 'lineage_history_statements'
    AND source_name = 'src'
    AND target_database = 'lineage_history_statements'
    AND target_name = 'insert_dst'
  QUALIFY row_number() OVER (
    ORDER BY updated_on DESC, query_info['query_id']::STRING DESC
  ) = 1
)
SELECT result.process['query_id']::STRING = history.query_info['query_id']::STRING,
       result.process['updated_on']::STRING =
         concat(replace(to_string(history.updated_on), ' ', 'T'), 'Z'),
       result.process['user_name']::STRING = history.user_name,
       result.process['query_parameterized_hash']::STRING = history.query_parameterized_hash,
       result.process['lineage_kind']::STRING = history.lineage_kind,
       result.process['query_text']::STRING = history.query_info['query_text']::STRING,
       result.process['query_duration_ms']::Int64 =
         history.query_info['query_duration_ms']::Int64,
       result.process['written_rows']::UInt64 = history.query_info['written_rows']::UInt64,
       result.process['scan_rows']::UInt64 = history.query_info['scan_rows']::UInt64
FROM result CROSS JOIN history
----
1 1 1 1 1 1 1 1 1

query B
SETTINGS (timezone = 'Asia/Shanghai')
WITH result AS (
  SELECT parse_json(process)['updated_on']::STRING AS updated_on
  FROM get_lineage('lineage_history_statements.insert_dst', 'TABLE', 'UPSTREAM', 1)
), history AS (
  SELECT updated_on, query_info
  FROM system_history.lineage_history
  WHERE source_database = 'lineage_history_statements'
    AND source_name = 'src'
    AND target_database = 'lineage_history_statements'
    AND target_name = 'insert_dst'
  QUALIFY row_number() OVER (
    ORDER BY updated_on DESC, query_info['query_id']::STRING DESC
  ) = 1
)
SELECT result.updated_on = concat(
         replace(to_string(convert_timezone('UTC', history.updated_on)), ' ', 'T'),
         'Z'
       )
FROM result CROSS JOIN history
----
1

