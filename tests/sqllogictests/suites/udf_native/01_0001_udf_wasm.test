4 3

statement ok
CREATE OR REPLACE FUNCTION wasm_is_prime (INT) RETURNS BOOLEAN LANGUAGE wasm HANDLER = 'wasm_is_prime' AS $$@data/udf/test10_udf_wasm_gcd.wasm.zst$$

query IB
select number, wasm_is_prime(number) from numbers(5) where number > 0 order by 1;
----
1 0
2 1
3 1
4 0

