----
1 1
2 2
3 6
4 24

statement ok
CREATE OR REPLACE FUNCTION wasm_fibonacci (INT) RETURNS INT LANGUAGE wasm HANDLER = 'wasm_fibonacci' AS $$@data/udf/test10_udf_wasm_gcd.wasm.zst$$

query II
