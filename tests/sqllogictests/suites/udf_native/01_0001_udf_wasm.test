query T
select name from list_stage(location => '@data/udf/test10_udf_wasm_gcd.wasm.zst') order by name
----
udf/test10_udf_wasm_gcd.wasm.zst

statement ok
CREATE OR REPLACE FUNCTION wasm_gcd (INT, INT) RETURNS INT LANGUAGE wasm HANDLER = 'wasm_gcd' AS $$@data/udf/test10_udf_wasm_gcd.wasm.zst$$

query II
select number, wasm_gcd(number * 3, number * 6) from numbers(5) where number > 0 order by 1;
----
1	3
2	6
3	9
4	12

query I
select  sum(wasm_gcd(number * 3, number * 6)) from numbers(5) where number > 0;
----
30

statement ok
CREATE OR REPLACE FUNCTION wasm_lcm (INT, INT) RETURNS INT LANGUAGE wasm HANDLER = 'wasm_lcm' AS $$@data/udf/test10_udf_wasm_gcd.wasm.zst$$

query II
select number, wasm_lcm(number * 3, number * 6) from numbers(5) where number > 0 order by 1;
----
1 6
2 12
3 18
4 24

statement ok
