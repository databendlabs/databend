# COPY ... SORTED_BY_CLUSTER_KEY = TRUE: the rows of each file are declared to be ordered by the
# cluster key, so the blocks written from one file must not overlap on the cluster key.

statement ok
CREATE OR REPLACE STAGE s_sorted_by_cluster_key

statement ok
REMOVE @s_sorted_by_cluster_key

statement ok
SET enable_compact_after_write = 0

# One sorted CSV file, and three sorted CSV files with disjoint key ranges.
statement ok
COPY INTO @s_sorted_by_cluster_key/csv_one/ FROM (SELECT number // 1000 AS k, number AS v FROM numbers(200000) ORDER BY v) FILE_FORMAT = (TYPE = CSV) SINGLE = TRUE MAX_FILE_SIZE = 10000000000

statement ok
COPY INTO @s_sorted_by_cluster_key/csv_many/a FROM (SELECT number // 1000 AS k, number AS v FROM numbers(200000) WHERE number < 70000 ORDER BY v) FILE_FORMAT = (TYPE = CSV) SINGLE = TRUE MAX_FILE_SIZE = 10000000000

statement ok
COPY INTO @s_sorted_by_cluster_key/csv_many/b FROM (SELECT number // 1000 AS k, number AS v FROM numbers(200000) WHERE number >= 70000 AND number < 140000 ORDER BY v) FILE_FORMAT = (TYPE = CSV) SINGLE = TRUE MAX_FILE_SIZE = 10000000000

statement ok
COPY INTO @s_sorted_by_cluster_key/csv_many/c FROM (SELECT number // 1000 AS k, number AS v FROM numbers(200000) WHERE number >= 140000 ORDER BY v) FILE_FORMAT = (TYPE = CSV) SINGLE = TRUE MAX_FILE_SIZE = 10000000000

# Sorted Parquet files with disjoint key ranges, each larger than parquet_fast_read_bytes, so
# that without SORTED_BY_CLUSTER_KEY several sources read them in parallel and their blocks interleave.
statement ok
COPY INTO @s_sorted_by_cluster_key/parquet/ FROM (SELECT number // 20000 AS k, number AS v FROM numbers(4000000) ORDER BY v) FILE_FORMAT = (TYPE = PARQUET) MAX_FILE_SIZE = 1600000

# A sorted CSV file with one invalid row.
statement ok
COPY INTO @s_sorted_by_cluster_key/csv_bad_row/ FROM (SELECT number // 1000 AS k, if(number = 5000, 'bad', number::STRING) AS v FROM numbers(20000) ORDER BY number) FILE_FORMAT = (TYPE = CSV) SINGLE = TRUE MAX_FILE_SIZE = 10000000000

# Files that are not ordered by k.
statement ok
COPY INTO @s_sorted_by_cluster_key/csv_unordered/ FROM (SELECT number % 200 AS k, number AS v FROM numbers(200000) ORDER BY v) FILE_FORMAT = (TYPE = CSV) SINGLE = TRUE MAX_FILE_SIZE = 10000000000

statement ok
COPY INTO @s_sorted_by_cluster_key/parquet_unordered/ FROM (SELECT number % 200 AS k, number AS v FROM numbers(200000) ORDER BY v) FILE_FORMAT = (TYPE = PARQUET) SINGLE = TRUE MAX_FILE_SIZE = 10000000000

# Small files, each read as one batch: one starts above where it ends (k = 5, 1, 2, 3), and one
# is out of order only between its first and last rows (k = 1, 3, 2, 4).
statement ok
COPY INTO @s_sorted_by_cluster_key/csv_inverted/ FROM (SELECT if(number = 0, 5, number) AS k, number AS v FROM numbers(4) ORDER BY v) FILE_FORMAT = (TYPE = CSV) SINGLE = TRUE

statement ok
COPY INTO @s_sorted_by_cluster_key/parquet_inverted/ FROM (SELECT if(number = 0, 5, number) AS k, number AS v FROM numbers(4) ORDER BY v) FILE_FORMAT = (TYPE = PARQUET) SINGLE = TRUE

statement ok
COPY INTO @s_sorted_by_cluster_key/csv_inner_disorder/ FROM (SELECT CASE number WHEN 1 THEN 3 WHEN 2 THEN 2 ELSE number + 1 END AS k, number AS v FROM numbers(4) ORDER BY v) FILE_FORMAT = (TYPE = CSV) SINGLE = TRUE

# Small read batches, so that a block is built from many batches decoded in parallel.
statement ok
SET input_read_buffer_size = 65536

statement ok
SET max_threads = 8

statement ok
CREATE OR REPLACE TABLE t_sorted_by_cluster_key(k INT NOT NULL, v INT NOT NULL) CLUSTER BY (k) ROW_PER_BLOCK = 10000

statement ok
COPY INTO t_sorted_by_cluster_key FROM @s_sorted_by_cluster_key/csv_one/ FILE_FORMAT = (TYPE = CSV) SORTED_BY_CLUSTER_KEY = TRUE

query II
SELECT count(*), sum(v) FROM t_sorted_by_cluster_key
----
200000 19999900000

# No two blocks overlap on k beyond a shared endpoint.
query I
WITH b AS (SELECT _block_name n, min(k) lo, max(k) hi FROM t_sorted_by_cluster_key GROUP BY _block_name)
SELECT count(*) FROM b x, b y WHERE x.n < y.n AND x.lo < y.hi AND y.lo < x.hi
----
0

statement ok
CREATE OR REPLACE TABLE t_sorted_by_cluster_key(k INT NOT NULL, v INT NOT NULL) CLUSTER BY (k) ROW_PER_BLOCK = 10000

statement ok
COPY INTO t_sorted_by_cluster_key FROM @s_sorted_by_cluster_key/csv_many/ FILE_FORMAT = (TYPE = CSV) SORTED_BY_CLUSTER_KEY = TRUE

query II
SELECT count(*), sum(v) FROM t_sorted_by_cluster_key
----
200000 19999900000

query I
WITH b AS (SELECT _block_name n, min(k) lo, max(k) hi FROM t_sorted_by_cluster_key GROUP BY _block_name)
SELECT count(*) FROM b x, b y WHERE x.n < y.n AND x.lo < y.hi AND y.lo < x.hi
----
0

statement ok
CREATE OR REPLACE TABLE t_sorted_by_cluster_key(k INT NOT NULL, v INT NOT NULL) CLUSTER BY (k) ROW_PER_BLOCK = 10000

statement ok
COPY INTO t_sorted_by_cluster_key FROM @s_sorted_by_cluster_key/parquet/ FILE_FORMAT = (TYPE = PARQUET) SORTED_BY_CLUSTER_KEY = TRUE

query II
SELECT count(*), sum(v) FROM t_sorted_by_cluster_key
----
4000000 7999998000000

query I
WITH b AS (SELECT _block_name n, min(k) lo, max(k) hi FROM t_sorted_by_cluster_key GROUP BY _block_name)
SELECT count(*) FROM b x, b y WHERE x.n < y.n AND x.lo < y.hi AND y.lo < x.hi
----
0

# Rows skipped by ON_ERROR = CONTINUE do not break the order.
statement ok
CREATE OR REPLACE TABLE t_sorted_by_cluster_key(k INT NOT NULL, v INT NOT NULL) CLUSTER BY (k) ROW_PER_BLOCK = 1000

statement ok
COPY INTO t_sorted_by_cluster_key FROM @s_sorted_by_cluster_key/csv_bad_row/ FILE_FORMAT = (TYPE = CSV) ON_ERROR = CONTINUE SORTED_BY_CLUSTER_KEY = TRUE

query I
SELECT count(*) FROM t_sorted_by_cluster_key
----
19999

query I
WITH b AS (SELECT _block_name n, min(k) lo, max(k) hi FROM t_sorted_by_cluster_key GROUP BY _block_name)
SELECT count(*) FROM b x, b y WHERE x.n < y.n AND x.lo < y.hi AND y.lo < x.hi
----
0

# Control: the overlap check does detect overlapping blocks.
statement ok
CREATE OR REPLACE TABLE t_sorted_by_cluster_key(k INT NOT NULL, v INT NOT NULL) CLUSTER BY (k) ROW_PER_BLOCK = 10000

statement ok
COPY INTO t_sorted_by_cluster_key FROM @s_sorted_by_cluster_key/csv_unordered/ FILE_FORMAT = (TYPE = CSV)

query I
WITH b AS (SELECT _block_name n, min(k) lo, max(k) hi FROM t_sorted_by_cluster_key GROUP BY _block_name)
SELECT to_int64(count(*) > 0) FROM b x, b y WHERE x.n < y.n AND x.lo < y.hi AND y.lo < x.hi
----
1

# A file that does not follow the declared order is rejected.
statement ok
CREATE OR REPLACE TABLE t_sorted_by_cluster_key(k INT NOT NULL, v INT NOT NULL) CLUSTER BY (k) ROW_PER_BLOCK = 10000

statement error .*not sorted by the cluster key
COPY INTO t_sorted_by_cluster_key FROM @s_sorted_by_cluster_key/csv_unordered/ FILE_FORMAT = (TYPE = CSV) SORTED_BY_CLUSTER_KEY = TRUE

statement error .*not sorted by the cluster key
COPY INTO t_sorted_by_cluster_key FROM @s_sorted_by_cluster_key/parquet_unordered/ FILE_FORMAT = (TYPE = PARQUET) SORTED_BY_CLUSTER_KEY = TRUE

query I
SELECT count(*) FROM t_sorted_by_cluster_key
----
0

# Only the first and last rows of a batch are checked: a batch that starts above where it ends is
# rejected, while disorder between them is loaded, as it only widens the range of one block.
statement error .*start at \(5\), above \(3\)
COPY INTO t_sorted_by_cluster_key FROM @s_sorted_by_cluster_key/csv_inverted/ FILE_FORMAT = (TYPE = CSV) SORTED_BY_CLUSTER_KEY = TRUE

statement error .*start at \(5\), above \(3\)
COPY INTO t_sorted_by_cluster_key FROM @s_sorted_by_cluster_key/parquet_inverted/ FILE_FORMAT = (TYPE = PARQUET) SORTED_BY_CLUSTER_KEY = TRUE

statement ok
COPY INTO t_sorted_by_cluster_key FROM @s_sorted_by_cluster_key/csv_inner_disorder/ FILE_FORMAT = (TYPE = CSV) SORTED_BY_CLUSTER_KEY = TRUE

query II
SELECT k, v FROM t_sorted_by_cluster_key ORDER BY v
----
1 0
3 1
2 2
4 3

# FALSE is the default: an unordered file loads.
statement ok
CREATE OR REPLACE TABLE t_sorted_by_cluster_key(k INT NOT NULL, v INT NOT NULL) CLUSTER BY (k) ROW_PER_BLOCK = 10000

statement ok
COPY INTO t_sorted_by_cluster_key FROM @s_sorted_by_cluster_key/csv_unordered/ FILE_FORMAT = (TYPE = CSV) SORTED_BY_CLUSTER_KEY = FALSE

query I
SELECT count(*) FROM t_sorted_by_cluster_key
----
200000

statement error .*SORTED_BY_CLUSTER_KEY is not supported for COPY with a transform
COPY INTO t_sorted_by_cluster_key FROM (SELECT $1, $2 FROM @s_sorted_by_cluster_key/csv_one/) FILE_FORMAT = (TYPE = CSV) SORTED_BY_CLUSTER_KEY = TRUE

statement error .*SORTED_BY_CLUSTER_KEY only supports
COPY INTO t_sorted_by_cluster_key FROM @s_sorted_by_cluster_key/csv_one/ FILE_FORMAT = (TYPE = ORC) SORTED_BY_CLUSTER_KEY = TRUE

statement error .*MISSING_FIELD_AS
COPY INTO t_sorted_by_cluster_key FROM @s_sorted_by_cluster_key/parquet/ FILE_FORMAT = (TYPE = PARQUET MISSING_FIELD_AS = NULL) SORTED_BY_CLUSTER_KEY = TRUE

statement ok
CREATE OR REPLACE TABLE t_sorted_by_cluster_key_no_cluster(k INT NOT NULL, v INT NOT NULL)

statement error .*requires the target table to have a linear cluster key
COPY INTO t_sorted_by_cluster_key_no_cluster FROM @s_sorted_by_cluster_key/csv_one/ FILE_FORMAT = (TYPE = CSV) SORTED_BY_CLUSTER_KEY = TRUE

statement ok
CREATE OR REPLACE TABLE t_sorted_by_cluster_key_partitioned(k INT NOT NULL, v INT NOT NULL) PARTITION BY (v % 2) CLUSTER BY (k)

statement error .*not supported for tables with PARTITION BY
COPY INTO t_sorted_by_cluster_key_partitioned FROM @s_sorted_by_cluster_key/csv_one/ FILE_FORMAT = (TYPE = CSV) SORTED_BY_CLUSTER_KEY = TRUE

# A column filled by its default is not in the files.
statement ok
CREATE OR REPLACE TABLE t_sorted_by_cluster_key_default(k INT NOT NULL DEFAULT 0, v INT NOT NULL) CLUSTER BY (k)

statement error .*cluster key columns to be loaded from the files
COPY INTO t_sorted_by_cluster_key_default(v) FROM @s_sorted_by_cluster_key/csv_one/ FILE_FORMAT = (TYPE = CSV) SORTED_BY_CLUSTER_KEY = TRUE

statement ok
DROP TABLE t_sorted_by_cluster_key

statement ok
DROP TABLE t_sorted_by_cluster_key_no_cluster

statement ok
DROP TABLE t_sorted_by_cluster_key_partitioned

statement ok
DROP TABLE t_sorted_by_cluster_key_default

statement ok
UNSET enable_compact_after_write

statement ok
UNSET input_read_buffer_size

statement ok
UNSET max_threads

statement ok
REMOVE @s_sorted_by_cluster_key

statement ok
DROP STAGE s_sorted_by_cluster_key
