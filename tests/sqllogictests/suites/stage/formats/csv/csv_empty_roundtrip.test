# Empty STRING and BINARY values must remain distinct from NULL on a CSV round trip.
statement ok
drop stage if exists csv_empty_roundtrip

# Read physical CSV lines without interpreting CSV's quotes or delimiters.
statement ok
create stage csv_empty_roundtrip file_format = (type = csv field_delimiter = '|' quote = '`' escape = '')

statement ok
create or replace table csv_empty_source (
    id int,
    payload binary null,
    value string null,
    required_payload binary not null,
    required_value string not null
)

statement ok
insert into csv_empty_source values
(1, from_hex(''), '', from_hex(''), ''),
(2, NULL, NULL, from_hex(''), ''),
(3, from_hex('ff'), 'x', from_hex('ff'), 'x')

statement ok
create or replace table csv_empty_copy like csv_empty_source

# Default quoting and HEX encoding.
statement ok
copy into @csv_empty_roundtrip/default.csv
from (select * from csv_empty_source order by id)
file_format = (type = csv)
single = true include_query_id = false use_raw_path = true overwrite = true

query T
select $1 from @csv_empty_roundtrip/default.csv order by metadata$file_row_number
----
"1","","","",""
"2",\N,\N,"",""
"3","FF","x","FF","x"

# Keep the default EMPTY_FIELD_AS=NULL and QUOTED_EMPTY_FIELD_AS=STRING.
statement ok
copy into csv_empty_copy from @csv_empty_roundtrip/default.csv file_format = (type = csv)

query ITTTT
select id, to_hex(payload), value, to_hex(required_payload), required_value from csv_empty_copy order by id
----
1 (empty) (empty) (empty) (empty)
2 NULL NULL (empty) (empty)
3 ff x ff x

statement ok
truncate table csv_empty_copy

# Minimal quoting and BASE64 encoding must also quote empty values.
statement ok
copy into @csv_empty_roundtrip/minimal.csv
from (select * from csv_empty_source order by id)
file_format = (type = csv quote_style = 'quote_minimal' binary_format = base64)
single = true include_query_id = false use_raw_path = true overwrite = true

query T
select $1 from @csv_empty_roundtrip/minimal.csv order by metadata$file_row_number
----
1,"","","",""
2,\N,\N,"",""
3,/w==,x,/w==,x

statement ok
copy into csv_empty_copy from @csv_empty_roundtrip/minimal.csv file_format = (type = csv binary_format = base64)

query ITTTT
select id, to_hex(payload), value, to_hex(required_payload), required_value from csv_empty_copy order by id
----
1 (empty) (empty) (empty) (empty)
2 NULL NULL (empty) (empty)
3 ff x ff x

statement ok
drop stage csv_empty_roundtrip

statement ok
drop table csv_empty_source

statement ok
drop table csv_empty_copy
