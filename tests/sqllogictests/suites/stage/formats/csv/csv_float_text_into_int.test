# Non-integer numeric text (fraction / exponent) loaded into integer columns must
# be converted exactly, not through f64 which loses precision beyond 2^53.
# https://github.com/databendlabs/databend/issues/20786
statement ok
set numeric_cast_option = 'rounding'

statement ok
create or replace stage csv_float_text_stage

# Write raw CSV lines via minimally quoted, single-column CSV so the input
# spelling reaches the CSV decoder unchanged.
statement ok
copy into @csv_float_text_stage/ok/ from (
    select '1,1760000000123456789.4,1760000000123456789.4'
    union all select '2,1.760000000123456789e18,1.760000000123456789e18'
    union all select '3,9007199254740993.4,9007199254740993.4'
    union all select '4,9223372036854775807.4,18446744073709551615.4'
    union all select '5,-9223372036854775808.4,-0.4'
    union all select '6,1760000000123456789.5,1760000000123456789.5'
    union all select '7,-1.5,1.5'
)
file_format = (type = csv field_delimiter = '|' quote = '`' quote_style = 'quote_minimal' compression = none)

statement ok
create or replace table csv_float_text_int (id int, b bigint, u uint64)

statement ok
copy into csv_float_text_int from @csv_float_text_stage/ok/
file_format = (type = csv)

query III
select id, b, u from csv_float_text_int order by id
----
1 1760000000123456789 1760000000123456789
2 1760000000123456789 1760000000123456789
3 9007199254740993 9007199254740993
4 9223372036854775807 18446744073709551615
5 -9223372036854775808 0
6 1760000000123456790 1760000000123456790
7 -2 2

# Out of range text is rejected instead of being clamped to the type bounds.
# A valid control row distinguishes rejected records from silently imported ones.
statement ok
copy into @csv_float_text_stage/overflow/ from (
    select '0,1,1'
    union all select '1,-9223372036854775809,0'
    union all select '2,-9223372036854776000,0'
    union all select '3,9223372036854775807.5,0'
    union all select '4,0,18446744073709551615.5'
    union all select '5,0,-1.5'
)
file_format = (type = csv field_delimiter = '|' quote = '`' quote_style = 'quote_minimal' compression = none)

statement ok
truncate table csv_float_text_int

statement error overflowed
copy into csv_float_text_int from @csv_float_text_stage/overflow/
file_format = (type = csv)

statement ok
copy into csv_float_text_int from @csv_float_text_stage/overflow/
file_format = (type = csv) on_error = continue force = true

query III
select id, b, u from csv_float_text_int order by id
----
0 1 1

statement ok
set numeric_cast_option = 'truncating'

statement ok
copy into @csv_float_text_stage/truncating/ from (
    select '10,1760000000123456789.9,1760000000123456789.9'
    union all select '11,-9223372036854775808.9,18446744073709551615.9'
    union all select '12,-1.9,1.9'
)
file_format = (type = csv field_delimiter = '|' quote = '`' quote_style = 'quote_minimal' compression = none)

statement ok
truncate table csv_float_text_int

statement ok
copy into csv_float_text_int from @csv_float_text_stage/truncating/
file_format = (type = csv)

query III
select id, b, u from csv_float_text_int order by id
----
10 1760000000123456789 1760000000123456789
11 -9223372036854775808 18446744073709551615
12 -1 1

statement ok
set numeric_cast_option = 'rounding'

statement ok
drop table csv_float_text_int

statement ok
drop stage csv_float_text_stage
