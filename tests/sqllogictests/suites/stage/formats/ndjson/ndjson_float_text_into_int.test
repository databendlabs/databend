# Non-integer JSON numbers (fraction / exponent) loaded into integer columns must
# be converted exactly, not through f64 which loses precision beyond 2^53.
# https://github.com/databendlabs/databend/issues/20786
statement ok
set numeric_cast_option = 'rounding'

statement ok
create or replace stage ndjson_float_text_stage

# Write raw JSON via minimally quoted, single-column CSV so the input spelling
# reaches the NDJSON decoder unchanged.
statement ok
copy into @ndjson_float_text_stage/ok/ from (
    select '{"id":1,"b":1760000000123456789.4,"u":1760000000123456789.4}'
    union all select '{"id":2,"b":1.760000000123456789e18,"u":1.760000000123456789e18}'
    union all select '{"id":3,"b":9007199254740993.4,"u":9007199254740993.4}'
    union all select '{"id":4,"b":9223372036854775807.4,"u":18446744073709551615.4}'
    union all select '{"id":5,"b":-9223372036854775808.4,"u":-0.4}'
    union all select '{"id":6,"b":1760000000123456789.5,"u":1760000000123456789.5}'
    union all select '{"id":7,"b":-1.5,"u":1.5}'
)
file_format = (type = csv field_delimiter = '|' quote = '`' quote_style = 'quote_minimal' compression = none)

statement ok
create or replace table ndjson_float_text_int (id int, b bigint, u uint64)

statement ok
copy into ndjson_float_text_int from @ndjson_float_text_stage/ok/
file_format = (type = ndjson)

query III
select id, b, u from ndjson_float_text_int order by id
----
1 1760000000123456789 1760000000123456789
2 1760000000123456789 1760000000123456789
3 9007199254740993 9007199254740993
4 9223372036854775807 18446744073709551615
5 -9223372036854775808 0
6 1760000000123456790 1760000000123456790
7 -2 2

# Out of range values are rejected instead of being clamped to the type bounds.
# A valid control row distinguishes rejected records from silently imported ones.
statement ok
copy into @ndjson_float_text_stage/overflow/ from (
    select '{"id":0,"b":1,"u":1}'
    union all select '{"id":1,"b":-9223372036854775809,"u":0}'
    union all select '{"id":2,"b":-9223372036854776000,"u":0}'
    union all select '{"id":3,"b":9223372036854775807.5,"u":0}'
    union all select '{"id":4,"b":0,"u":18446744073709551615.5}'
    union all select '{"id":5,"b":0,"u":-1.5}'
)
file_format = (type = csv field_delimiter = '|' quote = '`' quote_style = 'quote_minimal' compression = none)

statement ok
truncate table ndjson_float_text_int

statement error overflowed
copy into ndjson_float_text_int from @ndjson_float_text_stage/overflow/
file_format = (type = ndjson)

statement ok
copy into ndjson_float_text_int from @ndjson_float_text_stage/overflow/
file_format = (type = ndjson) on_error = continue force = true

query III
select id, b, u from ndjson_float_text_int order by id
----
0 1 1

statement ok
set numeric_cast_option = 'truncating'

statement ok
copy into @ndjson_float_text_stage/truncating/ from (
    select '{"id":10,"b":1760000000123456789.9,"u":1760000000123456789.9}'
    union all select '{"id":11,"b":-9223372036854775808.9,"u":18446744073709551615.9}'
    union all select '{"id":12,"b":-1.9,"u":1.9}'
)
file_format = (type = csv field_delimiter = '|' quote = '`' quote_style = 'quote_minimal' compression = none)

statement ok
truncate table ndjson_float_text_int

statement ok
copy into ndjson_float_text_int from @ndjson_float_text_stage/truncating/
file_format = (type = ndjson)

query III
select id, b, u from ndjson_float_text_int order by id
----
10 1760000000123456789 1760000000123456789
11 -9223372036854775808 18446744073709551615
12 -1 1

statement ok
set numeric_cast_option = 'rounding'

statement ok
drop table ndjson_float_text_int

statement ok
drop stage ndjson_float_text_stage
