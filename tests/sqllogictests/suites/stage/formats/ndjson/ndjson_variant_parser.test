# Compare both parsers in one standard binary, including VARIANT subtrees
# nested in tuples/arrays, wide integer encodings, float overflow and escapes.
statement ok
set enable_sonic_json_parser = 0

statement ok
create or replace table ndjson_variant_serde (id int, payload variant, nested tuple(v variant, a array(variant)))

statement ok
copy into ndjson_variant_serde from @data/ndjson/variant_parser.ndjson file_format = (type = ndjson)

statement ok
set enable_sonic_json_parser = 1

statement ok
create or replace table ndjson_variant_sonic like ndjson_variant_serde

statement ok
copy into ndjson_variant_sonic from @data/ndjson/variant_parser.ndjson file_format = (type = ndjson)

query IIII
select count(*), count_if(s.payload != d.payload), count_if(s.nested:v != d.nested:v), count_if(s.nested:a != d.nested:a)
from ndjson_variant_serde s join ndjson_variant_sonic d on s.id = d.id
----
2 0 0 0

# Live rollback to Serde, without rebuilding or restarting the server.
statement ok
set enable_sonic_json_parser = 0

statement ok
truncate table ndjson_variant_sonic

statement ok
copy into ndjson_variant_sonic from @data/ndjson/variant_parser.ndjson file_format = (type = ndjson) force = true

query IIII
select count(*), count_if(s.payload != d.payload), count_if(s.nested:v != d.nested:v), count_if(s.nested:a != d.nested:a)
from ndjson_variant_serde s join ndjson_variant_sonic d on s.id = d.id
----
2 0 0 0

statement ok
drop table ndjson_variant_serde

statement ok
drop table ndjson_variant_sonic
