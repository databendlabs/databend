DROP TASK sessionTask

# Task validation must tolerate missing objects and runtime script variables,
# without executing statements during CREATE. (ALTER ... MODIFY AS is syntax-only,
# so these cases use CREATE OR REPLACE to exercise semantic validation.)
statement ok
DROP TABLE IF EXISTS task_validation_deferred_table

statement ok
DROP TASK IF EXISTS task_validation_deferred

statement ok
CREATE OR REPLACE TASK task_validation_deferred WAREHOUSE = 'mywh'
AS SELECT * FROM task_validation_deferred_table

statement ok
CREATE OR REPLACE TASK task_validation_deferred WAREHOUSE = 'mywh' AS EXECUTE IMMEDIATE $$
BEGIN
    CREATE TABLE task_validation_deferred_table (a INT);
    INSERT INTO task_validation_deferred_table VALUES (1);
END;
$$

query I
SELECT count(*) FROM system.tables WHERE database = current_database() AND name = 'task_validation_deferred_table'
----
0

statement ok
CREATE OR REPLACE TASK task_validation_deferred WAREHOUSE = 'mywh' AS EXECUTE IMMEDIATE $$
DECLARE x := 1;
BEGIN
    SELECT :x + 1;
    RETURN x;
END;
$$

statement ok
CREATE OR REPLACE TASK task_validation_deferred WAREHOUSE = 'mywh' AS EXECUTE IMMEDIATE $$
DECLARE t := 'task_validation_deferred_table';
BEGIN
    SELECT * FROM IDENTIFIER(:t);
END;
$$

statement ok
CREATE OR REPLACE TASK task_validation_deferred WAREHOUSE = 'mywh' AS EXECUTE IMMEDIATE $$
BEGIN
    FOR i IN 1 TO 2 DO
        SELECT :i;
    END FOR;
END;
$$

# A UDF that does not exist yet resolves as a builtin lookup and reports an unknown
# function, so a forward reference to it must not reject the task definition.
statement ok
CREATE OR REPLACE TASK task_validation_deferred WAREHOUSE = 'mywh'
AS SELECT task_validation_udf_not_created_yet(1)

# Dynamic PIVOT values (subquery / ANY) run a subquery while binding. Validation uses the
# same subquery executor as task execution, so such definitions are accepted.
statement ok
CREATE OR REPLACE TABLE task_validation_sales (empid INT, month STRING, amount INT)

statement ok
INSERT INTO task_validation_sales VALUES (1, 'jan', 1), (1, 'feb', 2)

statement ok
CREATE OR REPLACE TASK task_validation_deferred WAREHOUSE = 'mywh'
AS SELECT * FROM task_validation_sales PIVOT(SUM(amount) FOR month IN (SELECT DISTINCT month FROM task_validation_sales))

query T
select definition from system.tasks where name = 'task_validation_deferred'
----
SELECT * FROM task_validation_sales PIVOT(SUM(amount) FOR month IN (SELECT DISTINCT month FROM task_validation_sales))

statement ok
CREATE OR REPLACE TASK task_validation_deferred WAREHOUSE = 'mywh'
AS SELECT * FROM task_validation_sales PIVOT(SUM(amount) FOR month IN (ANY ORDER BY month))

statement ok
ALTER TASK task_validation_deferred MODIFY AS SELECT * FROM task_validation_sales PIVOT(SUM(amount) FOR month IN (ANY))

statement ok
DROP TABLE task_validation_sales

# ALTER TASK ... MODIFY AS cannot see the stored session parameters (for example
# DATABASE), so it only checks syntax; this type error is left to runtime planning.
statement ok
ALTER TASK task_validation_deferred MODIFY AS SELECT [1][true]

statement error 1005
ALTER TASK task_validation_deferred MODIFY AS SELECT FROM

statement ok
DROP TASK task_validation_deferred
