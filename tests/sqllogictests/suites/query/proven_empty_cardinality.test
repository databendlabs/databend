## A filter or join is only treated as exactly empty when that can be proven
## from type domains or exact row and null counts, without column value
## statistics. COUNT(*) over a non-empty result must not be folded to 0.

statement ok
CREATE OR REPLACE DATABASE proven_empty_cardinality

statement ok
USE proven_empty_cardinality

statement ok
CREATE TABLE w AS
SELECT number AS k,
       add_minutes(to_timestamp('2020-01-01 00:00:00'), number) AS ts,
       add_days(to_date('2020-01-01'), number % 365) AS d
FROM numbers(600)

statement ok
CREATE TABLE e(k UInt64 NOT NULL, v UInt64 NOT NULL)

## All rows are in the past, so these time windows keep every row.

query I
SELECT count(*) FROM w WHERE ts >= '2020-01-01 00:00:00' AND ts < now()
----
600

query I
SELECT count(*) FROM w WHERE d >= '2020-01-01' AND d < today()
----
600

query I
SELECT count(*) FROM w WHERE d BETWEEN '2020-01-01' AND today()
----
600

## Exactly empty inputs.

query I
SELECT count(*) FROM e WHERE v > 10
----
0

query I
SELECT count(*) FROM e LEFT JOIN w ON e.k = w.k
----
0

query I
SELECT count(*) FROM w RIGHT JOIN (SELECT * FROM e WHERE v > 10) AS f ON w.k = f.k
----
0

query I
SELECT count(*) FROM w INNER JOIN e ON w.k = e.k
----
0

## The empty side is not the preserved side, so every row of w is kept.

query I
SELECT count(*) FROM w LEFT JOIN e ON w.k = e.k
----
600

query I
SELECT count(*) FROM w FULL JOIN e ON w.k = e.k
----
600

query I
SELECT count(*) FROM w LEFT JOIN (SELECT * FROM e WHERE v > 10) AS f ON w.k = f.k WHERE w.k < 10
----
10

## Every row of n is NULL. After a non-NULL row is appended, the exact null
## count no longer covers every row and the matching row must be counted.

statement ok
CREATE TABLE z(k UInt64 NOT NULL, n UInt64 NULL)

statement ok
INSERT INTO z SELECT number, NULL FROM numbers(500)

query I
SELECT count(*) FROM z WHERE n > 10
----
0

statement ok
INSERT INTO z VALUES (500, 20)

query I
SELECT count(*) FROM z WHERE n > 10
----
1

query I
SELECT count(*) FROM z WHERE n IS NOT NULL
----
1

statement ok
DROP DATABASE proven_empty_cardinality
