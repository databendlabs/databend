statement ok
set max_block_size = 1;

statement ok
create table east(rid varchar, id int, dur int null, rev int, cores int);

statement ok
insert into east values ('r1', 100, 140, 12, 2), ('r2', 99, 100, 12, 8), ('r3', 103,  90,  5, 4);

statement ok
create table west(rid varchar, t_id int, time int, cost int, cores int);

statement ok
insert into west values ('s1', 404, 100,  6, 4), ('s2', 400, 140, 11, 2), ('s3', 676,  80, 10, 1), ('s4', 742,  90,  5, 4);

query TT
SELECT east.rid, west.rid
FROM east, west
WHERE east.dur < west.time AND east.rev > west.cost;
----
r2	s2

query TT
SELECT s1.rid, s2.rid
FROM west s1, west s2
WHERE s1.time > s2.time AND s1.cost < s2.cost ORDER BY 1, 2;
----
s1	s3
s4	s3

query TT
SELECT east.rid, west.rid
FROM east, west
WHERE east.dur + east.rev < west.time AND east.rev > west.cost;
----
r2 s2

query TT
SELECT s1.rid, s2.rid
FROM west s1, west s2
WHERE s1.time > s2.time AND s1.cost < s2.cost AND s1.rid != 's1';
----
s4 s3

query TT
SELECT s1.rid, s2.rid
FROM west s1, west s2
WHERE s1.time > s2.time AND s1.cost < s2.cost AND s1.rid > s2.rid;
----
s4 s3

query TT
SELECT east.rid, west.rid
FROM east, west
WHERE east.dur < west.time order by 1, 2;
----
r2 s2
r3 s1
r3 s2

query TT
SELECT east.rid, west.rid
FROM east, west
WHERE east.dur + east.rev < west.time order by 1, 2;
----
r2 s2
r3 s1
r3 s2

query TT
SELECT east.rid, west.rid
FROM east, west
WHERE east.dur < west.time AND east.dur + west.time < east.rev order by 1, 2;
----

statement ok
create table range_join_context_t1(c1 string, c2 string);

statement ok
insert into range_join_context_t1 values('2000-01-01', '1-1'), ('2020-01-01', '1-2');

statement ok
create table range_join_context_t2(c1 int, c2 string);

statement ok
insert into range_join_context_t2 values(1, '2-1'), (1, '2-2');

query I
select count(*)
from (
  select date_sub(year, t2.c1, today()) as d1, t1.c1 as d2
  from range_join_context_t1 t1 cross join range_join_context_t2 t2
)
where d1 >= d2;
----
4

query I
select count(*)
from (
  select date_sub(year, t2.c1, today()) as d1, t1.c1 as d2
  from range_join_context_t1 t1 cross join range_join_context_t2 t2
)
where d1 <= d2;
----
0

statement ok
drop table range_join_context_t1;

statement ok
drop table range_join_context_t2;

statement ok
drop table east;

statement ok
drop table west;

statement ok
set max_block_size = 65536;

# Regression for #21017: a pushed-down filter can leave empty blocks on
# the right side of MergeJoin. Keep multiple probe rows and disable repartitioning
# so those empty blocks reach the merge loop alongside non-empty blocks.
statement ok
set max_threads = 1;

statement ok
set max_block_size = 2;

statement ok
set enable_cbo = 0;

statement ok
create table range_join_empty_left(a int null, c string null);

statement ok
create table range_join_empty_right(x int null);

# This entire insert is rejected by the LIKE filter.
statement ok
insert into range_join_empty_left values (10, ''), (7, 'hello'), (-1, 'hello'), (NULL, NULL);

# These are the six matching rows from the issue, including a NULL join key.
statement ok
insert into range_join_empty_left values (1, 'ab'), (7, 'b'), (3, 'b'), (-100, 'b'), (NULL, 'abc'), (-100, 'b');

# Preserve the original join-key distribution, including NULLs and duplicates.
statement ok
insert into range_join_empty_right values
(10), (-100), (1000), (1000), (100), (-1), (7), (2),
(7), (NULL), (NULL), (-1), (NULL), (7), (NULL), (NULL),
(NULL), (2), (-1), (100), (3), (NULL), (NULL), (100),
(NULL), (1), (-1), (NULL), (1), (1000), (100), (7),
(NULL), (1), (100), (-1), (2), (3), (1), (-1);

query I
select count(*)
from range_join_empty_left l cross join range_join_empty_right r
where l.c like '%b%' and l.a <= r.x;
----
108

query I
select count(*)
from range_join_empty_left l inner join range_join_empty_right r
on l.c like '%b%' and l.a < r.x;
----
96

query I
select count(*)
from range_join_empty_left l cross join range_join_empty_right r
where l.c like '%b%' and l.a >= r.x;
----
49

query I
select count(*)
from range_join_empty_left l inner join range_join_empty_right r
on l.c like '%b%' and l.a > r.x;
----
37

# Check materialized matches as well as count-only projections.
query II
select l.a, count(*)
from range_join_empty_left l cross join range_join_empty_right r
where l.c like '%b%' and l.a <= r.x
group by l.a order by l.a;
----
-100 58
1 22
3 15
7 13

# An entirely filtered side and a side with only NULL keys produce no matches.
query I
select count(*)
from range_join_empty_left l cross join range_join_empty_right r
where l.c like '%missing%' and l.a <= r.x;
----
0

query I
select count(*)
from range_join_empty_left l cross join range_join_empty_right r
where l.c like '%abc%' and l.a <= r.x;
----
0

# Also exercise the partitioning path that scatters and removes empty blocks.
statement ok
set max_block_size = 65536;

statement ok
set max_threads = 4;

query I
select count(*)
from range_join_empty_left l cross join range_join_empty_right r
where l.c like '%b%' and l.a <= r.x;
----
108

statement ok
drop table range_join_empty_left;

statement ok
drop table range_join_empty_right;

statement ok
unset enable_cbo;

statement ok
unset max_block_size;

statement ok
unset max_threads;
