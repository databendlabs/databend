----
600

statement ok
DROP TABLE tm_bitmap_composite

## TIMESTAMP_TZ NULL with STRING, composite key
statement ok
CREATE OR REPLACE TABLE tm_timestamp_tz_composite(k TIMESTAMP_TZ NULL, k2 STRING NOT NULL)

statement ok
INSERT INTO tm_timestamp_tz_composite SELECT to_timestamp_tz(to_timestamp((number % 6)::INT64)), to_string(number % 6) FROM numbers(60)

query II
