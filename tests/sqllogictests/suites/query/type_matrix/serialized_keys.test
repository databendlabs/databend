----
6 60

query I
SELECT count(*) FROM tm_timestamp_tz_composite a JOIN tm_timestamp_tz_composite b ON (a.k, a.k2) = (b.k, b.k2)
----
600

query I
SELECT count(*) FROM tm_timestamp_tz_composite a LEFT JOIN tm_timestamp_tz_composite b ON (a.k, a.k2) = (b.k, b.k2)
----
600

statement ok
DROP TABLE tm_timestamp_tz_composite
