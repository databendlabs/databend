CREATE OR REPLACE TABLE tm_array_int32_mixed(k ARRAY(INT32) NULL)

statement ok
INSERT INTO tm_array_int32_mixed SELECT IF(number % 5 = 4, NULL, [(number % 6)::INT32]) FROM numbers(60)

query II
SELECT count(*), sum(c) FROM (SELECT k, count(*) c FROM tm_array_int32_mixed GROUP BY k)
----
7 60

query I
SELECT count(*) FROM (SELECT DISTINCT k FROM tm_array_int32_mixed)
----
7

query I
SELECT count(DISTINCT k) FROM tm_array_int32_mixed
----
6

query II
SELECT count(k), count(*) FROM tm_array_int32_mixed
----
48 60

query BB
SELECT min(k) IS NOT NULL, max(k) IS NOT NULL FROM tm_array_int32_mixed
----
1 1

query I
SELECT count(*) FROM tm_array_int32_mixed a JOIN tm_array_int32_mixed b ON a.k = b.k
----
384

query I
SELECT count(*) FROM tm_array_int32_mixed a LEFT JOIN tm_array_int32_mixed b ON a.k = b.k
----
396

query I
SELECT count(*) FROM tm_array_int32_mixed WHERE k IN (SELECT [number::INT32] FROM numbers(2))
----
16

statement ok
DROP TABLE tm_array_int32_mixed

