----
6

query II
SELECT count(k), count(*) FROM tm_tuple_dense_nn
----
60 60

query BB
SELECT min(k) IS NOT NULL, max(k) IS NOT NULL FROM tm_tuple_dense_nn
----
1 1

statement ok
DROP TABLE tm_tuple_dense_nn

