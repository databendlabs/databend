CREATE OR REPLACE TABLE tm_string_dense(k STRING NULL)

statement ok
INSERT INTO tm_string_dense SELECT 'k' || to_string((number % 6)) FROM numbers(60)

query II
SELECT count(*), count(k) FROM (SELECT k FROM tm_string_dense ORDER BY k NULLS FIRST)
----
60 60

query I
SELECT count(*) FROM (SELECT k FROM tm_string_dense ORDER BY k DESC NULLS LAST LIMIT 3)
----
3

query II
SELECT count(*), sum(c) FROM (SELECT k, count(*) c FROM tm_string_dense GROUP BY k)
----
6 60

query I
SELECT count(*) FROM (SELECT DISTINCT k FROM tm_string_dense)
----
6

query I
SELECT count(DISTINCT k) FROM tm_string_dense
----
6

query II
SELECT count(k), count(*) FROM tm_string_dense
----
60 60

query BB
SELECT min(k) IS NOT NULL, max(k) IS NOT NULL FROM tm_string_dense
----
1 1

query I
SELECT count(*) FROM tm_string_dense a JOIN tm_string_dense b ON a.k = b.k
----
600

query I
SELECT count(*) FROM tm_string_dense a LEFT JOIN tm_string_dense b ON a.k = b.k
----
600

query I
SELECT count(*) FROM tm_string_dense WHERE k IN (SELECT 'k' || to_string(number) FROM numbers(2))
----
20

query II
SELECT count(*), max(rn) FROM (SELECT row_number() OVER (PARTITION BY k ORDER BY k) rn FROM tm_string_dense)
----
60 10

query I
SELECT sum(s) FROM (SELECT sum(1) OVER (ORDER BY k ROWS UNBOUNDED PRECEDING) s FROM tm_string_dense)
----
1830

statement ok
DROP TABLE tm_string_dense

