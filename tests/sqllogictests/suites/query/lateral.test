# LEFT JOIN LATERAL keeps the outer row and NULL-extends the right side when HAVING or the
# ON condition fails, also for the rows whose aggregate input is empty.
statement ok
set enable_experimental_new_join = 0

query II
select o.id, t.c from nullable_lateral_outer o left join lateral (select count(*) c from nullable_lateral_inner i where i.k = o.k) t on t.c = 0 order by o.id
----
1 NULL
2 0
3 0

query II
select o.id, t.c from nullable_lateral_outer o left join lateral (select count(*) c from nullable_lateral_inner i where i.k = o.k having count(*) = 0) t on true order by o.id
----
1 NULL
2 0
3 0

# The projection above HAVING isn't evaluated on rows HAVING rejects.
query II
select o.id, t.c from nullable_lateral_outer o left join lateral (select (10 / count(*))::int c from nullable_lateral_inner i where i.k = o.k having count(*) > 0) t on true order by o.id
----
1 10
2 NULL
3 NULL

query II
select o.id, t.c from nullable_lateral_outer o left join lateral (select count(*) c from nullable_lateral_inner i where i.k = o.k) t on o.id = 2 order by o.id
----
1 NULL
2 0
3 NULL

query III
select o.id, t.c, t.s from nullable_lateral_outer o left join lateral (select count(*) c, sum(v) s from nullable_lateral_inner i where i.k = o.k) t on t.c > 0 and o.id < 3 order by o.id
----
1 1 10
2 NULL NULL
3 NULL NULL

query II
select o.id, t.c from nullable_lateral_outer o left join lateral (select count(*) c from nullable_lateral_inner i where i.k = o.k) t on t.c = 0 where t.c is null order by o.id
----
1 NULL

