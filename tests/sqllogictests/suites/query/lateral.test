# ORDER BY / LIMIT n over the aggregate and an explicit CROSS JOIN LATERAL.
query II
select o.id, t.c from nullable_lateral_outer o, lateral (select count(*) c from nullable_lateral_inner i where i.k = o.k order by c limit 1) t order by o.id
----
1 1
2 0
3 0

query II
select o.id, t.c from nullable_lateral_outer o left join lateral (select count(*) c from nullable_lateral_inner i where i.k = o.k order by c desc limit 5) t on true order by o.id
----
1 1
2 0
3 0

query II
select o.id, t.c from nullable_lateral_outer o cross join lateral (select count(*) c from nullable_lateral_inner i where i.k = o.k) t order by o.id
----
1 1
2 0
3 0

# Later references to the NULL-extended right side columns of a LEFT lateral join: another
# lateral subquery, `t.*`, and USING.
query III
select o.id, t.c, u.d from nullable_lateral_outer o left join lateral (select count(*) c from nullable_lateral_inner i where i.k = o.k) t on t.c = 0 left join lateral (select count(*) d from nullable_lateral_inner i2 where i2.v > t.c) u on true order by o.id
----
1 NULL 0
2 0 3
3 0 3

query III
select o.id, t.c, u.d from nullable_lateral_outer o left join lateral (select count(*) c from nullable_lateral_inner i where i.k = o.k) t on t.c = 0, lateral (select t.c + 1 d) u order by o.id
----
1 NULL NULL
2 0 1
3 0 1

query III
select o.id, t.* from nullable_lateral_outer o left join lateral (select count(*) c, sum(v) s from nullable_lateral_inner i where i.k = o.k) t on t.c > 0 order by o.id
----
1 1 10
2 NULL NULL
3 NULL NULL

query II
select o.id, t.id from nullable_lateral_outer o left join lateral (select count(*) id from nullable_lateral_inner i where i.k = o.k) t using (id) order by o.id
----
1 1
2 NULL
3 NULL

query II
select * from nullable_lateral_outer o left join lateral (select count(*) id from nullable_lateral_inner i where i.k = o.k) t using (id) order by id
----
1 1
2 NULL
3 5

# A lateral subquery projecting a nullable outer column directly reuses the outer column's
# index. NULL-extending the right side must not change the outer column itself.
statement ok
set enable_experimental_new_join = 0

query III
select o.k, t.x, t.c from (select nullif(number, 99) as k from numbers(3)) o left join lateral (select o.k as x, s.c from (select count(*) as c from numbers(1) i where i.number < o.k) s) t on t.c = 0 order by o.k
----
0 0 0
1 NULL NULL
2 NULL NULL

query II
select o.k, t.x from (select nullif(number, 99) as k from numbers(3)) o left join lateral (select o.k as x) t on t.x = 0 order by o.k
----
0 0
1 NULL
2 NULL

statement ok
set enable_experimental_new_join = 1

query III
select o.k, t.x, t.c from (select nullif(number, 99) as k from numbers(3)) o left join lateral (select o.k as x, s.c from (select count(*) as c from numbers(1) i where i.number < o.k) s) t on t.c = 0 order by o.k
----
0 0 0
1 NULL NULL
2 NULL NULL

query II
select o.k, t.x from (select nullif(number, 99) as k from numbers(3)) o left join lateral (select o.k as x) t on t.x = 0 order by o.k
----
