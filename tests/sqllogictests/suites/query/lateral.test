# DISTINCT over the scalar aggregate is a no-op on its single row, so the rewrite applies.
query II
select o.id, t.c from nullable_lateral_outer o, lateral (select distinct count(*) c from nullable_lateral_inner i where i.k = o.k) t order by o.id
----
1 1
2 0
3 0

query II
select o.id, t.c from nullable_lateral_outer o left join lateral (select distinct count(*) c from nullable_lateral_inner i where i.k = o.k) t on t.c = 0 order by o.id
----
1 NULL
2 0
3 0

query II
select o.id, t.c from nullable_lateral_outer o, lateral (select distinct count(*) + 1 c from nullable_lateral_inner i where i.k = o.k) t order by o.id
----
1 2
2 1
3 1

# A grouped aggregate nested in the aggregate input returns no rows for empty input, so
# losing its groups is correct and the outer aggregate is filled as usual.
query II
select o.id, t.n from nullable_lateral_outer o, lateral (select avg(c)::int n from (select v, count(*) c from nullable_lateral_inner i where i.k = o.k group by v) s) t order by o.id
----
1 1
2 NULL
3 NULL

query II
select o.id, t.n from nullable_lateral_outer o, lateral (select count(*) n from (select v from nullable_lateral_inner i where i.k = o.k group by v) s) t order by o.id
----
1 1
2 0
3 0

# The ON condition of a LEFT lateral join may read a virtual column of the outer side while the
# right side columns are NULL-extended.
statement ok
create or replace table lateral_vc_outer(id int, k int null, j json) storage_format = 'parquet' enable_virtual_column = true

statement ok
insert into lateral_vc_outer values (1, 1, '{"a":1}'), (2, NULL, '{"a":0}'), (3, 5, '{"a":5}')

query III
select o.id, o.j['a']::int a, t.c from lateral_vc_outer o left join lateral (select count(*) c from nullable_lateral_inner i where i.k = o.k) t on t.c = o.j['a']::int order by o.id
