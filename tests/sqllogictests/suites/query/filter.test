# Signed zeros survive the dictionary: atan2(-0.0, -1.0) = -pi, atan2(0.0, -1.0) = pi.

query III
SELECT count(*), sum(IF(atan2(f, -1.0) < 0, 1, 0)), sum(IF(atan2(f, -1.0) > 3, 1, 0)) FROM encoded_columns WHERE f = 0;
----
20001 10001 10000

