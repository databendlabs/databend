query R
SELECT sum(p * disc) FROM encoded_columns WHERE disc BETWEEN 0.05 AND 0.07 AND q < 24;
----
208934.1634

query IIRR
SELECT count(*), sum(c), sum(mx), sum(mn) FROM (SELECT d, s, count(*) c, max(p) mx, min(p) mn FROM encoded_columns GROUP BY d, s);
----
90 30000 85486.05 81013.05

# High-cardinality keys fall back from codes to hashing rows.

query III
SELECT count(*), sum(c), max(c) FROM (SELECT i, count(*) c FROM encoded_columns GROUP BY i);
----
6000 30000 7

query III
SELECT count(*), sum(c), max(c) FROM (SELECT hs, g, count(*) c FROM encoded_columns GROUP BY hs, g);
----
20000 30000 2

query IIII
SELECT count(DISTINCT s), count(DISTINCT i), count(DISTINCT d), count(DISTINCT hs) FROM encoded_columns;
----
5 6000 90 9000

# Nullable encoded columns.

query TIRII
SELECT ns, count(*), sum(np), count(ni), sum(ni) FROM encoded_columns GROUP BY ns ORDER BY ns NULLS FIRST;
----
NULL 6000 199500.00 5000 25746630
a 8002 266028.90 4001 20590471
b 8000 268990.70 8000 41190732
c 7998 268980.40 7998 41200335

query II
SELECT count(*), sum(k) FROM encoded_columns WHERE ni > 5100 AND np < 50;
----
5766 142434078

# Joins, sorting and output of encoded columns.

query IR
SELECT count(*), sum(a.q) FROM encoded_columns a JOIN encoded_columns b ON a.k = b.k AND a.d = b.d AND a.s = b.s WHERE b.s = 'MAIL' AND b.p > 940;
----
1200 29400.00

