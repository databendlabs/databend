statement ok
drop table t;

# Low-cardinality Parquet strings exercise dictionary LIKE when encoded columns and the
# deserialized column cache are enabled. The expression tests also force Dict input directly.
statement ok
CREATE OR REPLACE TABLE encoded_like(k UINT64 NOT NULL, url STRING NOT NULL, nullable_url STRING NULL) STORAGE_FORMAT = 'parquet' ENABLE_PARQUET_DICTIONARY = true;

statement ok
INSERT INTO encoded_like SELECT number, url, IF(number % 8 IN (2, 4), NULL, url) FROM (SELECT number, ['xxx/a', 'yyy/b', 'xxx/a', 'xxx/c', '', 'xxx_100%', 'yyy/b', 'xxx/c'][number % 8 + 1]::STRING AS url FROM numbers(8000));

statement ok
SET enable_selector_executor = 1;

statement ok
SET enable_encoded_columns = 0;

statement ok
CREATE OR REPLACE TABLE encoded_like_expected AS SELECT k, url FROM encoded_like WHERE (url LIKE 'xxx%' OR k % 8 = 1) AND (url NOT LIKE '%/a' OR k % 8 = 2);

query I
SELECT count(*) FROM encoded_like_expected;
----
5000

statement ok
SET enable_encoded_columns = 1;

query I
SELECT count(*) FROM encoded_like WHERE url LIKE 'xxx%';
----
5000

query I
SELECT count(*) FROM encoded_like WHERE url NOT LIKE 'xxx%';
----
3000

query I
SELECT count(*) FROM encoded_like WHERE url LIKE 'xxx/a';
----
2000

query I
SELECT count(*) FROM encoded_like WHERE url LIKE 'xxx!_%' ESCAPE '!';
----
1000

query I
SELECT count(*) FROM encoded_like WHERE url LIKE 'xxx/_';
----
4000

query I
SELECT count(*) FROM encoded_like WHERE url LIKE '%';
----
8000

query I
SELECT count(*) FROM encoded_like WHERE url NOT LIKE '%';
----
0

query I
SELECT count(*) FROM encoded_like WHERE url LIKE '';
----
1000

query I
SELECT count(*) FROM encoded_like WHERE nullable_url LIKE 'xxx%';
----
4000

query I
SELECT count(*) FROM encoded_like WHERE nullable_url NOT LIKE 'xxx%';
----
2000

query I
SELECT count(*) FROM encoded_like WHERE nullable_url LIKE 'xxx%' OR k % 8 = 2;
----
5000

# Consumers after the scan must still see the original NULL semantics.
query TI
SELECT nullable_url, count(*) FROM encoded_like GROUP BY nullable_url ORDER BY nullable_url NULLS FIRST;
----
NULL 2000
xxx/a 1000
xxx/c 2000
xxx_100% 1000
yyy/b 2000

query I
SELECT count(*) FROM encoded_like l JOIN encoded_like r ON l.k = r.k AND l.nullable_url = r.nullable_url WHERE l.url LIKE 'xxx%';
----
4000

# `k` is unique, so set difference compares the rows exactly (`EXCEPT ALL` is not supported).
query I
SELECT count(*) FROM (SELECT k, url FROM encoded_like WHERE (url LIKE 'xxx%' OR k % 8 = 1) AND (url NOT LIKE '%/a' OR k % 8 = 2) EXCEPT SELECT k, url FROM encoded_like_expected);
----
0

query I
SELECT count(*) FROM (SELECT k, url FROM encoded_like_expected EXCEPT SELECT k, url FROM encoded_like WHERE (url LIKE 'xxx%' OR k % 8 = 1) AND (url NOT LIKE '%/a' OR k % 8 = 2));
----
0

statement ok
UNSET enable_encoded_columns;

statement ok
UNSET enable_selector_executor;

statement ok
DROP TABLE encoded_like_expected;

statement ok
DROP TABLE encoded_like;

# Other encoded column paths: frame of reference comparisons, decimal arithmetic, grouping by
# codes, nullable columns, joins and output. Every query runs with the setting off and on, and both
# runs expect the same results.
statement ok
CREATE OR REPLACE TABLE encoded_columns(k UINT64 NOT NULL, i INT64 NOT NULL, d DATE NOT NULL, ts TIMESTAMP NOT NULL,
    p DECIMAL(15, 2) NOT NULL, q DECIMAL(15, 2) NOT NULL, disc DECIMAL(15, 2) NOT NULL, s STRING NOT NULL,
    g INT32 NOT NULL, f DOUBLE NOT NULL, ni INT64 NULL, np DECIMAL(15, 2) NULL, ns STRING NULL, hs STRING NOT NULL)
    STORAGE_FORMAT = 'parquet' ENABLE_PARQUET_DICTIONARY = true;

statement ok
INSERT INTO encoded_columns SELECT number, 1000000 + number % 3000, '2024-01-01'::DATE + (number % 90)::INT,
    '2024-01-01 00:00:00'::TIMESTAMP + (number % 500) * 60000000, 900 + (number % 5000)::DECIMAL(15, 2) / 100,
    (number % 50 + 1)::DECIMAL(15, 2), (number % 11)::DECIMAL(15, 2) / 100, ['AIR', 'MAIL', 'SHIP', 'RAIL', 'TRUCK'][number % 5 + 1],
    number % 7, IF(number % 3 = 0, -(0.0::DOUBLE), IF(number % 3 = 1, 0.0::DOUBLE, 1.5::DOUBLE)),
    IF(number % 6 = 0, NULL, 5000 + number % 300), IF(number % 4 = 1, NULL, (number % 900)::DECIMAL(15, 2) / 10),
    IF(number % 5 = 2, NULL, ['a', 'b', 'c'][number % 3 + 1]), 'u' || (number % 9000)::STRING
FROM numbers(20000);

statement ok
INSERT INTO encoded_columns SELECT number + 50000, 1000000 + number % 3000 + 50000, '2024-01-01'::DATE + (number % 90)::INT,
    '2024-01-01 00:00:00'::TIMESTAMP + (number % 500) * 60000000, 900 + (number % 5000)::DECIMAL(15, 2) / 100,
    (number % 50 + 1)::DECIMAL(15, 2), (number % 11)::DECIMAL(15, 2) / 100, ['AIR', 'MAIL', 'SHIP', 'RAIL', 'TRUCK'][number % 5 + 1],
    number % 7, IF(number % 3 = 0, -(0.0::DOUBLE), IF(number % 3 = 1, 0.0::DOUBLE, 1.5::DOUBLE)),
    IF(number % 6 = 0, NULL, 5000 + number % 300), IF(number % 4 = 1, NULL, (number % 900)::DECIMAL(15, 2) / 10),
    IF(number % 5 = 2, NULL, ['a', 'b', 'c'][number % 3 + 1]), 'u' || (number % 9000)::STRING
FROM numbers(10000);

statement ok
SET enable_encoded_columns = 0;

# Frame of reference comparisons: integer, date, timestamp, decimal (with a constant of a smaller scale).

query II
SELECT count(*), sum(k) FROM encoded_columns WHERE i >= 1001000 AND i < 1002000;
----
7000 73496500

query II
SELECT count(*), sum(k) FROM encoded_columns WHERE d BETWEEN '2024-02-01' AND '2024-02-10' OR ts > '2024-01-01 08:00:00';
----
4336 108441145

query II
SELECT count(*), sum(k) FROM encoded_columns WHERE q >= 25 AND p < 925.5 AND p <> 910.01;
----
7956 189245394

query II
SELECT count(*), sum(k) FROM encoded_columns WHERE i IN (1000005, 1000007, 1050009) OR g = 3;
----
4301 107424671

# Comparisons and arithmetic between encoded columns.

query II
SELECT count(*), sum(k) FROM encoded_columns WHERE p > q * 30 AND q - disc > 10;
----
12240 306295200

# Decimal arithmetic and aggregation over encoded operands, grouped by low-cardinality keys (codes).

