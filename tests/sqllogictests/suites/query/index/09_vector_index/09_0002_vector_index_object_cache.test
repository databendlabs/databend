# Decoded indexes use the existing vector-index memory budget automatically, without a new
# setting or an enabling CALL. Result/prune caches must not hide repeated index reads.
statement ok
set enable_query_result_cache = 0;

statement ok
set enable_prune_cache = 0;

statement ok
create or replace database test_vector_index_object_cache;

statement ok
use test_vector_index_object_cache;

statement ok
create table t(id int, embedding vector(8), vector index idx(embedding) m=4 ef_construct=8 distance='cosine,l1,l2');

statement ok
insert into t values
(1, [1,0,0,0,0,0,0,0]),
(2, [0,1,0,0,0,0,0,0]),
(3, [0,0,1,0,0,0,0,0]),
(4, [0,0,0,1,0,0,0,0]);

query I
select id from t order by cosine_distance(embedding, [1,0,0,0,0,0,0,0]::vector(8)) limit 1;
----
1

# A different query vector reuses the same decoded index, not the previous query's results.
query I
select id from t order by cosine_distance(embedding, [0,1,0,0,0,0,0,0]::vector(8)) limit 1;
----
2

query I
select id from t order by l1_distance(embedding, [0,0,1,0,0,0,0,0]::vector(8)) limit 1;
----
3

query I
select id from t order by l2_distance(embedding, [0,0,0,1,0,0,0,0]::vector(8)) limit 1;
----
4

# DESC and filtered searches use generate_scores(), sharing the same object-loading path.
query I
select id from t order by l2_distance(embedding, [1,0.4,0.2,0.1,0,0,0,0]::vector(8)) desc limit 1;
----
4

query I
select id from t where id > 1 order by l1_distance(embedding, [0,0,1,0,0,0,0,0]::vector(8)) limit 1;
----
3

query B
select count() > 0 from system.caches where name = 'memory_cache_vector_index_file' and capacity > 0 and num_items > 0 and size > 0 and hit > 0;
----
1

# The original cache name now reports decoded indexes; there is no additional memory budget.
query I
select count() from system.caches where name = 'memory_cache_vector_index';
----
0

# Mutations and index refresh use new immutable index locations and must not return stale objects.
statement ok
insert into t values (5, [0,0,0,0,1,0,0,0]);

query I
select id from t order by cosine_distance(embedding, [0,0,0,0,1,0,0,0]::vector(8)) limit 1;
----
5

statement ok
update t set embedding = [0,0,0,0,0,1,0,0]::vector(8) where id = 1;

query I
select id from t order by cosine_distance(embedding, [0,1,0,0,0,2,0,0]::vector(8)) limit 1;
----
1

statement ok
delete from t where id = 1;

query I
select id from t order by cosine_distance(embedding, [0,1,0,0,0,2,0,0]::vector(8)) limit 1;
----
2

statement ok
optimize table t compact;

statement ok
refresh vector index idx on t;

query I
select id from t order by cosine_distance(embedding, [0,1,0,0,0,2,0,0]::vector(8)) limit 1;
----
2

query I
select id from t order by l2_distance(embedding, [0,0,1,0,0,0,0,0]::vector(8)) limit 1;
----
3

statement ok
drop database test_vector_index_object_cache;

statement ok
set enable_prune_cache = 1;
