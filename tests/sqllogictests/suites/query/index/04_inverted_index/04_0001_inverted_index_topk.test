# The default pass uses lazy pruning in the pipeline; this pass prunes eagerly in read_partitions.
# run-with-settings: enable_distributed_pruning=0, enable_prune_pipeline=0
# FTS TopK is a query-time optimization; use the existing index and output path.
# Each INSERT creates a block with more matches than the small LIMITs below.
# Equal document lengths and interleaved term frequencies give distinct scores
# across the two blocks, so comparisons include document ids without tie ambiguity.

statement ok
DROP DATABASE IF EXISTS test_inverted_index_topk

statement ok
CREATE DATABASE test_inverted_index_topk

statement ok
USE test_inverted_index_topk

statement ok
CREATE TABLE docs (
    id INT NOT NULL,
    tenant INT NOT NULL,
    content STRING NOT NULL,
    INVERTED INDEX fts (content) tokenizer = 'english'
) ROW_PER_BLOCK = 64 STORAGE_FORMAT = 'parquet'

statement ok
INSERT INTO docs
SELECT number + 1, 0,
       concat(repeat('needle ', number * 2 + 1), repeat('filler ', 31 - number * 2))
FROM numbers(10)

statement ok
INSERT INTO docs
SELECT number + 11, 1,
       concat(repeat('needle ', number * 2 + 2), repeat('filler ', 30 - number * 2))
FROM numbers(10)

# No LIMIT in the reference query: collect every match and its original BM25 score.
statement ok
CREATE TABLE reference AS
SELECT id, tenant, content, score() AS s FROM docs WHERE match(content, 'needle')

query II
SELECT count(*), count(DISTINCT s) FROM reference
----
20 20

# Direct score ordering must preserve both ids and scores across blocks.
query I
WITH actual AS (
    SELECT id, score() AS s FROM docs WHERE match(content, 'needle') ORDER BY score() DESC LIMIT 3
), expected AS (
    SELECT id, s FROM reference ORDER BY s DESC LIMIT 3
)
SELECT count(*) FROM actual a FULL OUTER JOIN expected e ON a.id = e.id
WHERE a.id IS NULL OR e.id IS NULL OR a.s != e.s
----
0

query I
SELECT id FROM docs WHERE match(content, 'needle') ORDER BY score() DESC LIMIT 3
----
20
10
19

# QUERY() uses the same safe collector path as MATCH().
query I
WITH actual AS (
    SELECT id, score() AS s FROM docs WHERE query('content:needle') ORDER BY score() DESC LIMIT 10
), expected AS (
    SELECT id, s FROM reference ORDER BY s DESC LIMIT 10
)
SELECT count(*) FROM actual a FULL OUTER JOIN expected e ON a.id = e.id
WHERE a.id IS NULL OR e.id IS NULL OR a.s != e.s
----
0

# OFFSET needs limit + offset candidates per block, not just limit.
query I
WITH actual AS (
    SELECT id, score() AS s FROM docs WHERE match(content, 'needle') ORDER BY score() DESC LIMIT 3 OFFSET 5
), expected AS (
    SELECT id, s FROM reference ORDER BY s DESC LIMIT 3 OFFSET 5
)
SELECT count(*) FROM actual a FULL OUTER JOIN expected e ON a.id = e.id
WHERE a.id IS NULL OR e.id IS NULL OR a.s != e.s
----
0

query I
SELECT id FROM docs WHERE match(content, 'needle') ORDER BY score() DESC LIMIT 3 OFFSET 5
----
8
17
7

# Boundaries: fewer matches than K, no matches, zero limit, and exhausted offset.
query I
SELECT count(*) FROM (
    SELECT id FROM docs WHERE match(content, 'needle') ORDER BY score() DESC LIMIT 100
)
----
20

query I
SELECT id FROM docs WHERE match(content, 'absent') ORDER BY score() DESC LIMIT 3
----

query I
SELECT id FROM docs WHERE match(content, 'needle') ORDER BY score() DESC LIMIT 0
----

query I
SELECT id FROM docs WHERE match(content, 'needle') ORDER BY score() DESC LIMIT 3 OFFSET 30
----

# The index-only scan still needs the original row ids for late materialization.
query I
WITH actual AS (
    SELECT id, content, score() AS s FROM docs WHERE match(content, 'needle') ORDER BY score() DESC LIMIT 3
), expected AS (
    SELECT id, content, s FROM reference ORDER BY s DESC LIMIT 3
)
SELECT count(*) FROM actual a FULL OUTER JOIN expected e ON a.id = e.id
WHERE a.id IS NULL OR e.id IS NULL OR a.s != e.s OR a.content != e.content
----
0

# Fallbacks must keep the full match set: ASC, computed score and residual filters.
query I
WITH actual AS (
    SELECT id, score() AS s FROM docs WHERE match(content, 'needle') ORDER BY score() ASC LIMIT 3
), expected AS (
    SELECT id, s FROM reference ORDER BY s ASC LIMIT 3
)
SELECT count(*) FROM actual a FULL OUTER JOIN expected e ON a.id = e.id
WHERE a.id IS NULL OR e.id IS NULL OR a.s != e.s
----
0

query I
WITH actual AS (
    SELECT id, score() AS s FROM docs WHERE match(content, 'needle') ORDER BY -score() ASC LIMIT 3
), expected AS (
    SELECT id, s FROM reference ORDER BY s DESC LIMIT 3
)
SELECT count(*) FROM actual a FULL OUTER JOIN expected e ON a.id = e.id
WHERE a.id IS NULL OR e.id IS NULL OR a.s != e.s
----
0

# The best-scoring rows fail this predicate; truncating before filtering loses rows.
query I
WITH actual AS (
    SELECT id, score() AS s FROM docs WHERE match(content, 'needle') AND id <= 3 ORDER BY score() DESC LIMIT 3
), expected AS (
    SELECT id, s FROM reference WHERE id <= 3 ORDER BY s DESC LIMIT 3
)
SELECT count(*) FROM actual a FULL OUTER JOIN expected e ON a.id = e.id
WHERE a.id IS NULL OR e.id IS NULL OR a.s != e.s
----
0

query I
SELECT id FROM docs WHERE match(content, 'needle') AND id <= 3 ORDER BY score() DESC LIMIT 3
----
3
2
1

# A score predicate is also a residual filter, and the planner still pushes the
# limit down for it. Every block's top candidates fail the predicate, so a
# collector truncated before filtering would return nothing. The threshold is
# taken from the reference data so the test does not depend on BM25 constants.
statement ok
SET VARIABLE topk_threshold = (SELECT s FROM reference WHERE id = 3)

query I
SELECT id FROM docs
WHERE match(content, 'needle') AND score() < $topk_threshold
ORDER BY score() DESC LIMIT 3
----
12
2
11

statement ok
UNSET VARIABLE topk_threshold

query I
SELECT count(*) FROM (
    SELECT id FROM docs WHERE match(content, 'needle')
)
----
20

query I
SELECT count(*) FROM (
    SELECT id FROM docs WHERE match(content, 'needle') LIMIT 3
)
----
3

query I
SELECT id FROM docs WHERE match(content, 'needle') ORDER BY id DESC LIMIT 3
----
20
19
18

# Reuse the same index with another K after previous searches (including cached metadata).
query I
WITH actual AS (
    SELECT id, score() AS s FROM docs WHERE match(content, 'needle') ORDER BY score() DESC LIMIT 8
), expected AS (
    SELECT id, s FROM reference ORDER BY s DESC LIMIT 8
)
SELECT count(*) FROM actual a FULL OUTER JOIN expected e ON a.id = e.id
WHERE a.id IS NULL OR e.id IS NULL OR a.s != e.s
----
0

# Equal scores make a secondary sort key essential. Single-key TopK is not safe here.
statement ok
CREATE TABLE ties (
    id INT NOT NULL,
    content STRING NOT NULL,
    INVERTED INDEX fts (content) tokenizer = 'english'
) ROW_PER_BLOCK = 64 STORAGE_FORMAT = 'parquet'

statement ok
INSERT INTO ties VALUES (1, 'needle'), (2, 'needle'), (3, 'needle'), (4, 'needle'), (5, 'needle')

query I
SELECT id FROM ties WHERE match(content, 'needle') ORDER BY score() DESC, id DESC LIMIT 2
----
5
4

query I
SELECT count(*) FROM (
    SELECT id FROM ties WHERE match(content, 'needle') ORDER BY score() DESC LIMIT 2
)
----
2

statement ok
USE default

statement ok
DROP DATABASE test_inverted_index_topk
