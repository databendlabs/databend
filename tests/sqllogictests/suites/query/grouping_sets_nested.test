# A grouping-set branch makes its keys nullable under the original column IDs.
# Downstream aggregates must see the replacement, not a second non-nullable copy.
# Cover the default cascade, shared-base hierarchy, ordinary UNION rewrite, and Expand.
# Explicit modes keep these regressions covered if the default switch is deferred.
# run-with-settings: grouping_sets_to_union=1,enable_cascading_grouping_sets=0
# run-with-settings: grouping_sets_to_union=1,enable_cascading_grouping_sets=1
# run-with-settings: grouping_sets_to_union=1,optimizer_skip_list=HierarchicalGroupingSetsToUnion
# run-with-settings: grouping_sets_to_union=0

query III
WITH c AS (
    SELECT a, b, sum(v) AS s
    FROM (VALUES (1, 2, 3), (1, 3, 4)) t(a, b, v)
    GROUP BY ROLLUP(a, b)
)
SELECT a, sum(s), grouping(a)
FROM c
GROUP BY ROLLUP(a)
ORDER BY a NULLS LAST, grouping(a)
----
1 14 0
NULL 7 0
NULL 21 1

query TII
WITH c AS (
    SELECT a, b, sum(v) AS s
    FROM (VALUES ('x', 2, 3), ('x', 3, 4)) t(a, b, v)
    GROUP BY ROLLUP(a, b)
)
SELECT a, sum(s), grouping(a)
FROM c
GROUP BY ROLLUP(a)
ORDER BY a NULLS LAST, grouping(a)
----
x 14 0
NULL 7 0
NULL 21 1

# Non-hierarchical aggregates use the ordinary UNION rewrite as well.
query IRI
WITH c AS (
    SELECT a, b, avg(v) AS s
    FROM (VALUES (1, 2, 3), (1, 3, 4)) t(a, b, v)
    GROUP BY ROLLUP(a, b)
)
SELECT a, sum(s), grouping(a)
FROM c
GROUP BY ROLLUP(a)
ORDER BY a NULLS LAST, grouping(a)
----
1 10.5 0
NULL 3.5 0
NULL 14.0 1

# Multiple references remap the producer's columns to different consumer IDs.
query III
WITH c AS MATERIALIZED (
    SELECT a, b, sum(v) AS s
    FROM (VALUES (1, 2, 3), (1, 3, 4)) t(a, b, v)
    GROUP BY ROLLUP(a, b)
)
SELECT x.a, sum(x.s + y.s), grouping(x.a)
FROM c x JOIN c y ON x.a IS NOT DISTINCT FROM y.a
GROUP BY ROLLUP(x.a)
ORDER BY x.a NULLS LAST, grouping(x.a)
----
1 84 0
NULL 14 0
NULL 98 1

# The intermediate level and final grand total both consume nullable keys.
query III
WITH c AS (
    SELECT a, b, c, sum(v) AS s
    FROM (VALUES (1, 2, 3, 4), (1, 2, 4, 5)) t(a, b, c, v)
    GROUP BY ROLLUP(a, b, c)
), d AS (
    SELECT a, b, sum(s) AS s
    FROM c
    GROUP BY ROLLUP(a, b)
)
SELECT a, sum(s), grouping(a)
FROM d
GROUP BY ROLLUP(a)
ORDER BY a NULLS LAST, grouping(a)
----
1 54 0
NULL 54 0
NULL 108 1

# A ROLLUP without aggregate functions must not build a hierarchical CTE chain:
# its grand-total level has no columns and the materialized CTE never completes.
query TII rowsort
SELECT depname, salary, grouping(depname, salary)
FROM (VALUES ('develop', 5200), ('sales', 5000), ('personnel', 3500), ('sales', 4800), ('develop', 4200)) e(depname, salary)
GROUP BY ROLLUP(depname, salary)
----
NULL NULL 3
develop 4200 0
develop 5200 0
develop NULL 1
personnel 3500 0
personnel NULL 1
sales 4800 0
sales 5000 0
sales NULL 1

query I rowsort
SELECT grouping(depname, salary)
FROM (VALUES ('develop', 5200), ('sales', 5000), ('personnel', 3500), ('sales', 4800), ('develop', 4200)) e(depname, salary)
GROUP BY ROLLUP(depname, salary)
----
0
0
0
0
0
1
1
1
3
