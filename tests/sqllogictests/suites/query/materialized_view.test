# Materialized view DDL and explicit refresh over Fuse CHANGE_TRACKING.
# CREATE enables source CHANGE_TRACKING atomically when needed.

statement ok
drop database if exists test_materialized_view

statement ok
create database test_materialized_view

statement ok
use test_materialized_view

statement ok
create table source (
    id int,
    amount int,
    category string,
    active boolean
)

query B
select table_option like '%CHANGE_TRACKING=''true''%'
from system.tables
where database = 'test_materialized_view' and name = 'source'
----
0

# Explicit MV column names are exposed to users. CREATE atomically enables source change tracking.
statement ok
create materialized view mv_detail (item_id, doubled_amount) as
select id, amount * 2 from source where active

query B
select table_option like '%CHANGE_TRACKING=''true''%'
from system.tables
where database = 'test_materialized_view' and name = 'source'
----
1

# A rejected cross-engine replacement must not enable change tracking on its source.
statement ok
create table atomic_source (id int)

statement ok
create table atomic_target (id int)

statement error 1302
create or replace materialized view atomic_target as select id from atomic_source where id > 0

query B
select table_option like '%CHANGE_TRACKING=''true''%'
from system.tables
where database = 'test_materialized_view' and name = 'atomic_source'
----
0

# CREATE IF NOT EXISTS is a complete no-op when the target MV already exists.
statement ok
create materialized view if not exists mv_detail as select id from atomic_source where id > 0

query B
select table_option like '%CHANGE_TRACKING=''true''%'
from system.tables
where database = 'test_materialized_view' and name = 'atomic_source'
----
0

# A successful CREATE publishes the MV and enables source tracking atomically.
statement ok
drop table atomic_target

statement ok
create materialized view atomic_target as select id from atomic_source where id > 0

query B
select table_option like '%CHANGE_TRACKING=''true''%'
from system.tables
where database = 'test_materialized_view' and name = 'atomic_source'
----
1

statement ok
drop materialized view atomic_target

statement ok
drop table atomic_source

# Aggregating MVs persist states internally and expose finalized values.
statement ok
create materialized view mv_aggregate (category_name, total_amount, row_count, average_amount) as
select category, sum(amount), count(*), avg(amount)
from source
where active
group by category

query I
select count(*)
from system.tables
where database = 'test_materialized_view'
  and table_type = 'MATERIALIZED VIEW'
  and name in ('mv_detail', 'mv_aggregate')
----
2

# CREATE leaves MV storage empty. The first explicit refresh consumes the full endpoint.
statement ok
insert into source values
    (1, 10, 'a', true),
    (2, 20, 'a', false),
    (3, 30, 'b', true)

statement ok
refresh materialized view mv_detail

statement ok
refresh materialized view mv_aggregate

query II
select item_id, doubled_amount from mv_detail order by item_id
----
1 20
3 60

query TIIR
select category_name, total_amount, row_count, average_amount
from mv_aggregate
order by category_name
----
a 10 1 10.0
b 30 1 30.0

# INSERT-only changes use incremental refresh. Aggregate states are appended and merged on read.
statement ok
insert into source values
    (4, 40, 'a', true),
    (5, 50, 'b', true),
    (6, 60, 'c', false)

statement ok
refresh materialized view mv_detail

statement ok
refresh materialized view mv_aggregate

query II
select item_id, doubled_amount from mv_detail order by item_id
----
1 20
3 60
4 80
5 100

query TIIR
select category_name, total_amount, row_count, average_amount
from mv_aggregate
order by category_name
----
a 50 2 25.0
b 80 2 40.0

# UPDATE uses the Standard changes path. Detail MV is maintained by MERGE;
# aggregate MV is rebuilt from the current source endpoint.
statement ok
update source set amount = 25, active = true where id = 2

statement ok
update source set amount = 35, category = 'a' where id = 3

statement ok
refresh materialized view mv_detail

statement ok
refresh materialized view mv_aggregate

query II
select item_id, doubled_amount from mv_detail order by item_id
----
1 20
2 50
3 70
4 80
5 100

query TIIR
select category_name, total_amount, row_count, average_amount
from mv_aggregate
order by category_name
----
a 110 4 27.5
b 50 1 50.0

# DELETE also uses Standard changes. Aggregate refresh falls back to a full rebuild.
statement ok
delete from source where id in (1, 5)

statement ok
refresh materialized view mv_detail

statement ok
refresh materialized view mv_aggregate

query II
select item_id, doubled_amount from mv_detail order by item_id
----
2 50
3 70
4 80

query TIIR
select category_name, total_amount, row_count, round(average_amount, 2)
from mv_aggregate
order by category_name
----
a 100 3 33.33

query III
select count(*), sum(amount), count_if(active) from source
----
4 160 3

# TRUNCATE produces an empty source endpoint. Refresh must remove all previously materialized rows.
statement ok
truncate table source

statement ok
refresh materialized view mv_detail

statement ok
refresh materialized view mv_aggregate

query I
select count(*) from mv_detail
----
0

query I
select count(*) from mv_aggregate
----
0

query I
select count(*) from source
----
0

statement ok
drop materialized view mv_detail

statement ok
drop materialized view if exists mv_detail

statement ok
drop materialized view mv_aggregate

query I
select count(*)
from system.tables
where database = 'test_materialized_view'
  and table_type = 'MATERIALIZED VIEW'
  and name in ('mv_detail', 'mv_aggregate')
----
0

# A persisted definition resolving to a same-named replacement table must not read old MV storage
# or execute against the replacement source.
statement ok
create table replaced_source (id int) change_tracking = true

statement ok
create materialized view replaced_mv as select id from replaced_source where id > 0

statement ok
insert into replaced_source values (1)

statement ok
refresh materialized view replaced_mv

statement ok
alter table replaced_source rename to renamed_replaced_source

# Renaming the source invalidates the persisted query binding.
statement error 1025
select * from replaced_mv

statement error (?s)2328.*source table changed
refresh materialized view replaced_mv

statement ok
create table replaced_source (id int) change_tracking = true

statement error (?s)2328.*source table changed
select * from replaced_mv

statement error (?s)2328.*source table changed
refresh materialized view replaced_mv

statement ok
drop materialized view replaced_mv

statement ok
drop table replaced_source

statement ok
drop table renamed_replaced_source

statement ok
use default

statement ok
drop database test_materialized_view

# Materialized view DDL, maintenance, and source-binding guards.

statement ok
CREATE TABLE mv_base_t (id INT, val VARCHAR, amount INT)

statement ok
CREATE TABLE mv_base_t2 (id INT)

statement ok
INSERT INTO mv_base_t VALUES (1, 'a', 10), (2, 'b', 20), (3, 'a', 30), (4, 'b', 40)

statement ok
ALTER TABLE mv_base_t SET OPTIONS (change_tracking = true)

# EXPLAIN prints the metadata-only CREATE operation, not the stored definition query plan.
query T
EXPLAIN CREATE MATERIALIZED VIEW test_mv_explain AS SELECT id FROM mv_base_t WHERE 1 = 1
----
CreateMaterializedView

# CREATE leaves storage empty, but reads use the live definition until the first refresh.
statement ok
CREATE MATERIALIZED VIEW test_mv AS SELECT id, val, amount FROM mv_base_t WHERE id <= 2

query I
SELECT count(*) FROM test_mv
----
2

# DESC does not expose the materialized view's physical storage schema.
statement error 1302
DESC test_mv

# SHOW CREATE MATERIALIZED VIEW
query TT
SHOW CREATE MATERIALIZED VIEW test_mv
----
test_mv CREATE MATERIALIZED VIEW `default`.`test_mv` (`id`, `val`, `amount`) AS SELECT id, val, amount FROM default.mv_base_t WHERE id <= 2

# SHOW CREATE TABLE does not accept materialized views.
statement error 1302
SHOW CREATE TABLE test_mv

# Materialized view creation is always asynchronous; explicit creation modes are rejected.
statement error
CREATE SYNC MATERIALIZED VIEW test_mv_sync AS SELECT id FROM mv_base_t WHERE 1 = 1

statement error
CREATE ASYNC MATERIALIZED VIEW test_mv_async AS SELECT id FROM mv_base_t WHERE 1 = 1

# SHOW CREATE MATERIALIZED VIEW rejects base tables.
statement error 1302
SHOW CREATE MATERIALIZED VIEW mv_base_t

# SHOW MATERIALIZED VIEWS surfaces the MV object. Its system.tables metadata is verified below
# together with the clustered MV.
statement ok
SHOW MATERIALIZED VIEWS FROM default.default LIKE 'test_mv'

# IF NOT EXISTS
statement ok
CREATE MATERIALIZED VIEW IF NOT EXISTS test_mv AS SELECT id FROM mv_base_t WHERE 1 = 1

# Error: already exists
statement error 2329
CREATE MATERIALIZED VIEW test_mv AS SELECT id FROM mv_base_t WHERE 1 = 1

# CREATE OR REPLACE MATERIALIZED VIEW
statement ok
CREATE OR REPLACE MATERIALIZED VIEW test_mv AS SELECT val, COUNT(*) AS cnt FROM mv_base_t WHERE 1 = 1 GROUP BY val

query I
SELECT count(*) FROM test_mv
----
2

# CREATE OR REPLACE MATERIALIZED VIEW cannot depend on the old MV object.
statement error 1302
CREATE OR REPLACE MATERIALIZED VIEW test_mv AS SELECT val, cnt FROM test_mv WHERE 1 = 1

# Replace back to a stable definition for guard/drop tests.
statement ok
CREATE OR REPLACE MATERIALIZED VIEW test_mv AS SELECT id, val, amount FROM mv_base_t WHERE id <= 2

# Protected options: user cannot set MV options via CREATE TABLE.
statement error 1301
CREATE TABLE fake_mv (x INT) materialized_view_source_table_id = '1'

# The MV engine cannot be used to bypass CREATE MATERIALIZED VIEW metadata creation.
statement error 1005
CREATE TABLE fake_mv_engine (x INT) ENGINE = MATERIALIZED_VIEW

# Protected options: user cannot set MV options via ALTER TABLE.
statement error 1301
ALTER TABLE test_mv SET OPTIONS (materialized_view_source_table_id = '1')

# Even an option valid for the MV engine cannot be changed through ALTER TABLE.
statement error 3905
ALTER TABLE test_mv SET OPTIONS (aggressive_recluster = 1)

statement error 3905
ALTER TABLE test_mv UNSET OPTIONS (block_per_segment)

statement error
ALTER VIEW test_mv AS SELECT 1

statement error
ALTER TABLE test_mv RENAME TO test_mv_renamed

statement error
ALTER TABLE test_mv SWAP WITH mv_base_t

# All ALTER TABLE operations are blocked on materialized views.
statement error 3905
ALTER TABLE test_mv COMMENT = 'changed'

statement error 3905
ALTER TABLE test_mv CONNECTION = (CONNECTION_NAME = 'missing')

statement error 3905
ALTER TABLE test_mv ADD COLUMN new_col INT

statement error 3905
ALTER TABLE test_mv DROP COLUMN val

statement error 3905
ALTER TABLE test_mv RENAME COLUMN val TO value

statement error 3905
ALTER TABLE test_mv MODIFY COLUMN amount BIGINT

statement error 3905
ALTER TABLE test_mv ADD CONSTRAINT positive_id CHECK (id > 0)

statement error 3905
ALTER TABLE test_mv DROP CONSTRAINT positive_id

statement error 3905
ALTER TABLE test_mv RECLUSTER

statement error 3905
ALTER TABLE test_mv FLASHBACK TO (SNAPSHOT => '00000000-0000-0000-0000-000000000000')

statement error 3905
ALTER TABLE test_mv CREATE TAG mv_snapshot

statement error 3905
ALTER TABLE test_mv DROP TAG mv_snapshot

# TRUNCATE is blocked on materialized views.
statement error 3905
TRUNCATE TABLE test_mv

# User writes are blocked on materialized views.
statement error 3905
INSERT INTO test_mv VALUES (5, 'c', 50)

statement error 3905
UPDATE test_mv SET val = 'changed' WHERE id = 1

statement error 3905
DELETE FROM test_mv WHERE id = 1

statement error 3905
MERGE INTO test_mv AS target
USING (SELECT 1 AS id, 'changed' AS val, 100 AS amount) AS source
ON target.id = source.id
WHEN MATCHED THEN UPDATE SET target.val = source.val
WHEN NOT MATCHED THEN INSERT (id, val, amount) VALUES (source.id, source.val, source.amount)

statement error 3905
REPLACE INTO test_mv ON CONFLICT(id) VALUES (1, 'changed', 100)

statement error 1302
INSERT ALL
    INTO test_mv VALUES (id, val, amount)
SELECT 5 AS id, 'c' AS val, 50 AS amount

statement ok
CREATE STAGE mv_empty_stage

statement error 3905
COPY INTO test_mv FROM @mv_empty_stage FILE_FORMAT = (TYPE = CSV)

statement ok
