# Dedicated MV maintenance reuses Fuse plans without opening TABLE syntax on MVs.
statement ok
ALTER MATERIALIZED VIEW test_mv CLUSTER BY (id)

query TT
SHOW CREATE MATERIALIZED VIEW test_mv
----
test_mv CREATE MATERIALIZED VIEW `default`.`test_mv` (`id`, `val`, `amount`) CLUSTER BY (id) AS SELECT id, val, amount FROM default.mv_base_t WHERE id <= 2

# Hidden refresh columns are not valid MV cluster keys.
statement error
