statement ok
ALTER MATERIALIZED VIEW test_mv RECLUSTER LIMIT 1

statement ok
ALTER MATERIALIZED VIEW test_mv RECLUSTER FINAL LIMIT 1

statement ok
ALTER MATERIALIZED VIEW test_mv DROP CLUSTER KEY

query TT
SHOW CREATE MATERIALIZED VIEW test_mv
----
test_mv CREATE MATERIALIZED VIEW `default`.`test_mv` (`id`, `val`, `amount`) AS SELECT id, val, amount FROM default.mv_base_t WHERE id <= 2

# The dedicated syntax rejects ordinary tables and unrelated ALTER actions.
statement error
ALTER MATERIALIZED VIEW mv_base_t CLUSTER BY (id)

statement error
