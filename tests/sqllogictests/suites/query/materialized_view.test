statement ok
SET ROLE mv_maintenance_role

statement ok
ALTER MATERIALIZED VIEW test_mv CLUSTER BY (id)

statement ok
ALTER MATERIALIZED VIEW test_mv RECLUSTER LIMIT 1

statement ok
SET ROLE account_admin

statement ok
DROP ROLE mv_maintenance_role

# Snowflake-compatible syntax requires a column list whenever CLUSTER BY is present.
statement error 1065
