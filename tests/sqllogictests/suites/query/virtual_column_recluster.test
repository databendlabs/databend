# Overlapping blocks guarantee that recluster has Hilbert tasks to run.
query B
SELECT info:max_depth::int > 8 FROM clustering_information('test_virtual_column_recluster', 't_hilbert')
----
1

statement ok
SET enable_recluster_early_virtual_column = 1

statement ok
ALTER TABLE t_before_sort RECLUSTER FINAL

statement ok
ALTER TABLE t_hilbert RECLUSTER FINAL

statement ok
SET enable_recluster_early_virtual_column = 0

statement ok
ALTER TABLE t_writer RECLUSTER FINAL

statement ok
UNSET enable_recluster_early_virtual_column

