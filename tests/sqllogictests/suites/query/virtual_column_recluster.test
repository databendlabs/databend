# Both extraction paths write the same sidecars for the same output blocks.
query I
SELECT count(*) FROM (
  SELECT row_count, virtual_column_size, virtual_columns_complete, virtual_column_metas::STRING, virtual_path_statistics::STRING
  FROM fuse_virtual_column_block_meta('test_virtual_column_recluster', 't_before_sort')
  EXCEPT
  SELECT row_count, virtual_column_size, virtual_columns_complete, virtual_column_metas::STRING, virtual_path_statistics::STRING
  FROM fuse_virtual_column_block_meta('test_virtual_column_recluster', 't_writer')
)
----
0

query I
SELECT count(*) FROM (
  SELECT row_count, virtual_column_size, virtual_columns_complete, virtual_column_metas::STRING, virtual_path_statistics::STRING
  FROM fuse_virtual_column_block_meta('test_virtual_column_recluster', 't_writer')
  EXCEPT
  SELECT row_count, virtual_column_size, virtual_columns_complete, virtual_column_metas::STRING, virtual_path_statistics::STRING
  FROM fuse_virtual_column_block_meta('test_virtual_column_recluster', 't_before_sort')
)
----
0

