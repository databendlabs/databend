statement ok
DROP DATABASE IF EXISTS test_virtual_column_recluster

statement ok
CREATE DATABASE test_virtual_column_recluster

statement ok
USE test_virtual_column_recluster

# `t_before_sort` extracts virtual columns before the sort, `t_writer` in the block
# writer. The evaluated key `id % 5` places temporary key columns after the
# extracted virtual columns.
statement ok
CREATE TABLE t_before_sort(id INT, v VARIANT, w VARIANT NULL) CLUSTER BY(id % 5, id) row_per_block = 4 storage_format = 'parquet' enable_virtual_column = true

statement ok
CREATE TABLE t_writer(id INT, v VARIANT, w VARIANT NULL) CLUSTER BY(id % 5, id) row_per_block = 4 storage_format = 'parquet' enable_virtual_column = true

statement ok
CREATE TABLE t_hilbert(b INT, c INT, v VARIANT) CLUSTER BY HILBERT(b, c) row_per_block = 2 block_per_segment = 2 recluster_depth = 8 storage_format = 'parquet' enable_virtual_column = true

statement ok
CREATE TABLE src(id INT, v VARIANT, w VARIANT NULL)

statement ok
