# run-with-settings: partial_aggregate_mode=bypass

# Partial aggregation strategies must not change results. The default pass runs the adaptive
# strategy; the pass above forwards every row as raw input. Two threads and small blocks make the
# partial table fill up.

statement ok
set max_block_size = 4096

statement ok
set max_threads = 2

query IIIIII
select count(), sum(c), sum(s), min(mn), max(mx), sum(dc) from (select number % 30011 as k, count() c, sum(number) s, min(number) mn, max(number) mx, count(distinct number % 7) dc from numbers(100000) group by k)
----
30011	100000	4999950000	0	99999	100000

query IIT
select count(), sum(length(a)), max(m) from (select to_string(number % 1000) as k, array_agg(number) a, max(to_string(number)) m from numbers(100000) group by k)
----
1000	100000	99999

query II
select count(), sum(c) from (select if(number % 3 = 0, null, number % 1000) as k1, number % 7 as k2, count() c from numbers(100000) group by k1, k2)
----
7007	100000

query II
select count(), sum(c) from (select number % 100 a, number % 7 b, count() c from numbers(100000) group by grouping sets ((a), (b), ()))
----
108	300000

query II
select count(), sum(s) from (select number k, sum(number) s from numbers(100000) group by k)
----
100000	4999950000

query II
select sum(av)::Int64, sum(u) from (select number % 500 k, avg(number) av, uniq(number % 13) u from numbers(100000) group by k)
----
24999750	6500

statement ok
unset max_block_size

# Keys recur beyond the initial table: the adaptive strategy grows the table at once.
query II
select count(), sum(c) from (select number % 50000 as k, count() c from numbers(2000000) group by k)
----
50000	2000000

# Mostly unique input: the adaptive strategy forwards raw rows after its first checkpoint.
query II
select count(), sum(s) from (select number k, sum(number) s from numbers(2000000) group by k)
----
2000000	1999999000000

# Large input blocks: the partial state changes within a block, growing the table for string keys
# in a cyclic order, and forwarding the rest of a block once the keys are mostly unique.
statement ok
set max_block_size = 1000000

query II
select count(), sum(c) from (select to_string(number % 50000) as k, count() c from numbers(2000000) group by k)
----
50000	2000000

query II
select count(), sum(s) from (select number k, sum(number) s from numbers(2000000) group by k)
----
2000000	1999999000000

statement ok
unset max_block_size

# The final aggregate spills without changing the results.
statement ok
set force_aggregate_data_spill = 1

query IIIIII
select count(), sum(c), sum(s), min(mn), max(mx), sum(dc) from (select number % 30011 as k, count() c, sum(number) s, min(number) mn, max(number) mx, count(distinct number % 7) dc from numbers(100000) group by k)
----
30011	100000	4999950000	0	99999	100000

statement ok
unset force_aggregate_data_spill

# Final aggregates whose groups outgrow the caches keep their input by bucket of the group hash,
# and aggregate it a bucket at a time: with keys that come again many times, two keys of which one
# is nullable, and string keys.
query IIII
select count(), sum(c), min(c), max(c) from (select number % 400000 as k, count() c from numbers(4000000) group by k)
----
400000	4000000	10	10

query III
select count(), sum(c), sum(s) from (select number % 300000 as k1, if(number % 7 = 0, null, number % 3) as k2, count() c, sum(number) s from numbers(3000000) group by k1, k2)
----
600000	3000000	4499998500000

query IIII
select count(), sum(c), min(c), max(c) from (select to_string(number % 400000) as k, count() c from numbers(4000000) group by k)
----
400000	4000000	10	10

query IIII
select count(), sum(c), sum(s), max(l) from (select concat('a longer group key ', to_string(number % 300000)) as k, count() c, sum(number) s, max(length(k)) l from numbers(1500000) group by k)
----
300000	1500000	1124999250000	25

query IIII
select count(), sum(c), sum(d), sum(a::Int64) from (select number % 400000 as k, count() c, count(distinct number % 7) d, avg(number) a from numbers(4000000) group by k)
----
400000	4000000	2800000	799999800000

query IIII
select count(), sum(c), sum(s)::Int64, sum(n) from (select number % 400000 as k, count() c, sum((number % 1000)::decimal(15, 2)) s, count(if(number % 3 = 0, null, number)) n from numbers(4000000) group by k)
----
400000	4000000	1998000000	2666666

# Staged groups spill by bucket, and are aggregated again from the spill.
statement ok
set max_block_size = 1000000

statement ok
set force_aggregate_data_spill = 1

query II
select count(), sum(s) from (select number k, sum(number) s from numbers(2000000) group by k)
----
2000000	1999999000000

query IIII
select count(), sum(c), sum(d), sum(a::Int64) from (select number % 400000 as k, count() c, count(distinct number % 7) d, avg(number) a from numbers(4000000) group by k)
----
400000	4000000	2800000	799999800000

query IIII
select count(), sum(c), sum(s)::Int64, sum(n) from (select number % 400000 as k, count() c, sum((number % 1000)::decimal(15, 2)) s, count(if(number % 3 = 0, null, number)) n from numbers(4000000) group by k)
----
400000	4000000	1998000000	2666666

query IIII
select count(), sum(c), sum(s), max(l) from (select concat('a longer group key ', to_string(number % 300000)) as k, count() c, sum(number) s, max(length(k)) l from numbers(1500000) group by k)
----
300000	1500000	1124999250000	25

statement ok
unset force_aggregate_data_spill

statement ok
unset max_block_size

statement ok
unset max_threads
