# New-view regressions, independent of legacy-view compatibility.
# Possible CTE names stay unqualified; real tables must still use the stored namespace.

statement ok
create or replace database cte_view_a

statement ok
create or replace database cte_view_b

statement ok
create table cte_view_a.b(n int)

statement ok
insert into cte_view_a.b values (11)

# Different column names make a wrong database fail during binding, not just reading.
statement ok
create table cte_view_b.b(m int)

statement ok
insert into cte_view_b.b values (22)

statement ok
use cte_view_a

statement ok
set enable_auto_materialize_cte = 1

# a is materialized before the later CTE b is registered, so its b is a real table.
query II
with a as (select * from b), b as (select 99 as n) select x.n, y.n from a x, a y
----
11 11

statement ok
create view v_scalar as select n from b where n in (select n from b) and exists (with b as (select 99 as n) select * from b)

statement ok
use cte_view_b

# Combine target-DB creation, cross-DB reading, and restoration of the caller's DB.
statement ok
create view cte_view_a.v_forward as with a as (select * from b), b as (select 99 as n) select x.n as x, y.n as y from a x, a y

query III
select v.x, v.y, b.m from cte_view_a.v_forward v, b
----
11 11 22

# Scalar-subquery binders must inherit the view namespace too.
query I
select * from cte_view_a.v_scalar
----
11

# Direct schema readers need the stored namespace too. The caller's b has no n.
statement ok
create table copied like cte_view_a.v_forward

query TT
select `table`, name from system.columns where database in ('cte_view_a', 'cte_view_b') and `table` in ('copied', 'v_forward') order by `table`, name
----
copied x
copied y
v_forward x
v_forward y

# Lazy CTE definitions bind in the referencing scope, not their lexical AST scope.
statement ok
set enable_auto_materialize_cte = 0

statement ok
create table cte_view_a.z(n int)

statement ok
insert into cte_view_a.z values (33)

statement ok
use cte_view_a

query I
with a as (select * from z) select * from (with z as (select 77 as n) select * from a)
----
77

statement ok
create view v_nested as with a as (select * from z) select * from (with z as (select 77 as n) select * from a)

statement ok
use cte_view_b

query I
select * from cte_view_a.v_nested
----
77

# Qualification uses CREATE's case settings, not a default name-resolution context.
statement ok
use cte_view_a

statement ok
create table t(n int)

statement ok
insert into t values (17)

statement ok
set unquoted_ident_case_sensitive = 1

statement ok
create view v_case as with T as (select 99 as n) select * from t

statement ok
set unquoted_ident_case_sensitive = 0

query I
select * from v_case
----
17

statement ok
unset unquoted_ident_case_sensitive

# Dynamic definitions capture the source session's DB, not the target table's DB.
# The qualified z source also verifies strict lookup despite the same-named CTE b.
statement ok
set enable_auto_materialize_cte = 1

statement ok
use cte_view_b

statement ok
create dynamic table cte_view_a.dt as with a as (select * from b), b as (select 99 as m) select x.m as x, y.m as y, z.m as z from a x, a y, cte_view_b.b z

statement ok
use cte_view_a

statement ok
refresh dynamic table dt

query III
select * from dt
----
22 22 22

statement ok
unset enable_auto_materialize_cte

statement ok
use default

statement ok
drop database cte_view_b

statement ok
drop database cte_view_a
