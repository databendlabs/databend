# UNION ALL branches padded with constant columns (NULL and string literals)
# through hash shuffles and spills, which partition blocks by destination.

statement ok
SET force_aggregate_data_spill = 1;

query IIIIITT
WITH t AS (
    SELECT number % 7 AS k, number AS v, NULL::BIGINT AS pad_i, 'p' AS pad_s FROM numbers(100000)
    UNION ALL
    SELECT number % 7, 1, number::BIGINT, 'q' FROM numbers(10)
)
SELECT k, count(*), sum(v), count(pad_i), sum(pad_i), min(pad_s), max(pad_s)
FROM t
GROUP BY k
ORDER BY k;
----
0 14288 714264287 2 7 p q
1 14288 714278573 2 9 p q
2 14288 714292859 2 11 p q
3 14287 714307144 1 3 p q
4 14287 714321430 1 4 p q
5 14286 714235716 1 5 p q
6 14286 714250001 1 6 p q

statement ok
UNSET force_aggregate_data_spill;

statement ok
SET force_join_data_spill = 1;

query IIIITT
WITH a AS (
    SELECT number % 7 AS k, number AS v, NULL::BIGINT AS pad_i, 'p' AS pad_s FROM numbers(20000)
    UNION ALL
    SELECT number % 7, 1, number::BIGINT, 'q' FROM numbers(10)
), b AS (
    SELECT number % 7 AS k, NULL::BIGINT AS pad_i, 'r' AS pad_s FROM numbers(100)
    UNION ALL
    SELECT number % 7, number::BIGINT, 's' FROM numbers(3)
)
SELECT count(*), sum(a.v), count(b.pad_i), sum(b.pad_i), min(b.pad_s), max(a.pad_s)
FROM a JOIN b ON a.k = b.k;
----
294437 2942704436 8578 8577 r q

statement ok
UNSET force_join_data_spill;

query IIIII
WITH t AS (
    SELECT number % 7 AS k, number AS v, NULL::BIGINT AS pad_i, 'p' AS pad_s FROM numbers(100000)
    UNION ALL
    SELECT number % 7, 1, number::BIGINT, 'q' FROM numbers(10)
)
SELECT
    count(*),
    sum(s),
    sum(c),
    sum(CASE WHEN pad_i IS NULL THEN 1 ELSE 0 END),
    sum(CASE WHEN pad_s = 'p' THEN 1 ELSE 0 END)
FROM (
    SELECT
        pad_i,
        pad_s,
        SUM(v) OVER (PARTITION BY k) AS s,
        COUNT(pad_i) OVER (PARTITION BY k) AS c
    FROM t
);
----
100010 71435000142872 142874 100000 100000
