CREATE TABLE window_filter_build(id BIGINT)

statement ok
INSERT INTO window_filter_build VALUES (11)

query III
SETTINGS(disable_join_reorder=1, enable_experimental_new_join=0)
SELECT p.k, p.rn, p.s
FROM (
    SELECT a + 10 AS k,
           row_number() OVER (ORDER BY a DESC) AS rn,
           sum(a) OVER () AS s
    FROM window_filter_input
) p JOIN window_filter_build b ON p.k = b.id
----
11 3 6

query III
SETTINGS(disable_join_reorder=1, enable_experimental_new_join=1)
SELECT p.k, p.rn, p.s
FROM (
    SELECT a + 10 AS k,
           row_number() OVER (ORDER BY a DESC) AS rn,
           sum(a) OVER () AS s
    FROM window_filter_input
) p JOIN window_filter_build b ON p.k = b.id
----
11 3 6

