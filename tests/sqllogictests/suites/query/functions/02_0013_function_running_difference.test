drop table if exists running_difference_test

statement ok
create table running_difference_test (a Int8, b Int32, c Int64, d varchar, e Float32, f Float64) Engine = Fuse

statement ok
insert into running_difference_test values (1, 1, 1, 'a', 1, 1),(3, 3, 3, 'b', 3, 3),(5, 5, 5, 'c', 5, 5),(10, 10, 10, 'd', 10, 10)

query IIIRI
select running_difference(a), running_difference(b), running_difference(c), running_difference(e), running_difference(10) from running_difference_test
----
0 0 0 0.0 0
2 2 2 2.0 0
2 2 2 2.0 0
5 5 5 5.0 0

statement error 1006
select d, running_difference(d) from running_difference_test

# A filter on another column must not remove the preceding rows that
# running_difference reads, whether it is projected, filtered or joined on.
query II
select a, d from (select a, running_difference(a) as d from running_difference_test) s where a = 3
----
3 2

query I
select a from (select a from running_difference_test where running_difference(a) = 2) s where a = 5
----
5

query II
select t.a, u.a from running_difference_test t join running_difference_test u on running_difference(t.a) = u.a where t.a = 10
----
10 5

statement ok
DROP TABLE IF EXISTS running_difference_test

