statement ok
DROP TABLE IF EXISTS t1

statement ok
CREATE TABLE t1(s String NULL, pat String NULL, pos Int64 NULL, occu Int64 NULL, ro Int64 NULL, mt String NULL) Engine = Fuse

statement ok
-- INSERT INTO t1 (s, pat, pos, occu, ro, mt) VALUES (NULL, 'dog', 1, 1, 1, ''), ('dog cat dog', 'dog', NULL, 1, 1, 'c'), ('dog cat dog', 'dog', 1, 1, 1, 'c'), ('dog cat dog', 'dog', 1, 1, 1, NULL)
INSERT INTO t1 (s, pat, pos, occu, ro, mt) VALUES (NULL, 'dog', 1, 1, 1, ''), ('dog cat dog', 'dog', 1, 1, 1, 'c'), ('dog cat dog', 'dog', 1, 1, 1, NULL)

query T
SELECT s FROM t1 WHERE REGEXP_INSTR(s, pat, pos, occu, ro, mt) = 4
----
dog cat dog

statement ok
DROP TABLE t1

# Partial evaluation preserves row alignment and NULLs, and masks invalid
# patterns, match types and positions on inactive rows.
query I
SELECT IF(enabled, regexp_instr(source, pat, pos, 1, 0, mt), to_uint64(99))
FROM (VALUES
    (0, TRUE,  'dog cat', 'dog', 'c',       1),
    (1, FALSE, 'dog cat', '[',   'invalid', 0),
    (2, TRUE,  'cat',     'dog', 'c',       1),
    (3, TRUE,  NULL,      '[',   'invalid', 0),
    (4, TRUE,  'dog cat', NULL,  'invalid', 0)
) AS t(id, enabled, source, pat, mt, pos)
ORDER BY id
----
1
99
0
NULL
NULL

# Scalar calls still work when row zero is inactive.
query I
SELECT IF(number = 1, regexp_instr('dog', 'dog'), to_uint64(99))
FROM numbers(2)
ORDER BY number
----
99
1

# An invalid pattern on an active row must still report an error.
statement error 1006
SELECT IF(number = 1, regexp_instr(to_string(number), '['), to_uint64(0)) FROM numbers(2)
