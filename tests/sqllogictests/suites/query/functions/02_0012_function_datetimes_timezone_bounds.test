# Year 0 is representable, but its first days belong to ISO year -1.
query III
SELECT to_year(to_timestamp(-62167219200000000, 6)),
       to_yyyymmdd(to_timestamp(-62167219200000000, 6)),
       to_year(to_timestamp(253402387199999999, 6))
----
0 101 10000

