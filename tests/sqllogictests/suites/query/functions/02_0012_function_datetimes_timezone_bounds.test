# DATE and explicit input calendar years are not widened with the UTC range.
query BB
SELECT to_date(-719162) = DATE '0001-01-01', to_date(2932896) = DATE '9999-12-31'
----
1 1

# DATE keeps both its original endpoints and its numeric clamp-to-MIN policy.
query BBBBBB
SELECT DATE '0001-01-01' - 1 = DATE '0001-01-01',
       DATE '9999-12-31' + 1 = DATE '0001-01-01',
       add_months(DATE '9999-12-31', 1) = DATE '0001-01-01',
       add_years(DATE '0001-01-01', -1) = DATE '0001-01-01',
       try_to_date(-719163) = DATE '0001-01-01',
       try_to_date(2932897) = DATE '0001-01-01'
----
1 1 1 1 1 1

query BBBBBB
SELECT try_to_date('0000-12-31') IS NULL, try_to_date('+10000-01-01') IS NULL,
       try_to_timestamp('0000-12-31') IS NULL, try_to_timestamp('+10000-01-01') IS NULL,
       try_to_timestamp_tz('0000-12-31 00:00:00 +0000') IS NULL,
       try_to_timestamp_tz('+10000-01-01 00:00:00 +0000') IS NULL
