statement ok
SET timezone = 'UTC'

# Strict text parsing rejects actual UTC overflow, but not a local year 0/10000.
query BBBBBB
SELECT to_timestamp('0000-12-31')::BIGINT = -62135683200000000,
       to_timestamp('+10000-01-01 13:59:59.999999 +14:00')::BIGINT = 253402300799999999,
       try_to_timestamp('0000-12-30 23:59:59.999999Z') IS NULL,
       try_to_timestamp('+10000-01-01') IS NULL,
       try_to_timestamp_tz('0000-12-30 23:59:59.999999 +0000') IS NULL,
       try_to_timestamp_tz('+10000-01-01 00:00:00 +0000') IS NULL
----
1 1 1 1 1 1

statement error 1006
SELECT to_timestamp('0000-12-30 23:59:59.999999Z')

statement error 1006
SELECT to_timestamp('9999-12-31 23:59:59.999999 -00:01')

# Original clamp semantics apply to numeric conversion, TRY and legacy arithmetic.
statement ok
CREATE OR REPLACE TABLE timestamp_clamp_inputs(n BIGINT)

statement ok
INSERT INTO timestamp_clamp_inputs VALUES
    (-9223372036854775808), (-62135683200000001), (0),
    (253402300800000000), (9223372036854775807), (NULL)

query I
SELECT to_timestamp(n, 6)::BIGINT FROM timestamp_clamp_inputs ORDER BY n NULLS FIRST
----
NULL
-62135683200000000
-62135683200000000
0
-62135683200000000
-62135683200000000

query I
SELECT count_if(to_timestamp(n, 6) = try_to_timestamp(n, 6)) FROM timestamp_clamp_inputs
----
5

query BBBB
SELECT TIMESTAMP '1970-01-01' + 9223372036854775807 = TIMESTAMP '0000-12-31',
       TIMESTAMP '1970-01-01' - 9223372036854775807 = TIMESTAMP '0000-12-31',
       add_months(TIMESTAMP '9999-12-31', 1) = TIMESTAMP '0000-12-31',
       add_days(TIMESTAMP '0000-12-31', -1) = TIMESTAMP '0000-12-31'
----
1 1 1 1

query I
SELECT count(*) FROM timestamp_clamp_inputs WHERE to_timestamp(n, 6) > TIMESTAMP '1960-01-01'
----
1

statement ok
DROP TABLE timestamp_clamp_inputs

# INTERVAL overflow was already an error; do not change it to clamp.
statement error 1006
SELECT TIMESTAMP '0000-12-31' - INTERVAL 1 MICROSECOND

statement error 1006
SELECT TIMESTAMP '9999-12-31 23:59:59.999999' + INTERVAL 1 MICROSECOND

# DATE's calendar and numeric/arithmetic policies stay unchanged.
query BBBBBB
SELECT try_to_date('0000-12-31') IS NULL, try_to_date('+10000-01-01') IS NULL,
       DATE '0001-01-01' - 1 = DATE '0001-01-01',
       DATE '9999-12-31' + 1 = DATE '0001-01-01',
       add_months(DATE '9999-12-31', 1) = DATE '0001-01-01',
       try_to_date(-719163) = DATE '0001-01-01'
----
1 1 1 1 1 1

# Keep Random -> calendar clustering -> MERGE covered with the narrowed range.
statement ok
CREATE OR REPLACE TABLE timestamp_random_source(ts TIMESTAMP NOT NULL) ENGINE = Random seed = 42

statement ok
CREATE OR REPLACE TABLE timestamp_random_store AS SELECT ts FROM timestamp_random_source LIMIT 1024

query II
SELECT count(*), count_if(ts < TIMESTAMP '0000-12-31') FROM timestamp_random_store
----
1024 0

statement ok
CREATE OR REPLACE TABLE timestamp_random_target(ts TIMESTAMP NOT NULL) CLUSTER BY(to_yyyymmdd(ts))

statement ok
MERGE INTO timestamp_random_target t USING timestamp_random_store s ON 1=2 WHEN NOT MATCHED THEN INSERT *

statement ok
MERGE INTO timestamp_random_target t USING (SELECT DISTINCT ts FROM timestamp_random_store) s ON t.ts=s.ts
WHEN MATCHED THEN UPDATE * WHEN NOT MATCHED THEN INSERT *

query I
SELECT count(*) FROM timestamp_random_target
----
1024

statement ok
DROP TABLE timestamp_random_source

statement ok
DROP TABLE timestamp_random_store

statement ok
DROP TABLE timestamp_random_target
