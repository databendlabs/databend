----
0
1000000
-62167219200000000
NULL
253402387199999999
NULL
NULL
NULL
NULL

query II
SELECT try_to_timestamp(1, scale)::BIGINT, try_to_timestamp(n, 6)::BIGINT
FROM timestamp_conversion_bounds ORDER BY id
