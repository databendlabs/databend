query BBBB
SELECT try_to_timestamp(-62167219200000001, 6) IS NULL,
       try_to_timestamp(253402387200000000, 6) IS NULL,
       try_to_timestamp(9223372036854775807, 0) IS NULL,
       try_to_timestamp(0, 6) = TIMESTAMP '1970-01-01'
----
1 1 1 1

# Vary the precision column and include NULLs on both arguments. TRY must
# preserve valid rows and null only errors, including overflow during scaling.
statement ok
CREATE OR REPLACE TABLE timestamp_conversion_bounds(id INT, n BIGINT, scale BIGINT UNSIGNED)

statement ok
INSERT INTO timestamp_conversion_bounds VALUES
    (1, 0, 6), (2, 1, 0), (3, -62167219200000000, 6),
    (4, -62167219200000001, 6), (5, 253402387199999999, 6),
    (6, 253402387200000000, 6), (7, 9223372036854775807, 0),
    (8, NULL, 6), (9, 0, NULL)

query I
