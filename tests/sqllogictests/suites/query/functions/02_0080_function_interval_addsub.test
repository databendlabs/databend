# Test nullable date ± interval preserves nullability
skipif mysql
statement ok
CREATE OR REPLACE TABLE nullable_date_interval_test(d DATE NULL)

skipif mysql
statement ok
INSERT INTO nullable_date_interval_test VALUES ('2022-03-15'), (NULL), ('2022-06-20')

skipif mysql
query ?
SELECT d - INTERVAL '1 hour' FROM nullable_date_interval_test ORDER BY d NULLS LAST
----
2022-03-14 23:00:00.000000
2022-06-19 23:00:00.000000
NULL

skipif mysql
query ?
SELECT d + INTERVAL '30 minutes' FROM nullable_date_interval_test ORDER BY d NULLS LAST
----
2022-03-15 00:30:00.000000
2022-06-20 00:30:00.000000
NULL

skipif mysql
query ?
SELECT d - interval '2 days' FROM nullable_date_interval_test ORDER BY d NULLS LAST
----
2022-03-13 00:00:00.000000
2022-06-18 00:00:00.000000
NULL

skipif mysql
query ?
SELECT d + interval '2 days' FROM nullable_date_interval_test ORDER BY d NULLS LAST
----
2022-03-17 00:00:00.000000
2022-06-22 00:00:00.000000
NULL

skipif mysql
query ?
SELECT (interval '2 days') + d FROM nullable_date_interval_test ORDER BY d NULLS LAST
----
2022-03-17 00:00:00.000000
2022-06-22 00:00:00.000000
NULL

skipif mysql
statement ok
DROP TABLE nullable_date_interval_test

query T
SELECT typeof(DATE '2024-01-31' + to_interval('1 day'))
----
TIMESTAMP

query T
SELECT DATE '2024-01-31' + to_interval('1 month 1 day')
----
2024-03-01 00:00:00.000000

query T
SELECT TIMESTAMP '9999-12-31 23:59:59.999999' + to_interval('0 day')
----
9999-12-31 23:59:59.999999

query T
SELECT DATE '9999-12-31' + to_interval('0 day')
----
9999-12-31 00:00:00.000000

statement ok
SET timezone = 'America/New_York'

query T
