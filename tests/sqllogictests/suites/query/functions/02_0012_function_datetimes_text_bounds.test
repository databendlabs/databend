query BBB
settings(enable_auto_detect_datetime_format=1)
SELECT to_timestamp('31-DEC-0000 00:00:00')::BIGINT = -62135683200000000,
       to_timestamp(to_timestamp_tz('31-DEC-0000 00:00:00'))::BIGINT = -62135683200000000,
       try_to_timestamp('01-JAN-+10000 00:00:00') IS NULL
----
1 1 1

# Date text and numeric epoch clamping remain untouched.
query BBB
settings(enable_auto_detect_datetime_format=1)
SELECT try_to_date('31-DEC-0000') IS NULL,
       to_timestamp('9223372036854775807')::BIGINT = -62135683200000000,
       try_to_timestamp('9223372036854775807')::BIGINT = -62135683200000000
----
1 1 1

statement ok
SET timezone = 'Asia/Shanghai'

query BB
settings(enable_auto_detect_datetime_format=1)
SELECT to_timestamp('01-JAN-+10000 07:59:59.999999')::BIGINT = 253402300799999999,
       to_timestamp(to_timestamp_tz('01-JAN-+10000 07:59:59.999999'))::BIGINT = 253402300799999999
----
1 1

# No new second-bearing TIMESTAMP_TZ output format is introduced here.
query T
SELECT to_string(to_timestamp_tz('1800-01-01 00:00:00'))
----
1800-01-01 00:00:00.000000 +0806

statement ok
