# New calendar years are allowed only to preserve valid UTC boundary instants.
# They must not widen main's set of text inputs eligible for silent clamping.
# This suite intentionally does not change TIMESTAMP_TZ's minute-offset format.

statement ok
SET timezone = 'UTC'

statement ok
CREATE OR REPLACE TABLE timestamp_text_year_target(ts TIMESTAMP)

statement ok
CREATE OR REPLACE STAGE timestamp_text_year_stage

statement ok
