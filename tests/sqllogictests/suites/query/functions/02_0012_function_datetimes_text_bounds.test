# TRY must still null formerly rejected extended-year input, with and without AUTO.
statement ok
CREATE OR REPLACE TABLE timestamp_text_year_inputs(s STRING)

statement ok
INSERT INTO timestamp_text_year_inputs VALUES
    ('0000-01-01 00:00:00'), ('-0500-01-01 00:00:00'),
    ('+10000-06-01 00:00:00'), ('01-JAN-0000 00:00:00'),
    ('01-JAN--0500 00:00:00'), ('01-JUN-+10000 00:00:00'), (NULL)

query III
settings(enable_auto_detect_datetime_format=0)
SELECT count(*), count_if(try_to_timestamp(s) IS NULL), count_if(try_to_timestamp_tz(s) IS NULL)
FROM timestamp_text_year_inputs
----
7 7 7

query III
settings(enable_auto_detect_datetime_format=1)
SELECT count(*), count_if(try_to_timestamp(s) IS NULL), count_if(try_to_timestamp_tz(s) IS NULL)
FROM timestamp_text_year_inputs
----
7 7 7

# Strict conversions must not silently succeed, including column evaluation.
statement error
