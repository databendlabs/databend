query TTTIIII
SELECT to_string(bitmap_intersect(v)), to_string(bitmap_union(v)), to_string(bitmap_xor_agg(v)), bitmap_and_count(v), bitmap_or_count(v), bitmap_xor_count(v), bitmap_not_count(v)
FROM (
    SELECT bitmap_or_agg(to_bitmap(number + 1)) AS v FROM numbers(2)
    UNION ALL
    SELECT bitmap_or_agg(to_bitmap(number + 2)) AS v FROM numbers(2)
)
----
2 1,2,3 1,3 1 3 2 1

