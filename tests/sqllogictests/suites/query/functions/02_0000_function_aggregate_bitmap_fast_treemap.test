statement ok
DROP TABLE IF EXISTS agg_bitmap_fast_treemap_test

statement ok
CREATE TABLE agg_bitmap_fast_treemap_test(group_id Int, v Bitmap)

statement ok
INSERT INTO agg_bitmap_fast_treemap_test
SELECT group_id, bitmap_or_agg(to_bitmap(value))
FROM (
    SELECT 1 AS group_id, 1 AS bitmap_id, number AS value FROM numbers(33)
    UNION ALL
    SELECT 1, 1, number + 4294967296 FROM numbers(33)
    UNION ALL
    SELECT 1, 2, number + 16 FROM numbers(33)
    UNION ALL
    SELECT 1, 2, number + 4294967312 FROM numbers(33)
    UNION ALL
    SELECT 2, 1, number FROM numbers(33)
    UNION ALL
    SELECT 2, 2, number + 1 FROM numbers(33)
)
GROUP BY group_id, bitmap_id

