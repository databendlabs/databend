query TTT
WITH
    low_large AS (
        SELECT bitmap_or_agg(to_bitmap(number)) AS b FROM numbers(33)
    ),
    multi_large AS (
        SELECT bitmap_or_agg(to_bitmap(value)) AS b
        FROM (
            SELECT number AS value FROM numbers(33)
            UNION ALL
            SELECT number + 4294967296 AS value FROM numbers(33)
        )
    )
SELECT
    to_string(bitmap_and(multi_large.b, build_bitmap([]))),
    to_string(bitmap_and(multi_large.b, low_large.b)),
    to_string(bitmap_not(multi_large.b, build_bitmap([])))
FROM multi_large, low_large;
----
