query TTTT
SELECT
    to_string(bitmap_and(build_bitmap([]), build_bitmap([]))),
    to_string(bitmap_or(build_bitmap([]), build_bitmap([]))),
    to_string(bitmap_xor(build_bitmap([]), build_bitmap([]))),
    to_string(bitmap_not(build_bitmap([]), build_bitmap([])));
----
(empty) (empty) (empty) (empty)

query TTTTTTTT
SELECT
    to_string(bitmap_and(build_bitmap([]), build_bitmap([1,2]))),
    to_string(bitmap_or(build_bitmap([]), build_bitmap([1,2]))),
    to_string(bitmap_xor(build_bitmap([]), build_bitmap([1,2]))),
    to_string(bitmap_not(build_bitmap([]), build_bitmap([1,2]))),
    to_string(bitmap_and(build_bitmap([1,2]), build_bitmap([]))),
    to_string(bitmap_or(build_bitmap([1,2]), build_bitmap([]))),
    to_string(bitmap_xor(build_bitmap([1,2]), build_bitmap([]))),
    to_string(bitmap_not(build_bitmap([1,2]), build_bitmap([])));
