query TTTTTTTT
WITH
    low_large AS (
        SELECT bitmap_or_agg(to_bitmap(number)) AS b FROM numbers(33)
    )
SELECT
    to_string(bitmap_and(build_bitmap([1,2]), low_large.b)),
    to_string(bitmap_and(low_large.b, build_bitmap([1,2]))),
    to_string(bitmap_or(build_bitmap([1,2]), low_large.b)),
    to_string(bitmap_or(low_large.b, build_bitmap([1,2]))),
    to_string(bitmap_xor(build_bitmap([1,2]), low_large.b)),
    to_string(bitmap_xor(low_large.b, build_bitmap([1,2]))),
    to_string(bitmap_not(build_bitmap([1,2]), low_large.b)),
    to_string(bitmap_not(low_large.b, build_bitmap([1,2])))
FROM low_large;
