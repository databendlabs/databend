statement ok
drop table if exists t_charset

statement ok
create table t_charset(id int, s string, b binary)

# b holds the GBK encoding of s
statement ok
insert into t_charset values
(1, '你好', from_hex('C4E3BAC3')),
(2, '中文', from_hex('D6D0CEC4')),
(3, 'ascii', to_binary('ascii')),
(4, NULL, NULL)

# decode: GBK bytes -> string
query T
select to_string(b, 'gbk') from t_charset order by id
----
你好
中文
ascii
NULL

query T
select convert_from(b, 'GBK') from t_charset order by id
----
你好
中文
ascii
NULL

# GB2312 is an alias of GBK, GB18030 is a superset
query TT
select to_string(from_hex('C4E3BAC3'), 'gb2312'), to_string(from_hex('C4E3BAC3'), 'gb18030')
----
你好 你好

query TTT
select to_string(from_hex('A4A4'), 'big5'), to_string(from_hex('604F7D59'), 'utf-16le'), to_string(from_hex('E4BDA0'), 'utf-8')
----
中 你好 你

# GB18030 supports four-byte sequences for characters outside GBK.
query TT
select to_string(from_hex('9439FC36'), 'gb18030'), to_hex(to_binary('😀', 'gb18030'))
----
😀 9439fc36

# to_string(binary, format) is the inverse of to_binary(string, format)
query TT
select to_string(to_binary('abc'), 'hex'), to_string(to_binary('abc'), 'base64')
----
616263 YWJj

# decode from base64-wrapped GBK, the typical migration case
query T
select to_string(from_base64('xOO6ww=='), 'gbk')
----
你好

# encode: string -> GBK bytes
query T
select to_hex(to_binary(s, 'gbk')) from t_charset order by id
----
c4e3bac3
d6d0cec4
6173636969
NULL

query T
select to_hex(convert_to(s, 'gbk')) from t_charset order by id
----
c4e3bac3
d6d0cec4
6173636969
NULL

query B
select to_string(to_binary(s, 'gbk'), 'gbk') = s from t_charset where s is not null order by id
----
1
1
1

# invalid byte sequence
statement error 1006
select to_string(from_hex('C4'), 'gbk')

query T
select try_to_string(b, 'gbk') from (values (1, from_hex('C4E3')), (2, from_hex('C4')), (3, to_binary('ok'))) as t(id, b) order by id
----
你
NULL
ok

query T
select try_convert_from(from_hex('C4'), 'gbk')
----
NULL

# unmappable character
statement error 1006
select to_binary('😀', 'gbk')

query T
select to_hex(try_to_binary(s, 'gbk')) from (values (1, '你好'), (2, '😀'), (3, 'ok')) as t(id, s) order by id
----
c4e3bac3
NULL
6f6b

query T
select try_convert_to('😀', 'gbk')
----
NULL

# unknown charset
statement error 1006
select to_string(from_hex('C4E3'), 'not-a-charset')

statement error 1006
select to_binary('abc', 'not-a-charset')

query T
select try_to_string(from_hex('C4E3'), 'not-a-charset')
----
NULL

# encoding_rs cannot encode UTF-16
statement error 1006
select to_binary('abc', 'utf-16le')

# charset must be a constant
statement error 1006
select to_string(b, s) from t_charset

# Charset validation must survive a NULL first row and preserve the result shape.
statement ok
create table t_charset_null_first(s string, b binary)

statement ok
insert into t_charset_null_first values (NULL, NULL), ('abc', from_hex('616263')), (NULL, NULL)

statement error 1006
select to_binary(s, 'not-a-charset') from t_charset_null_first

statement error 1006
select convert_to(s, 'utf-16le') from t_charset_null_first

statement error 1006
select to_string(b, 'not-a-charset') from t_charset_null_first

statement error 1006
select convert_from(b, 'not-a-charset') from t_charset_null_first

query TTTT
select to_hex(try_to_binary(s, 'not-a-charset')), to_hex(try_convert_to(s, 'utf-16le')), try_to_string(b, 'not-a-charset'), try_convert_from(b, 'not-a-charset') from t_charset_null_first
----
NULL NULL NULL NULL
NULL NULL NULL NULL
NULL NULL NULL NULL

# Nonconstant charset errors must likewise not be masked by the first NULL.
statement error 1006
select to_string(from_hex('616263'), s) from t_charset_null_first

statement error 1006
select convert_from(from_hex('616263'), s) from t_charset_null_first

statement error 1006
select to_binary('abc', s) from t_charset_null_first

statement error 1006
select convert_to('abc', s) from t_charset_null_first

# TRY catches data conversion failures, not nonconstant-parameter misuse.
statement error 1006
select try_to_string(from_hex('616263'), s) from t_charset_null_first

statement error 1006
select try_convert_from(from_hex('616263'), s) from t_charset_null_first

statement error 1006
select try_to_binary('abc', s) from t_charset_null_first

statement error 1006
select try_convert_to('abc', s) from t_charset_null_first

# Non-NULL columns with valid charset labels are also rejected.
statement error 1006
select try_to_string(from_hex('C4E3'), charset) from (values ('gbk'), ('gb18030')) as t(charset)

statement error 1006
select try_convert_from(from_hex('C4E3'), charset) from (values ('gbk'), ('gb18030')) as t(charset)

statement error 1006
select try_to_binary('你好', charset) from (values ('gbk'), ('gb18030')) as t(charset)

statement error 1006
select try_convert_to('你好', charset) from (values ('gbk'), ('gb18030')) as t(charset)

# A NULL scalar format still propagates NULL.
query TTTT
select try_to_string(from_hex('616263'), NULL), try_convert_from(from_hex('616263'), NULL), to_hex(try_to_binary('abc', NULL)), to_hex(try_convert_to('abc', NULL))
----
NULL NULL NULL NULL

statement ok
drop table t_charset_null_first

statement ok
drop table t_charset
