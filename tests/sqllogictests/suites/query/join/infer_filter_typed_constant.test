# Typed-constant equality is already supported; this is a non-regression.
# The missing-index error branch is covered separately by an optimizer unit test.
statement ok
create or replace table infer_typed_l(a bigint not null);

statement ok
create or replace table infer_typed_r(a bigint not null);

statement ok
insert into infer_typed_l values (4), (5), (6);

statement ok
insert into infer_typed_r values (5), (5);

# The scalar subquery folds to a typed constant in the inferred predicate.
query II rowsort
select l.a, r.a from infer_typed_l l left join infer_typed_r r on l.a = r.a where l.a + (select 1) > 5;
----
5 5
5 5
6 NULL

# A non-subquery constant has identical results, including duplicate matches
# and the NULL-extended unmatched row.
query II rowsort
select l.a, r.a from infer_typed_l l left join infer_typed_r r on l.a = r.a where l.a + 1 > 5;
----
5 5
5 5
6 NULL

statement ok
drop table infer_typed_l;

statement ok
drop table infer_typed_r;
