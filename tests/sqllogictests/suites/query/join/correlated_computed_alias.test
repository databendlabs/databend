# Correlated aliases may resolve to computed outputs, not just identity columns.
# Preserve both the original computation and distinct outer-column bindings.
query I
SELECT count(*) FROM (VALUES (1,1),(2,1)) t1(a,b)
WHERE EXISTS (
    SELECT 1 FROM (
        SELECT t2.a + 1 AS a FROM (VALUES (1,1),(2,1)) t2(a,b)
        JOIN (VALUES (1)) t3(c) ON t2.a=t1.a
        WHERE t2.b=t1.b
    ) s WHERE s.a=t1.a
);
----
0

query I
SELECT count(*) FROM (VALUES (1,1),(2,1)) t1(a,b)
WHERE EXISTS (
    SELECT 1 FROM (
        SELECT t2.a + 1 AS a FROM (VALUES (1,1),(2,1)) t2(a,b)
        JOIN (VALUES (1)) t3(c) ON t2.a+1=t1.a
        WHERE t2.b=t1.b
    ) s WHERE s.a=t1.a
);
----
1

query I
SELECT count(*) FROM (VALUES (1,1),(2,1)) t1(a,b)
WHERE EXISTS (
    SELECT 1 FROM (
        SELECT cast(t2.a as bigint) + 1 AS a FROM (VALUES (1,1),(2,1)) t2(a,b)
        JOIN (VALUES (1)) t3(c) ON t2.a+1=t1.a
        WHERE t2.b=t1.b
    ) s WHERE s.a=t1.a
);
----
1

query I
SELECT count(*) FROM (VALUES (1,1),(2,1)) t1(a,b)
WHERE EXISTS (
    SELECT 1 FROM (
        SELECT case when t2.a=1 then 2 else 3 end AS a
        FROM (VALUES (1,1),(2,1)) t2(a,b)
        JOIN (VALUES (1)) t3(c) ON t2.a+1=t1.a
        WHERE t2.b=t1.b
    ) s WHERE s.a=t1.a
);
----
1

# Correlated LIMIT retains a computed alias; each matching group has one row.
query I
SELECT count(*) FROM (VALUES (1,1),(2,2)) t1(a,b)
WHERE EXISTS (
    SELECT 1 FROM (
        SELECT t2.a + 1 AS a FROM (VALUES (0,1),(1,2)) t2(a,b)
        WHERE t2.b=t1.b LIMIT 1
    ) s WHERE s.a=t1.a
);
----
2

# Non-equi ON correlation must not filter preserved rows of a LEFT JOIN.
query I
SELECT count(*) FROM (VALUES (1,1),(2,2)) t1(a,b)
WHERE NOT EXISTS (
    SELECT 1 FROM (
        SELECT t2.a FROM (VALUES (1,1),(2,2)) t2(a,b)
        LEFT JOIN (VALUES (1)) t3(c) ON t2.a=t1.a
        WHERE t2.b=t1.b
    ) s WHERE s.a=t1.a
);
----
0

# Duplicate outer rows are preserved; ordinary equality does not match NULLs.
query I
SELECT count(*) FROM (VALUES (2,1),(2,1),(NULL,1),(3,NULL)) t1(a,b)
WHERE EXISTS (
    SELECT 1 FROM (
        SELECT t2.a + 1 AS a FROM (VALUES (1,1),(2,NULL)) t2(a,b)
        JOIN (VALUES (1)) t3(c) ON t2.a+1=t1.a
        WHERE t2.b=t1.b
    ) s WHERE s.a=t1.a
);
----
2

# Two outer columns can resolve to a single inner column.
query I
SELECT count(*) FROM (VALUES (1,1),(2,1),(2,2)) t1(a,b)
WHERE EXISTS (
    SELECT 1 FROM (
        SELECT t2.a FROM (VALUES (1),(2)) t2(a)
        WHERE t2.a=t1.a AND t2.a=t1.b
    ) s WHERE s.a=t1.a
);
----
2

# An alias above a correlated LIMIT must not replace the outer column below it:
# the LIMIT is evaluated once per outer row, before the alias filter.
query I
SELECT count(*) FROM (VALUES (1,1),(2,1)) t1(a,b)
WHERE EXISTS (
    SELECT 1 FROM (
        SELECT t2.a AS a FROM (VALUES (1,1),(2,1)) t2(a,b)
        WHERE t2.b=t1.b ORDER BY t2.a DESC LIMIT 1
    ) s WHERE s.a=t1.a
);
----
1

query I
SELECT count(*) FROM (VALUES (1,1),(2,1)) t1(a,b)
WHERE EXISTS (
    SELECT 1 FROM (
        SELECT t2.a + 1 AS a FROM (VALUES (0,1),(1,1)) t2(a,b)
        WHERE t2.b=t1.b ORDER BY t2.a DESC LIMIT 1
    ) s WHERE s.a=t1.a
);
----
1

query I
SELECT count(*) FROM (VALUES (1,1),(2,1)) t1(a,b)
WHERE EXISTS (
    SELECT 1 FROM (
        SELECT x.a FROM (
            SELECT * FROM (VALUES (1,1),(2,1)) t2(a,b) WHERE t2.b=t1.b
        ) x JOIN (VALUES (1)) t3(c) ON true
        ORDER BY x.a DESC LIMIT 1
    ) s WHERE s.a=t1.a
);
----
1

# Aliases of aggregate and UNION ALL outputs are defined by that operator.
query I
SELECT count(*) FROM (VALUES (1,1),(2,1)) t1(a,b)
WHERE EXISTS (
    SELECT 1 FROM (
        SELECT max(t2.a) AS a FROM (VALUES (1,1),(2,1)) t2(a,b)
        WHERE t2.b=t1.b
    ) s WHERE s.a=t1.a
);
----
1

query I
SELECT count(*) FROM (VALUES (1,1),(2,1)) t1(a,b)
WHERE EXISTS (
    SELECT 1 FROM (
        SELECT t2.a AS a FROM (VALUES (1,1),(2,1)) t2(a,b) WHERE t2.b=t1.b
        UNION ALL
        SELECT t3.a FROM (VALUES (5,1)) t3(a,b) WHERE t3.b=t1.b
    ) s WHERE s.a=t1.a
);
----
2

# A join below the alias must materialize outer columns neither input references.
query I
SELECT count(*) FROM (VALUES (1,1),(2,1)) t1(a,b)
WHERE EXISTS (
    SELECT 1 FROM (
        SELECT x.a + 1 AS a FROM (
            SELECT * FROM (VALUES (1,1),(2,1)) t2(a,b) WHERE t2.b=t1.b
        ) x JOIN (VALUES (1)) t3(c) ON true
    ) s WHERE s.a=t1.a
);
----
1

query I rowsort
SELECT (
    SELECT max(t1.a + x.a) FROM (
        SELECT * FROM (VALUES (1,1),(2,1)) t2(a,b) WHERE t2.b=t1.b
    ) x JOIN (VALUES (1)) t3(c) ON true
) FROM (VALUES (1,1),(2,1)) t1(a,b);
----
3
4

# An aggregate without GROUP BY returns one row even for an empty input. The
# outer value (0,2) has no inner rows: max() is NULL there and the alias filter
# rejects it, but count() would be 0, which the decorrelated plan cannot keep.
query I
SELECT count(*) FROM (VALUES (0,2),(1,1)) t1(a,b)
WHERE EXISTS (
    SELECT 1 FROM (
        SELECT max(t2.a) AS a FROM (VALUES (1,1)) t2(a,b) WHERE t2.b=t1.b
    ) s WHERE s.a=t1.a
);
----
1

statement error 1002
