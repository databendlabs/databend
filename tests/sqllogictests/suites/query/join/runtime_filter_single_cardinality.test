# A scalar subquery must report a second match for every row that reaches the
# result. Rows removed by an outer predicate are not guaranteed to be checked:
# ordinary filter push-down and runtime filters may both remove them first.
# Keep the scalar result on the parent join's probe side. With reordering,
# this small fixture swaps the sides and no longer exercises the probe path.
statement ok
set disable_join_reorder = 1;

statement ok
drop table if exists rf_single_input;

statement ok
drop table if exists rf_single_values;

statement ok
drop table if exists rf_single_keep;

statement ok
drop table if exists rf_single_keep_dup;

statement ok
create table rf_single_input(k int);

statement ok
create table rf_single_values(k int, v int);

statement ok
create table rf_single_keep(k int);

statement ok
create table rf_single_keep_dup(k int);

# Separate blocks let a runtime filter remove one key without the others.
statement ok
insert into rf_single_input values (1);

statement ok
insert into rf_single_input values (2);

statement ok
insert into rf_single_input values (3);

# Keys 1 and 3 have two matches, key 2 has one.
statement ok
insert into rf_single_values values (1,10), (1,20), (2,30), (3,40), (3,50);

statement ok
insert into rf_single_keep values (0), (2);

statement ok
insert into rf_single_keep_dup values (3);

statement ok
set enable_join_runtime_filter = 0;

# An outer predicate removes key 1 before its scalar check even without a
# runtime filter, so the second match of key 1 is not reported.
query II
select q.k, q.v
from (
    select a.k, (select b.v from rf_single_values b where b.k = a.k) v
    from rf_single_input a
) q
join rf_single_keep c on q.k = c.k
where q.v is not null and c.k in (0, 2);
----
2 30

# IS NOT NULL rewrites the scalar join to Inner, but it still checks for
# multiple matches of the rows that it keeps.
query error 1001.*Scalar subquery can't return more than one row
select q.k, q.v
from (
    select a.k, (select b.v from rf_single_values b where b.k = a.k) v
    from rf_single_input a
) q
join rf_single_keep_dup c on q.k = c.k
where q.v is not null;

# A predicate on the scalar result must not remove the match 40 of key 3.
query error 1001.*Scalar subquery can't return more than one row
select q.k, q.v
from (
    select a.k, (select b.v from rf_single_values b where b.k = a.k) v
    from rf_single_input a
) q
join rf_single_keep_dup c on q.k = c.k
where q.v > 45;

statement ok
set enable_join_runtime_filter = 1;

query II
select q.k, q.v
from (
    select a.k, (select b.v from rf_single_values b where b.k = a.k) v
    from rf_single_input a
) q
join rf_single_keep c on q.k = c.k
where q.v is not null and c.k in (0, 2);
----
2 30

# The runtime filter keeps only key 3, which still has two matches.
query error 1001.*Scalar subquery can't return more than one row
select q.k, q.v
from (
    select a.k, (select b.v from rf_single_values b where b.k = a.k) v
    from rf_single_input a
) q
join rf_single_keep_dup c on q.k = c.k
where q.v is not null;

query error 1001.*Scalar subquery can't return more than one row
select q.k, q.v
from (
    select a.k, (select b.v from rf_single_values b where b.k = a.k) v
    from rf_single_input a
) q
join rf_single_keep_dup c on q.k = c.k
where q.v > 45;

statement ok
drop table rf_single_keep_dup;

statement ok
drop table rf_single_keep;

statement ok
drop table rf_single_values;

statement ok
drop table rf_single_input;

statement ok
unset enable_join_runtime_filter;

statement ok
unset disable_join_reorder;
