# run-with-settings: enable_experimental_new_join=0
# run-with-settings: max_threads=1, max_block_size=1
# run-with-settings: max_threads=2, max_block_size=2

# Correlated references in a subquery JOIN ON condition must be materialized
# before decorrelation.

statement ok
use default

query I rowsort
SELECT *
FROM (VALUES (1), (2)) t1(a)
WHERE EXISTS (
    SELECT 1
    FROM (VALUES (1), (2)) t2(a)
    JOIN (VALUES (1)) t3(c) ON t2.a = t1.a
)
----
1
2

query I rowsort
SELECT *
FROM (VALUES (1), (2)) t1(a)
WHERE EXISTS (
    SELECT 1
    FROM (VALUES (1), (2)) t2(a)
    JOIN (VALUES (1)) t3(c) ON t2.a > t1.a
)
----
1

query I rowsort
SELECT *
FROM (VALUES (1), (2)) t1(a)
WHERE EXISTS (
    SELECT 1
    FROM (VALUES (1), (2)) t2(a)
    LEFT JOIN (VALUES (1)) t3(c) ON t2.a = t1.a
)
----
1
2

query I rowsort
SELECT *
FROM (VALUES (1), (2)) t1(a)
WHERE t1.a IN (
    SELECT t2.a
    FROM (VALUES (1), (2)) t2(a)
    JOIN (VALUES (1)) t3(c) ON t2.a = t1.a
)
----
1
2

query I rowsort
SELECT (SELECT count(*)
        FROM (VALUES (1), (2)) t2(a)
        JOIN (VALUES (1)) t3(c) ON t2.a = t1.a)
FROM (VALUES (1), (2)) t1(a)
----
1
1

query I rowsort
SELECT *
FROM (VALUES (1), (2)) t1(a)
WHERE EXISTS (
    SELECT 1
    FROM (VALUES (1)) t2(a)
    JOIN (VALUES (1)) t3(c) ON t1.a = 1
)
----
1

query I rowsort
SELECT *
FROM (VALUES (1), (2)) t1(a)
WHERE EXISTS (
    SELECT t2.b
    FROM (VALUES (10), (20)) t2(b)
    GROUP BY t1.a, t2.b
)
----
1
2

query I rowsort
SELECT *
FROM (VALUES (1), (2)) t1(a)
WHERE EXISTS (
    SELECT DISTINCT t1.a
    FROM (VALUES (10), (20)) t2(b)
)
----
1
2

query I rowsort
SELECT (SELECT row_number() OVER (
            PARTITION BY t1.a ORDER BY t2.b
        )
        FROM (VALUES (10), (20)) t2(b)
        LIMIT 1)
FROM (VALUES (1), (2)) t1(a)
----
1
1

query I rowsort
SELECT (SELECT row_number() OVER (
            ORDER BY t1.a, t2.b
        )
        FROM (VALUES (10), (20)) t2(b)
        LIMIT 1)
FROM (VALUES (1), (2)) t1(a)
----
1
1

query I rowsort
SELECT (SELECT sum(t1.a + t2.b) OVER ()
        FROM (VALUES (10), (20)) t2(b)
        LIMIT 1)
FROM (VALUES (1), (2)) t1(a)
----
32
34

# Adding correlated partition keys must also rebuild an existing window sort.
# The original PARTITION BY does not separate different outer rows.
query II rowsort
SELECT t1.a,
       (SELECT sum(t1.a + t2.b) OVER (PARTITION BY t2.k)
        FROM (VALUES (1, 10), (1, 20)) t2(k, b)
        LIMIT 1)
FROM (VALUES (1), (2)) t1(a)
----
1 32
2 34

# An ORDER BY-only window originally had no partition exchange. Preserve DESC
# and NULLS LAST when adding the correlated partition keys.
query II rowsort
SELECT t1.a,
       (SELECT sum(t1.a + t2.b) OVER (
            ORDER BY t2.b DESC NULLS LAST
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        )
        FROM (VALUES (10), (20), (NULL)) t2(b)
        ORDER BY t2.b DESC NULLS LAST
        LIMIT 1 OFFSET 1)
FROM (VALUES (1), (2)) t1(a)
----
1 32
2 34

# Rebuild both the sort keys and partition exchange for a partitioned, ordered
# window; do not mix the same inner partition across outer rows.
query II rowsort
SELECT t1.a,
       (SELECT sum(t1.a + t2.b) OVER (
            PARTITION BY t2.k ORDER BY t2.b DESC NULLS LAST
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        )
        FROM (VALUES (1, 10), (1, 20), (2, 100), (2, 200)) t2(k, b)
        ORDER BY t2.k, t2.b DESC NULLS LAST
        LIMIT 1 OFFSET 1)
FROM (VALUES (1), (2), (1)) t1(a)
----
1 32
1 32
2 34

# Grouped windows already arrange their own input. Keep this path working when
# decorrelation adds partition keys to several windows at once.
query II rowsort
SELECT t1.a,
       (SELECT sum(t1.a + t2.b) OVER () + count(*) OVER ()
        FROM (VALUES (10), (20)) t2(b)
        LIMIT 1)
FROM (VALUES (1), (2)) t1(a)
----
1 34
2 36

# Empty window input must still leave the outer row with a NULL scalar result.
query II rowsort
SELECT t1.a,
       (SELECT sum(t1.a + t2.b) OVER ()
        FROM (VALUES (10), (20)) t2(b)
        WHERE t2.b < 0
        LIMIT 1)
FROM (VALUES (1), (2)) t1(a)
----
1 NULL
2 NULL
