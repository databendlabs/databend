# GitHub issue: https://github.com/databendlabs/databend/issues/21001
# Every scan in a query must read its own partitions. Before the fix, scans
# built with the same pipeline context (e.g. the branches of a UNION ALL)
# shared one partition queue, so a later scan replaced the partitions of an
# earlier file scan.

statement ok
DROP STAGE IF EXISTS issue_21001_s

statement ok
CREATE STAGE issue_21001_s

statement ok
COPY INTO @issue_21001_s/pa/ FROM (SELECT number::INT AS id FROM numbers(10)) FILE_FORMAT = (TYPE = PARQUET)

statement ok
COPY INTO @issue_21001_s/pb/ FROM (SELECT (number + 100)::INT AS id FROM numbers(20)) FILE_FORMAT = (TYPE = PARQUET)

statement ok
COPY INTO @issue_21001_s/pc/ FROM (SELECT (number + 200)::INT AS id FROM numbers(10)) FILE_FORMAT = (TYPE = PARQUET)

statement ok
COPY INTO @issue_21001_s/ca/ FROM (SELECT number::INT AS id FROM numbers(10)) FILE_FORMAT = (TYPE = CSV)

statement ok
COPY INTO @issue_21001_s/cb/ FROM (SELECT (number + 100)::INT AS id FROM numbers(20)) FILE_FORMAT = (TYPE = CSV)

statement ok
COPY INTO @issue_21001_s/ja/ FROM (SELECT number::INT AS id FROM numbers(10)) FILE_FORMAT = (TYPE = NDJSON)

statement ok
COPY INTO @issue_21001_s/jb/ FROM (SELECT (number + 100)::INT AS id FROM numbers(20)) FILE_FORMAT = (TYPE = NDJSON)

statement ok
CREATE OR REPLACE TABLE issue_21001_f (id INT)

statement ok
INSERT INTO issue_21001_f SELECT (number + 1000)::INT FROM numbers(30)

# Each source on its own.
query III
SELECT count(*), min(id), max(id) FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
----
10 0 9

query III
SELECT count(*), min(id), max(id) FROM @issue_21001_s/pb/ (FILE_FORMAT => 'parquet')
----
20 100 119

# parquet UNION ALL parquet, named columns.
query TIII
SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'a' AS src, id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT 'b' AS src, id FROM @issue_21001_s/pb/ (FILE_FORMAT => 'parquet')
) GROUP BY src ORDER BY src
----
a 10 0 9
b 20 100 119

# parquet UNION ALL parquet, reading the row as a variant.
query TIII
SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'a' AS src, $1:id::INT AS id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT 'b' AS src, $1:id::INT AS id FROM @issue_21001_s/pb/ (FILE_FORMAT => 'parquet')
) GROUP BY src ORDER BY src
----
a 10 0 9
b 20 100 119

# csv UNION ALL csv.
query TIII
SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'a' AS src, $1::INT AS id FROM @issue_21001_s/ca/ (FILE_FORMAT => 'csv')
    UNION ALL
    SELECT 'b' AS src, $1::INT AS id FROM @issue_21001_s/cb/ (FILE_FORMAT => 'csv')
) GROUP BY src ORDER BY src
----
a 10 0 9
b 20 100 119

# ndjson UNION ALL ndjson.
query TIII
SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'a' AS src, $1:id::INT AS id FROM @issue_21001_s/ja/ (FILE_FORMAT => 'ndjson')
    UNION ALL
    SELECT 'b' AS src, $1:id::INT AS id FROM @issue_21001_s/jb/ (FILE_FORMAT => 'ndjson')
) GROUP BY src ORDER BY src
----
a 10 0 9
b 20 100 119

# Three branches.
query TIII
SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'a' AS src, id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT 'b' AS src, id FROM @issue_21001_s/pb/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT 'c' AS src, id FROM @issue_21001_s/pc/ (FILE_FORMAT => 'parquet')
) GROUP BY src ORDER BY src
----
a 10 0 9
b 20 100 119
c 10 200 209

# Each branch aggregates its own scan.
query TIII
SELECT * FROM (
    SELECT 'a' AS src, count(*), min(id), max(id) FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT 'b' AS src, count(*), min(id), max(id) FROM @issue_21001_s/pb/ (FILE_FORMAT => 'parquet')
) ORDER BY src
----
a 10 0 9
b 20 100 119

# A single thread gives the same result.
query TIII
SETTINGS (max_threads = 1) SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'a' AS src, id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT 'b' AS src, id FROM @issue_21001_s/pb/ (FILE_FORMAT => 'parquet')
) GROUP BY src ORDER BY src
----
a 10 0 9
b 20 100 119

# UNION (distinct).
query III
SELECT count(*), min(id), max(id) FROM (
    SELECT id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION
    SELECT id FROM @issue_21001_s/pb/ (FILE_FORMAT => 'parquet')
)
----
30 0 119

# CTE referenced once, so it is inlined.
query TIII
WITH u AS (
    SELECT 'a' AS src, id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT 'b' AS src, id FROM @issue_21001_s/pb/ (FILE_FORMAT => 'parquet')
) SELECT src, count(*), min(id), max(id) FROM u GROUP BY src ORDER BY src
----
a 10 0 9
b 20 100 119

# UNION ALL on the build side of a join.
query III
SELECT count(*), min(u.id), max(u.id) FROM numbers(200) n JOIN (
    SELECT id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT id FROM @issue_21001_s/pb/ (FILE_FORMAT => 'parquet')
) u ON n.number = u.id
----
30 0 119

query III
SETTINGS (enable_experimental_new_join = 0) SELECT count(*), min(u.id), max(u.id) FROM numbers(200) n JOIN (
    SELECT id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT id FROM @issue_21001_s/pb/ (FILE_FORMAT => 'parquet')
) u ON n.number = u.id
----
30 0 119

# UNION ALL on the probe side of a join.
query III
SELECT count(*), min(u.id), max(u.id) FROM (
    SELECT id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT id FROM @issue_21001_s/pb/ (FILE_FORMAT => 'parquet')
) u JOIN numbers(200) n ON n.number = u.id
----
30 0 119

# A file scan followed by a fuse scan.
query TIII
SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'a' AS src, id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT 'f' AS src, id FROM issue_21001_f
) GROUP BY src ORDER BY src
----
a 10 0 9
f 30 1000 1029

query TIII
SETTINGS (enable_prune_pipeline = 0) SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'a' AS src, id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT 'f' AS src, id FROM issue_21001_f
) GROUP BY src ORDER BY src
----
a 10 0 9
f 30 1000 1029

query TIII
SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'c' AS src, $1::INT AS id FROM @issue_21001_s/ca/ (FILE_FORMAT => 'csv')
    UNION ALL
    SELECT 'f' AS src, id FROM issue_21001_f
) GROUP BY src ORDER BY src
----
c 10 0 9
f 30 1000 1029

# A fuse scan followed by a file scan.
query TIII
SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'f' AS src, id FROM issue_21001_f
    UNION ALL
    SELECT 'a' AS src, id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
) GROUP BY src ORDER BY src
----
a 10 0 9
f 30 1000 1029

query TIII
SETTINGS (enable_prune_pipeline = 0) SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'f' AS src, id FROM issue_21001_f
    UNION ALL
    SELECT 'a' AS src, id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
) GROUP BY src ORDER BY src
----
a 10 0 9
f 30 1000 1029

# Different file formats.
query TIII
SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'a' AS src, id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT 'b' AS src, $1::INT AS id FROM @issue_21001_s/cb/ (FILE_FORMAT => 'csv')
    UNION ALL
    SELECT 'j' AS src, $1:id::INT AS id FROM @issue_21001_s/jb/ (FILE_FORMAT => 'ndjson')
) GROUP BY src ORDER BY src
----
a 10 0 9
b 20 100 119
j 20 100 119

# A file scan followed by a table function and by a system table.
query TIII
SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'a' AS src, id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT 'n' AS src, number::INT AS id FROM numbers(5)
) GROUP BY src ORDER BY src
----
a 10 0 9
n 5 0 4

query TIII
SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'j' AS src, $1:id::INT AS id FROM @issue_21001_s/ja/ (FILE_FORMAT => 'ndjson')
    UNION ALL
    SELECT 'n' AS src, number::INT AS id FROM numbers(5)
) GROUP BY src ORDER BY src
----
j 10 0 9
n 5 0 4

query TIII
SELECT src, count(*), min(id), max(id) FROM (
    SELECT 'a' AS src, id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT 'o' AS src, dummy::INT AS id FROM system.one
) GROUP BY src ORDER BY src
----
a 10 0 9
o 1 1 1

# Write paths persist what the scans return.
statement ok
CREATE OR REPLACE TABLE issue_21001_t (src STRING, id INT)

statement ok
INSERT INTO issue_21001_t SELECT * FROM (
    SELECT 'a' AS src, id FROM @issue_21001_s/pa/ (FILE_FORMAT => 'parquet')
    UNION ALL
    SELECT 'b' AS src, id FROM @issue_21001_s/pb/ (FILE_FORMAT => 'parquet')
)

query TIII
SELECT src, count(*), min(id), max(id) FROM issue_21001_t GROUP BY src ORDER BY src
----
a 10 0 9
b 20 100 119

statement ok
CREATE OR REPLACE TABLE issue_21001_ctas AS SELECT * FROM (
    SELECT 'a' AS src, $1::INT AS id FROM @issue_21001_s/ca/ (FILE_FORMAT => 'csv')
    UNION ALL
    SELECT 'b' AS src, $1::INT AS id FROM @issue_21001_s/cb/ (FILE_FORMAT => 'csv')
)

query TIII
SELECT src, count(*), min(id), max(id) FROM issue_21001_ctas GROUP BY src ORDER BY src
----
a 10 0 9
b 20 100 119

statement ok
DROP TABLE issue_21001_ctas

statement ok
DROP TABLE issue_21001_t

statement ok
DROP TABLE issue_21001_f

statement ok
DROP STAGE issue_21001_s
