# Explicit offsets bypass session-local DST gap resolution in both parsers.
query II
SELECT to_timestamp('2024-03-10 02:30:00+0000')::BIGINT,
       to_timestamp('2024-03-10 2:30:00+0000')::BIGINT
----
1710037800000000	1710037800000000

