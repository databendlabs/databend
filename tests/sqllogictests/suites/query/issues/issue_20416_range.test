# Calendar text and explicit parts constructors retain years 0001..9999.
# Internal DATE/TIMESTAMP values have headroom through year 11000. Generate
# extended values with arithmetic, not five-digit calendar input.

statement ok
SET timezone = 'UTC'

query TTTTTT
SELECT DATE '9999-12-31' + INTERVAL 1 DAY,
       DATE '9999-12-31' + INTERVAL 24 HOUR,
       DATE '9999-12-31' + INTERVAL 1440 MINUTE,
       DATE '9999-12-31' + INTERVAL 86400 SECOND,
       DATE '9999-12-31' + INTERVAL 1 MONTH,
       DATE '9999-12-31' + INTERVAL 1 YEAR
----
+10000-01-01 00:00:00.000000	+10000-01-01 00:00:00.000000	+10000-01-01 00:00:00.000000	+10000-01-01 00:00:00.000000	+10000-01-31 00:00:00.000000	+10000-12-31 00:00:00.000000

# Explicit constructors and calendar parsers do not expose the internal range.
statement error
SELECT DATE '10000-01-01'

statement error
SELECT TIMESTAMP '10000-01-01'

statement error
SELECT to_date('+11000-12-31')

statement error
SELECT to_timestamp('+11000-12-31 23:59:59.999999')

statement error
SELECT to_timestamp_tz('+11000-12-31 23:59:59.999999 +0000')

statement error 1006
SELECT date_from_parts(10000, 1, 1)

statement error 1006
SELECT timestamp_from_parts(10000, 1, 1, 0, 0, 0)

statement error 1006
SELECT timestamp_tz_from_parts(10000, 1, 1, 0, 0, 0, 'UTC')

statement error 1006
SELECT date_from_parts(9999, 13, 1)

statement error 1006
SELECT timestamp_from_parts(9999, 12, 31, 24, 0, 0)

query BBBBB
SELECT try_to_date('+10000-01-01', '%Y-%m-%d') IS NULL,
       try_to_timestamp('+10000-01-01', '%Y-%m-%d') IS NULL,
       try_to_timestamp_tz('+10000-01-01 00:00:00') IS NULL,
       try_to_date('0000-12-31') IS NULL,
       try_to_timestamp('0000-12-31') IS NULL
----
1	1	1	1	1

statement ok
SET enable_auto_detect_datetime_format = 1

query BBB
SELECT try_to_date('01-JAN-+10000') IS NULL,
       try_to_timestamp('01-JAN-+10000 00:00:00') IS NULL,
       try_to_timestamp_tz('01-JAN-+10000 00:00:00') IS NULL
----
1	1	1

statement ok
UNSET enable_auto_detect_datetime_format

# Persist computed values at the internal upper bound; reading them does not
# parse calendar text again. The displayed text need not be accepted as input.
statement ok
CREATE OR REPLACE TABLE datetime_range_upper(d DATE, ts TIMESTAMP, z TIMESTAMP_TZ)

statement ok
INSERT INTO datetime_range_upper SELECT
    add_years(DATE '9999-12-31', 1001),
    add_years(TIMESTAMP '9999-12-31 23:59:59.999999', 1001),
    to_timestamp_tz('9999-12-31 23:59:59.999999 +0000') + INTERVAL 1001 YEAR

query TTTII
SELECT d, ts, z, to_year(d), to_iso_year(d) FROM datetime_range_upper
----
+11000-12-31	+11000-12-31 23:59:59.999999	+11000-12-31 23:59:59.999999 +0000	11000	11001

query BBB
SELECT try_to_date(to_string(d)) IS NULL,
       try_to_timestamp(to_string(ts)) IS NULL,
       try_to_timestamp_tz(to_string(z)) IS NULL
FROM datetime_range_upper
----
1	1	1

