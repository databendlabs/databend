# Fractional interval quantities round to a whole number of their unit, halves away
# from zero.
query TTTTTT
SELECT to_string('1.3 HOUR'::INTERVAL), to_string('1.5 HOUR'::INTERVAL),
       to_string('2.5 HOUR'::INTERVAL), to_string('0.3 HOUR'::INTERVAL),
       to_string('-1.3 HOUR'::INTERVAL), to_string('-2.5 HOUR'::INTERVAL)
----
1:00:00 2:00:00 3:00:00 00:00:00 -1:00:00 -3:00:00

query TTTTTT
SELECT to_string(to_interval('1.5 SECOND')), to_string(to_interval('1.5 MINUTE')),
       to_string(to_interval('1.5 DAY')), to_string(to_interval('1.5 WEEK')),
       to_string(to_interval('1.5 MONTH')), to_string(to_interval('1.5 YEAR'))
----
0:00:02 0:02:00 2 days 14 days 2 months 2 years

# Each quantity rounds separately, and the SQL INTERVAL syntax uses the same rule.
query TTTT
SELECT to_string(to_interval('1.3 HOUR 1.3 HOUR')), to_string(to_interval('1.5 HOUR ago')),
       to_string(INTERVAL '1.5' HOUR), to_string(INTERVAL 2.5 MINUTE)
----
2:00:00 -2:00:00 2:00:00 0:03:00

# Rounding is exact on the decimal digits.
query T
SELECT to_string(to_interval('1.49999999999999999999 HOUR'))
----
1:00:00

# Zero fractional parts, clock fractions, mixed units, and ISO parsing are unchanged.
query TTTT
SELECT to_string(to_interval('1.0000000 HOUR')),
       to_string(to_interval('00:00:01.5')),
       to_string(to_interval('1 second 500 milliseconds')),
       to_string(to_interval('PT1.5M'))
----
1:00:00 0:00:01.5 0:00:01.5 0:01:30

statement error Number too large
SELECT to_interval('9223372036854775807.5')

# Across DST, a rounded day count keeps the wall clock and rounded hours are elapsed
# time.
statement ok
SET timezone = 'America/Los_Angeles'

query TII
SELECT c, to_unix_timestamp(r), to_hour(r)
FROM (
    SELECT 'spring +1.5 day' AS c, '2024-03-09 12:00:00'::TIMESTAMP + '1.5 day'::INTERVAL AS r
    UNION ALL SELECT 'spring +1.3 day', '2024-03-09 12:00:00'::TIMESTAMP + '1.3 day'::INTERVAL
    UNION ALL SELECT 'spring +1.5 hour', '2024-03-10 01:30:00'::TIMESTAMP + '1.5 hour'::INTERVAL
    UNION ALL SELECT 'spring +24.4 hour', '2024-03-09 12:00:00'::TIMESTAMP + '24.4 hour'::INTERVAL
    UNION ALL SELECT 'spring -1.5 hour', '2024-03-10 03:30:00'::TIMESTAMP - '1.5 hour'::INTERVAL
    UNION ALL SELECT 'spring -1.5 day', '2024-03-11 12:00:00'::TIMESTAMP - '1.5 day'::INTERVAL
    UNION ALL SELECT 'fall +1.5 day', '2024-11-02 12:00:00'::TIMESTAMP + '1.5 day'::INTERVAL
    UNION ALL SELECT 'fall +1.5 hour', '2024-11-03 00:30:00'::TIMESTAMP + '1.5 hour'::INTERVAL
    UNION ALL SELECT 'fall +24.4 hour', '2024-11-02 12:00:00'::TIMESTAMP + '24.4 hour'::INTERVAL
    UNION ALL SELECT 'fall +0.5 month', '2024-10-03 12:00:00'::TIMESTAMP + '0.5 month'::INTERVAL
) ORDER BY c
----
fall +0.5 month 1730664000 12
fall +1.5 day 1730750400 12
fall +1.5 hour 1730626200 1
fall +24.4 hour 1730660400 11
spring +1.3 day 1710097200 12
spring +1.5 day 1710183600 12
spring +1.5 hour 1710070200 4
spring +24.4 hour 1710100800 13
spring -1.5 day 1710014400 12
spring -1.5 hour 1710059400 0

statement ok
UNSET timezone
