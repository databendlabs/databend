# Fractional interval quantities round to a whole number of their unit, halves away
# from zero.
query TTTTTT
SELECT to_string('1.3 HOUR'::INTERVAL), to_string('1.5 HOUR'::INTERVAL),
       to_string('2.5 HOUR'::INTERVAL), to_string('0.3 HOUR'::INTERVAL),
       to_string('-1.3 HOUR'::INTERVAL), to_string('-2.5 HOUR'::INTERVAL)
----
1:00:00 2:00:00 3:00:00 00:00:00 -1:00:00 -3:00:00

query TTTTTT
SELECT to_string(to_interval('1.5 SECOND')), to_string(to_interval('1.5 MINUTE')),
       to_string(to_interval('1.5 DAY')), to_string(to_interval('1.5 WEEK')),
       to_string(to_interval('1.5 MONTH')), to_string(to_interval('1.5 YEAR'))
----
0:00:02 0:02:00 2 days 14 days 2 months 2 years

# Each quantity rounds separately, and the SQL INTERVAL syntax uses the same rule.
query TTTT
SELECT to_string(to_interval('1.3 HOUR 1.3 HOUR')), to_string(to_interval('1.5 HOUR ago')),
       to_string(INTERVAL '1.5' HOUR), to_string(INTERVAL 2.5 MINUTE)
----
2:00:00 -2:00:00 2:00:00 0:03:00

# Rounding is exact on the decimal digits.
query T
SELECT to_string(to_interval('1.49999999999999999999 HOUR'))
----
1:00:00

# Zero fractional parts, clock fractions, mixed units, and ISO parsing are unchanged.
query TTTT
SELECT to_string(to_interval('1.0000000 HOUR')),
       to_string(to_interval('00:00:01.5')),
       to_string(to_interval('1 second 500 milliseconds')),
       to_string(to_interval('PT1.5M'))
----
1:00:00 0:00:01.5 0:00:01.5 0:01:30

statement error Number too large
SELECT to_interval('9223372036854775807.5')

# Across DST, rounded days and larger units keep the local wall clock, while rounded
# hours and minutes are elapsed time. The zones cover summer time and winter time in
# both hemispheres and a 30-minute shift. Some results land in a skipped or repeated
# local hour: a skipped time moves forward by the gap, the same as parsing that time;
# in a repeated hour, addition gives the first occurrence and subtraction the second.

statement ok
SET timezone = 'America/Los_Angeles'

query TIT
SELECT label, to_unix_timestamp(r), to_string(r)
FROM (
    SELECT label, if(op = '+', start::TIMESTAMP + to_interval(iv), start::TIMESTAMP - to_interval(iv)) AS r
    FROM (VALUES ('s01 +1.5 day', '2024-03-09 12:00:00', '+', '1.5 day'),
       ('s02 +0.6 day', '2024-03-09 12:00:00', '+', '0.6 day'),
       ('s03 +23.6 hour', '2024-03-09 12:00:00', '+', '23.6 hour'),
       ('s04 +1.4 day into gap', '2024-03-09 02:30:00', '+', '1.4 day'),
       ('s05 +1.5 hour', '2024-03-10 01:30:00', '+', '1.5 hour'),
       ('s06 +0.6 minute', '2024-03-10 01:59:30', '+', '0.6 minute'),
       ('s07 +89.6 minute', '2024-03-10 01:00:00', '+', '89.6 minute'),
       ('s08 -1.5 day', '2024-03-11 12:00:00', '-', '1.5 day'),
       ('s09 -0.6 day into gap', '2024-03-11 02:30:00', '-', '0.6 day'),
       ('s10 -1.5 hour', '2024-03-10 04:30:00', '-', '1.5 hour'),
       ('s11 +0.5 week', '2024-03-07 12:00:00', '+', '0.5 week'),
       ('s12 +0.5 month', '2024-02-19 12:00:00', '+', '0.5 month'),
       ('w01 +1.5 day', '2024-11-02 12:00:00', '+', '1.5 day'),
       ('w02 +24.4 hour', '2024-11-02 12:00:00', '+', '24.4 hour'),
       ('w03 +0.5 day into fold', '2024-11-02 01:30:00', '+', '0.5 day'),
       ('w04 +1.5 hour', '2024-11-03 00:30:00', '+', '1.5 hour'),
       ('w05 +2.5 hour', '2024-11-03 00:30:00', '+', '2.5 hour'),
       ('w06 +120.4 minute', '2024-11-03 00:00:00', '+', '120.4 minute'),
       ('w07 -1.5 day', '2024-11-04 12:00:00', '-', '1.5 day'),
       ('w08 -0.6 day into fold', '2024-11-04 01:30:00', '-', '0.6 day'),
       ('w09 -2.5 hour', '2024-11-03 04:30:00', '-', '2.5 hour'),
       ('w10 +0.5 week', '2024-10-31 12:00:00', '+', '0.5 week'),
       ('w11 +0.5 month', '2024-10-14 12:00:00', '+', '0.5 month')) AS t(label, start, op, iv)
) ORDER BY label
