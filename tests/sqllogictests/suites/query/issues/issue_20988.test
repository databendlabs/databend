# TIMESTAMP_TZ keeps its own UTC offset, so the session time zone and its DST
# changes do not apply to the arithmetic.
statement ok
SET timezone = 'America/Los_Angeles'

query TIT
SELECT label, to_unix_timestamp(r::TIMESTAMP), to_string(r)
FROM (
    SELECT label, if(op = '+', start::TIMESTAMP_TZ + to_interval(iv), start::TIMESTAMP_TZ - to_interval(iv)) AS r
    FROM (VALUES ('s01 +1.5 day', '2024-03-09 12:00:00 -08:00', '+', '1.5 day'),
       ('s02 +23.6 hour', '2024-03-09 12:00:00 -08:00', '+', '23.6 hour'),
       ('s03 -1.5 day', '2024-03-11 12:00:00 -07:00', '-', '1.5 day'),
       ('w01 +1.5 day', '2024-11-02 12:00:00 -07:00', '+', '1.5 day'),
       ('w02 +24.4 hour', '2024-11-02 12:00:00 -07:00', '+', '24.4 hour'),
       ('w03 +0.5 month', '2024-10-14 12:00:00 -07:00', '+', '0.5 month')) AS t(label, start, op, iv)
) ORDER BY label
