statement ok
INSERT INTO issue_20416_interval_cases VALUES
    (TIMESTAMP '2024-03-09 02:30:00', '1 day', false, 1710055800),
    (TIMESTAMP '2024-10-03 01:30:00', '1 month', false, 1730611800),
    (TIMESTAMP '2024-12-03 01:30:00', '1 month', true, 1730615400),
    (TIMESTAMP '2024-03-10 03:30:00', '1 hour', true, 1710052200),
    (TIMESTAMP '2024-03-10 01:30:00', '1 hour', false, 1710055800),
    (to_timestamp(1730611800), '1 hour', false, 1730615400),
    (to_timestamp(1730615400), '1 hour', true, 1730611800)

query I
SELECT count_if(to_unix_timestamp(if(is_subtract, ts - to_interval(delta), ts + to_interval(delta))) = expected)
FROM issue_20416_interval_cases
----
7

