statement ok
SET timezone = 'UTC'

query T
SELECT to_timestamp_tz('9999-12-31 23:59:59.999999 +0000')
----
9999-12-31 23:59:59.999999 +0000

query T
SELECT to_timestamp_tz(to_timestamp('9999-12-31 23:59:59.999999'))
----
9999-12-31 23:59:59.999999 +0000

query T
SELECT to_timestamp_tz(to_date('9999-12-31'))
----
9999-12-31 00:00:00.000000 +0000

query T
SELECT timestamp_tz_from_parts(9999, 12, 31, 23, 59, 59, 999999000, 'UTC')
----
9999-12-31 23:59:59.999999 +0000

query T
SELECT to_timestamp_tz('9999-12-31 23:59:59.999999 +0000') + to_interval('0 day')
----
9999-12-31 23:59:59.999999 +0000

query TTTTTTT
SELECT
    to_timestamp('2017', '%Y'),
    to_timestamp('03', '%m'),
    to_timestamp('04', '%d'),
    to_timestamp('05', '%H'),
    to_timestamp('06', '%M'),
    to_timestamp('07', '%S'),
    to_timestamp('12', '%I')
----
2017-01-01 00:00:00.000000	1970-03-01 00:00:00.000000	1970-01-04 00:00:00.000000	1970-01-01 05:00:00.000000	1970-01-01 00:06:00.000000	1970-01-01 00:00:07.000000	1970-01-01 12:00:00.000000

query TTTTTTTTT
SELECT
    to_timestamp('20', '%C'),
    to_timestamp('20-24', '%C-%y'),
    to_timestamp('69', '%y'),
    to_timestamp('68', '%y'),
    to_timestamp('69-01-1', '%g-%V-%u'),
    to_timestamp('PM', '%p'),
    to_timestamp('13AM', '%H%p'),
    to_timestamp('13PM', '%H%p'),
    to_timestamp('123456', '%f')
----
2000-01-01 00:00:00.000000	2024-01-01 00:00:00.000000	1969-01-01 00:00:00.000000	2068-01-01 00:00:00.000000	1968-12-30 00:00:00.000000	1970-01-01 12:00:00.000000	1970-01-01 01:00:00.000000	1970-01-01 13:00:00.000000	1970-01-01 00:00:00.123456

statement ok
SET parse_datetime_ignore_remainder = 0

query TTTBB
SELECT
    to_timestamp('68-01-1', '%g-%V-%u'),
    to_timestamp('1', '%f'),
    to_timestamp('123456789', '%f'),
    try_to_timestamp('1234567890', '%f') IS NULL,
    try_to_timestamp('', '%f') IS NULL
----
2068-01-02 00:00:00.000000	1970-01-01 00:00:00.100000	1970-01-01 00:00:00.123456	1	1

statement ok
UNSET parse_datetime_ignore_remainder

query T
