query BBBBB
SELECT
    try_to_timestamp('9999-12-31 23:59:59.999999 -00:01') IS NULL,
    try_to_timestamp('0001-01-01 00:00:00.000000 +00:01') IS NULL,
    try_to_timestamp('9999-12-31 23:59:59.999999 -0001', '%Y-%m-%d %H:%M:%S%.f %z') IS NULL,
    try_to_timestamp('0001-01-01 00:00:00.000000 +0001', '%Y-%m-%d %H:%M:%S%.f %z') IS NULL,
    try_to_timestamp('253402300800', '%s') IS NULL
----
1	1	1	1	1

query TT
SELECT typeof(DATE '9999-12-31' + to_interval('0 day')), DATE '9999-12-31' + to_interval('0 day')
----
TIMESTAMP	9999-12-31 00:00:00.000000

query T
SELECT TIMESTAMP '0001-01-01 00:00:00' - to_interval('1 minute')
----
0001-01-01 00:00:00.000000

query T
