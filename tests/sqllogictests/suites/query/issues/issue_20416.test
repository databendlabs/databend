    try_to_timestamp('2024-01-02 03:04:60', '%Y-%m-%d %H:%M:%S') IS NULL,
    try_to_timestamp('2024-01-02 03:04:61', '%Y-%m-%d %H:%M:%S') IS NULL
----
1	1

