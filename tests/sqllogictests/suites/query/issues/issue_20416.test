       try_to_timestamp_tz('2024-1-1 00:00:00 +1401') IS NULL,
       try_to_timestamp_tz('2024-1-1 00:00:00 +9900') IS NULL
----
1 1 1 1

statement ok
SET timezone = 'Asia/Shanghai'

query BBBB
SELECT to_timestamp('Mon, 01 Jan 2024 00:00:00 +1400')::BIGINT = 1704016800000000,
       to_timestamp('Mon, 01 Jan 2024 00:00:00 -1400')::BIGINT = 1704117600000000,
       to_timestamp('2024-01-01 00:00:00 +14:00', '%Y-%m-%d %H:%M:%S %z')::BIGINT = 1704016800000000,
       try_to_timestamp('Mon, 01 Jan 2024 00:00:00 +9900') IS NULL
----
1 1 1 1

query TT
SELECT to_string(to_timestamp_tz('Mon, 01 Jan 2024 00:00:00 +1400')),
       to_string(to_timestamp_tz('2024-1-1 00:00:00 -1400'))
----
2024-01-01 00:00:00.000000 +1400	2024-01-01 00:00:00.000000 -1400

# Valid offsets retain the legacy AUTO clamp at either UTC boundary.
query BBBB
SELECT to_timestamp('Mon, 01 Jan 0001 00:00:00 +1400')::BIGINT = -62135596800000000,
       to_timestamp('Fri, 31 Dec 9999 23:59:59 -1400')::BIGINT = -62135596800000000,
       try_to_timestamp('9223372036854775807')::BIGINT = -62135596800000000,
       to_timestamp(to_timestamp_tz('Mon, 01 Jan 0001 00:00:00 +1400'))::BIGINT = -62135596800000000
----
1 1 1 1

statement ok
