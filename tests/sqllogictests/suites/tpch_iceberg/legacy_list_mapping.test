# prepare_iceberg_decimal_data.py imports two ID-less legacy LIST encodings and
# renames old_items -> items and element.x -> element.y. The repeated group in
# each file is itself a struct element, not a three-level LIST wrapper.
# Fixtures: optional old_items (LIST) { repeated group array/old_items_tuple {
# optional int64 x; } }. Low-level writer definitions=[3,3,3,0],
# repetitions=[0,1,0,0], values=[10,20,30], k=[1,2,3].
statement ok
DROP CATALOG IF EXISTS ctl;

statement ok
CREATE CATALOG ctl TYPE=ICEBERG CONNECTION=(
    TYPE='rest'
    ADDRESS='http://127.0.0.1:8181'
    WAREHOUSE='s3://iceberg-tpch/'
    "s3.region"='us-east-1'
    "s3.endpoint"='http://127.0.0.1:9002'
);

query IT rowsort
SELECT k, items FROM ctl.test.t_legacy_list_array;
----
1 [(10),(20)]
2 [(30)]
3 NULL

query IT rowsort
SELECT k, items FROM ctl.test.t_legacy_list_tuple;
----
1 [(10),(20)]
2 [(30)]
3 NULL

query II rowsort
SELECT k, items[1]:y FROM ctl.test.t_legacy_list_tuple WHERE k < 3;
----
1 10
2 30

query II
SELECT k, items[1]:y FROM ctl.test.t_legacy_list_array WHERE k < 3 ORDER BY k DESC LIMIT 1;
----
2 30

# A top-level ':' is a literal name, not a nested Reference separator.
query I rowsort
SELECT "a:b" FROM ctl.test.t_colon_name WHERE "a:b" > 1;
----
2

query I
SELECT count(*) FROM ctl.test.t_colon_name WHERE "a:b" IS NULL;
----
1

query I rowsort
SELECT "a:b" FROM ctl.test.t_colon_name WHERE 1 < "a:b";
----
2

# The table property is malformed, but these files supply their field IDs.
query I rowsort
SELECT k FROM ctl.test.t_unused_name_mapping;
----
1
2
