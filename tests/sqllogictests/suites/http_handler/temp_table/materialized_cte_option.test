# `materialized_cte` is set by the planner on the temporary table a
# materialized CTE is spilled into. It is accepted on temporary tables of both
# engines and hidden from SHOW CREATE TABLE like other internal options.

statement ok
CREATE TEMP TABLE mcte_opt_mem (a INT) ENGINE = Memory materialized_cte = '1'

query TT
SHOW CREATE TABLE mcte_opt_mem
----
mcte_opt_mem CREATE TEMP TABLE mcte_opt_mem ( a INT NULL ) ENGINE=MEMORY

statement ok
CREATE TEMP TABLE mcte_opt_fuse (a INT) materialized_cte = '1'

query TT
SHOW CREATE TABLE mcte_opt_fuse
----
mcte_opt_fuse CREATE TEMP TABLE mcte_opt_fuse ( a INT NULL ) ENGINE=FUSE

statement ok
DROP TABLE mcte_opt_mem

statement ok
DROP TABLE mcte_opt_fuse
