# The second IN joins its consumer with a build side that reads the first
# consumer. The first IN's build keys contain its keys, so they cover both.
query T
explain with c as (select f1.k from cte_rf_fact f1 join cte_rf_fact f2 on f1.k = f2.k and f1.v <> f2.v where f1.v < 2)
select count(*) from cte_rf_dim3
where cte_rf_dim3.k in (select k from c)
  and cte_rf_dim3.k in (select cte_rf_dim1.k from cte_rf_dim1, c where cte_rf_dim1.k = c.k);
