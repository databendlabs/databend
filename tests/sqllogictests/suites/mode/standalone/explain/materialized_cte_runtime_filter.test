# A consumer without a covering join keeps every producer row.
query T
explain with c as (select k, sum(v) as s from cte_rf_fact group by k)
select 'a' as n, count(*) as total from c
union all
select 'b' as n, sum(s) as total from c join cte_rf_dim1 on c.k = cte_rf_dim1.k;
