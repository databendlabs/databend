SELECT
    lag(
        to_date(1643745600000000::TIMESTAMP),
        1,
        to_date(1643745600000000::TIMESTAMP)
    ) OVER (PARTITION BY k % 2 ORDER BY k) AS d,
    row_number() OVER (PARTITION BY k % 2 ORDER BY k) AS rn
FROM function_context_default_window
