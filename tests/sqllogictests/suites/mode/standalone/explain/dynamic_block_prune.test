statement ok
alter table t_dynamic_block_prune_explain set options(row_per_block = 2, block_per_segment = 10);

statement ok
insert into t_dynamic_block_prune_explain values (1), (2), (3), (4);

# A TopN on the probe side must retain the semi hash join. Applying the block
# filter before TopN would incorrectly turn this result from zero into one.
query I
select count(*) from (
    select _block_name from t_dynamic_block_prune_explain order by _block_name limit 1
) as limited where _block_name in (
    select block_location from fuse_block('default', 't_dynamic_block_prune_explain')
    order by block_location desc limit 1
);
----
0

statement ok
drop table t_dynamic_block_prune_explain;
