# TRY_CAST over a string column moves as a whole; both wide columns are pruned.
query T
explain select try_cast(s as int) as si, v:a:n as n, rn from (select v, s, row_number() over (partition by v:a:k order by id) as rn from win_narrow) where rn = 1
----
EvalScalar
├── output columns: [row_number() OVER (PARTITION BY v:a:k ORDER BY id) (#4), si (#5), n (#6)]
├── expressions: [CAST(win_narrow.s (#2) AS Int32 NULL) (#7), get_by_keypath(win_narrow.v (#1), '{"a","n"}') (#8)]
├── estimated rows: 1.00
└── Filter
    ├── output columns: [CAST(win_narrow.s (#2) AS Int32 NULL) (#7), get_by_keypath(win_narrow.v (#1), '{"a","n"}') (#8), row_number() OVER (PARTITION BY v:a:k ORDER BY id) (#4)]
    ├── filters: [row_number() OVER (PARTITION BY v:a:k ORDER BY id) (#4) = 1]
    ├── estimated rows: 1.00
    └── Window
        ├── output columns: [win_narrow.id (#0), row_number_part_0 (#3), CAST(win_narrow.s (#2) AS Int32 NULL) (#7), get_by_keypath(win_narrow.v (#1), '{"a","n"}') (#8), row_number() OVER (PARTITION BY v:a:k ORDER BY id) (#4)]
        ├── aggregate function: [row_number]
        ├── partition by: [row_number_part_0]
        ├── order by: [id]
        ├── frame: [Range: Preceding(None) ~ CurrentRow]
        └── WindowPartition
            ├── output columns: [win_narrow.id (#0), row_number_part_0 (#3), CAST(win_narrow.s (#2) AS Int32 NULL) (#7), get_by_keypath(win_narrow.v (#1), '{"a","n"}') (#8)]
            ├── hash keys: [row_number_part_0]
            ├── top: 1
            ├── estimated rows: 4.00
            └── EvalScalar
                ├── output columns: [win_narrow.id (#0), row_number_part_0 (#3), CAST(win_narrow.s (#2) AS Int32 NULL) (#7), get_by_keypath(win_narrow.v (#1), '{"a","n"}') (#8)]
                ├── expressions: [get_by_keypath(win_narrow.v (#1), '{"a","k"}'), TRY_CAST(win_narrow.s (#2) AS Int32 NULL), get_by_keypath(win_narrow.v (#1), '{"a","n"}')]
                ├── estimated rows: 4.00
                └── TableScan
                    ├── table: default.default.win_narrow
                    ├── scan id: 0
                    ├── output columns: [id (#0), v (#1), s (#2)]
                    ├── read rows: 4
                    ├── read size: < 1 KiB
                    ├── partitions total: 1
                    ├── partitions scanned: 1
                    ├── pruning stats: [segments: <read cost: <slt:ignore>, decompress cost: <slt:ignore>, range pruning: 1 to 1 cost: <slt:ignore>>, blocks: <range pruning: 1 to 1 cost: <slt:ignore>>]
                    ├── push downs: [filters: [], limit: NONE]
                    └── estimated rows: 4.00

# WindowGroup: the extraction joins the group's scalar inputs.
query T
explain select v:a:x::float as x, rn, cnt from (select v, row_number() over (partition by v:a:k order by v:t desc) as rn, count(*) over (partition by v:a:k) as cnt from win_narrow) where rn = 1
----
EvalScalar
├── output columns: [row_number() OVER (PARTITION BY v:a:k ORDER BY v:t DESC) (#5), COUNT(*) OVER (PARTITION BY v:a:k) (#7), x (#8)]
├── expressions: [CAST(get_by_keypath(win_narrow.v (#1), '{"a","x"}') (#9) AS Float32 NULL)]
├── estimated rows: 1.00
└── Filter
    ├── output columns: [get_by_keypath(win_narrow.v (#1), '{"a","x"}') (#9), row_number() OVER (PARTITION BY v:a:k ORDER BY v:t DESC) (#5), COUNT(*) OVER (PARTITION BY v:a:k) (#7)]
    ├── filters: [row_number() OVER (PARTITION BY v:a:k ORDER BY v:t DESC) (#5) = 1]
    ├── estimated rows: 1.00
    └── WindowGroup
        ├── output columns: [row_number_part_0 (#3), row_number_order_0 (#4), get_by_keypath(win_narrow.v (#1), '{"a","x"}') (#9), row_number() OVER (PARTITION BY v:a:k ORDER BY v:t DESC) (#5), COUNT(*) OVER (PARTITION BY v:a:k) (#7)]
        ├── Window
        │   ├── output column: [5]
        │   ├── aggregate function: [row_number]
        │   ├── partition by: [row_number_part_0]
        │   ├── order by: [row_number_order_0]
        │   └── frame: [Range: Preceding(None) ~ CurrentRow]
        ├── Window
        │   ├── output column: [7]
        │   ├── aggregate function: [count()]
        │   ├── partition by: [row_number_part_0]
        │   ├── order by: []
        │   └── frame: [Range: Preceding(None) ~ Following(None)]
        └── WindowPartition
            ├── output columns: [row_number_part_0 (#3), row_number_order_0 (#4), get_by_keypath(win_narrow.v (#1), '{"a","x"}') (#9)]
            ├── hash keys: [row_number_part_0]
            ├── estimated rows: 4.00
            └── EvalScalar
                ├── output columns: [row_number_part_0 (#3), row_number_order_0 (#4), get_by_keypath(win_narrow.v (#1), '{"a","x"}') (#9)]
                ├── expressions: [get_by_keypath(win_narrow.v (#1), '{"a","k"}'), get_by_keypath(win_narrow.v (#1), '{"t"}'), get_by_keypath(win_narrow.v (#1), '{"a","x"}')]
                ├── estimated rows: 4.00
                └── TableScan
                    ├── table: default.default.win_narrow
                    ├── scan id: 0
                    ├── output columns: [v (#1)]
                    ├── read rows: 4
                    ├── read size: < 1 KiB
                    ├── partitions total: 1
                    ├── partitions scanned: 1
                    ├── pruning stats: [segments: <read cost: <slt:ignore>, decompress cost: <slt:ignore>, range pruning: 1 to 1 cost: <slt:ignore>>, blocks: <range pruning: 1 to 1 cost: <slt:ignore>>]
                    ├── push downs: [filters: [], limit: NONE]
                    └── estimated rows: 4.00

# Extractions inside the filter above the window move too.
query T
explain select v:a:x::float as x from (select v, row_number() over (partition by v:a:k order by v:t desc) as rn from win_narrow) where rn = 1 and v:a:n::string <> 'zz'
----
EvalScalar
├── output columns: [x (#6)]
├── expressions: [CAST(get_by_keypath(win_narrow.v (#1), '{"a","x"}') (#9) AS Float32 NULL)]
├── estimated rows: 1.00
└── Filter
    ├── output columns: [get_by_keypath(win_narrow.v (#1), '{"a","x"}') (#9)]
    ├── filters: [row_number() OVER (PARTITION BY v:a:k ORDER BY v:t DESC) (#5) = 1, is_true(CAST(get_by_keypath(win_narrow.v (#1), '{"a","n"}') (#10) AS String NULL) <> 'zz')]
    ├── estimated rows: 1.00
    └── Window
        ├── output columns: [row_number_part_0 (#3), row_number_order_0 (#4), get_by_keypath(win_narrow.v (#1), '{"a","x"}') (#9), get_by_keypath(win_narrow.v (#1), '{"a","n"}') (#10), row_number() OVER (PARTITION BY v:a:k ORDER BY v:t DESC) (#5)]
        ├── aggregate function: [row_number]
        ├── partition by: [row_number_part_0]
        ├── order by: [row_number_order_0]
        ├── frame: [Range: Preceding(None) ~ CurrentRow]
        └── WindowPartition
            ├── output columns: [row_number_part_0 (#3), row_number_order_0 (#4), get_by_keypath(win_narrow.v (#1), '{"a","x"}') (#9), get_by_keypath(win_narrow.v (#1), '{"a","n"}') (#10)]
            ├── hash keys: [row_number_part_0]
