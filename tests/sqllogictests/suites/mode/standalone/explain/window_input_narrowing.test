query RTI
select v:a:x::float as x, v:a:n::string as n, rn from (select v, row_number() over (partition by v:a:k order by v:t desc) as rn from win_narrow) where rn = 1 order by x
----
2.5 q 1
3.5 r 1

query IIT
select try_cast(s as int) as si, id, v:a:n::string as n from (select v, s, id, row_number() over (partition by v:a:k order by id) as rn from win_narrow) where rn = 1 order by id
----
NULL 1 p
NULL 3 r

query RII
select v:a:x::float as x, rn, cnt from (select v, row_number() over (partition by v:a:k order by v:t desc) as rn, count(*) over (partition by v:a:k) as cnt from win_narrow) where rn = 1 order by x
----
2.5 1 2
3.5 1 2

# A virtual column takes precedence: the scan already produces the narrow
# value, so there is nothing left to move below the window.
statement ok
create or replace table win_narrow_vc (id int, v variant) enable_virtual_column = true

statement ok
insert into win_narrow_vc select id, v from win_narrow

query T
explain select v:a:x::float as x, rn from (select v, row_number() over (partition by v:a:k order by v:t desc) as rn from win_narrow_vc) where rn = 1
