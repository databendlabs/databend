# Narrowing extractions over wide columns move below the window so the
# partition shuffle and spill no longer carry the whole value.

statement ok
drop table if exists win_narrow

statement ok
create table win_narrow (id int, v variant, s string)

statement ok
insert into win_narrow values
 (1, '{"a":{"k":1,"x":1.5,"n":"p"},"t":"2020-01-01"}', 'abc'),
 (2, '{"a":{"k":1,"x":2.5,"n":"q"},"t":"2020-01-02"}', '12'),
 (3, '{"a":{"k":2,"x":3.5,"n":"r"},"t":"2020-01-03"}', 'xyz'),
 (4, '{"a":{"k":2,"x":null,"n":"s"},"t":"2020-01-01"}', null)

# The fallible CAST stays above the filter; only the infallible path access
# moves below the window and the VARIANT column is pruned from WindowPartition.
query T
explain select v:a:x::float as x, rn from (select v, row_number() over (partition by v:a:k order by v:t desc) as rn from win_narrow) where rn = 1
----
EvalScalar
├── output columns: [row_number() OVER (PARTITION BY v:a:k ORDER BY v:t DESC) (#5), x (#6)]
├── expressions: [CAST(get_by_keypath(win_narrow.v (#1), '{"a","x"}') (#7) AS Float32 NULL)]
├── estimated rows: 1.00
└── Filter
    ├── output columns: [get_by_keypath(win_narrow.v (#1), '{"a","x"}') (#7), row_number() OVER (PARTITION BY v:a:k ORDER BY v:t DESC) (#5)]
    ├── filters: [row_number() OVER (PARTITION BY v:a:k ORDER BY v:t DESC) (#5) = 1]
    ├── estimated rows: 1.00
    └── Window
        ├── output columns: [row_number_part_0 (#3), row_number_order_0 (#4), get_by_keypath(win_narrow.v (#1), '{"a","x"}') (#7), row_number() OVER (PARTITION BY v:a:k ORDER BY v:t DESC) (#5)]
        ├── aggregate function: [row_number]
        ├── partition by: [row_number_part_0]
        ├── order by: [row_number_order_0]
        ├── frame: [Range: Preceding(None) ~ CurrentRow]
        └── WindowPartition
            ├── output columns: [row_number_part_0 (#3), row_number_order_0 (#4), get_by_keypath(win_narrow.v (#1), '{"a","x"}') (#7)]
            ├── hash keys: [row_number_part_0]
            ├── top: 1
            ├── estimated rows: 4.00
            └── EvalScalar
                ├── output columns: [row_number_part_0 (#3), row_number_order_0 (#4), get_by_keypath(win_narrow.v (#1), '{"a","x"}') (#7)]
                ├── expressions: [get_by_keypath(win_narrow.v (#1), '{"a","k"}'), get_by_keypath(win_narrow.v (#1), '{"t"}'), get_by_keypath(win_narrow.v (#1), '{"a","x"}')]
                ├── estimated rows: 4.00
                └── TableScan
                    ├── table: default.default.win_narrow
                    ├── scan id: 0
                    ├── output columns: [v (#1)]
                    ├── read rows: 4
                    ├── read size: < 1 KiB
                    ├── partitions total: 1
                    ├── partitions scanned: 1
                    ├── pruning stats: [segments: <read cost: <slt:ignore>, decompress cost: <slt:ignore>, range pruning: 1 to 1 cost: <slt:ignore>>, blocks: <range pruning: 1 to 1 cost: <slt:ignore>>]
                    ├── push downs: [filters: [], limit: NONE]
                    └── estimated rows: 4.00

