statement ok
CREATE OR REPLACE DATABASE current_time_selectivity

statement ok
USE current_time_selectivity

statement ok
CREATE TABLE fact_events AS
SELECT number % 1000 + 1 AS customer_id,
       add_seconds(to_timestamp('2024-01-01 00:00:00'), number) AS event_time
FROM numbers(10000)

statement ok
CREATE TABLE customers AS
SELECT number + 1 AS customer_id,
       number % 100 + 1 AS segment_id
FROM numbers(1000)

statement ok
CREATE TABLE segments AS
SELECT number + 1 AS segment_id
FROM numbers(100)

# CTAS records row counts and min/max statistics, so this case does not need ANALYZE TABLE.
# All events are historical. The recent-time filter should make fact_events the first join input.
query T
EXPLAIN optimized
SELECT count()
FROM fact_events AS e
JOIN customers AS c ON e.customer_id = c.customer_id
JOIN segments AS s ON c.segment_id = s.segment_id
WHERE e.event_time >= subtract_hours(now(), 24)
