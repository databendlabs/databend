settings (ddl_column_type_nullable=0) CREATE OR REPLACE TABLE t1 AS
SELECT
    number % 5 AS c39,
    number % 2 = 0 AS c13,
    if(number % 40 = 0, NULL, number % 40) AS c40,
    number AS c45
FROM numbers(1000)

statement ok
ANALYZE TABLE t1

query T
EXPLAIN SELECT c39, c13, c40, c45
FROM t1
WHERE c39 != 0
  AND c13 = FALSE
  AND (c40 = 1 OR c40 IS NULL OR c40 = 2);
