# Partial states are routed by the global hash shuffle. Every group must be
# merged on exactly one node, in both shuffle modes, with or without spilling.
statement ok
set max_threads = 8;

statement ok
set force_aggregate_shuffle_mode = 'row';

query III
SELECT count(), sum(c), sum(s) FROM (SELECT number % 1000 AS a, number % 7 AS b, count() AS c, sum(number) AS s FROM numbers_mt(100000) GROUP BY a, b);
----
7000 100000 4999950000

query III
SELECT count(), sum(c), sum(if(k IS NULL, s, 0)) FROM (SELECT if(number % 3 = 0, NULL, number % 100) AS k, count() AS c, sum(number) AS s FROM numbers_mt(100000) GROUP BY k);
----
101 100000 1666683333

query II
SELECT count(), sum(c) FROM (SELECT (number % 5000)::string AS k, count(DISTINCT number % 3) AS c FROM numbers_mt(100000) GROUP BY k);
----
5000 15000

query II
SELECT count(), sum(c) FROM (SELECT number % 10 AS a, number % 3 AS b, count() AS c FROM numbers_mt(1000) GROUP BY GROUPING SETS ((a), (b), ()));
----
14 3000

query I
SELECT count() FROM (SELECT number FROM numbers_mt(1000) WHERE number < 0 GROUP BY number);
----
0

query TIII rowsort
SELECT to_string(number % 2) AS s, number % 3 AS n, count(), sum(number) FROM numbers_mt(12) GROUP BY s, n;
----
0 0 2 6
0 1 2 14
0 2 2 10
1 0 2 12
1 1 2 8
1 2 2 16

