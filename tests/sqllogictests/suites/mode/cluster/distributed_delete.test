statement ok
drop table if exists t;

statement ok
drop table if exists t_origin;

# make sure there will be multiple blocks there, by shrink the `row_per_block`
statement ok
create or replace table t (id int not null, c1 int not null, c2 int not null) row_per_block=10;

# generate test data
statement ok
insert into t select number, number * 10, number * 5 from numbers(500) where number ;

statement ok
insert into t select number, number * 10, number * 5 from numbers(1000) where number > 499;

statement ok
insert into t select number, number * 10, number * 5 from numbers(1500) where number > 999;

# "backup" t
statement ok
create or replace table t_origin as select * from t;

# do the deletion (in distributed settings)
# two segments are totally rewritten, one segment is reserved
statement ok
delete from t where id % 3 = 0 and id > 500;

# check the sum of columns
query B
select (select sum(id) from t_origin where id % 3 != 0 or id <= 500) = (select sum(id) from t);
----
1

query B
select (select sum(c1) from t_origin where id % 3 != 0 or id <= 500) = (select sum(c1) from t);
----
1

query B
select (select sum(c2) from t_origin where id % 3 != 0 or id <= 500) = (select sum(c2) from t);
----
1

# backup t again
statement ok
create or replace table t_after_delete as select * from t;

# one segment is totally deleted, two segments are reserved
statement ok
delete from t where id <= 499;

# check the sum of columns
query B
select (select sum(id) from t_after_delete where id > 499) = (select sum(id) from t);
----
1

query B
select (select sum(c1) from t_after_delete where id > 499) = (select sum(c1) from t);
----
1

query B
select (select sum(c2) from t_after_delete where id > 499) = (select sum(c2) from t);
----
1

# backup t again
statement ok
create or replace table t_after_delete_2 as select * from t;

# some block is totally deleted, some block is reserved, some block is partially reserved
statement ok
delete from t where id > 600 and id < 700;

# check the sum of columns
query B
select (select sum(id) from t_after_delete_2 where id <= 600 or id >= 700) = (select sum(id) from t);
----
1

query B
select (select sum(c1) from t_after_delete_2 where id <= 600 or id >= 700) = (select sum(c1) from t);
----
1

query B
select (select sum(c2) from t_after_delete_2 where id <= 600 or id >= 700) = (select sum(c2) from t);
----
1

# for issue #11784 https://github.com/datafuselabs/databend/issues/11784

statement ok
drop table if exists t;

statement ok
drop table if exists del_id;

statement ok
create or replace table t (id int not null, c1 int not null, c2 int not null) row_per_block=3;

statement ok
insert into t select number, number * 5, number * 7 from numbers(50);

statement ok
create or replace table del_id (id int not null) as select cast(FLOOR(0 + RAND(number) * 50), int) from numbers(10);

statement ok
delete from t where id in (select id from del_id);

statement ok
create view v_after_deletion as select number as id, number * 5 as c1, number * 7 as c2 from numbers(50) where id not in (select * from del_id);

query 
select * from v_after_deletion order by id except select * from t order by id;
----

query 
select * from t order by id except select * from v_after_deletion order by id;
----

query B
select (select count() from v_after_deletion) = (select count() from t);
----
1

statement ok
drop table t;

statement ok
drop view v_after_deletion;

statement ok
drop table if exists del_id;

# The segments of a lazy distributed deletion are pruned by a pruning pipeline at runtime,
# which streams the deletion tasks to the mutation sources of each node.
statement ok
create or replace table t_lazy (id int not null, c1 int not null) row_per_block=10;

# 12 segments, more than the number of nodes, so that the deletion is lazy
statement ok
insert into t_lazy select number, number * 10 from numbers(100);

statement ok
insert into t_lazy select number, number * 10 from numbers(200) where number >= 100;

statement ok
insert into t_lazy select number, number * 10 from numbers(300) where number >= 200;

statement ok
insert into t_lazy select number, number * 10 from numbers(400) where number >= 300;

statement ok
insert into t_lazy select number, number * 10 from numbers(500) where number >= 400;

statement ok
insert into t_lazy select number, number * 10 from numbers(600) where number >= 500;

statement ok
insert into t_lazy select number, number * 10 from numbers(700) where number >= 600;

statement ok
insert into t_lazy select number, number * 10 from numbers(800) where number >= 700;

statement ok
insert into t_lazy select number, number * 10 from numbers(900) where number >= 800;

statement ok
insert into t_lazy select number, number * 10 from numbers(1000) where number >= 900;

statement ok
insert into t_lazy select number, number * 10 from numbers(1100) where number >= 1000;

statement ok
insert into t_lazy select number, number * 10 from numbers(1200) where number >= 1100;

# no segment is touched
statement ok
delete from t_lazy where id > 5000;

query II
select count(*), sum(c1) from t_lazy;
----
1200 7194000

# mix of whole segment, whole block and partial block deletions
statement ok
delete from t_lazy where id < 300 or (id >= 400 and id < 450) or (id >= 645 and id < 655) or id >= 1195;

query II
select count(*), sum(c1) from t_lazy;
----
835 6408450

query I
select count(*) from t_lazy where id < 300 or (id >= 400 and id < 450) or (id >= 645 and id < 655) or id >= 1195;
----
0

# more mutation sources than deletion tasks
statement ok
set max_threads = 16;

statement ok
delete from t_lazy where id = 700;

statement ok
unset max_threads;

query II
select count(*), sum(c1) from t_lazy;
----
834 6401450

# all the rows are deleted by the filter
statement ok
delete from t_lazy where id >= 0;

query I
select count(*) from t_lazy;
----
0

statement ok
drop table t_lazy;
