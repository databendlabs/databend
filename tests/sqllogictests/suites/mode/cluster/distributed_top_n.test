# Distributed EXPLAIN shape tests for the fused TopN operator (`enable_top_n`).

statement ok
create or replace table t_top_n_dist (a int not null, b string not null);

statement ok
set enable_top_n = 1;

# The distributed plan splits TopN into a final stage above the merge
# exchange and a partial stage below it; both stages keep limit + offset
# candidates and the offset is applied at the final stage only.
query T
explain select a, b from t_top_n_dist order by a desc limit 3 offset 1
----
RowFetch
├── output columns: [t_top_n_dist.a (#0), t_top_n_dist._row_id (#2), t_top_n_dist.b (#1)]
├── columns to fetch: [b]
├── estimated rows: <slt:ignore>
└── TopN(Final)
    ├── output columns: [t_top_n_dist.a (#0), t_top_n_dist._row_id (#2)]
    ├── sort keys: [a DESC NULLS LAST]
    ├── limit: 3
    ├── offset: 1
    ├── estimated rows: <slt:ignore>
    └── Exchange
        ├── output columns: [t_top_n_dist.a (#0), t_top_n_dist._row_id (#2)]
        ├── exchange type: Merge
        └── TopN(Partial)
            ├── output columns: [t_top_n_dist.a (#0), t_top_n_dist._row_id (#2)]
            ├── sort keys: [a DESC NULLS LAST]
            ├── limit: 4
            ├── offset: 0
            ├── estimated rows: <slt:ignore>
            └── TableScan
                ├── table: default.default.t_top_n_dist
                ├── scan id: 0
                ├── output columns: [a (#0), _row_id (#2)]
                ├── read rows: <slt:ignore>
                ├── read size: <slt:ignore>
                ├── partitions total: <slt:ignore>
                ├── partitions scanned: <slt:ignore>
                ├── push downs: [filters: [], limit: 4]
                └── estimated rows: <slt:ignore>

# Multi-key ordering appends an order column in the partial stage.
query T
explain select a, b from t_top_n_dist order by a desc, b asc limit 5
----
TopN(Final)
├── output columns: [t_top_n_dist.a (#0), t_top_n_dist.b (#1)]
├── sort keys: [a DESC NULLS LAST, b ASC NULLS LAST]
├── limit: 5
├── offset: 0
├── estimated rows: <slt:ignore>
└── Exchange
    ├── output columns: [t_top_n_dist.a (#0), t_top_n_dist.b (#1), #_order_col]
    ├── exchange type: Merge
    └── TopN(Partial)
        ├── output columns: [t_top_n_dist.a (#0), t_top_n_dist.b (#1), #_order_col]
        ├── sort keys: [a DESC NULLS LAST, b ASC NULLS LAST]
        ├── limit: 5
        ├── offset: 0
        ├── estimated rows: <slt:ignore>
        └── TableScan
            ├── table: default.default.t_top_n_dist
            ├── scan id: 0
            ├── output columns: [a (#0), b (#1)]
            ├── read rows: <slt:ignore>
            ├── read size: <slt:ignore>
            ├── partitions total: <slt:ignore>
            ├── partitions scanned: <slt:ignore>
            ├── push downs: [filters: [], limit: 5]
            └── estimated rows: <slt:ignore>

# Execution sanity check in cluster mode.
statement ok
insert into t_top_n_dist select number, concat('v', to_string(number % 3)) from numbers(50);

query IT
select a, b from t_top_n_dist order by a desc limit 3 offset 1
----
48 v0
47 v2
46 v1

# TopN over UNION ALL keeps the union below the partial stage, so one partial
# TopN drives the runtime filters of both branch scans. The right branch
# outputs a NOT NULL column cast to the nullable union type.
statement ok
create or replace table t_top_n_union_l (a int64 null) row_per_block = 5;

statement ok
create or replace table t_top_n_union_r (b int64 not null) row_per_block = 5;

statement ok
insert into t_top_n_union_l select number * 2 from numbers(50);

statement ok
insert into t_top_n_union_r select number + 1000 from numbers(50);

statement ok
insert into t_top_n_union_r values (1), (3);

query T
explain select a from (select a from t_top_n_union_l union all select b from t_top_n_union_r) u order by a limit 4
----
TopN(Final)
├── output columns: [a (#2)]
├── sort keys: [a ASC NULLS LAST]
├── limit: 4
├── offset: 0
├── estimated rows: <slt:ignore>
└── Exchange
    ├── output columns: [a (#2), #_order_col]
    ├── exchange type: Merge
    └── TopN(Partial)
        ├── output columns: [a (#2), #_order_col]
        ├── sort keys: [a ASC NULLS LAST]
        ├── limit: 4
        ├── offset: 0
        ├── estimated rows: <slt:ignore>
        └── UnionAll
            ├── output columns: [a (#2)]
            ├── estimated rows: <slt:ignore>
            ├── TableScan
            │   ├── table: default.default.t_top_n_union_l
            │   ├── scan id: 0
            │   ├── output columns: [a (#0)]
            │   ├── read rows: <slt:ignore>
            │   ├── read size: <slt:ignore>
            │   ├── partitions total: <slt:ignore>
            │   ├── partitions scanned: <slt:ignore>
            │   ├── pruning stats: <slt:ignore>
            │   ├── push downs: [filters: [], limit: NONE]
            │   └── estimated rows: <slt:ignore>
            └── TableScan
                ├── table: default.default.t_top_n_union_r
                ├── scan id: 1
                ├── output columns: [b (#1)]
                ├── read rows: <slt:ignore>
                ├── read size: <slt:ignore>
                ├── partitions total: <slt:ignore>
                ├── partitions scanned: <slt:ignore>
                ├── pruning stats: <slt:ignore>
                ├── push downs: [filters: [], limit: NONE]
                └── estimated rows: <slt:ignore>

query I
select a from (select a from t_top_n_union_l union all select b from t_top_n_union_r) u order by a limit 4
----
0
1
2
3

query I
select a from (select a from t_top_n_union_l union all select b from t_top_n_union_r) u order by a desc limit 3 offset 1
----
1048
1047
1046

# Aggregate rank limit over UNION ALL: groups merge across branches.
query II
select k, count(*) from (select a as k from t_top_n_union_l union all select a from t_top_n_union_l where a > 90) u group by k order by k desc limit 3
----
98 2
96 2
94 2

# The Sort + Limit path is the differential oracle.
query I
settings (enable_top_n = 0) select a from (select a from t_top_n_union_l union all select b from t_top_n_union_r) u order by a limit 4
----
0
1
2
3

statement ok
drop table t_top_n_union_l;

statement ok
drop table t_top_n_union_r;

statement ok
unset enable_top_n;

statement ok
drop table t_top_n_dist;
