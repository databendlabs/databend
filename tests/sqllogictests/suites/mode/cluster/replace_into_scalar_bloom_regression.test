# Cluster-only regression: this external-Parquet REPLACE path can trigger the bug only in a
# multi-node deployment.
#
# Reproduced query shape:
#
#   REPLACE INTO replace_target ON (a, constant_key, c, e, b)
#   SELECT a, b, c, d, 42::uint64 AS constant_key, e
#   FROM (SELECT a, b, c, d, e FROM 'fs:///tmp/replace_into_external_parquet/');
#
#   file 1 --> node A --> projection: constant_key = Scalar(42)
#   file 2 --> node B --> projection: constant_key = Scalar(42)
#                         |
#                  broadcast exchange
#                    /              \
#   local path keeps Scalar(42)   remote path serializes the block:
#                                  Scalar(42) --> Column([42, ...])
#
# Before this fix, on a node responsible for a target block:
#
#   local:  constant_key is Scalar; other Bloom keys are Columns -> Scalar dropped -> 3 hashes
#   remote: all four Bloom keys are Columns -> 4 hashes
#   same DeletionAccumulator entry -> panic: 3 != 4
#
# This test case requires exactly three query nodes to reproduce the pre-fix panic reliably.
query I
select count() from system.clusters;
----
3

statement ok
create or replace table replace_target (
    a uint64,
    b uint64,
    c uint64,
    d uint64,
    constant_key uint64,
    e uint64
) cluster by (a) row_per_block = 2;

statement ok
drop stage if exists replace_files;

statement ok
create stage replace_files
url = 'fs:///tmp/replace_into_external_parquet/'
file_format = (type = parquet);

statement ok
remove @replace_files;

# Make each external Parquet file a separate scan partition in the REPLACE source subquery.
statement ok
set parquet_fast_read_bytes = 0;

# a ranges from 1 to 18. This maps rows 1-9 to partition 0 and rows 10-18 to partition 1,
# producing exactly two external Parquet files.
statement ok
copy into @replace_files from (
    select
        number + 1 as a,
        number + 11 as b,
        number + 21 as c,
        number + 31 as d,
        number + 41 as e
    from numbers(18)
) partition by (to_string(floor((a - 1) / 9)));

# With row_per_block = 2, these six rows form three target blocks, one per query node. Their ranges
# cover the source rows, and constant_key has the highest NDV so it is selected for Bloom pruning.
# The first target row conflicts with source row a = 1. Its old d is 10; the source d is 31.
statement ok
insert into replace_target values
    (1, 11, 21, 10, 42, 41), (100, 1000, 1000, 30, 101, 1000),
    (1, 0, 0, 10, 2, 0), (100, 1000, 1000, 30, 102, 1000),
    (1, 0, 0, 10, 3, 0), (100, 1000, 1000, 30, 103, 1000);

statement ok
set enable_distributed_replace_into = 1;

statement ok
replace into replace_target
on (a, constant_key, c, e, b)
select a, b, c, d, 42::uint64 as constant_key, e
from (
    select a, b, c, d, e
    from 'fs:///tmp/replace_into_external_parquet/'
);

# REPLACE deletes the one conflicting target row, then inserts all 18 source rows.
# The result has 6 initial rows - 1 deleted row + 18 inserted rows = 23.
query I
select count() from replace_target;
----
23

# In this data set, a = 1 and constant_key = 42 uniquely identify the conflicting row.
# It now has the source value d = 31 instead of the old target value d = 10.
query I
select d from replace_target
where a = 1 and constant_key = 42;
----
31

statement ok
remove @replace_files;

statement ok
drop stage replace_files;

statement ok
drop table replace_target;

# Hash-distributed REPLACE must keep correct data and partition-pure blocks.
statement ok
create table replace_hash_target(id int, p int)
partition by (p % 16) write_distribution_mode='hash'
row_per_block=1000 block_per_segment=1000;

statement ok
insert into replace_hash_target
select number::int, (number % 16)::int from numbers(24);

statement ok
replace into replace_hash_target on(id)
select number::int, (number % 16)::int from numbers(2400);

query II
select count(*), sum(p) from replace_hash_target;
----
2400 18000

statement ok
set replace_into_shuffle_strategy = 1;

statement ok
replace into replace_hash_target on(id)
select (number + 2400)::int, (number % 16)::int from numbers(2400);

query II
select count(*), sum(p) from replace_hash_target;
----
4800 36000

query I
select count(*) from (
  select _block_name from replace_hash_target group by _block_name
  having min(p % 16) != max(p % 16)
);
----
0

statement ok
set replace_into_shuffle_strategy = 0;

statement ok
drop table replace_hash_target;

# DELETE WHEN with a hash-distributed target.
statement ok
create table replace_delete_hash(id int, p int)
partition by (p % 16) write_distribution_mode='hash';

statement ok
insert into replace_delete_hash values(0, 0), (1, 1);

statement ok
create table replace_delete_src(id int, p int, c int);

statement ok
insert into replace_delete_src values(0, 0, 0), (1, 2, 1), (2, 3, 1);

statement ok
replace into replace_delete_hash on(id) delete when c = 0
select * from replace_delete_src;

query II
select count(*), sum(p) from replace_delete_hash;
----
2 5

statement ok
drop table replace_delete_hash;

statement ok
drop table replace_delete_src;

# Hash routing must change the physical layout of distributed REPLACE INTO writes.
statement ok
set enable_distributed_replace_into = 1;

statement ok
create or replace table replace_layout_src(a int) row_per_block=128 block_per_segment=1000;

statement ok
insert into replace_layout_src select number::int from numbers(4096);

statement ok
create or replace table replace_layout_hash(a int, p int)
partition by (p % 2) write_distribution_mode='hash'
row_per_block=1000 block_per_segment=1000;

statement ok
create or replace table replace_layout_none(a int, p int)
partition by (p % 2) row_per_block=1000 block_per_segment=1000;

statement ok
replace into replace_layout_hash on(a) select a, a from replace_layout_src;

statement ok
replace into replace_layout_none on(a) select a, a from replace_layout_src;

query II
select to_int64(h.row_count = n.row_count), to_int64(h.block_count < n.block_count)
from (select row_count, block_count from fuse_snapshot('default', 'replace_layout_hash') order by timestamp desc limit 1) h
cross join (select row_count, block_count from fuse_snapshot('default', 'replace_layout_none') order by timestamp desc limit 1) n;
----
1 1

statement ok
drop table replace_layout_src;

statement ok
drop table replace_layout_hash;

statement ok
drop table replace_layout_none;
