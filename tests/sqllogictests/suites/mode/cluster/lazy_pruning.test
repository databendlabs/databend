# A lazy `MutationSource` publishes its scanned count after pruning, and
# `explain analyze` must apply it to the leaf like it does for `TableScan`;
# otherwise the leaf keeps the planner's estimate. `explain analyze` does not
# commit the delete.
query T
explain analyze delete from t where a > 2500
----
MutationSource(Delete)
├── cpu time: <slt:ignore>
├── wait time: <slt:ignore>
├── partitions scanned: 2
├── table: default.lazy_pruning.t
├── output columns: [a (#0)]
├── filters: [is_true(t.a (#0) > 2500)]
├── read rows: 0
├── read size: 0
├── partitions total: 12
└── partitions scanned: 6

query I
select count() from t
----
1200

statement ok
drop database lazy_pruning
