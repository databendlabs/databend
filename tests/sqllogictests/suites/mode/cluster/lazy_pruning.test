# Lazy (deferred) block pruning: when a table has more segments than the
# cluster has nodes, `read_partitions` hands out segments as lazy parts and
# block pruning runs inside the pipeline on each node, either in a dedicated
# `FusePrune` stage (`enable_distributed_pruning`, the default) or in the
# `TableScan` itself.
#
# The cluster suite runs on 3 nodes, so the table below needs at least 4
# segments to take this path. Keep it that way: with 3 or fewer segments the
# scan is eager and this file no longer tests what it claims to.
#
# `partitions total` is the table's block count in every output below; it is
# not the segment count, and segments pruned without being read still count.

statement ok
create or replace database lazy_pruning

statement ok
use lazy_pruning

# Each insert is one segment of 3 blocks: 4 segments, 12 blocks.
statement ok
create table t (a int) row_per_block=100 block_per_segment=10

statement ok
insert into t select number + 1000 from numbers(300)

statement ok
insert into t select number + 2000 from numbers(300)

statement ok
insert into t select number + 3000 from numbers(300)

statement ok
insert into t select number + 4000 from numbers(300)

query III
select count(), count(distinct _block_name), count(distinct _segment_name) from t
----
1200 12 4

# Distributed pruning (default): the planner has pruned, so both `explain`
# and `explain analyze` show the pruned counts. Segments [1000, 1300) and
# [2000, 2300) are pruned whole; 6 of the 12 blocks remain.
query T
explain select * from t where a > 2500
----
Exchange
├── output columns: [t.a (#0)]
├── exchange type: Merge
└── FuseBlockRead
    └── Exchange
        ├── output columns: []
        ├── exchange type: Hash()
        └── FusePrune
            ├── table: default.lazy_pruning.t
            ├── read rows: 600
            ├── read size: 1.51 KiB
            ├── partitions total: 12
            ├── partitions scanned: 6
            └── pruning stats: [segments: <read cost: <slt:ignore>, decompress cost: <slt:ignore>, range pruning: 4 to 2 cost: <slt:ignore>>, blocks: <range pruning: 6 to 6 cost: <slt:ignore>>]

# Without distributed pruning the scan is a lazy TableScan. Plain `explain`
# prunes synchronously to print the plan, so the counts match; the pipeline
# path is what `explain analyze` and the query log go through.
statement ok
set enable_distributed_pruning = 0

query T
explain select * from t where a > 2500
----
Exchange
├── output columns: [t.a (#0)]
├── exchange type: Merge
└── TableScan
    ├── table: default.lazy_pruning.t
    ├── scan id: 0
    ├── output columns: [a (#0)]
    ├── read rows: 600
    ├── read size: 1.51 KiB
    ├── partitions total: 12
    ├── partitions scanned: 6
    ├── pruning stats: [segments: <read cost: <slt:ignore>, decompress cost: <slt:ignore>, range pruning: 4 to 2 cost: <slt:ignore>>, blocks: <range pruning: 6 to 6 cost: <slt:ignore>>]
    ├── push downs: [filters: [is_true(t.a (#0) > 2500)], limit: NONE]
    └── estimated rows: 654.18

query T
explain analyze select * from t where a > 2500
----
<slt:ignore>

statement ok
unset enable_distributed_pruning

statement ok
drop database lazy_pruning
