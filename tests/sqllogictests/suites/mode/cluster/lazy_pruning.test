            ├── exchange type: Hash(0)
            └── AggregatePartial
                ├── group by: [a % 3]
                ├── aggregate functions: [count()]
                ├── estimated rows: 3.00
                └── EvalScalar
                    ├── output columns: [a % 3 (#1)]
                    ├── expressions: [t.a (#0) % 3]
                    ├── estimated rows: 654.18
                    └── TableScan
                        ├── table: default.lazy_pruning.t
                        ├── scan id: 0
                        ├── output columns: [a (#0)]
                        ├── read rows: 600
