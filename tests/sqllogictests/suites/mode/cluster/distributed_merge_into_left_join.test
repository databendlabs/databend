merge into t using (select a.id, a.val + d.v as val from s as a left join dim as d on a.id % 10 = d.k qualify row_number() over (partition by a.id order by d.v) = 1) as s on t.id = s.id when matched then update set t.val = s.val, t.note = 'upd' when not matched then insert (id, val, note) values (s.id, s.val, 'new');
----
12000 6000

query ??????????
select count(*), count(id), count(distinct id), sum(id), count(val), sum(val), sum(id * val), count_if(note = 'old'), count_if(note = 'upd'), count_if(note = 'new') from t;
----
18000 18000 18000 161991000 18000 1619991000 19439109138000 0 6000 12000

statement ok
drop table dim;

