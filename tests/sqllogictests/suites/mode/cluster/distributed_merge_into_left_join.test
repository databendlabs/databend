# Exact results for distributed MERGE, mostly the left-outer shape where the source is the probe
# side and the target is the build side. Expected values were computed by hand-written semantics,
# not copied from engine output. Passes cover the join implementations and distributions:
# enforce_broadcast_join=1 goes through the broadcast to shuffle rewrite, and
# enable_experimental_new_join=0 keeps the legacy hash join as a differential check.
# run-with-settings: enforce_broadcast_join=1
# run-with-settings: enforce_shuffle_join=1
# run-with-settings: enforce_broadcast_join=1, force_join_data_spill=1
# run-with-settings: enforce_shuffle_join=1, force_join_data_spill=1
# run-with-settings: enforce_broadcast_join=1, enable_experimental_new_join=0

statement ok
create or replace database merge_left_join;

statement ok
use merge_left_join;

# update and insert on a single bigint key

statement ok
create or replace table t (id bigint, val bigint, note string);

statement ok
insert into t select number * 2, number, 'old' from numbers(6000);

statement ok
create or replace table s (id bigint, val bigint, note string);

statement ok
insert into s select number, number * 10, 'src' from numbers(18000);

query ??
merge into t using s on t.id = s.id when matched then update set t.val = s.val, t.note = 'upd' when not matched then insert (id, val, note) values (s.id, s.val, 'new');
----
12000 6000

query ??????????
select count(*), count(id), count(distinct id), sum(id), count(val), sum(val), sum(id * val), count_if(note = 'old'), count_if(note = 'upd'), count_if(note = 'new') from t;
----
18000 18000 18000 161991000 18000 1619910000 19438380030000 0 6000 12000

# composite key with a nullable column and a type cast on the build side

statement ok
create or replace table t (id bigint not null, game int not null, room bigint null, val bigint, note string);

statement ok
insert into t select number * 2, (number * 2) % 16, if(number % 50 = 0, null, (number * 2) % 1000), number, 'old' from numbers(6000);

statement ok
create or replace table s (id bigint not null, game bigint not null, room bigint not null, val bigint);

statement ok
insert into s select number, number % 16, number % 1000, number * 10 from numbers(18000);

query ??
merge into t using s on t.id = s.id and t.game = s.game and t.room = s.room when matched then update set t.val = s.val, t.note = 'upd' when not matched then insert (id, game, room, val, note) values (s.id, s.game, s.room, s.val, 'new');
----
12120 5880

query ??????????
select count(*), count(id), count(distinct id), sum(id), count(val), sum(val), sum(id * val), count_if(note = 'old'), count_if(note = 'upd'), count_if(note = 'new') from t;
----
18120 18120 18000 162705000 18120 1620267000 19441224130000 120 5880 12120

