# Physical-plan regression for distributed dynamic `_block_name` pruning.
# The build side must be broadcast so every node can prune its local Fuse scan.

statement ok
drop table if exists t_dynamic_block_prune_explain;

statement ok
create table t_dynamic_block_prune_explain(a Int64);

query T nosort
explain select count(*) from t_dynamic_block_prune_explain where _block_name in (
    select block_location from fuse_block('default', 't_dynamic_block_prune_explain')
    order by block_location limit 1
);
