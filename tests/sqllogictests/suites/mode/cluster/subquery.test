# Unlike a literal LIMIT 0, this build input becomes empty only while scanning.
# Its plan must retain Merge -> final Limit -> Broadcast so the execution also
# verifies that every remote-only receiver observes EOF from a zero-block producer.
query T nosort
explain
select count(*)
from t_limit_in_subquery o
where a in (
    select a
    from t_limit_in_subquery
    where a < a
    limit 10
);
