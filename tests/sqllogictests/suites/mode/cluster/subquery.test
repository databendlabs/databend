# RightMark: preserve the probe scan through both nested mark joins.
# The compact optimized plan records exchanges without physical scan statistics.
query T
EXPLAIN (logical, optimized) SELECT
      t1.a,
      t1.a IN (SELECT a FROM t2) AS in_match,
      t1.a NOT IN (SELECT a FROM t2) AS not_in_match
FROM t1
----
Exchange(Merge)
└── EvalScalar
    ├── scalars: [t1.a (#0) AS (#0), in_match (#3) AS (#3), not(marker (#5)) AS (#4)]
    └── Join(RightMark)
        ├── build keys: [t2.a (#2)]
        ├── probe keys: [t1.a (#0)]
        ├── other filters: []
        ├── Exchange(Broadcast)
        │   └── Scan
        │       ├── table: d_subquery.t2 (#2)
        │       ├── filters: []
        │       ├── order by: []
        │       └── limit: NONE
        └── Join(RightMark)
            ├── build keys: [t2.a (#1)]
            ├── probe keys: [t1.a (#0)]
            ├── other filters: []
            ├── Exchange(Broadcast)
            │   └── Scan
            │       ├── table: d_subquery.t2 (#1)
            │       ├── filters: []
            │       ├── order by: []
            │       └── limit: NONE
            └── Scan
                ├── table: d_subquery.t1 (#0)
                ├── filters: []
                ├── order by: []
                └── limit: NONE

# A larger subquery makes join commutation choose LeftMark. Both inputs remain
# distributed: this exercises NonBroadcast, not the scalar-aggregate Serial path.
statement ok
INSERT INTO t2 SELECT 2 FROM numbers(8)

# LeftMark: preserve the build scan; broadcast the probe-side subquery.
query T
EXPLAIN (logical, optimized) SELECT a, a IN (SELECT a FROM t2) AS present FROM t1
----
Exchange(Merge)
└── Join(LeftMark)
    ├── build keys: [t1.a (#0)]
    ├── probe keys: [t2.a (#1)]
    ├── other filters: []
    ├── Scan
    │   ├── table: d_subquery.t1 (#0)
    │   ├── filters: []
    │   ├── order by: []
    │   └── limit: NONE
    └── Exchange(Broadcast)
        └── Scan
            ├── table: d_subquery.t2 (#1)
            ├── filters: []
            ├── order by: []
            └── limit: NONE

query IBB rowsort
SELECT a, a IN (SELECT a FROM t2), a NOT IN (SELECT a FROM t2) FROM t1
----
1 NULL NULL
2 1 0
NULL 1 0

statement ok
drop database d_subquery
