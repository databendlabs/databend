# A preserved build side cannot be broadcast. The optimizer must keep this
# physical RIGHT OUTER join Serial even though its pushed LIMIT is gathered by
# a Merge exchange; otherwise it could duplicate unmatched rows.
query T nosort
explain
select l.a, r.a
from t_limit_in_subquery l
left join t_limit_in_subquery r on l.a = r.a
limit 3;
