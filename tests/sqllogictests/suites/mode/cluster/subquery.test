statement ok
set max_execute_time_in_seconds = 10;

# LIMIT without ORDER BY does not define which ten keys are selected. Count
# unique outer keys instead of asserting a particular unordered result set.
query I
select count(*)
from t_limit_in_subquery t
where a in (
    select a
    from t_limit_in_subquery
    limit 10
);
----
10

query I
settings(enforce_shuffle_join = 1) select count(*)
from t_limit_in_subquery t
where a in (
    select a
    from t_limit_in_subquery
    limit 10
);
----
10

query I
select count(*)
from (
    select l.a, r.a
    from t_limit_in_subquery l
    left join t_limit_in_subquery r on l.a = r.a
    limit 3
);
----
3

query I
select count(*)
from t_limit_in_subquery t
where a in (
    select a
    from t_limit_in_subquery
    limit 7 offset 5
);
----
7

query I
select count(*)
from t_limit_in_subquery o
where a in (
    select a
    from t_limit_in_subquery
    where a < a
    limit 10
);
----
0

query I
select count(*)
from t_limit_in_subquery t
where a in (
    select a
    from t_limit_in_subquery
    limit 0
);
----
0

statement ok
unset max_execute_time_in_seconds;

statement ok
drop table if exists t_limit_in_subquery all;


statement ok
drop database d_subquery
