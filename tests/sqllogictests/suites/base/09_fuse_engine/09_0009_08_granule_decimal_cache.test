# Metadata-only precision widening must not reuse arrays with the old Decimal type.
# Warm the data and granule-min caches before ALTER; blocks are not rewritten.
statement ok
create or replace table granule_decimal_cache(k decimal(10, 2)) cluster by(k) index_granularity=2

statement ok
insert into granule_decimal_cache values (1.00), (2.00), (3.00), (4.00), (5.00)

query I rowsort
select k from granule_decimal_cache
----
1.00
2.00
3.00
4.00
5.00

query I rowsort
select k from granule_decimal_cache where k >= 3.00
----
3.00
4.00
5.00

statement ok
alter table granule_decimal_cache modify column k decimal(15, 2)

query IT rowsort
select k, typeof(k) from granule_decimal_cache where k >= 3.00
----
3.00 DECIMAL(15, 2) NULL
4.00 DECIMAL(15, 2) NULL
5.00 DECIMAL(15, 2) NULL

query I rowsort
select k from granule_decimal_cache
----
1.00
2.00
3.00
4.00
5.00

statement ok
drop table granule_decimal_cache
