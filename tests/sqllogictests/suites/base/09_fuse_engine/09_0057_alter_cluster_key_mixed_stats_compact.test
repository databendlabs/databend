query I
SELECT count() FROM fuse_block('db_09_0057', 't')
----
22

statement ok
OPTIMIZE TABLE t COMPACT

query II
SELECT count(), sum(a + b) FROM t
----
22 2082

statement ok
ALTER TABLE t RECLUSTER FINAL

query II
SELECT count(), sum(a + b) FROM t
----
22 2082

query T
SELECT cluster_key FROM clustering_information('db_09_0057', 't')
----
(b)

statement ok
SET enable_compact_after_write = 1

statement ok
DROP DATABASE db_09_0057
