## Compact / recluster after ALTER TABLE ... CLUSTER BY must handle blocks with stale cluster stats.

statement ok
DROP DATABASE IF EXISTS db_09_0057

statement ok
CREATE DATABASE db_09_0057

statement ok
USE db_09_0057

statement ok
SET enable_compact_after_write = 0

statement ok
CREATE TABLE t(a INT, b INT) CLUSTER BY (a)

# Each INSERT creates one block; the values and order matter for reproducing the old panic.
statement ok
INSERT INTO t VALUES(70, 70)

statement ok
