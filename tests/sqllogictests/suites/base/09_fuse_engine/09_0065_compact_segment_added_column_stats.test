query III
select segment_count, block_count, row_count from fuse_snapshot('default', 'compact_segment_added_stats') limit 1
----
2 2 2

# Neither column is covered by the older segment's statistics.
query III
select min(b), max(b), (max(d) = 9.25)::int from compact_segment_added_stats
----
7 100 1

statement ok
optimize table compact_segment_added_stats compact segment

query III
select segment_count, block_count, row_count from fuse_snapshot('default', 'compact_segment_added_stats') limit 1
----
1 2 2

query I
select a from compact_segment_added_stats where b = 7
----
1

query I
select a from compact_segment_added_stats where c is null
----
1

query I
select a from compact_segment_added_stats where d = 9.25
----
1

query I
select a from compact_segment_added_stats where dt = '2001-01-01'::date
----
1

query I
select a from compact_segment_added_stats where ts = '2001-01-01 12:00:00'::timestamp
----
1

query I
select a from compact_segment_added_stats where tz is null
----
1

# The default's string upper bound must include the full 40-character value.
query I
select a from compact_segment_added_stats where s = repeat('z', 40)
----
1

# The truncated bound must never be used as an exact MAX result.
query IIII
select min(b), max(b), (max(d) = 9.25)::int, length(max(s))
from compact_segment_added_stats
----
7 100 1 40

statement ok
