set enable_compact_after_write = 0

statement ok
create table compact_segment_added_stats (a int)
  storage_format = 'parquet' segment_format = 'row_oriented' block_per_segment = 10

statement ok
insert into compact_segment_added_stats values (1)

statement ok
alter table compact_segment_added_stats add column b int not null default 7

statement ok
alter table compact_segment_added_stats add column c int null

statement ok
alter table compact_segment_added_stats add column d decimal(10, 2) not null default 9.25

statement ok
alter table compact_segment_added_stats add column dt date not null default '2001-01-01'

statement ok
alter table compact_segment_added_stats add column ts timestamp not null default '2001-01-01 12:00:00'

statement ok
alter table compact_segment_added_stats add column tz timestamp_tz null

statement ok
alter table compact_segment_added_stats add column s string not null default repeat('z', 40)

