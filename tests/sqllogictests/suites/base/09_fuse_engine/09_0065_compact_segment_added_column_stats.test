statement ok
optimize table mutate_added_null compact segment

statement ok
update mutate_added_null set c = 100 where a = 2

query I
select a from mutate_added_null where c is null
----
1

query II
select min(c), max(c) from mutate_added_null
----
100 100

statement ok
drop table mutate_added_null

