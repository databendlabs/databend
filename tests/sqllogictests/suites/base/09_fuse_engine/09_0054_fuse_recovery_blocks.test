statement ok
CREATE OR REPLACE TABLE fuse_recovery_blocks_slt(id INT, payload VARIANT) CLUSTER BY(id) CHANGE_TRACKING = TRUE ENABLE_AUTO_ANALYZE = 0

statement ok
INSERT INTO fuse_recovery_blocks_slt VALUES(1, parse_json('{"v":1}'))

# UPDATE adds change-tracking fields to the source block. Recovery ignores them.
# VARIANT verifies that Parquet logical types are preserved.
statement ok
UPDATE fuse_recovery_blocks_slt SET payload = parse_json('{"v":2}') WHERE id = 1

statement ok
SET VARIABLE source_block = (SELECT _block_name FROM fuse_recovery_blocks_slt WHERE id = 1)

# TRUNCATE removes the source block from the current snapshot but leaves it in storage.
statement ok
TRUNCATE TABLE fuse_recovery_blocks_slt

statement ok
SET VARIABLE recovery_sql = concat(
    'COPY INTO fuse_recovery_blocks_slt FROM FUSE_RECOVERY_BLOCKS(FILES => (''',
    $source_block,
    ''')) FORCE = FALSE'
)

statement ok
EXECUTE IMMEDIATE $recovery_sql

query III
SELECT count(), sum(id), max(payload['v']::INT) FROM fuse_recovery_blocks_slt
----
1 1 2

query B
SELECT count() = 1 AND min(content_length) > 0 FROM copy_history('fuse_recovery_blocks_slt')
----
1

statement ok
SET VARIABLE recovered_block = (SELECT _block_name FROM fuse_recovery_blocks_slt WHERE id = 1)

query B
SELECT count() > 0 AND count_if(level IS NOT NULL) = count()
FROM clustering_statistics('default', 'fuse_recovery_blocks_slt')
----
1

# Remove the source block from storage but retain its COPY history entry.
# FORCE = FALSE must filter the path before reading object storage.
statement ok
SET data_retention_time_in_days = 0

statement ok
OPTIMIZE TABLE fuse_recovery_blocks_slt PURGE

statement ok
UNSET data_retention_time_in_days

statement ok
EXECUTE IMMEDIATE $recovery_sql

query I
SELECT count() FROM fuse_recovery_blocks_slt
----
1

# FORCE = TRUE bypasses COPY history and tries to read the deleted block.
statement ok
SET VARIABLE force_sql = concat(
    'COPY INTO fuse_recovery_blocks_slt FROM FUSE_RECOVERY_BLOCKS(FILES => (''',
    $source_block,
    ''')) FORCE = TRUE'
)

statement error 3001
EXECUTE IMMEDIATE $force_sql

query I
SELECT count() FROM fuse_recovery_blocks_slt
----
1

# Replace the final path component with a missing block in the same _b/ directory.
statement ok
SET VARIABLE missing_block = regexp_replace($recovered_block, '[^/]+$', 'missing_v2.parquet')

# A missing block rejects the whole batch; the valid block must not be appended.
statement ok
SET VARIABLE missing_batch_sql = concat(
    'COPY INTO fuse_recovery_blocks_slt FROM FUSE_RECOVERY_BLOCKS(FILES => (''',
    $recovered_block,
    ''', ''',
    $missing_block,
    ''')) FORCE = FALSE'
)

statement error 3001
EXECUTE IMMEDIATE $missing_batch_sql

query I
SELECT count() FROM fuse_recovery_blocks_slt
----
1

# Reject the whole batch when one selected block has an old schema.
statement ok
ALTER TABLE fuse_recovery_blocks_slt ADD COLUMN added INT

statement ok
INSERT INTO fuse_recovery_blocks_slt(id, payload, added) VALUES(2, parse_json('{"v":3}'), 2)

statement ok
SET VARIABLE current_block = (SELECT _block_name FROM fuse_recovery_blocks_slt WHERE id = 2)

statement ok
SET VARIABLE schema_mismatch_sql = concat(
    'COPY INTO fuse_recovery_blocks_slt FROM FUSE_RECOVERY_BLOCKS(FILES => (''',
    $current_block,
    ''', ''',
    $recovered_block,
    ''')) FORCE = TRUE'
)

statement error 1303.*FUSE_RECOVERY_BLOCKS schema mismatch
EXECUTE IMMEDIATE $schema_mismatch_sql

query I
SELECT count() FROM fuse_recovery_blocks_slt
----
2

statement ok
UNSET VARIABLE (source_block, recovery_sql, recovered_block, force_sql, missing_block, missing_batch_sql, current_block, schema_mismatch_sql)

statement ok
DROP TABLE fuse_recovery_blocks_slt
