    SELECT _block_name FROM fuse_recovery_external_db.source_t
)

statement ok
SET VARIABLE external_file = (SELECT split_part($external_block, '/', -1))

statement ok
ALTER TABLE fuse_recovery_external_db.source_t ADD COLUMN added INT

statement ok
SET VARIABLE external_recovery_sql = concat(
    'COPY INTO fuse_recovery_external_target FROM FUSE_RECOVERY_BLOCKS(SOURCE_TABLE => default.fuse_recovery_external_db.source_t, FILES => (''',
    $external_file,
    '''))'
)

statement ok
EXECUTE IMMEDIATE $external_recovery_sql

# History is stored on the target and identifies the full external source path.
query B
SELECT count() = 1
    AND count_if(file_name LIKE '%fuse_recovery_blocks_external/%') = 1
    AND count_if(file_name LIKE concat('%', $external_block)) = 1
FROM copy_history('fuse_recovery_external_target')
----
1

# The retry is skipped by target COPY history.
statement ok
EXECUTE IMMEDIATE $external_recovery_sql

