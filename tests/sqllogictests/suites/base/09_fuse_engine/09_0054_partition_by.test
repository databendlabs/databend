INSERT INTO merge_partitioned VALUES (1, 0), (2, 0), (3, 1)

statement ok
MERGE INTO merge_partitioned AS t USING (SELECT 1 AS id, 1 AS p) AS s ON t.id = s.id WHEN MATCHED THEN UPDATE SET t.p = s.p

