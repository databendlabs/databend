# Segment compaction may combine metadata only inside one physical partition.
statement ok
OPTIMIZE TABLE t COMPACT SEGMENT

query II
SELECT segment_count, block_count FROM fuse_snapshot('db_09_0054', 't') LIMIT 1
----
3 6

# Block compaction may merge the two small blocks in each partition, but never
# merge blocks from different partition values.
statement ok
OPTIMIZE TABLE t COMPACT

query II
SELECT segment_count, block_count FROM fuse_snapshot('db_09_0054', 't') LIMIT 1
----
3 3

query IIT rowsort
SELECT p, c, v FROM t
