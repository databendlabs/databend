# Regression test for issue #19716:
# INSERT ALL with SELECT * ... WHERE ... LIMIT caused column mapping error
# due to lazy materialization reordering physical output columns.

statement ok
create or replace table src_19716 (id int, name varchar, created_at timestamp);

statement ok
insert into src_19716 values
  (0, 'alice', '2026-04-10 08:00:00'),
  (1, 'bob',   '2026-04-12 08:00:00');

statement ok
create or replace table dst1_19716 like src_19716;

statement ok
create or replace table dst2_19716 like src_19716;

# Case 1: no WHERE, no LIMIT
statement ok
INSERT ALL
  WHEN id = 0 THEN INTO dst1_19716
  WHEN id = 1 THEN INTO dst2_19716
SELECT * FROM src_19716;

query ITT
select id, name, created_at from dst1_19716 order by id;
----
0 alice 2026-04-10 08:00:00.000000

query ITT
select id, name, created_at from dst2_19716 order by id;
----
1 bob 2026-04-12 08:00:00.000000

statement ok
truncate table dst1_19716;

statement ok
truncate table dst2_19716;

# Case 2: WHERE only
statement ok
INSERT ALL
  WHEN id = 0 THEN INTO dst1_19716
  WHEN id = 1 THEN INTO dst2_19716
SELECT * FROM src_19716
WHERE created_at >= '2026-04-01' AND created_at < '2026-04-15';

query ITT
select id, name, created_at from dst1_19716 order by id;
----
0 alice 2026-04-10 08:00:00.000000

query ITT
select id, name, created_at from dst2_19716 order by id;
----
1 bob 2026-04-12 08:00:00.000000

statement ok
truncate table dst1_19716;

statement ok
truncate table dst2_19716;

# Case 3: LIMIT only
statement ok
INSERT ALL
  WHEN id = 0 THEN INTO dst1_19716
  WHEN id = 1 THEN INTO dst2_19716
SELECT * FROM src_19716
LIMIT 2;

query ITT
select id, name, created_at from dst1_19716 order by id;
----
0 alice 2026-04-10 08:00:00.000000

query ITT
select id, name, created_at from dst2_19716 order by id;
----
1 bob 2026-04-12 08:00:00.000000

statement ok
truncate table dst1_19716;

statement ok
truncate table dst2_19716;

# Case 4: WHERE + LIMIT — previously failed with column mapping error
statement ok
INSERT ALL
  WHEN id = 0 THEN INTO dst1_19716
  WHEN id = 1 THEN INTO dst2_19716
SELECT * FROM src_19716
WHERE created_at >= '2026-04-01' AND created_at < '2026-04-15'
LIMIT 2;

query ITT
select id, name, created_at from dst1_19716 order by id;
----
0 alice 2026-04-10 08:00:00.000000

query ITT
select id, name, created_at from dst2_19716 order by id;
----
1 bob 2026-04-12 08:00:00.000000

statement ok
truncate table dst1_19716;

statement ok
truncate table dst2_19716;

# Case 5: WHERE + LIMIT with subquery WHEN keeps source column order
statement ok
INSERT ALL
  WHEN id = (SELECT 0) THEN INTO dst1_19716
  WHEN id = (SELECT 1) THEN INTO dst2_19716
SELECT * FROM src_19716
WHERE created_at >= '2026-04-01' AND created_at < '2026-04-15'
LIMIT 2;

query ITT
select id, name, created_at from dst1_19716 order by id;
----
0 alice 2026-04-10 08:00:00.000000

query ITT
select id, name, created_at from dst2_19716 order by id;
----
1 bob 2026-04-12 08:00:00.000000

statement ok
drop table src_19716;

statement ok
drop table dst1_19716;

statement ok
drop table dst2_19716;

# ChunkAppendData builds each target's partition transforms independently.
# Different target expressions must not share or misalign partition metadata.
statement ok
CREATE TABLE multi_partitioned_a(p INT, id INT)
PARTITION BY (p % 2)
ROW_PER_BLOCK=100000 BLOCK_PER_SEGMENT=1000

statement ok
CREATE TABLE multi_partitioned_b(id INT)
PARTITION BY (id % 3)
ROW_PER_BLOCK=100000 BLOCK_PER_SEGMENT=1000

statement ok
INSERT ALL
  WHEN true THEN INTO multi_partitioned_a VALUES(p, id)
  WHEN id % 2 = 0 THEN INTO multi_partitioned_b VALUES(id)
SELECT (number % 4)::INT AS p, number::INT AS id FROM numbers(16)

query I
SELECT count(*) FROM multi_partitioned_a
----
16

query I
SELECT count(*) FROM multi_partitioned_b
----
8

query I
SELECT count_if(partition_values != 1)
FROM (
    SELECT _block_name, count(DISTINCT p % 2) AS partition_values
    FROM multi_partitioned_a
    GROUP BY _block_name
)
----
0

query I
SELECT count_if(partition_values != 1)
FROM (
    SELECT _block_name, count(DISTINCT id % 3) AS partition_values
    FROM multi_partitioned_b
    GROUP BY _block_name
)
----
0

statement ok
DROP TABLE multi_partitioned_a

statement ok
DROP TABLE multi_partitioned_b

# Each WHEN condition is evaluated once per source row, and a NULL condition is not matched.
statement ok
CREATE OR REPLACE TABLE route_src(a INT NULL, b INT)

statement ok
INSERT INTO route_src VALUES (NULL, 1), (NULL, 0), (20, 0), (20, 1)

statement ok
CREATE OR REPLACE TABLE route_t1(a INT NULL, b INT)

statement ok
CREATE OR REPLACE TABLE route_t2(a INT NULL, b INT)

statement ok
CREATE OR REPLACE TABLE route_t3(a INT NULL, b INT)

# INSERT FIRST: a NULL condition falls through to the next WHEN and to ELSE.
query III
INSERT FIRST
    WHEN a > 10 THEN INTO route_t1
    WHEN b = 1 THEN INTO route_t2
    ELSE INTO route_t3
SELECT a, b FROM route_src
----
2 1 1

query II
SELECT * FROM route_t1 ORDER BY a, b
----
20 0
20 1

query II
SELECT * FROM route_t2 ORDER BY a, b
----
NULL 1

query II
SELECT * FROM route_t3 ORDER BY a, b
----
NULL 0

statement ok
TRUNCATE TABLE route_t1

statement ok
TRUNCATE TABLE route_t2

statement ok
TRUNCATE TABLE route_t3

# INSERT ALL: ELSE only receives the rows for which no WHEN condition is true.
query III
INSERT ALL
    WHEN a > 10 THEN INTO route_t1
    WHEN b = 1 THEN INTO route_t2
    ELSE INTO route_t3
SELECT a, b FROM route_src
----
2 2 1

query II
SELECT * FROM route_t1 ORDER BY a, b
----
20 0
20 1

query II
SELECT * FROM route_t2 ORDER BY a, b
----
20 1
NULL 1

query II
SELECT * FROM route_t3 ORDER BY a, b
----
NULL 0

statement ok
CREATE OR REPLACE TABLE route_rand_1(n BIGINT)

statement ok
CREATE OR REPLACE TABLE route_rand_2(n BIGINT)

# The INTO clauses of one WHEN receive the same rows, even for a volatile condition.
statement ok
INSERT ALL
    WHEN rand() < 0.5 THEN INTO route_rand_1 INTO route_rand_2
SELECT number AS n FROM numbers(10000)

query B
SELECT (SELECT count(*) FROM route_rand_1) = (SELECT count(*) FROM route_rand_2)
    AND (SELECT count(*) FROM route_rand_1) = (SELECT count(*) FROM route_rand_1 WHERE n IN (SELECT n FROM route_rand_2))
----
1

statement ok
TRUNCATE TABLE route_rand_1

statement ok
TRUNCATE TABLE route_rand_2

# INSERT FIRST with a volatile condition puts each row into exactly one branch.
statement ok
INSERT FIRST
    WHEN rand() < 0.5 THEN INTO route_rand_1
    ELSE INTO route_rand_2
SELECT number AS n FROM numbers(10000)

query II
SELECT
    (SELECT count(*) FROM route_rand_1) + (SELECT count(*) FROM route_rand_2),
    (SELECT count(*) FROM route_rand_1 WHERE n IN (SELECT n FROM route_rand_2))
----
10000 0

# AND/OR inside a WHEN condition short-circuit like a WHERE filter.
statement ok
CREATE OR REPLACE TABLE route_guard_src(x INT)

statement ok
INSERT INTO route_guard_src VALUES (0), (3)

statement ok
CREATE OR REPLACE TABLE route_guard_1(x INT)

statement ok
CREATE OR REPLACE TABLE route_guard_2(x INT)

query I
INSERT ALL WHEN x <> 0 AND 3 / x = 1 THEN INTO route_guard_1 SELECT x FROM route_guard_src
----
1

query II
INSERT FIRST
    WHEN x = 0 OR 3 / x = 1 THEN INTO route_guard_2
    ELSE INTO route_guard_1
SELECT x FROM route_guard_src
----
0 2

query I
SELECT x FROM route_guard_2 ORDER BY x
----
0
3

statement ok
TRUNCATE TABLE route_guard_1

statement ok
TRUNCATE TABLE route_guard_2

# INSERT FIRST evaluates a WHEN only for the rows that no earlier WHEN has taken.
query II
INSERT FIRST
    WHEN x = 0 THEN INTO route_guard_1
    WHEN 3 / x = 1 THEN INTO route_guard_2
SELECT x FROM route_guard_src
----
1 1

query II
SELECT (SELECT x FROM route_guard_1), (SELECT x FROM route_guard_2)
----
0 3

statement ok
DROP TABLE route_guard_src

statement ok
DROP TABLE route_guard_1

statement ok
DROP TABLE route_guard_2

