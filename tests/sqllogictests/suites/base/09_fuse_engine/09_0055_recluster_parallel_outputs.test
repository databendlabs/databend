# Parallel sorted outputs of a recluster MergeBlocks task: with
# recluster_depth_reduction set, a task over many overlapping blocks writes several
# sorted outputs without one global order. The data must stay intact.
#
# 40 blocks overlap everywhere. At 87% with eight threads, the task writes
# 1 + 13% * 39 = 6 sorted outputs. Blocks of one output do not overlap except on a key
# shared across a cut, so the depth left behind is at most twice the outputs.

statement ok
DROP DATABASE IF EXISTS db_09_0055_parallel

statement ok
CREATE DATABASE db_09_0055_parallel

statement ok
USE db_09_0055_parallel

statement ok
set max_threads = 8

statement ok
CREATE TABLE t(k int not null, payload string not null) CLUSTER BY(k) row_per_block=1000

statement ok
INSERT INTO t SELECT (number * 37 + 0) % 1000, concat('p', to_string(number)) FROM numbers(1000)

