query III
SELECT count(), sum(k), count(DISTINCT payload) FROM t
----
40000 19980000 1000

statement ok
set recluster_depth_reduction = 87

statement ok
ALTER TABLE t RECLUSTER

query III
SELECT count(), sum(k), count(DISTINCT payload) FROM t
----
40000 19980000 1000

query II
SELECT k, count() FROM t WHERE k IN (0, 499, 999) GROUP BY k ORDER BY k
----
0 40
499 40
999 40

query I
SELECT (info:max_depth::INT <= 12)::INT FROM clustering_information('db_09_0055_parallel','t')
----
1

statement ok
ALTER TABLE t RECLUSTER FINAL

query III
SELECT count(), sum(k), count(DISTINCT payload) FROM t
----
40000 19980000 1000

query I
SELECT (info:max_depth::INT <= 12)::INT FROM clustering_information('db_09_0055_parallel','t')
----
1

# 100 removes the whole depth, the same as the merge into one global order.
statement ok
set recluster_depth_reduction = 100

statement ok
INSERT INTO t SELECT number, 'extra' FROM numbers(10)

statement ok
ALTER TABLE t RECLUSTER FINAL

query II
SELECT count(), sum(k) FROM t
----
40010 19980045

statement ok
unset recluster_depth_reduction

statement ok
unset max_threads

statement ok
DROP DATABASE db_09_0055_parallel
