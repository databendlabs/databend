query I
select count(*) from t where n <> ''
----
30000

query I
select count(*) from t where n = ''
----
10000

query I
select count(*) from t where octet_length(n) > 3
----
10000

query I
select count(*) from t where n is null
----
10000

query I
select count(*) from t where n <> '' or s = ''
----
35333

query I
select count(*) from t where s <> '' and n = ''
----
7334

query I
select count(*) from t where s <> '' and s like '%example%'
----
6000

query TI
select s, count(*) from t where s <> '' and id < 30000 and octet_length(s) < 4 group by s order by s
----
k0 857
k1 858
