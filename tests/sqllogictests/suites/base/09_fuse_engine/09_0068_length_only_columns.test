# A string column that a prewhere filter reads only through `octet_length`, `= ''` and `<> ''`,
# and that the scan does not output, is read as the lengths of its values only.
# Blocks of 10000 rows: `s` has empty, inline (up to 12 bytes), long and non-ASCII values, `n`
# nulls and empty values; the last blocks have few distinct values (dictionary pages).

statement ok
create or replace database test_length_only

statement ok
use test_length_only

statement ok
create or replace table t(id int, s string, n string null) row_per_block = 10000

statement ok
insert into t select number, case when number % 5 = 0 then '' when number % 5 = 1 then concat('k', (number % 7)::string) when number % 5 = 2 then concat('https://example.com/', number::string) when number % 5 = 3 then concat('数据库-', (number % 11)::string) else repeat('x', number % 30) end, case when number % 6 = 0 then null when number % 6 = 1 then '' else concat('v', (number % 50)::string) end from numbers(30000)

statement ok
insert into t select number + 30000, case when number % 3 = 0 then '' else concat('w', (number % 4)::string) end, case when number % 4 = 0 then null when number % 4 = 1 then '' else 'abcdefghijklmnop' end from numbers(20000)

query I
select count(*) from t where s <> ''
----
37333

query I
select count(*) from t where s = ''
----
12667

query I
select count(*) from t where '' = s
----
12667

query I
select count(*) from t where not (s <> '')
----
12667

query I
select count(*) from t where octet_length(s) > 20
----
8000

query I
select count(*) from t where s <> '' and octet_length(s) < 13
----
27333

query II
select count(*), sum(id) from t where s <> '' and id % 3 = 1
----
14667 386670000

query I
select id from t where s = '' and id % 997 = 0 order by id
----
0
4985
9970
14955
19940
24925
29910
32901
35892
38883
41874
44865
47856

query IT
select id, concat('n=', n) from t where s <> '' and id % 1999 = 0 order by id
----
