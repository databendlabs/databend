UNSET (nested_loop_join_threshold, inlist_runtime_filter_threshold, join_runtime_filter_selectivity_threshold, enforce_shuffle_join)

statement ok
REPLACE INTO float_nan ON (f, d) VALUES (5, 'nan', 'nan', 'nan', 'k')

query I
SELECT id FROM float_nan ORDER BY id
----
