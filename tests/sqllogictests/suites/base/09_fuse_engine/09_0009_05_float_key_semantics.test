MERGE INTO float_nan USING (SELECT 7 AS id, -('nan'::FLOAT) AS f, sqrt(-1) AS d, 'nan'::DOUBLE AS n, 'm' AS s) src
ON float_nan.f = src.f AND float_nan.d = src.d
WHEN MATCHED THEN UPDATE SET float_nan.s = src.s
WHEN NOT MATCHED THEN INSERT VALUES (src.id, src.f, src.d, src.n, src.s)

