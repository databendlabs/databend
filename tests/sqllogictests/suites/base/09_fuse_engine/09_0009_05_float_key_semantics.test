# Structured row hashes must distinguish NULL positions, including NULL from zero.
statement ok
CREATE TABLE signed_zero_tuple_keys(id INT, k TUPLE(a INT NULL, b INT NULL)) bloom_index_columns=''

statement ok
REPLACE INTO signed_zero_tuple_keys ON(k) VALUES (1, (NULL, 1)), (2, (1, NULL)), (3, (0, 1))

query I
SELECT id FROM signed_zero_tuple_keys ORDER BY id
----
1
2
3

statement error .*duplicated data detected.*
REPLACE INTO signed_zero_tuple_keys ON(k) VALUES (4, (NULL, 1)), (5, (NULL, 1))

statement ok
DROP TABLE signed_zero_tuple_keys

statement ok
CREATE TABLE signed_zero_array_keys(id INT, k ARRAY(INT NULL)) bloom_index_columns=''

statement ok
REPLACE INTO signed_zero_array_keys ON(k) VALUES (1, [NULL, 1]), (2, [1, NULL]), (3, [0, 1])

query I
SELECT id FROM signed_zero_array_keys ORDER BY id
----
1
2
3

statement error .*duplicated data detected.*
REPLACE INTO signed_zero_array_keys ON(k) VALUES (4, [NULL, 1]), (5, [NULL, 1])

statement ok
DROP TABLE signed_zero_array_keys
