# run-with-settings: enable_replace_into_partitioning=0

# Regression for #20790: without partitioning, REPLACE does not compute bloom
# hashes. Existing blocks with bloom indexes must not trigger bloom pruning.
# Run with both the default partitioned path and the non-partitioned path.
statement ok
CREATE OR REPLACE DATABASE replace_into_issue_20790

statement ok
USE replace_into_issue_20790

# The cluster key is also the on-conflict key.
statement ok
CREATE TABLE cluster_by_id (id INT, v INT) CLUSTER BY (id)

statement ok
INSERT INTO cluster_by_id VALUES (1, 10), (2, 20)

# Ensure the fixture has bloom indexes: single-row blocks would mask the panic.
query B
SELECT count(*) > 0 FROM fuse_block('replace_into_issue_20790', 'cluster_by_id') WHERE bloom_filter_location IS NOT NULL
----
1

statement ok
REPLACE INTO cluster_by_id ON (id) VALUES (1, 11)

query II
SELECT * FROM cluster_by_id ORDER BY id
----
1 11
2 20

# Replace an existing key and append a new key in the same statement.
statement ok
REPLACE INTO cluster_by_id ON (id) VALUES (2, 22), (3, 30)

query II
SELECT * FROM cluster_by_id ORDER BY id
----
1 11
2 22
3 30

# The cluster key does not have to be an on-conflict key to trigger the bug.
statement ok
CREATE TABLE cluster_by_v (id INT, v INT) CLUSTER BY (v)

statement ok
INSERT INTO cluster_by_v VALUES (1, 10), (2, 20)

query B
SELECT count(*) > 0 FROM fuse_block('replace_into_issue_20790', 'cluster_by_v') WHERE bloom_filter_location IS NOT NULL
----
1

statement ok
REPLACE INTO cluster_by_v ON (id) VALUES (1, 11)

query II
SELECT * FROM cluster_by_v ORDER BY id
----
1 11
2 20

statement ok
REPLACE INTO cluster_by_v ON (id) VALUES (2, 22), (3, 30)

query II
SELECT * FROM cluster_by_v ORDER BY id
----
1 11
2 22
3 30

statement ok
DROP DATABASE replace_into_issue_20790
