statement ok
CREATE OR REPLACE DATABASE test_hilbert

statement ok
USE test_hilbert

statement ok
CREATE OR REPLACE TABLE t_direct(a int, b int) CLUSTER BY HILBERT(a, b) row_per_block=2 block_per_segment=2

statement ok
CREATE OR REPLACE TABLE t_expr(a int, b string, c int) CLUSTER BY HILBERT(substring(b, 1, 2), c + 1) row_per_block=2 block_per_segment=2

statement ok
CREATE OR REPLACE TABLE t_string(b string, c int) CLUSTER BY HILBERT(b, c) row_per_block=2 block_per_segment=2

statement ok
CREATE OR REPLACE TABLE t_recluster(b int, c int) CLUSTER BY HILBERT(b, c) row_per_block=2 block_per_segment=2 recluster_depth=8

statement ok
CREATE OR REPLACE TABLE t_partitioned_recluster(p int, b int, c int) PARTITION BY (p) CLUSTER BY HILBERT(b, c) row_per_block=2 block_per_segment=10 recluster_depth=8

statement ok
CREATE OR REPLACE TABLE t_small_compact(b int, c int) CLUSTER BY HILBERT(b, c) row_per_block=100 block_per_segment=100 recluster_depth=8

statement ok
CREATE OR REPLACE TABLE t_alter(a int, b int) CLUSTER BY LINEAR(a)

statement ok
ALTER TABLE t_alter CLUSTER BY HILBERT(a, b)

