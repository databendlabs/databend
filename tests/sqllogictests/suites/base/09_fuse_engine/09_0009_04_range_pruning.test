# for issue which addressed in PR #10070 (https://github.com/datafuselabs/databend/pull/10070)
statement ok
DROP DATABASE IF EXISTS db_09_0009_04

statement ok
CREATE DATABASE db_09_0009_04

statement ok
USE db_09_0009_04

statement ok
create table range_test_t(a int)

statement ok
insert into range_test_t values(1),(2)

statement ok
alter table range_test_t add column b int default 0

statement ok
insert into range_test_t values(3,3),(4,4)

query II
select * from range_test_t where b=0 order by a
----
1 0
2 0

statement ok
optimize table range_test_t compact

query II
select * from range_test_t where b=0 order by a
----
1 0
2 0

statement ok
insert into range_test_t (a) select number from numbers(10000);


query I
select max(a) from range_test_t where a >= 4000 and a <= 5000;
----
5000

## issue:https://github.com/datafuselabs/databend/issues/15170

statement ok
create or replace table test_range_array(doc varchar, embedding ARRAY(FLOAT32 not null));

statement ok
insert into test_range_array(doc)values('xx');

query I
select count() from test_range_array where embedding is not null;
----
0

query I
select count() from test_range_array where embedding is null;
----
1

# Learn existing segment ranges without ANALYZE, COMPACT or data rewrites.
statement ok
SET enable_auto_analyze = 0

statement ok
SET enable_compact_after_write = 0

statement ok
SET auto_compaction_imperfect_blocks_threshold = 0

statement ok
SET enable_prune_cache = 0

statement ok
CREATE TABLE ordered_segments(k BIGINT NULL, payload BIGINT) CLUSTER BY(k) block_per_segment=1

statement ok
INSERT INTO ordered_segments VALUES (1, 1)

statement ok
INSERT INTO ordered_segments VALUES (2, 2)

statement ok
INSERT INTO ordered_segments VALUES (3, 3)

statement ok
INSERT INTO ordered_segments VALUES (4, 4)

# Normal reads learn the layout; repeats must keep returning the same rows.
query I rowsort
SELECT payload FROM ordered_segments WHERE k BETWEEN 2 AND 3
----
2
3

query I rowsort
SELECT payload FROM ordered_segments WHERE k BETWEEN 2 AND 3
----
2
3

query I rowsort
SELECT payload FROM ordered_segments WHERE k = 2 OR payload = 4
----
2
4

# A new snapshot must not inherit stale positions; NULL remains an unread hole.
statement ok
INSERT INTO ordered_segments VALUES (NULL, 5)

query I
SELECT payload FROM ordered_segments WHERE k IS NULL
----
5

query I rowsort
SELECT payload FROM ordered_segments WHERE k = 2 OR k IS NULL
----
2
5

statement ok
UNSET (enable_auto_analyze, enable_compact_after_write, auto_compaction_imperfect_blocks_threshold, enable_prune_cache)

statement ok
DROP DATABASE db_09_0009_04
