# The table summary keeps a column range only if it covers every row.

statement ok
set enable_compact_after_write = 0

# A batch-written string with no upper bound within STATS_TRUNCATE_LEN leaves
# its block without statistics (#21130). The table range must not come from
# the other blocks only, or REPLACE dismisses a real conflict on it.
statement ok
set enable_block_stream_write = 0

statement ok
create or replace table summary_string_coverage (id int, s string stats_truncate_len 4)
  storage_format = 'parquet'

statement ok
insert into summary_string_coverage values (1, 'abc')

statement ok
insert into summary_string_coverage values (2, repeat(char(0x10FFFF), 4) || 'z')

statement ok
replace into summary_string_coverage on (s) values (3, repeat(char(0x10FFFF), 4) || 'z')

query I
select id from summary_string_coverage order by id
----
1
3

statement ok
drop table summary_string_coverage

statement ok
unset enable_block_stream_write

# ADD COLUMN records the default range of the old rows, so appends do not
# have to infer it, and compaction keeps it although the old segment has none.
statement ok
create or replace table summary_added_column (a int)
  storage_format = 'parquet' segment_format = 'row_oriented' block_per_segment = 10

statement ok
insert into summary_added_column values (1)

statement ok
alter table summary_added_column add column b int not null default 7

statement ok
alter table summary_added_column add column c int null

query TI
select column_name, null_count from fuse_statistic('default', 'summary_added_column') order by column_name
----
a 0
b 0
c 1

statement ok
insert into summary_added_column values (2, 100, null)

statement ok
optimize table summary_added_column compact segment

query III
select segment_count, block_count, row_count from fuse_snapshot('default', 'summary_added_column') limit 1
----
1 2 2

query T
select column_name from fuse_statistic('default', 'summary_added_column') order by column_name
----
a
b
c

# ANALYZE keeps the range that the old segment cannot provide.
statement ok
analyze table summary_added_column

query T
select column_name from fuse_statistic('default', 'summary_added_column') order by column_name
----
a
b
c

# The rewritten segment mixes the old block with an updated one and has no
# range for b or c. The table range must not keep b in [7, 100], or REPLACE
# misses 200.
statement ok
update summary_added_column set b = 200 where a = 2

query T
select column_name from fuse_statistic('default', 'summary_added_column') order by column_name
----
a

statement ok
replace into summary_added_column on (b) values (3, 200, null)

query II
select a, b from summary_added_column order by a
----
1 7
3 200

statement ok
drop table summary_added_column

# A non-deterministic default is filled by rewriting every row, so the
# rewritten segments describe the whole table.
statement ok
create or replace table summary_rewritten_column (a int) storage_format = 'parquet'

statement ok
insert into summary_rewritten_column values (1), (2)

statement ok
alter table summary_rewritten_column add column ts timestamp default now()

query T
select column_name from fuse_statistic('default', 'summary_rewritten_column') order by column_name
----
a
ts

statement ok
drop table summary_rewritten_column

statement ok
unset enable_compact_after_write
