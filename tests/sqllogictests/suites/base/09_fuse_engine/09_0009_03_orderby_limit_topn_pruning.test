# orderby + limit TopN pruning

statement ok
DROP DATABASE IF EXISTS db_09_0009_03

statement ok
CREATE DATABASE db_09_0009_03

statement ok
USE db_09_0009_03

statement ok
create table t(a Int64)

statement ok
insert into t select * from numbers(100);

statement ok
insert into t select * from numbers(100);

statement ok
insert into t select * from numbers(100);

query I
select * from t order by a limit 5;
----
0
0
0
1
1

query I
select * from t order by a desc limit 5;
----
99
99
99
98
98

statement ok
DROP TABLE t

# https://github.com/databendlabs/databend/issues/20612
# blocks [1, 4], [2], [3]: the range of the first block covers the later blocks
statement ok
create table t1(a Int64 not null)

statement ok
insert into t1 values (1), (4);

statement ok
insert into t1 values (2);

statement ok
insert into t1 values (3);

query I
select a from t1 order by a limit 3;
----
1
2
3

statement ok
create table t2(a Int64 not null)

statement ok
insert into t2 values (1), (4);

statement ok
insert into t2 values (3);

statement ok
insert into t2 values (2);

query I
select a from t2 order by a desc limit 3;
----
4
3
2

statement ok
DROP TABLE t1

statement ok
DROP TABLE t2

# Same interleaved block ranges, but with enough rows for the runtime TopN
# filter to be registered (read rows >= 2 * (limit + offset)).
statement ok
set enable_top_n = 1

# Block layout: [1, 1002], [2], [3], then filler blocks that are entirely worse.
statement ok
create table t3(a Int64 not null) row_per_block = 5

statement ok
insert into t3 values (1), (1000), (1001), (1002);

statement ok
insert into t3 values (2);

statement ok
insert into t3 values (3);

statement ok
insert into t3 select number + 2000 from numbers(50);

query I
select a from t3 order by a limit 3;
----
1
2
3

query I
select a from t3 order by a limit 2 offset 1;
----
2
3

# The Sort + Limit path is the differential oracle.
query I
settings (enable_top_n = 0) select a from t3 order by a limit 3;
----
1
2
3

# Mirrored DESC layout: [-3, 10], [9], [8], then filler blocks below.
statement ok
create table t4(a Int64 not null) row_per_block = 5

statement ok
insert into t4 values (10), (-1), (-2), (-3);

statement ok
insert into t4 values (9);

statement ok
insert into t4 values (8);

statement ok
insert into t4 select number - 2000 from numbers(50);

query I
select a from t4 order by a desc limit 3;
----
10
9
8

query I
settings (enable_top_n = 0) select a from t4 order by a desc limit 3;
----
10
9
8

statement ok
DROP TABLE t3

statement ok
DROP TABLE t4

statement ok
unset enable_top_n

statement ok
DROP DATABASE db_09_0009_03
