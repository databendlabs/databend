# Cross-method compatibility in the other direction: vertical MergeBlocks must
# consume blocks previously produced by the horizontal recluster path.
statement ok
create table t_cross_method(k int, tie string, payload string) cluster by(k, tie) row_per_block=8 block_per_segment=2

statement ok
insert into t_cross_method values (4, 'd', 'horizontal-d'), (1, 'a', 'horizontal-a'), (3, 'c', 'horizontal-c'), (2, 'b', 'horizontal-b')

statement ok
alter table t_cross_method recluster final

statement ok
set recluster_method = 'vertical'

statement ok
