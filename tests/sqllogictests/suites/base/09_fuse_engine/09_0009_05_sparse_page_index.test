# Sparse page index: verify cluster-key predicates over a table written with `index_granularity`
# return correct results. Exercises the write (granule split + index file) and read (byte-range
# narrowing) paths end to end.

statement ok
DROP DATABASE IF EXISTS db_09_0009_05

statement ok
CREATE DATABASE db_09_0009_05

statement ok
USE db_09_0009_05

# Clustered table with a small granule so a single block spans many granules.
statement ok
CREATE TABLE spi_t(a int, b string) CLUSTER BY (a) index_granularity = 100

statement ok
INSERT INTO spi_t SELECT number, concat('v', to_string(number)) FROM numbers(10000)

# Point lookup on the cluster key: only the matching granule's bytes should be read.
query IT
SELECT * FROM spi_t WHERE a = 4242
----
4242 v4242

# Range fully inside one granule.
query III
SELECT count(*), min(a), max(a) FROM spi_t WHERE a >= 500 AND a < 600
----
100 500 599

# Range spanning several granules.
query I
SELECT count(*) FROM spi_t WHERE a >= 1234 AND a <= 5678
----
4445

# Predicate matching the very first rows.
query I
SELECT count(*) FROM spi_t WHERE a < 50
----
50

# Predicate matching the tail (partial last granule territory).
query I
SELECT count(*) FROM spi_t WHERE a >= 9950
----
50

# Predicate that matches nothing: whole-block skip.
query I
SELECT count(*) FROM spi_t WHERE a >= 100000
----
0

# Aggregate over the full table is unaffected by narrowing (no cluster-key filter).
query II
SELECT count(*), sum(a) FROM spi_t
----
10000 49995000

# Non-cluster-key predicate must still return correct rows (narrowing must not apply or must be safe).
query IT
SELECT * FROM spi_t WHERE b = 'v7777'
----
7777 v7777

# Multiple disjoint ranges via OR over the cluster key.
query I
SELECT count(*) FROM spi_t WHERE (a >= 100 AND a < 200) OR (a >= 9000 AND a < 9100)
----
200

# IN list bound as `contains(<array>, a)`: interior granules between the listed
# values are pruned.
query I
SELECT count(*) FROM spi_t WHERE a IN (42, 424, 4242, 9942)
----
4

query IT
SELECT * FROM spi_t WHERE a IN (123, 4321, 6789, 9876) ORDER BY a
----
123 v123
4321 v4321
6789 v6789
9876 v9876

# Small IN list stays a disjunction of equalities.
query I
SELECT count(*) FROM spi_t WHERE a = 77 OR a = 8888
----
2

# Cost-based IO coalescing on/off/aggressive must not change results.
statement ok
SET storage_io_merge_equivalent_bytes = 0

query I
SELECT count(*) FROM spi_t WHERE a IN (42, 424, 4242, 9942)
----
4

statement ok
SET storage_io_merge_equivalent_bytes = 4194304

query IT
SELECT * FROM spi_t WHERE a IN (123, 9876) ORDER BY a
----
123 v123
9876 v9876

statement ok
UNSET storage_io_merge_equivalent_bytes

# Narrowed read split into <= max_block_size sub-blocks: with a tiny max_block_size the surviving
# granule run is read as many row-bounded DataBlocks instead of one. Results must stay correct.
statement ok
SET max_block_size = 128

# The cluster-key predicate selects every indexed granule. It must still use bounded granule groups
# rather than falling back to one complete-block read.
query II
SELECT count(*), sum(a) FROM spi_t WHERE a >= 0
----
10000 49995000

query I
SELECT count(*) FROM spi_t WHERE a >= 1234 AND a <= 5678
----
4445

query III
SELECT count(*), min(a), max(a) FROM spi_t WHERE a >= 500 AND a < 3000
----
2500 500 2999

query IT
SELECT * FROM spi_t WHERE a = 4242
----
4242 v4242

statement ok
UNSET max_block_size

# After reclustering, results must remain correct.
statement ok
ALTER TABLE spi_t RECLUSTER FINAL

query IT
SELECT * FROM spi_t WHERE a = 4242
----
4242 v4242

query I
SELECT count(*) FROM spi_t WHERE a >= 1234 AND a <= 5678
----
4445

# ALTER CLUSTER KEY: existing blocks keep the old key id and old-key-sorted granule mins. The
# sparse pruner must NOT narrow them with the new-key predicate, or it would drop matching rows.
# Results must stay correct on the not-yet-reclustered data.
statement ok
ALTER TABLE spi_t CLUSTER BY (b)

query IT
SELECT * FROM spi_t WHERE a = 4242
----
4242 v4242

query I
SELECT count(*) FROM spi_t WHERE a >= 1234 AND a <= 5678
----
4445

query I
SELECT count(*) FROM spi_t WHERE a < 50
----
50

# A predicate on the new cluster key must also be correct on the old-key blocks.
query IT
SELECT * FROM spi_t WHERE b = 'v7777'
----
7777 v7777

# After reclustering to the new key, queries remain correct.
statement ok
ALTER TABLE spi_t RECLUSTER FINAL

query IT
SELECT * FROM spi_t WHERE a = 4242
----
4242 v4242

query I
SELECT count(*) FROM spi_t WHERE a >= 1234 AND a <= 5678
----
4445

# Internal columns under sparse-page-index narrowing: a cluster-key predicate narrows the read to a
# granule sub-run whose first row is at block position `base > 0`. `_row_id` / `_base_row_id` encode
# the block-relative position, so they must still match what a full (unnarrowed) scan assigns to the
# same row. A fresh single-block, cluster-ordered table keeps positions deterministic.
statement ok
CREATE TABLE spi_row(a int, b string) CLUSTER BY (a) index_granularity = 100

statement ok
INSERT INTO spi_row SELECT number, concat('v', to_string(number)) FROM numbers(5000)

# Every narrowed `_row_id` (cluster-key predicate) must appear in the full-scan `_row_id` set.
# Intersection size == number of matching rows proves the base offset was applied.
query I
SELECT count(*) FROM (
  SELECT _row_id FROM spi_row WHERE a >= 2000 AND a < 2500
  INTERSECT
  SELECT _row_id FROM spi_row
)
----
500

# Same, but forcing sub-run splitting so the base offset varies per emitted block.
statement ok
SET max_block_size = 64

query I
SELECT count(*) FROM (
  SELECT _row_id FROM spi_row WHERE a >= 2000 AND a < 2500
  INTERSECT
  SELECT _row_id FROM spi_row
)
----
500

# `_base_row_id` (string form) must likewise agree across narrowed and full reads.
query I
SELECT count(*) FROM (
  SELECT _base_row_id FROM spi_row WHERE a >= 100 AND a < 900
  INTERSECT
  SELECT _base_row_id FROM spi_row
)
----
800

statement ok
UNSET max_block_size

statement ok
DROP TABLE spi_row

# Regression: a min-only sparse index is only sound when granules do not overlap. Writing rows in
# an order that would put a large value inside an early granule (e.g. [1,500,3,4] at granularity 2)
# must NOT drop rows. The clustered write path sorts before serializing, so `a = 500` still finds
# its row; the per-granule overlap guard additionally prevents emitting a corrupt index.
statement ok
CREATE TABLE spi_overlap(a int) CLUSTER BY (a) index_granularity = 2

statement ok
INSERT INTO spi_overlap VALUES (1),(500),(3),(4)

query I
SELECT count(*) FROM spi_overlap WHERE a = 500
----
1

query I
SELECT count(*) FROM spi_overlap WHERE a = 3
----
1

query I
SELECT count(*) FROM spi_overlap WHERE a = 4
----
1

query I
SELECT count(*) FROM spi_overlap WHERE a = 1
----
1

query I
SELECT count(*) FROM spi_overlap WHERE a >= 5 AND a <= 499
----
0

query I
SELECT count(*) FROM spi_overlap
----
4

statement ok
DROP TABLE spi_overlap

# A table with `index_granularity` but no cluster key: the writer records page offsets (offset-only
# index, no min/max), so reads stream the block page-wise but never prune. Results must be correct
# for any predicate, and a tiny max_block_size must still emit correct row-bounded sub-blocks.
statement ok
CREATE TABLE spi_nocluster(a int, b string) index_granularity = 100

statement ok
INSERT INTO spi_nocluster SELECT number, concat('v', to_string(number)) FROM numbers(10050)

query IT
SELECT * FROM spi_nocluster WHERE a = 4242
----
4242 v4242

query II
SELECT count(*), sum(a) FROM spi_nocluster
----
10050 50496225

query I
SELECT count(*) FROM spi_nocluster WHERE a >= 1234 AND a <= 5678
----
4445

statement ok
SET max_block_size = 128

# With no pruning ranges, the complete indexed block is read as bounded granule groups. The final
# 50 rows exercise a partial tail granule.
query II
SELECT count(*), sum(a) FROM spi_nocluster
----
10050 50496225

# Repeat the full scan so partial granule arrays cannot corrupt the complete-column cache key.
query II
SELECT count(*), sum(a) FROM spi_nocluster
----
10050 50496225

# A predicate whose granule selection covers the full block must use the same bounded read path.
query II
SELECT count(*), sum(a) FROM spi_nocluster WHERE a >= 0
----
10050 50496225

# Projection and internal row identifiers must remain correct across emitted groups.
query II
SELECT count(*), sum(a) FROM (SELECT a FROM spi_nocluster)
----
10050 50496225

query II
SELECT count(DISTINCT _row_id), count(*) FROM spi_nocluster
----
10050 10050

query I
SELECT count(*) FROM spi_nocluster WHERE a >= 1234 AND a <= 5678
----
4445

query IT
SELECT * FROM spi_nocluster WHERE a = 4242
----
4242 v4242

statement ok
UNSET max_block_size

statement ok
DROP TABLE spi_nocluster

# Regression: SQL binding may retain a String literal for an equality against a nullable integer
# cluster key. The sparse pruner must safely normalize the literal and still narrow granules.
statement ok
CREATE TABLE spi_implicit_string(key_id int null, payload string) CLUSTER BY (key_id) row_per_block = 10000 index_granularity = 100

statement ok
INSERT INTO spi_implicit_string SELECT number, concat('v', to_string(number)) FROM numbers(10000)

query IT
SELECT key_id, payload FROM spi_implicit_string WHERE key_id = '3167'
----
3167 v3167

query T
EXPLAIN SELECT key_id, payload FROM spi_implicit_string WHERE key_id = '3167'
----
<slt:ignore>granule pruning: 100 to 2<slt:ignore>

statement ok
DROP TABLE spi_implicit_string

statement ok
DROP DATABASE db_09_0009_05
