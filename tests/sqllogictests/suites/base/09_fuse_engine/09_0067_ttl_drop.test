# COMPACT and RECLUSTER drop the blocks of the segments they scan whose
# statistics prove every row expired by the table TTL, like ClickHouse TTLDrop
# merges. Tasks are built on the other blocks only. Partially expired blocks,
# and blocks with NULL TTL values, are kept.

statement ok
create or replace database db_09_0067

statement ok
use db_09_0067

statement ok
set enable_compact_after_write = 0

statement ok
set max_threads = 1

# COMPACT: an expired segment is dropped; NULL and partially expired blocks are kept.
statement ok
CREATE TABLE t_compact (id INT, expires TIMESTAMP) TTL expires

statement ok
INSERT INTO t_compact VALUES (1, '2000-01-01 00:00:00'), (2, '2000-01-02 00:00:00')

statement ok
INSERT INTO t_compact VALUES (3, '2099-01-01 00:00:00')

statement ok
INSERT INTO t_compact VALUES (4, '2000-01-01 00:00:00'), (5, NULL)

statement ok
INSERT INTO t_compact VALUES (6, '2000-01-01 00:00:00'), (7, '2099-01-01 00:00:00')

statement ok
OPTIMIZE TABLE t_compact COMPACT

query I
SELECT id FROM t_compact ORDER BY id
----
3
4
5
6
7

# The ordinary compaction still ran on what was left.
query I
SELECT count(*) FROM fuse_block('db_09_0067', 't_compact')
----
1

# An expired block is dropped from its segment, even when nothing needs compaction.
statement ok
CREATE TABLE t_block (id INT, expires TIMESTAMP) TTL expires + INTERVAL 1 DAY ROW_PER_BLOCK = 2

statement ok
INSERT INTO t_block VALUES (1, '2000-01-01 00:00:00'), (2, '2000-01-02 00:00:00'), (3, '2099-01-01 00:00:00'), (4, '2099-01-02 00:00:00')

query I
SELECT count(*) FROM fuse_block('db_09_0067', 't_block')
----
2

statement ok
OPTIMIZE TABLE t_block COMPACT

query I
SELECT id FROM t_block ORDER BY id
----
3
4

query II
SELECT count(*), sum(row_count) FROM fuse_block('db_09_0067', 't_block')
----
1 2

# In a compacted group, the expired block is dropped and the others are merged.
statement ok
CREATE TABLE t_compact_group (id INT, expires TIMESTAMP, n INT) TTL expires

statement ok
INSERT INTO t_compact_group VALUES (1, '2099-01-01 00:00:00', 10)

statement ok
INSERT INTO t_compact_group VALUES (2, '2000-01-01 00:00:00', 20)

statement ok
INSERT INTO t_compact_group VALUES (3, '2099-01-01 00:00:00', 30)

statement ok
OPTIMIZE TABLE t_compact_group COMPACT SEGMENT

query II
SELECT count(*), sum(block_count) FROM fuse_segment('db_09_0067', 't_compact_group')
----
1 3

statement ok
OPTIMIZE TABLE t_compact_group COMPACT

query I
SELECT id FROM t_compact_group ORDER BY id
----
1
3

query II
SELECT count(*), sum(row_count) FROM fuse_block('db_09_0067', 't_compact_group')
----
1 2

query IIII
SELECT count(*), count(n), min(n), max(n) FROM t_compact_group
----
2 2 10 30

# A DATE TTL column uses the same cutoff.
statement ok
CREATE TABLE t_date (id INT, expires DATE) TTL expires

statement ok
INSERT INTO t_date VALUES (1, '2000-01-01')

statement ok
INSERT INTO t_date VALUES (2, '2099-01-01')

statement ok
OPTIMIZE TABLE t_date COMPACT

query I
SELECT id FROM t_date ORDER BY id
----
2

# Dropping blocks written before ADD COLUMN keeps MIN/MAX and COUNT exact.
statement ok
CREATE TABLE t_add_column (id INT, expires TIMESTAMP) TTL expires

statement ok
INSERT INTO t_add_column VALUES (1, '2099-01-01 00:00:00')

statement ok
ALTER TABLE t_add_column ADD COLUMN n INT DEFAULT 10

statement ok
INSERT INTO t_add_column VALUES (2, '2000-01-01 00:00:00', 20), (3, '2000-01-01 00:00:00', 30)

statement ok
OPTIMIZE TABLE t_add_column COMPACT

query IIIIII
SELECT count(*), count(n), min(n), max(n), min(n + 0), max(n + 0) FROM t_add_column
----
1 1 10 10 10 10

# An explicit transaction does not drop: its commit is deferred.
statement ok
CREATE TABLE t_txn (id INT, expires TIMESTAMP) TTL expires

statement ok
INSERT INTO t_txn VALUES (1, '2000-01-01 00:00:00')

statement ok
INSERT INTO t_txn VALUES (2, '2099-01-01 00:00:00')

statement ok
BEGIN

statement ok
OPTIMIZE TABLE t_txn COMPACT

statement ok
COMMIT

query I
SELECT id FROM t_txn ORDER BY id
----
1
2

# RECLUSTER and RECLUSTER FINAL drop; RECLUSTER WHERE does not apply TTL.
statement ok
CREATE TABLE t_recluster_where (id INT, expires TIMESTAMP) CLUSTER BY (id) TTL expires

statement ok
INSERT INTO t_recluster_where VALUES (1, '2000-01-01 00:00:00'), (3, '2000-01-01 00:00:00')

statement ok
INSERT INTO t_recluster_where VALUES (2, '2099-01-01 00:00:00'), (4, '2099-01-01 00:00:00')

statement ok
ALTER TABLE t_recluster_where RECLUSTER WHERE id > 0

query I
SELECT id FROM t_recluster_where ORDER BY id
----
1
2
3
4

statement ok
CREATE TABLE t_recluster (id INT, expires TIMESTAMP) CLUSTER BY (id) TTL expires

statement ok
INSERT INTO t_recluster VALUES (1, '2000-01-01 00:00:00'), (3, '2000-01-01 00:00:00')

statement ok
INSERT INTO t_recluster VALUES (2, '2099-01-01 00:00:00'), (4, '2099-01-01 00:00:00')

statement ok
INSERT INTO t_recluster VALUES (5, '2099-01-01 00:00:00'), (6, '2000-01-01 00:00:00')

statement ok
ALTER TABLE t_recluster RECLUSTER

query I
SELECT id FROM t_recluster ORDER BY id
----
2
4
5
6

# In a segment RECLUSTER selects, the expired block forms no task and is dropped.
statement ok
CREATE TABLE t_recluster_block (id INT, expires TIMESTAMP) CLUSTER BY (id) TTL expires

statement ok
INSERT INTO t_recluster_block VALUES (1, '2000-01-01 00:00:00'), (5, '2000-01-01 00:00:00')

statement ok
INSERT INTO t_recluster_block VALUES (2, '2099-01-01 00:00:00'), (6, '2099-01-01 00:00:00')

statement ok
INSERT INTO t_recluster_block VALUES (3, '2099-01-01 00:00:00'), (7, '2099-01-01 00:00:00')

statement ok
OPTIMIZE TABLE t_recluster_block COMPACT SEGMENT

query II
SELECT count(*), sum(block_count) FROM fuse_segment('db_09_0067', 't_recluster_block')
----
1 3

statement ok
ALTER TABLE t_recluster_block RECLUSTER

query I
SELECT id FROM t_recluster_block ORDER BY id
----
2
3
6
7

statement ok
CREATE TABLE t_recluster_final (id INT, expires TIMESTAMP) CLUSTER BY (id) TTL expires

statement ok
INSERT INTO t_recluster_final VALUES (1, '2000-01-01 00:00:00')

statement ok
INSERT INTO t_recluster_final VALUES (2, '2099-01-01 00:00:00')

statement ok
ALTER TABLE t_recluster_final RECLUSTER FINAL

query I
SELECT id FROM t_recluster_final ORDER BY id
----
2

# COMPACT drops the expired blocks of every segment it scans before it stops:
# segments that may hold expired rows but have no expired block do not crowd
# out the expired segment scanned after them.
statement ok
CREATE TABLE t_compact_many (id INT, expires TIMESTAMP) TTL expires ROW_PER_BLOCK = 2 BLOCK_PER_SEGMENT = 1

statement ok
INSERT INTO t_compact_many VALUES (0, '2000-01-01 00:00:00')

statement ok
INSERT INTO t_compact_many SELECT number + 1, if(number % 2 = 0, '2000-01-01 00:00:00'::TIMESTAMP, '2099-01-01 00:00:00'::TIMESTAMP) FROM numbers(260)

query II
SELECT segment_count, block_count FROM fuse_snapshot('db_09_0067', 't_compact_many') LIMIT 1
----
131 131

statement ok
OPTIMIZE TABLE t_compact_many COMPACT

query III
SELECT count(*), min(id), max(id) FROM t_compact_many
----
260 1 260

# A vector RECLUSTER FINAL whose rows not mixed yet are too few to rewrite
# still drops the expired blocks, and leaves the other blocks as they are.
statement ok
CREATE TABLE t_vector (id INT, embedding VECTOR(2), expires TIMESTAMP, VECTOR INDEX idx(embedding) distance='l2') CLUSTER BY (embedding) TTL expires

statement ok
INSERT INTO t_vector SELECT number, [number, 0], '2099-01-01 00:00:00' FROM numbers(50)

statement ok
INSERT INTO t_vector SELECT number + 50, [0, number], '2099-01-01 00:00:00' FROM numbers(50)

statement ok
ALTER TABLE t_vector RECLUSTER FINAL

statement ok
INSERT INTO t_vector VALUES (100, [1, 1], '2000-01-01 00:00:00')

statement ok
CREATE TABLE t_vector_blocks AS SELECT block_location FROM fuse_block('db_09_0067', 't_vector')

statement ok
ALTER TABLE t_vector RECLUSTER FINAL

query II
SELECT count(*), max(id) FROM t_vector
----
100 99

query I
SELECT count(*) FROM fuse_block('db_09_0067', 't_vector') WHERE block_location NOT IN (SELECT block_location FROM t_vector_blocks)
----
0

# Automatic compaction after a write drops as well.
statement ok
CREATE TABLE t_auto (id INT, expires TIMESTAMP) TTL expires

statement ok
INSERT INTO t_auto VALUES (1, '2000-01-01 00:00:00')

statement ok
set enable_compact_after_write = 1

statement ok
set auto_compaction_imperfect_blocks_threshold = 1

statement ok
INSERT INTO t_auto VALUES (2, '2099-01-01 00:00:00')

query I
SELECT id FROM t_auto ORDER BY id
----
2

statement ok
drop database db_09_0067
