# Task-level inverted index reuse after horizontal two-level row merge.
statement ok
create or replace database db_recluster_inverted_merge

statement ok
use db_recluster_inverted_merge

statement ok
set recluster_method = 'horizontal'

statement ok
set enable_recluster_multiway_merge = 1

statement ok
set enable_recluster_inverted_index_merge = 1

statement ok
create table t(k int, content string, inverted index text_idx(content)) cluster by(-k) row_per_block=100 block_per_segment=2

statement ok
insert into t select number, concat('word',to_string(number),' alpha') from numbers(200)

statement ok
insert into t select number, concat('word',to_string(number),' beta') from numbers(200)

statement ok
set force_sort_data_spill = 1

statement ok
alter table t recluster final

query I
select count() from t where match(content,'word123') and k=123
----
2

query I
select count() from t where match(content,'alpha')
----
200

query I
select count() from t where match(content,'beta')
----
200

query I
select count() from t where match(content,'missingword')
----
0

query I
select count() from t where match(content,'"word123 alpha"')
----
1

statement ok
unset force_sort_data_spill

# Sources missing a newly added index still rebuild that definition.
statement ok
create table partial(k int, content string, other string, inverted index existing_idx(content)) cluster by(k) row_per_block=100 block_per_segment=2

statement ok
insert into partial values (3,'alpha','delta'),(1,'alpha','gamma')

statement ok
insert into partial values (4,'beta','delta'),(2,'beta','gamma')

statement ok
create inverted index late_idx on partial(other)

statement ok
alter table partial recluster final

query I
select count() from partial where match(content,'alpha')
----
2

query I
select count() from partial where match(other,'gamma')
----
2

statement ok
unset enable_recluster_inverted_index_merge

statement ok
unset enable_recluster_multiway_merge

statement ok
unset recluster_method

statement ok
drop database db_recluster_inverted_merge
