statement ok
create or replace database db_09_0065

statement ok
use db_09_0065

# `a`, `b` and `n` are only filtered on, `s` and `p` are also output: the leading conjuncts on
# the former are evaluated first, and the other prewhere columns decoded for the rows that pass.
statement ok
create or replace table t (a int not null, b int not null, n int null, s string not null, p string not null) row_per_block = 9000

statement ok
insert into t select number, number % 13, if(number % 5 = 0, null, number % 10), concat('x', (number % 100)::string), concat('payload-', number::string, '-', repeat('y', number % 30)) from numbers(20000)

statement ok
set prewhere_selectivity_threshold = 0

query ITT
select count(*), min(s), max(p) from t where b = 3 and s <> 'x7'
----
1523 x0 payload-9987-yyyyyyyyyyyyyyyyyyyyyyyyyyy

query TT
select s, p from t where a % 7 = 3 and s like '%5%' order by p limit 5
----
x55 payload-10055-yyyyy
x25 payload-10125-yyyyyyyyyyyyyyy
x53 payload-10153-yyyyyyyyyyyyy
x95 payload-10195-yyyyyyyyyyyyyyyyyyyyyyyyy
x25 payload-1025-yyyyy

query IT
select count(*), min(s) from t where a > 10 and a + length(s) > 19990
----
12 x88

query IT
select count(*), max(p) from t where n > 5 and s = 'x9'
----
200 payload-9909-yyyyyyyyy

query IT
select count(*), max(s) from t where a < 0 and s <> ''
----
0 NULL

query IT
select count(*), min(p) from t where a >= 0 and s = 'x42'
----
200 payload-10042-yyyyyyyyyyyyyyyyyyyyyy

query IT
select count(*), max(p) from t where (a = 100 or b = 12) and s like '%1'
----
154 payload-9931-y

query TT
select s, p from t where b = 0 and a < 200 order by p
