# run-with-settings: enable_block_stream_write=1
# run-with-settings: enable_block_stream_write=0

statement ok
create or replace database db_column_statistics_null_bounds;

statement ok
use db_column_statistics_null_bounds;

# Keep the blocks separate until the explicit segment compaction steps.
statement ok
set enable_compact_after_write = 0;

statement ok
create table t_all_null(id int not null, k int null);

statement ok
insert into t_all_null values (1, null), (2, null);

statement ok
insert into t_all_null values (3, 5);

statement ok
optimize table t_all_null compact segment;

query I
select id from t_all_null where k is not null;
----
3

query I
select id from t_all_null where k is null order by id;
----
1
2

query III
select min(k), max(k), count(k) from t_all_null;
----
5 5 1

statement ok
delete from t_all_null where k is null;

query II
select id, k from t_all_null order by id;
----
3 5

# Leaf statistics cannot tell a NULL array from [] or [NULL].
statement ok
create table t_array(id int not null, a array(int) null);

statement ok
insert into t_array values (1, []);

statement ok
insert into t_array values (2, [null]);

statement ok
insert into t_array values (3, null);

query I
select id from t_array where a is not null order by id;
----
1
2

query I
select id from t_array where a = [];
----
1

statement ok
delete from t_array where a is null;

query I
select id from t_array order by id;
----
1
2

# A tuple with a NULL field is not NULL, and a NULL tuple can have a NOT NULL field type.
statement ok
create table t_tuple(id int not null, t tuple(x int null) null, u tuple(x int not null) null);

statement ok
insert into t_tuple values (1, tuple(null), null);

query I
select id from t_tuple where t is not null;
----
1

query I
select id from t_tuple where u is null;
----
1

statement ok
create table t_map(id int not null, m map(string, int) null);

statement ok
insert into t_map values (1, {});

statement ok
insert into t_map values (2, null);

statement ok
optimize table t_map compact segment;

query I
select id from t_map where m is not null;
----
1

query I
select id from t_map where m is null;
----
2

# The leaf null count counts elements, not rows. Compaction must keep the bounds
# for the non-NULL elements even when the count is as large as the row count.
statement ok
create table t_elements(id int not null, a array(int null) not null, m map(string, int null) not null);

statement ok
insert into t_elements values (1, [], {});

statement ok
insert into t_elements values (2, [null, null, 5], {'x': null, 'y': null, 'k': 5});

statement ok
optimize table t_elements compact segment;

statement ok
insert into t_elements values (3, [7, 8, 9], {'k': 7, 'l': 9});

statement ok
optimize table t_elements compact segment;

query I
select id from t_elements where a[3] = 5;
----
2

query I
select id from t_elements where m['k'] = 5;
----
2

# Empty collections have NULL bounds for their leaves, even for NOT NULL elements.
statement ok
create table t_column_oriented(id int not null, a array(int not null) null, m map(string, int not null) null)
segment_format = 'column_oriented' storage_format = 'parquet';

statement ok
insert into t_column_oriented values (1, [], {});

statement ok
insert into t_column_oriented values (2, [5], {'k': 5});

query I
select id from t_column_oriented where a = [] and m is not null;
----
1

query I
select id from t_column_oriented where a[1] = 5 and m['k'] = 5;
----
2

# A longer upper bound must survive compaction and remain safe for MAX, TopN,
# and the range checks that REPLACE uses to find conflicts.
statement ok
create table t_string(id int not null, s string stats_truncate_len 4);

statement ok
insert into t_string values (1, concat(repeat(char(0x10FFFF), 4), 'z-tail'));

statement ok
insert into t_string values (2, 'a');

statement ok
insert into t_string values (3, null);

statement ok
optimize table t_string compact segment;

query I
select id from t_string where s > 'b';
----
1

query I
select id from t_string where s < 'b';
----
2

query I
select id from t_string where s is null;
----
3

query B
select max(s) = concat(repeat(char(0x10FFFF), 4), 'z-tail') from t_string;
----
1

query I
select id from t_string order by s desc nulls last limit 1;
----
1

statement ok
replace into t_string on (s) values (9, concat(repeat(char(0x10FFFF), 4), 'z-tail'));

statement ok
delete from t_string where s = 'a';

query I
select id from t_string order by id;
----
3
9

statement ok
drop database db_column_statistics_null_bounds;
