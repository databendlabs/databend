statement ok
CREATE DATABASE db20_20;

statement ok
USE db20_20;

statement ok
SET GLOBAL enable_planner_cache = 0;

query TT
SELECT value, level FROM system.settings WHERE name = 'enable_planner_cache';
----
0 GLOBAL

statement ok
SET enable_planner_cache = 1;

query TT
SELECT value, level FROM system.settings WHERE name = 'enable_planner_cache';
----
1 SESSION

statement ok
SET variable a = 'a';

statement ok
CREATE TABLE IF NOT EXISTS t1 (a INT not null);

statement ok
INSERT INTO t1 VALUES (1), (2), (3);

query IT
SELECT *, $a FROM t1 ORDER BY a;
----
1 a
2 a
3 a

query IT
SELECT *, $a FROM t1 ORDER BY a;
----
1 a
2 a
3 a

statement ok
SET variable a = 'b';

query IT
SELECT *, $a FROM t1 ORDER BY a;
----
1 b
2 b
3 b

statement ok
alter table t1 add column b string default 's';

query IT
SELECT * FROM t1 ORDER BY a;
----
1 s
2 s
3 s

query IT
SELECT * FROM t1 ORDER BY a;
----
1 s
2 s
3 s

statement ok
SET enable_planner_cache = 0;

query IT
SELECT * FROM t1 ORDER BY a;
----
1 s
2 s
3 s

query IT
SELECT * FROM t1 ORDER BY a;
----
1 s
2 s
3 s

statement ok
SET enable_planner_cache = 1;

statement ok
SET lazy_read_threshold = 0;

statement ok
SET enable_distributed_pruning = 0;

statement ok
SET enable_query_result_cache = 0;

statement ok
CREATE TABLE t2 (a INT NOT NULL);

statement ok
INSERT INTO t2 VALUES (1);

query I
SELECT * FROM t2 ORDER BY a;
----
1

query I
SELECT * FROM t2 ORDER BY a;
----
1

statement ok
