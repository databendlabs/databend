# Task SQL is validated statically while binding CREATE/ALTER TASK: syntax, constant
# EXECUTE IMMEDIATE scripts and script control flow. Nothing is bound or executed, so
# these cases need neither a cloud-control server nor the referenced objects.
#
# Bodies that pass validation reach the task interpreter, which rejects them here
# because cloud control is not enabled (1702). That code therefore marks "accepted by
# validation" below.

# Syntax errors in the body.
statement error 1005
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS EXECUTE IMMEDIATE $$ BEGIN SELECT FROM; END; $$

statement error 1005
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS EXECUTE IMMEDIATE $$ BEGIN IF FALSE THEN SELECT FROM; END IF; END; $$

# Constant single-statement scripts are parsed too.
statement error 1005
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS EXECUTE IMMEDIATE 'SELECT FROM'

# Nested constant scripts are expanded.
statement error 1005
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS EXECUTE IMMEDIATE $$ BEGIN EXECUTE IMMEDIATE 'BEGIN SELECT FROM; END;'; END; $$

# Every statement of a task script block is checked.
statement error 1005
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS BEGIN SELECT 1; EXECUTE IMMEDIATE 'SELECT FROM'; END;

# Script compilation: undeclared variables and control flow outside a loop.
statement error 3128
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS EXECUTE IMMEDIATE $$ BEGIN RETURN unknown_variable; END; $$

statement error 3128
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS EXECUTE IMMEDIATE $$ BEGIN BREAK; END; $$

statement error 3128
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS EXECUTE IMMEDIATE $$ BEGIN LOOP EXECUTE IMMEDIATE 'BEGIN CONTINUE; END;'; END LOOP; END; $$

# ALTER TASK ... MODIFY AS runs the same checks.
statement error 1005
ALTER TASK static_validation_task MODIFY AS SELECT FROM

statement error 3128
ALTER TASK static_validation_task MODIFY AS EXECUTE IMMEDIATE $$ BEGIN BREAK; END; $$

# Scripts that are not a string literal need evaluation and are left to runtime.
statement error 1702
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS EXECUTE IMMEDIATE 1

statement error 1702
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS EXECUTE IMMEDIATE 'SELECT ' || 'FROM'

# Nothing is bound: missing objects, forward UDF references, stream consumption and
# execution-dependent planning (dynamic PIVOT, materialized CTE) are all accepted and
# never executed at definition time.
statement error 1702
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS INSERT INTO static_validation_not_created_yet SELECT 1

statement error 1702
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS SELECT static_validation_udf_not_created_yet(1)

statement error 1702
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS SELECT * FROM static_validation_stream WITH CONSUME

statement ok
CREATE OR REPLACE TABLE static_validation_sales (empid INT, month STRING, amount INT)

statement ok
INSERT INTO static_validation_sales VALUES (1, 'jan', 1), (1, 'feb', 2)

# `to_int64(month)` fails if evaluated on the stored rows.
statement error 1702
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS SELECT * FROM static_validation_sales PIVOT(SUM(amount) FOR month IN (SELECT to_int64(month) FROM static_validation_sales))

statement error 1702
CREATE TASK static_validation_task WAREHOUSE = 'mywh' AS WITH m AS MATERIALIZED (SELECT to_int64(month) FROM static_validation_sales) SELECT * FROM m

statement ok
DROP TABLE static_validation_sales

# Session parameters do not change what is validated. DATABASE is only accepted by
# private tasks (2801) or when cloud control is enabled (1702).
statement error 1005
CREATE TASK static_validation_task WAREHOUSE = 'mywh' DATABASE = 'default' AS SELECT FROM static_validation_t

statement error (1702|2801)
CREATE TASK static_validation_task WAREHOUSE = 'mywh' DATABASE = 'default' AS SELECT v FROM static_validation_t
