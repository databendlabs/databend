# LIMIT finishes downstream while parallel final aggregators are receiving
# recursively spilled tasks. They must exit without waiting for all senders.
statement ok
set max_threads = 4;

statement ok
set max_block_size = 256;

statement ok
set force_aggregate_data_spill = 1;

statement ok
set max_aggregate_spill_level = 3;

statement ok
set group_by_shuffle_mode = 'before_partial';

query II
select count(*), sum(cnt)
from (
    select number % 1024 as k, count(*) as cnt
    from numbers_mt(8192)
    group by k
    having cnt >= 2
    limit 10
);
----
10 80

statement ok
set group_by_shuffle_mode = 'before_merge';

query II
select count(*), sum(cnt)
from (
    select number % 1024 as k, count(*) as cnt
    from numbers_mt(8192)
    group by k
    having cnt >= 2
    limit 10
);
----
10 80

# Without early termination, all tasks must still be consumed by live peers.
query II
select count(*), sum(cnt)
from (
    select number % 1024 as k, count(*) as cnt
    from numbers_mt(8192)
    group by k
);
----
1024 8192

statement ok
unset (max_threads, max_block_size, force_aggregate_data_spill, max_aggregate_spill_level, group_by_shuffle_mode);
