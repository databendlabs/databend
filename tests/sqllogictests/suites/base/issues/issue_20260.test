statement ok
DROP TABLE IF EXISTS issue_20260_other;

statement ok
CREATE TABLE issue_20260(a INT);

statement ok
ALTER TABLE issue_20260 SET OPTIONS(change_tracking = true);

statement ok
CREATE TABLE issue_20260_source(a INT);

statement ok
CREATE TABLE issue_20260_other(a INT);

statement ok
INSERT INTO issue_20260 VALUES (1), (2);

statement ok
INSERT INTO issue_20260_source VALUES (10), (20);

# Qualified internal column from the outer scope.
query I
SELECT count(*) FROM issue_20260 AS t
WHERE EXISTS (SELECT 1 WHERE t._row_id IS NOT NULL);
----
2

# change$row_id follows the same correlated internal-column resolution path.
query I
SELECT count(*) FROM issue_20260 AS t
WHERE EXISTS (SELECT 1 WHERE length(t.change$row_id) = 38);
----
2

# Unqualified internal column falls back to the only table in the outer scope.
query I
SELECT count(*) FROM issue_20260 AS t
WHERE EXISTS (SELECT 1 WHERE to_string(_row_id) != '');
----
2

# A qualified outer reference skips a non-matching table in the inner scope.
query I
SELECT count(*) FROM issue_20260 AS t
WHERE EXISTS (
    SELECT 1 FROM issue_20260_source AS s
    WHERE to_string(t._row_id) != ''
);
----
2

# An unqualified internal column belongs to the nearest scope.
query I
SELECT count(*) FROM issue_20260 AS t
WHERE EXISTS (
    SELECT 1 FROM issue_20260_source AS s
    WHERE _row_id = s._row_id
);
----
2

# Resolving an outer internal column must not pollute inner-scope name resolution.
query I
SELECT count(*) FROM issue_20260 AS t
WHERE EXISTS (
    SELECT 1 FROM issue_20260_source AS s
    WHERE to_string(t._row_id) != '' AND _row_id = s._row_id
);
----
2

# Internal-column requirements propagate through nested subqueries.
query I
SELECT count(*) FROM issue_20260 AS t
WHERE EXISTS (
    SELECT 1
    WHERE EXISTS (SELECT 1 WHERE to_string(t._row_id) != '')
);
----
2

# Repeated correlated references reuse the same internal column.
query I
SELECT count(*) FROM issue_20260 AS t
WHERE EXISTS (SELECT 1 WHERE t._row_id > 0)
  AND EXISTS (SELECT 1 WHERE t._row_id > 1);
----
2

# An unqualified internal column remains ambiguous when multiple outer tables are visible.
statement error (?s)1065.*ambiguous
SELECT * FROM issue_20260 AS t, issue_20260_other AS o
WHERE EXISTS (SELECT 1 WHERE _row_id > 0);

