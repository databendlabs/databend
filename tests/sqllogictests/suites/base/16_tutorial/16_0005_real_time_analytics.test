query TTI
SELECT v.route_name,
       v.weather,
       COUNT(f.frame_id) AS flagged_frames
FROM citydrive_videos AS v
         LEFT JOIN frame_events AS f USING (video_id)
WHERE v.capture_date >= '2025-01-01'
GROUP BY v.route_name, v.weather
ORDER BY flagged_frames DESC, v.route_name
----
Downtown Loop Rain 2
Airport Connector Clear 1
Port Perimeter Overcast 1

query TTIRR
SELECT video_id,
       frame_id,
       frame_index,
       risk_score,
       AVG(risk_score) OVER (
                    PARTITION BY video_id
                    ORDER BY frame_index
                    ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
                ) AS rolling_risk
FROM frame_events
ORDER BY video_id, frame_index
----
VID-001 FRAME-0101 125 0.81 0.81
VID-001 FRAME-0102 416 0.67 0.74
VID-002 FRAME-0201 298 0.74 0.74
VID-003 FRAME-0301 188 0.59 0.59

