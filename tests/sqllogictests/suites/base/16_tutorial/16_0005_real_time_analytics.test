statement ok
CREATE OR REPLACE DATABASE citydrive_demo

statement ok
USE citydrive_demo

statement ok
CREATE OR REPLACE TABLE citydrive_videos (
    video_id     STRING,
    vehicle_id   STRING,
    capture_date DATE,
    route_name   STRING,
    weather      STRING,
    camera       STRING,
    duration_sec INT
)

statement ok
CREATE OR REPLACE TABLE frame_events (
    frame_id     STRING,
    video_id     STRING,
    frame_index  INT,
    collected_at TIMESTAMP,
    event_tag    STRING,
    risk_score   DOUBLE,
    speed_kmh    DOUBLE
)

