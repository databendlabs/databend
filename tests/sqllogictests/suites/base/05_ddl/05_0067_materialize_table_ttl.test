statement ok
BEGIN

statement error 1002
ALTER TABLE ttl_materialize_test MATERIALIZE TTL

statement ok
ROLLBACK

statement ok
ALTER TABLE ttl_materialize_test MATERIALIZE TTL

query I
SELECT id FROM ttl_materialize_test ORDER BY id
----
2
3

# Retrying after the first pass does not remove NULL or future rows.
statement ok
ALTER TABLE ttl_materialize_test MATERIALIZE TTL

query I
SELECT count(*) FROM ttl_materialize_test
----
2

statement ok
ALTER TABLE ttl_materialize_test SET TTL expires + INTERVAL 1 DAY

statement ok
ALTER TABLE ttl_materialize_test MATERIALIZE TTL

query I
SELECT count(*) FROM ttl_materialize_test
----
2

statement ok
ALTER TABLE ttl_materialize_test REMOVE TTL

statement error 1065
ALTER TABLE ttl_materialize_test MATERIALIZE TTL

statement ok
