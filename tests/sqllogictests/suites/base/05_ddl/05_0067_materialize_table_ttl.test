# Persisted TTL identifiers use the storage dialect, not the executor's SQL dialect.
# Under MySQL, "2000-01-01" would otherwise be a string literal and could expire every row.
statement ok
SET sql_dialect = 'PostgreSQL'

statement ok
CREATE TABLE ttl_materialize_quoted (id INT, "2000-01-01" TIMESTAMP, "ExpireAt" TIMESTAMP) TTL "2000-01-01"

statement ok
