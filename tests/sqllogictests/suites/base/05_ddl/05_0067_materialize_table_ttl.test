# A virtual computed column cannot be used as a TTL expiration time.
# This must fail during binding, before the computed-column license check.
statement error 1065
CREATE TABLE ttl_materialize_virtual_rejected (ts TIMESTAMP, expires TIMESTAMP AS (ts) VIRTUAL) TTL expires

# MATERIALIZE TTL applies the stored TTL definition without modifying it.
statement ok
ALTER TABLE IF EXISTS ttl_materialize_absent MATERIALIZE TTL

statement ok
DROP TABLE IF EXISTS ttl_materialize_test

statement ok
DROP TABLE IF EXISTS ttl_materialize_date

statement ok
