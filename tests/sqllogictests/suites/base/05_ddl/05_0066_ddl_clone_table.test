# CLONE owns its schema and engine and supports only snapshot-ID navigation.
statement error
CREATE TABLE clone_with_schema(id INT) CLONE head

statement error
CREATE TABLE clone_with_engine CLONE head ENGINE = FUSE

statement error
CREATE TABLE clone_at_timestamp CLONE head AT (TIMESTAMP => now())

