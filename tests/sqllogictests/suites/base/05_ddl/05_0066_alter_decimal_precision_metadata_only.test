# Widening precision without changing the Parquet physical representation is metadata-only.
statement ok
ALTER TABLE decimal_same_width MODIFY COLUMN d64 DECIMAL(15, 2)

statement ok
ALTER TABLE decimal_same_width MODIFY COLUMN d128 DECIMAL(21, 0)

statement ok
ALTER TABLE decimal_same_width MODIFY COLUMN d256 DECIMAL(40, 5)

# Cluster statistics are persisted separately from column statistics and must use the same
# schema-aware Decimal widening semantics.
statement ok
ALTER TABLE decimal_cluster_key MODIFY COLUMN d DECIMAL(15, 2)

query TR rowsort
SELECT typeof(d), d FROM decimal_cluster_key
----
DECIMAL(15, 2) NULL 1.00
DECIMAL(15, 2) NULL 3.00

query B
SELECT count(*) = count_if(new_blocks.block_location IS NOT NULL)
FROM decimal_original_blocks AS old_blocks
LEFT JOIN fuse_block('default', 'decimal_cluster_key') AS new_blocks
    ON old_blocks.block_location = new_blocks.block_location
WHERE old_blocks.table_name = 'cluster_key'
----
1

# Appending creates widened cluster stats and merges them with the persisted old precision.
statement ok
INSERT INTO decimal_cluster_key VALUES (2.00), (4.00)

query R rowsort
SELECT d FROM decimal_cluster_key WHERE d >= 2.00
----
2.00
3.00
4.00

statement ok
OPTIMIZE TABLE decimal_cluster_key RECLUSTER

query R
SELECT d FROM decimal_cluster_key ORDER BY d
----
1.00
2.00
3.00
4.00

query TTT
SELECT typeof(d64), typeof(d128), typeof(d256) FROM decimal_same_width
----
DECIMAL(15, 2) NULL DECIMAL(21, 0) NULL DECIMAL(40, 5) NULL

query RRR
SELECT d64, d128, d256 FROM decimal_same_width
----
12345678.90 12345678901234567890 1234567890123456789012345678901234.56789

# The old snapshot keeps its original schema and remains readable.
query RRR
SELECT d64, d128, d256 FROM decimal_same_width AT (
    SNAPSHOT => (SELECT snapshot_id FROM decimal_original_snapshot LIMIT 1)
)
----
12345678.90 12345678901234567890 1234567890123456789012345678901234.56789

# Persisted statistics retain the old precision, but pruning uses the current schema size.
query RRR
SELECT d64, d128, d256 FROM decimal_same_width
WHERE d64 = 12345678.90
  AND d128 = 12345678901234567890
  AND d256 = 1234567890123456789012345678901234.56789
----
12345678.90 12345678901234567890 1234567890123456789012345678901234.56789

query B
SELECT count(*) = count_if(new_blocks.block_location IS NOT NULL)
FROM decimal_original_blocks AS old_blocks
LEFT JOIN fuse_block('default', 'decimal_same_width') AS new_blocks
    ON old_blocks.block_location = new_blocks.block_location
WHERE old_blocks.table_name = 'same_width'
----
1

# New block statistics use the widened precision and must merge with persisted old statistics.
statement ok
INSERT INTO decimal_same_width VALUES (87654321.09, 223456789012345678901, 99999999999999999999999999999999999.12345)

query RRR rowsort
SELECT d64, d128, d256 FROM decimal_same_width
----
12345678.90 12345678901234567890 1234567890123456789012345678901234.56789
87654321.09 223456789012345678901 99999999999999999999999999999999999.12345

query RRR
SELECT d64, d128, d256 FROM decimal_same_width WHERE d64 > 50000000
----
87654321.09 223456789012345678901 99999999999999999999999999999999999.12345

# Partition and runtime TopN ordering must consume the schema-aligned statistics.
query RRR
SELECT d64, d128, d256 FROM decimal_same_width ORDER BY d64 LIMIT 1
----
12345678.90 12345678901234567890 1234567890123456789012345678901234.56789

# REPLACE uses table/segment/block ranges and must fail open rather than miss an old block.
statement ok
REPLACE INTO decimal_same_width ON(d64)
VALUES (12345678.90, 32345678901234567890, 111.00000)

query RRR rowsort
SELECT d64, d128, d256 FROM decimal_same_width
----
12345678.90 32345678901234567890 111.00000
87654321.09 223456789012345678901 99999999999999999999999999999999999.12345

statement ok
ANALYZE TABLE decimal_same_width

statement ok
OPTIMIZE TABLE decimal_same_width COMPACT

query RRR
SELECT d64, d128, d256 FROM decimal_same_width WHERE d64 < 50000000
----
12345678.90 32345678901234567890 111.00000

# Widening within the same Decimal kind must still rewrite when the Parquet physical width changes.
statement ok
ALTER TABLE decimal_parquet_width_change MODIFY COLUMN d64 DECIMAL(10, 0)

statement ok
ALTER TABLE decimal_parquet_width_change MODIFY COLUMN d128 DECIMAL(30, 0)

statement ok
ALTER TABLE decimal_parquet_width_change MODIFY COLUMN d256 DECIMAL(50, 0)

query TTT
SELECT typeof(d64), typeof(d128), typeof(d256) FROM decimal_parquet_width_change
----
DECIMAL(10, 0) NULL DECIMAL(30, 0) NULL DECIMAL(50, 0) NULL

query RRR
SELECT d64, d128, d256 FROM decimal_parquet_width_change
----
123456789 12345678901234567890 1234567890123456789012345678901234567890

# Crossing a Decimal kind boundary, changing scale, or narrowing precision must rewrite data.
statement ok
ALTER TABLE decimal_cross_64_128 MODIFY COLUMN v DECIMAL(19, 0)

statement ok
ALTER TABLE decimal_precision_one MODIFY COLUMN v DECIMAL(5, 0)

statement ok
ALTER TABLE decimal_cross_128_256 MODIFY COLUMN v DECIMAL(39, 0)

statement ok
ALTER TABLE decimal_scale_change MODIFY COLUMN v DECIMAL(30, 2)

statement ok
ALTER TABLE decimal_precision_narrow MODIFY COLUMN v DECIMAL(20, 0)

