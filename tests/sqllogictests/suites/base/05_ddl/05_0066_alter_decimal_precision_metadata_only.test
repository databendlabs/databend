query TB rowsort
SELECT 'cross_64_128', count_if(new_blocks.block_location IS NULL) = count(*)
FROM decimal_original_blocks AS old_blocks
LEFT JOIN fuse_block('default', 'decimal_cross_64_128') AS new_blocks
    ON old_blocks.block_location = new_blocks.block_location
WHERE old_blocks.table_name = 'cross_64_128'
UNION ALL
SELECT 'cross_128_256', count_if(new_blocks.block_location IS NULL) = count(*)
FROM decimal_original_blocks AS old_blocks
LEFT JOIN fuse_block('default', 'decimal_cross_128_256') AS new_blocks
    ON old_blocks.block_location = new_blocks.block_location
WHERE old_blocks.table_name = 'cross_128_256'
UNION ALL
SELECT 'precision_one', count_if(new_blocks.block_location IS NULL) = count(*)
FROM decimal_original_blocks AS old_blocks
LEFT JOIN fuse_block('default', 'decimal_precision_one') AS new_blocks
    ON old_blocks.block_location = new_blocks.block_location
WHERE old_blocks.table_name = 'precision_one'
UNION ALL
SELECT 'parquet_width_change', count_if(new_blocks.block_location IS NULL) = count(*)
FROM decimal_original_blocks AS old_blocks
LEFT JOIN fuse_block('default', 'decimal_parquet_width_change') AS new_blocks
    ON old_blocks.block_location = new_blocks.block_location
WHERE old_blocks.table_name = 'parquet_width_change'
UNION ALL
SELECT 'scale_change', count_if(new_blocks.block_location IS NULL) = count(*)
FROM decimal_original_blocks AS old_blocks
LEFT JOIN fuse_block('default', 'decimal_scale_change') AS new_blocks
    ON old_blocks.block_location = new_blocks.block_location
WHERE old_blocks.table_name = 'scale_change'
UNION ALL
SELECT 'precision_narrow', count_if(new_blocks.block_location IS NULL) = count(*)
FROM decimal_original_blocks AS old_blocks
LEFT JOIN fuse_block('default', 'decimal_precision_narrow') AS new_blocks
    ON old_blocks.block_location = new_blocks.block_location
WHERE old_blocks.table_name = 'precision_narrow'
----
cross_128_256 1
cross_64_128 1
parquet_width_change 1
precision_narrow 1
precision_one 1
scale_change 1

