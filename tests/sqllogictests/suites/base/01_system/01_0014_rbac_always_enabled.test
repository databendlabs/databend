# The stage/UDF and connection switches are still removed.
query I
SELECT count(*) FROM system.settings WHERE name IN ('enable_experimental_rbac_check', 'enable_experimental_connection_privilege_check')
----
0

statement error 2801
SET enable_experimental_rbac_check = 0

statement error 2801
SET GLOBAL enable_experimental_connection_privilege_check = 0

# Statement-level settings ignore unknown names instead of applying them.
query I
SETTINGS (enable_experimental_rbac_check = 0) SELECT count(*) FROM system.settings WHERE name = 'enable_experimental_rbac_check'
----
0

query I
SELECT /*+ SET_VAR(enable_experimental_connection_privilege_check = 0) */ count(*) FROM system.settings WHERE name = 'enable_experimental_connection_privilege_check'
----
0

# The sequence upgrade switch is global-only, even for an administrator.
statement error Variable scope mismatch
SET enable_experimental_sequence_privilege_check = 0

statement error Variable scope mismatch
UNSET enable_experimental_sequence_privilege_check

statement error Variable scope mismatch
SETTINGS (enable_experimental_sequence_privilege_check = 0) SELECT 1

statement error Variable scope mismatch
SELECT /*+ SET_VAR(enable_experimental_sequence_privilege_check = 0) */ 1
