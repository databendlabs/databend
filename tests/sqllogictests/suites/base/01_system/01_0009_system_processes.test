query B
SELECT count(*)>0 FROM system.processes
----
1

# SQL exposes canonical p-<UUID> internal session ids, not protocol/login ids.
query B
SELECT regexp_like(connection_id(), '^p-[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$', 'c')
----
1

query B
SELECT count(*) = 1 FROM system.processes WHERE id = connection_id()
----
1

# now() uses the coordinator query creation time, including during planning.
query B
SELECT count(*) > 0 FROM system.processes WHERE created_time = now()
----
1
