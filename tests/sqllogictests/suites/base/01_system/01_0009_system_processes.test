query B
SELECT count(*)>0 FROM system.processes
----
1

# SQL connection ids and system.processes expose the internal session id prefix.
query B
SELECT connection_id() LIKE 'p-%'
----
1

query B
SELECT count(*) > 0 FROM system.processes WHERE id = connection_id() AND id LIKE 'p-%'
----
1

# now() uses the coordinator query creation time, including during planning.
query B
SELECT count(*) > 0 FROM system.processes WHERE created_time = now()
----
1
