# Uses the existing Arrow Flight fixture: python3 tests/udf/udf_server.py.
# The existing udf_server suite config enables insecure Flight and allowlists
# http://0.0.0.0:8815, deliberately also allowing the legacy path below.
statement ok
DROP FUNCTION IF EXISTS managed_gcd;

statement ok
DROP FUNCTION IF EXISTS legacy_gcd_access;

statement ok
DROP EXTERNAL ACCESS INTEGRATION IF EXISTS flight_access;

statement ok
DROP NETWORK RULE IF EXISTS flight_rule;

statement ok
DROP NETWORK RULE IF EXISTS unrelated_rule;

statement ok
CREATE NETWORK RULE flight_rule TYPE = HOST_PORT MODE = EGRESS VALUE_LIST = ('0.0.0.0:8815');

statement ok
CREATE NETWORK RULE unrelated_rule TYPE = HOST_PORT MODE = EGRESS VALUE_LIST = ('unrelated.example.com:443');

statement ok
CREATE EXTERNAL ACCESS INTEGRATION flight_access ALLOWED_NETWORK_RULES = (unrelated_rule, flight_rule) ENABLED = TRUE;

statement ok
CREATE FUNCTION managed_gcd(INT, INT) RETURNS INT LANGUAGE python IMMUTABLE HANDLER = 'gcd' ADDRESS = 'http://0.0.0.0:8815' EXTERNAL_ACCESS_INTEGRATIONS = (flight_access);

statement ok
CREATE FUNCTION legacy_gcd_access(INT, INT) RETURNS INT LANGUAGE python HANDLER = 'gcd' ADDRESS = 'http://0.0.0.0:8815';

query I
SELECT managed_gcd(6, 4);
----
2

query I
SELECT managed_gcd(number::INT, 2) FROM numbers(3);
----
2
1
2

statement error not allowed by external access integrations
CREATE FUNCTION denied_gcd(INT, INT) RETURNS INT LANGUAGE python HANDLER = 'gcd' ADDRESS = 'http://0.0.0.0:8816' EXTERNAL_ACCESS_INTEGRATIONS = (flight_access);

statement error arg types mismatch
CREATE FUNCTION wrong_gcd_schema(STRING, STRING) RETURNS INT LANGUAGE python HANDLER = 'gcd' ADDRESS = 'http://0.0.0.0:8815' EXTERNAL_ACCESS_INTEGRATIONS = (flight_access);

statement ok
ALTER EXTERNAL ACCESS INTEGRATION flight_access SET ENABLED = FALSE;

statement error disabled
SELECT managed_gcd(6, 4);

# Explicit integrations must not fall back to udf_server_allow_list.
statement error disabled
CREATE FUNCTION denied_disabled_gcd(INT, INT) RETURNS INT LANGUAGE python HANDLER = 'gcd' ADDRESS = 'http://0.0.0.0:8815' EXTERNAL_ACCESS_INTEGRATIONS = (flight_access);

# Legacy UDFs retain their old behavior.
query I
SELECT legacy_gcd_access(6, 4);
----
2

statement ok
ALTER EXTERNAL ACCESS INTEGRATION flight_access SET ENABLED = TRUE;

statement ok
ALTER NETWORK RULE flight_rule SET VALUE_LIST = ('0.0.0.0:8816');

statement error not allowed by external access integrations
SELECT managed_gcd(6, 4);

statement ok
ALTER NETWORK RULE flight_rule SET VALUE_LIST = ('0.0.0.0:8815');

query I
SELECT managed_gcd(6, 4);
----
2

statement ok
ALTER EXTERNAL ACCESS INTEGRATION flight_access SET ALLOWED_NETWORK_RULES = (unrelated_rule);

statement error not allowed by external access integrations
SELECT managed_gcd(6, 4);

statement ok
DROP EXTERNAL ACCESS INTEGRATION flight_access;

statement error ExternalAccessIntegration
SELECT managed_gcd(6, 4);

statement ok
DROP FUNCTION managed_gcd;

