statement ok
SET enable_experimental_clone_table = 1

statement ok
SET enable_experimental_table_ref = 1

statement ok
DROP DATABASE IF EXISTS db_08_clone_at

statement ok
CREATE DATABASE db_08_clone_at

statement ok
USE db_08_clone_at

statement ok
SET data_retention_time_in_days = 0

statement ok
SET data_retention_num_snapshots_to_keep = 1

statement ok
CREATE TABLE source(id INT, payload STRING)

statement ok
INSERT INTO source VALUES (1, 'first')

statement ok
SET VARIABLE first_time = (
    SELECT timestamp FROM fuse_snapshot('db_08_clone_at', 'source')
    ORDER BY timestamp DESC LIMIT 1
)

# Quoted tag names must keep their case when resolving CLONE AT.
statement ok
ALTER TABLE source CREATE TAG "Original"

statement ok
CREATE TABLE offset_clone CLONE source AT (OFFSET => 0)

statement ok
ALTER TABLE source ADD COLUMN evolved STRING

statement ok
INSERT INTO source VALUES (2, 'second', 'new')

statement ok
CREATE TABLE timestamp_clone CLONE source AT (TIMESTAMP => $first_time::TIMESTAMP)

statement ok
CREATE TABLE tag_clone CLONE source AT (TAG => "Original")

query IT
SELECT * FROM timestamp_clone
----
1 first

query IT
SELECT * FROM tag_clone
----
1 first

query IT
SELECT * FROM offset_clone
----
1 first

query I
SELECT count(*) FROM system.columns
WHERE database = 'db_08_clone_at'
  AND "table" IN ('timestamp_clone', 'offset_clone', 'tag_clone')
  AND name = 'evolved'
----
0

statement error 2745
CREATE TABLE missing_tag_clone CLONE source AT (TAG => missing)

# STREAM remains unsupported even though the shared AT parser accepts it.
statement ok
CREATE STREAM source_stream ON TABLE source

statement error .*CREATE TABLE CLONE does not support AT.*STREAM.*
CREATE TABLE stream_clone CLONE source AT (STREAM => source_stream)

statement ok
DROP STREAM source_stream

statement ok
VACUUM TABLE source

# A tag still permits reads below LVT, but cannot bypass CLONE's publication fence.
query IT
SELECT * FROM source AT (TAG => "Original")
----
1 first

statement error 2327
CREATE TABLE expired_tag_clone CLONE source AT (TAG => "Original")

statement error 2013
CREATE TABLE expired_timestamp_clone CLONE source AT (TIMESTAMP => $first_time::TIMESTAMP)

query I
SELECT count(*) FROM system.tables
WHERE database = 'db_08_clone_at'
  AND name IN ('missing_tag_clone', 'stream_clone', 'expired_tag_clone', 'expired_timestamp_clone')
----
0

# Removing the tag and purging the source must not reclaim data used by any AT clone.
statement ok
ALTER TABLE source DROP TAG "Original"

statement ok
TRUNCATE TABLE source

statement ok
INSERT INTO source VALUES (3, 'third', 'head')

statement ok
OPTIMIZE TABLE source PURGE

query IT
SELECT * FROM timestamp_clone
----
1 first

query IT
SELECT * FROM tag_clone
----
1 first

query IT
SELECT * FROM offset_clone
----
1 first

query I
SELECT id FROM source
----
3

statement ok
DROP DATABASE db_08_clone_at
