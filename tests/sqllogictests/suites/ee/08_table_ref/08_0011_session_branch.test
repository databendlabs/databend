statement ok
set enable_experimental_table_ref=1;

statement ok
DROP DATABASE IF EXISTS test_session_branch

statement ok
CREATE DATABASE test_session_branch

statement ok
USE test_session_branch

statement ok
CREATE TABLE t1(a INT, b STRING)

statement ok
INSERT INTO t1 VALUES (1, 'a'), (2, 'b')

statement ok
ALTER TABLE t1 CREATE BRANCH dev

statement ok
ALTER TABLE t1 CREATE BRANCH other

statement ok
INSERT INTO t1/dev VALUES (3, 'c')

statement ok
INSERT INTO t1/other VALUES (5, 'e')

statement ok
CREATE TABLE t_no_branch(a INT, c STRING)

statement ok
INSERT INTO t_no_branch VALUES (3, 'base_only')

statement ok
CREATE TABLE t_memory(a INT) ENGINE = Memory

statement ok
INSERT INTO t_memory VALUES (7)

statement ok
CREATE TEMP TABLE t_temp(a INT)

statement ok
INSERT INTO t_temp VALUES (8)

## Empty `session_branch`: normal behavior.
query IT
SELECT * FROM t1 ORDER BY a
----
1 a
2 b

statement ok
SET session_branch = 'dev'

## Reads use an existing session branch.
query IT
SELECT * FROM t1 ORDER BY a
----
1 a
2 b
3 c

## Every eligible table must have the session branch; queries never mix branch and base tables.
statement error .*Unknown branch 'dev'.*
SELECT t1.a, t_no_branch.c FROM t1 JOIN t_no_branch ON t1.a = t_no_branch.a ORDER BY t1.a

## FUSE writes use an existing session branch.
statement ok
INSERT INTO t1 VALUES (4, 'd')

## Unqualified reads continue to use the session branch.
query IT
SELECT * FROM t1 ORDER BY a
----
1 a
2 b
3 c
4 d

## Mutations use the existing session branch.
statement ok
UPDATE t1 SET b = 'branch_updated' WHERE a = 1

query IT
SELECT * FROM t1/dev WHERE a = 1
----
1 branch_updated

## Base table is unchanged.
statement ok
UNSET session_branch

query IT
SELECT * FROM t1 ORDER BY a
----
1 a
2 b

## Explicit branch targets take precedence over `session_branch`.
statement ok
SET session_branch = 'dev'

query IT
SELECT * FROM t1/other ORDER BY a
----
1 a
2 b
5 e

statement ok
INSERT INTO t1/other VALUES (6, 'explicit')

query IT
SELECT * FROM t1/other ORDER BY a
----
1 a
2 b
5 e
6 explicit

## Explicit branch destructive writes take precedence over `session_branch`.
statement ok
TRUNCATE TABLE t1/other

query I
SELECT count() FROM t1/other
----
0

query IT
SELECT * FROM t1/dev ORDER BY a
----
1 branch_updated
2 b
3 c
4 d

## Missing session branches fail for reads and writes.
statement ok
UNSET session_branch

statement ok
SET session_branch = 'nonexistent'

statement error .*Unknown branch 'nonexistent'.*
INSERT INTO t1 VALUES (99, 'fail')

statement error .*Unknown branch 'nonexistent'.*
SHOW STATISTICS FROM TABLE t1

## Engines without branch support ignore `session_branch` for reads; writes remain fail-closed.
statement ok
UNSET session_branch

statement ok
SET session_branch = 'dev'

statement error .*Unknown branch 'dev'.*
INSERT INTO t_memory VALUES (8)

query I
SELECT * FROM t_memory ORDER BY a
----
7

## Temp tables are not branch-routed.
statement ok
INSERT INTO t_temp VALUES (9)

query I
SELECT * FROM t_temp ORDER BY a
----
8
9

## Persisted definitions ignore `session_branch` and resolve base tables; an
## explicit `table/branch` inside a body still wins.
statement ok
ALTER TABLE t_no_branch CREATE BRANCH dev

statement ok
ALTER TABLE t_no_branch/dev ADD COLUMN d INT

statement ok
UPDATE t_no_branch/dev SET d = 30 WHERE a = 3

statement ok
INSERT INTO t_no_branch/dev VALUES (4, 'branch_only', 40)

statement ok
SET session_branch = 'dev'

## DESCRIBE and SHOW FIELDS follow `session_branch`.
query TTTTT
DESCRIBE t_no_branch
----
a INT YES NULL (empty)
c VARCHAR YES NULL (empty)
d INT YES NULL (empty)

query TTTTT
SHOW FIELDS FROM t_no_branch
----
a INT YES NULL (empty)
c VARCHAR YES NULL (empty)
d INT YES NULL (empty)

query TTTT??
SHOW COLUMNS FROM t_no_branch
----
a int YES (empty) NULL NULL
c varchar(16382) YES (empty) NULL NULL
d int YES (empty) NULL NULL

## DESCRIBE and SHOW COLUMNS apply the session branch to branch-capable tables without fallback.
statement ok
SET session_branch = 'nonexistent'

statement error .*Unknown branch 'nonexistent'.*
DESCRIBE t_no_branch

statement error .*Unknown branch 'nonexistent'.*
SHOW COLUMNS FROM t_no_branch

## Engines without branch support ignore the session branch.
query TTTTT
DESCRIBE t_memory
----
a INT YES NULL (empty)

## An explicit branch takes precedence over `session_branch`.
query TTTTT
DESCRIBE t_no_branch/dev
----
a INT YES NULL (empty)
c VARCHAR YES NULL (empty)
d INT YES NULL (empty)

query TTTTT
SHOW FIELDS FROM t_no_branch/dev
----
a INT YES NULL (empty)
c VARCHAR YES NULL (empty)
d INT YES NULL (empty)

query TTTT??
SHOW COLUMNS FROM t_no_branch/dev
----
a int YES (empty) NULL NULL
c varchar(16382) YES (empty) NULL NULL
d int YES (empty) NULL NULL

statement ok
SET session_branch = 'dev'

## CREATE/ALTER VIEW are allowed under a branch session; the body resolves to base.
statement ok
CREATE VIEW v_session(a, c) AS SELECT a, c FROM t_no_branch

statement ok
ALTER VIEW v_session(a, c) AS SELECT a, c FROM t_no_branch

## CREATE/REFRESH AGGREGATING INDEX are allowed under a branch session; the index
## query resolves base, anchoring materialized data to the base table.
statement ok
DROP AGGREGATING INDEX IF EXISTS idx_session_base

statement ok
CREATE AGGREGATING INDEX idx_session_base AS SELECT SUM(a) FROM t_no_branch

statement ok
REFRESH AGGREGATING INDEX idx_session_base

## Dynamic tables stay rejected under a branch session: branch refresh semantics are
## not defined yet.
statement error .*session_branch.*
CREATE DYNAMIC TABLE dt_session TARGET_LAG = DOWNSTREAM WAREHOUSE = 'wh' AS SELECT * FROM t_no_branch

## The view body ignores the session branch and returns base data.
query IT
SELECT * FROM v_session ORDER BY a
----
3 base_only

## A directly invoked SQL UDTF inherits `session_branch`.
statement ok
CREATE OR REPLACE FUNCTION session_direct_udtf() RETURNS TABLE (a INT, c STRING) AS $$ SELECT a, c FROM t_no_branch $$

statement ok
SET session_branch = 'dev'

query IT
SELECT * FROM session_direct_udtf() ORDER BY a
----
3 base_only
4 branch_only

## A SQL UDTF invoked from a persisted view inherits the view's effective session branch
## suppression. SELECT * deliberately distinguishes the base schema (a, c) from
## the dev schema (a, c, d), so lost suppression also causes a schema mismatch.
statement ok
CREATE OR REPLACE FUNCTION session_view_udtf() RETURNS TABLE (a INT, c STRING) AS $$ SELECT * FROM t_no_branch $$

statement ok
SET session_branch = 'dev'

statement ok
CREATE VIEW v_session_udtf AS SELECT * FROM session_view_udtf()

query IT
SELECT * FROM v_session_udtf ORDER BY a
----
3 base_only

query I
SELECT count(*) FROM system.columns WHERE database = 'test_session_branch' AND `table` = 'v_session_udtf' AND branch = ''
----
2

statement ok
DROP VIEW v_session_udtf

statement ok
DROP FUNCTION session_view_udtf

statement ok
DROP FUNCTION session_direct_udtf

statement ok
UNSET session_branch

statement ok
DROP AGGREGATING INDEX IF EXISTS idx_session_base

## A base-table aggregating index must not satisfy a session branch query.
statement ok
SET enable_aggregating_index_scan = 1

statement ok
CREATE AGGREGATING INDEX idx_session_scan AS SELECT SUM(a) FROM t_no_branch

statement ok
REFRESH AGGREGATING INDEX idx_session_scan

## No branch: base SUM(a) over base rows.
query I
SELECT SUM(a) FROM t_no_branch
----
3

statement ok
SET session_branch = 'dev'

## Branch read must reflect branch data (3 + 4 = 7), not the base index (3).
query I
SELECT SUM(a) FROM t_no_branch
----
7

statement ok
UNSET session_branch

statement ok
DROP AGGREGATING INDEX idx_session_scan

statement ok
SET enable_aggregating_index_scan = 0

## An explicit `table/branch` inside a view body is always honored, independent of
## `session_branch`.
statement ok
CREATE VIEW v_branch(a, c) AS SELECT a, c FROM t_no_branch/dev

statement ok
SET session_branch = 'dev'

query IT
SELECT * FROM v_branch ORDER BY a
----
3 base_only
4 branch_only

statement ok
UNSET session_branch

statement ok
DROP VIEW v_branch

## Schema inference for a `SELECT *` view must ignore `session_branch` and
## resolve base (a, c), not the dev branch's extra `d`. All suppressed-planning entry
## points must agree: system.columns, DESCRIBE VIEW, DESCRIBE <view>,
## system.statistics, and CREATE TABLE ... LIKE view.
statement ok
CREATE VIEW v_star AS SELECT * FROM t_no_branch

statement ok
SET session_branch = 'dev'

## Under `session_branch=dev` the body still resolves base: 2 columns, base data.
query IT
SELECT * FROM v_star ORDER BY a
----
3 base_only

query I
SELECT count(*) FROM system.columns WHERE database = 'test_session_branch' AND `table` = 'v_star' AND branch = ''
----
2

query TTTTT
DESCRIBE VIEW v_star
----
a INT YES NULL (empty)
c VARCHAR YES NULL (empty)

query TTTTT
DESCRIBE v_star
----
a INT YES NULL (empty)
c VARCHAR YES NULL (empty)

query I
SELECT count(*) FROM system.statistics WHERE database = 'test_session_branch' AND `table` = 'v_star' AND branch = ''
----
2

## CREATE TABLE LIKE view must persist the base schema (2 columns).
statement ok
CREATE TABLE t_like_v_star LIKE v_star

query I
SELECT count(*) FROM system.columns WHERE database = 'test_session_branch' AND `table` = 't_like_v_star' AND branch = ''
----
2

statement ok
DROP TABLE t_like_v_star

statement ok
UNSET session_branch

statement ok
DROP VIEW v_star

## CREATE/ALTER VIEW validation resolves base tables, not the session branch.
## (1) A body referencing a branch-only column is rejected: it does not exist on base.
statement ok
SET session_branch = 'dev'

statement error
CREATE VIEW v_reject AS SELECT a, d FROM t_no_branch

## (2) A base-valid `SELECT *` with column aliases must not be rejected by a column
## count mismatch against the wider branch schema. Base has 2 columns.
statement ok
CREATE VIEW v_alias(x, y) AS SELECT * FROM t_no_branch

query TTTTT
DESCRIBE VIEW v_alias
----
x INT YES NULL (empty)
y VARCHAR YES NULL (empty)

statement ok
UNSET session_branch

statement ok
DROP VIEW v_alias

## Explicit branch CHANGES keeps its branch after the internal rewrite.
statement ok
CREATE TABLE t_changes(a INT, b STRING)

statement ok
INSERT INTO t_changes VALUES (1, 'base')

statement ok
ALTER TABLE t_changes CREATE BRANCH dev

statement ok
ALTER TABLE t_changes CREATE BRANCH other

statement ok
INSERT INTO t_changes/dev VALUES (10, 'dev_before_stream')

statement ok
INSERT INTO t_changes/other VALUES (20, 'other_before_stream')

statement ok
CREATE STREAM s_changes_other ON TABLE t_changes/other APPEND_ONLY = true

statement ok
INSERT INTO t_changes/dev VALUES (11, 'dev_after_stream')

statement ok
INSERT INTO t_changes/other VALUES (21, 'other_after_stream')

query ITTB
SELECT a, b, change$action, change$is_update FROM t_changes/other CHANGES(INFORMATION => APPEND_ONLY) AT(STREAM => s_changes_other) ORDER BY a
----
21 other_after_stream INSERT 0

statement ok
SET session_branch = 'dev'

## CTAS reads through the session branch; metadata DDL still targets the base table.
statement ok
CREATE TABLE t_ctas AS SELECT * FROM t1

query IT
SELECT * FROM t_ctas ORDER BY a
----
1 branch_updated
2 b
3 c
4 d

statement ok
ALTER TABLE t1 COMMENT='session ddl keeps base semantics'

## Branch management keeps its base-table semantics under `session_branch`.
statement ok
ALTER TABLE t1 CREATE BRANCH another

statement ok
ALTER TABLE t1 DROP BRANCH another

statement ok
DROP TABLE t_ctas

## TRUNCATE is a destructive write and uses the session branch.
statement ok
TRUNCATE TABLE t1

query I
SELECT count() FROM t1/dev
----
0

statement ok
UNSET session_branch

query IT
SELECT * FROM t1 ORDER BY a
----
1 a
2 b

query T
SELECT comment FROM system.tables WHERE database = 'test_session_branch' AND name = 't1'
----
session ddl keeps base semantics

## Planner cache must distinguish the same SQL text across `session_branch` values. The
## cache validates session setting changes, and `session_branch` is a session setting, so a
## base-resolved plan is never reused for a branch-routed read (or vice versa).
statement ok
SET enable_planner_cache = 1

statement ok
CREATE TABLE t_cache(a INT)

statement ok
INSERT INTO t_cache VALUES (1)

statement ok
ALTER TABLE t_cache CREATE BRANCH dev

statement ok
INSERT INTO t_cache/dev VALUES (2)

## Prime the cache with no branch: resolves to base.
query I
SELECT * FROM t_cache ORDER BY a
----
1

## Same SQL text under `session_branch=dev` must route to the branch, not reuse the base plan.
statement ok
SET session_branch = 'dev'

query I
SELECT * FROM t_cache ORDER BY a
----
1
2

## Metadata reads use the same session branch.
query TTTIIIITTIT
SHOW STATISTICS FROM TABLE t_cache
----
test_session_branch t_cache/dev a 2 2 2 0 1 2 4 (empty)

statement ok
SET enable_planner_cache = 0

statement ok
DROP TABLE t_cache

## Suppressed planning must bypass the planner cache: a branch-routed plan for the
## same stored view SQL must not be reused for view schema inference.
statement ok
SET enable_planner_cache = 1

statement ok
CREATE VIEW v_cache_star AS SELECT * FROM t_no_branch

statement ok
SET session_branch = 'dev'

## This exact text matches the stored view body, priming the branch-routed plan
## under the same cache key.
query ITI rowsort
SELECT * FROM test_session_branch.t_no_branch
----
3 base_only 30
4 branch_only 40

query I
SELECT count(*) FROM system.columns WHERE database = 'test_session_branch' AND `table` = 'v_cache_star' AND branch = ''
----
2

statement ok
UNSET session_branch

statement ok
SET enable_planner_cache = 0

statement ok
DROP VIEW v_cache_star

## Regression: an auto-materialized CTE inside a persisted definition must inherit the
## suppression context. A CTE referenced more than once is auto-materialized; its
## producer is bound in a fresh context that previously dropped
## binding_views/suppress_session_branch and read the session branch. Must resolve base.
statement ok
SET enable_auto_materialize_cte = 1

statement ok
CREATE VIEW v_mcte(a, c) AS WITH c AS (SELECT * FROM t_no_branch) SELECT c1.a, c1.c FROM c c1 JOIN c c2 ON c1.a = c2.a

query IT
SELECT * FROM v_mcte ORDER BY a
----
3 base_only

statement ok
SET session_branch = 'dev'

## Under `session_branch=dev` the materialized CTE producer must still resolve base, so the
## view returns base data (single row), not the dev branch.
query IT
SELECT * FROM v_mcte ORDER BY a
----
3 base_only

## Suppressed schema inference (system.columns) must report the base schema (2).
query I
SELECT count(*) FROM system.columns WHERE database = 'test_session_branch' AND `table` = 'v_mcte' AND branch = ''
----
2

statement ok
UNSET session_branch

statement ok
DROP VIEW v_mcte

## A view body with JOIN/WHERE subqueries must keep session branch suppression after
## BindContext::replace(). The dev branch has a=4; the base table does not.
statement ok
CREATE VIEW v_join AS SELECT l.a, l.c FROM t_no_branch l JOIN t_no_branch r ON l.a = r.a WHERE EXISTS (SELECT 1 FROM t_no_branch s WHERE s.a = 4)

statement ok
SET session_branch = 'dev'

query I
SELECT count(*) FROM v_join
----
0

query I
SELECT count(*) FROM system.columns WHERE database = 'test_session_branch' AND `table` = 'v_join' AND branch = ''
----
2

statement ok
UNSET session_branch

statement ok
DROP VIEW v_join

## Internal ALTER TABLE maintenance replans must target the ALTER plan table, not
## `session_branch`.
statement ok
CREATE TABLE t_ddl_replan(a INT)

statement ok
INSERT INTO t_ddl_replan VALUES (1)

statement ok
ALTER TABLE t_ddl_replan CREATE BRANCH dev

statement ok
SET session_branch = 'dev'

## The generated UPDATE for uuid() must update base, not t_ddl_replan/dev.
statement ok
ALTER TABLE t_ddl_replan ADD COLUMN b STRING DEFAULT uuid()

statement ok
UNSET session_branch

query IB
SELECT a, b IS NOT NULL FROM t_ddl_replan
----
1 1

query I
SELECT * FROM t_ddl_replan/dev
----
1

## Explicit branch in generated UPDATE still wins under a different session branch.
statement ok
ALTER TABLE t_ddl_replan CREATE BRANCH other

statement ok
SET session_branch = 'other'

statement ok
ALTER TABLE t_ddl_replan/dev ADD COLUMN c STRING DEFAULT uuid()

statement ok
UNSET session_branch

query IB
SELECT a, c IS NOT NULL FROM t_ddl_replan/dev
----
1 1

query IB
SELECT a, b IS NOT NULL FROM t_ddl_replan/other
----
1 1

statement ok
DROP TABLE t_ddl_replan

## The generated SELECT->INSERT rewrite must also suppress `session_branch`.
statement ok
CREATE TABLE t_ddl_rewrite(a INT, c STRING)

statement ok
INSERT INTO t_ddl_rewrite VALUES (1, 'base')

statement ok
ALTER TABLE t_ddl_rewrite CREATE BRANCH dev

statement ok
INSERT INTO t_ddl_rewrite/dev VALUES (2, 'branch')

statement ok
SET session_branch = 'dev'

statement ok
ALTER TABLE t_ddl_rewrite ADD COLUMN s STRING AS (concat(c, '-stored')) STORED

statement ok
UNSET session_branch

query ITT
SELECT a, c, s FROM t_ddl_rewrite ORDER BY a
----
1 base base-stored

query IT
SELECT * FROM t_ddl_rewrite/dev ORDER BY a
----
1 base
2 branch

statement ok
DROP TABLE t_ddl_rewrite

## ANALYZE histogram replans must read the analyze target, not the session branch.
statement ok
SET enable_analyze_histogram = 1

statement ok
SET enable_table_snapshot_stats = 1

statement ok
SET session_branch = 'dev'

statement ok
ANALYZE TABLE t_no_branch

statement ok
