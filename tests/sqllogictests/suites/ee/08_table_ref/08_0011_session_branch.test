query B
SELECT histogram LIKE '%min: "3"%' AND histogram NOT LIKE '%min: "4"%' FROM system.statistics WHERE database = 'test_session_branch' AND `table` = 't_no_branch' AND branch = '' AND column_name = 'a'
----
1

statement ok
SET enable_analyze_histogram = 0

statement ok
SET enable_table_snapshot_stats = 0

## Guard: an explicit MATERIALIZED CTE cannot live in a persisted view body
## (CREATE/ALTER VIEW validate with a Planner that has no subquery executor, so the
## CTAS errors first). This is why `m_cte_to_temp_table` need not forward session branch
## suppression. If this ever passes, restore that forwarding (see NOTE in bind.rs).
statement error
CREATE VIEW v_mat_cte_in_view_rejected AS WITH c AS MATERIALIZED (SELECT a, c FROM t_no_branch) SELECT a FROM c

statement ok
DROP DATABASE test_session_branch
