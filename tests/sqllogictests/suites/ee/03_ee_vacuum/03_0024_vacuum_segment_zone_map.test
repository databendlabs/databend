# Segment zone map files (`_zm`) follow the segments: vacuum2 removes the ones no
# retained snapshot points to and keeps the one the gc root points to.

statement ok
drop database if exists vacuum2_zm;

statement ok
create database vacuum2_zm;

statement ok
use vacuum2_zm;

statement ok
set data_retention_time_in_days = 0;

statement ok
set enable_compact_after_write = 0;

statement ok
set segment_zone_map_full_segment_threshold = 0;

# The stage lists the table's storage root; clear what an earlier run left there.
statement ok
create or replace stage stage_zm url = 'fs:///tmp/vacuum2_zm/';

statement ok
remove @stage_zm;

statement ok
create or replace table t (c int) 'fs:///tmp/vacuum2_zm/' cluster by (c) block_per_segment = 1;

# Every recluster round refreshes the zone map: three files, each snapshot
# after a refresh points at a newer one. Two overlapping inserts give each
# round one block to merge.
statement ok
insert into t values(1), (3);

statement ok
insert into t values(2), (4);

statement ok
optimize table t recluster;

statement ok
insert into t values(11), (13);

statement ok
insert into t values(12), (14);

statement ok
optimize table t recluster;

statement ok
insert into t values(21), (23);

statement ok
insert into t values(22), (24);

statement ok
optimize table t recluster;

query I
select count() from list_stage(location => '@stage_zm') where name like '%/_zm/%';
----
3

query I
select count(*) from fuse_vacuum2('vacuum2_zm', 't');
----
0

# Retention is zero, so only the zone map the latest snapshot points to survives.
query I
select count() from list_stage(location => '@stage_zm') where name like '%/_zm/%';
----
1

query B
select right((select segment_zone_map_location from fuse_snapshot('vacuum2_zm', 't') order by timestamp desc limit 1), length(name)) = name from list_stage(location => '@stage_zm') where name like '%/_zm/%';
----
1

# The surviving zone map is intact and still prunes.
query T
explain select c from t where c = 100;
----
<slt:ignore>partitions scanned: 0<slt:ignore>zone map pruning: <slt:ignore>

query I
select c from t where c = 23;
----
23

# After a truncate nothing points at a zone map any more; vacuum removes them all.
statement ok
truncate table t;

query I
select count(*) from fuse_vacuum2('vacuum2_zm', 't');
----
0

query I
select count() from list_stage(location => '@stage_zm') where name like '%/_zm/%';
----
0

query I
select count(*) from t;
----
0

statement ok
remove @stage_zm;

statement ok
drop stage stage_zm;

statement ok
unset segment_zone_map_full_segment_threshold;

statement ok
unset enable_compact_after_write;

statement ok
unset data_retention_time_in_days;

statement ok
drop database vacuum2_zm;
