statement ok
CREATE DATABASE vacuum_idle_snapshot

statement ok
USE vacuum_idle_snapshot

statement ok
SET enable_auto_vacuum = 0

statement ok
SET data_retention_time_in_days = 0

statement ok
CREATE TABLE t(c INT) AS SELECT 1

statement ok
CREATE TABLE previous_head ENGINE = MEMORY AS
SELECT snapshot_id FROM fuse_snapshot('vacuum_idle_snapshot', 't') ORDER BY timestamp DESC LIMIT 1

# An empty probe must preserve the head.
statement ok
VACUUM TABLE t

query I
SELECT count(*) FROM fuse_snapshot('vacuum_idle_snapshot', 't')
----
1

query I
SELECT count(*) FROM fuse_snapshot('vacuum_idle_snapshot', 't')
WHERE snapshot_id IN (SELECT snapshot_id FROM previous_head)
----
1

# Rollback leaves an uncommitted block newer than the head.
statement ok
BEGIN

statement ok
INSERT INTO t VALUES (2)

statement ok
ROLLBACK

statement ok
SELECT sleep(0.01)

# A single vacuum must advance the head and collect the orphan.
statement ok
VACUUM TABLE t

query I
SELECT count(*) FROM fuse_snapshot('vacuum_idle_snapshot', 't')
----
1

query I
SELECT count(*) FROM
    (SELECT snapshot_id FROM fuse_snapshot('vacuum_idle_snapshot', 't') ORDER BY timestamp DESC LIMIT 1)
WHERE snapshot_id IN (SELECT snapshot_id FROM previous_head)
----
0

statement ok
TRUNCATE TABLE previous_head

statement ok
INSERT INTO previous_head
SELECT snapshot_id FROM fuse_snapshot('vacuum_idle_snapshot', 't')

# An already cleaned table must not advance again.
statement ok
VACUUM TABLE t

query I
SELECT count(*) FROM fuse_snapshot('vacuum_idle_snapshot', 't')
WHERE snapshot_id IN (SELECT snapshot_id FROM previous_head)
----
1

query I
SELECT c FROM t
----
1

statement ok
DROP DATABASE vacuum_idle_snapshot
