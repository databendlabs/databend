# Named connections share this file's sandbox, but keep independent transactions.
# A write begun before the first CLONE has no clone-group LVT fence. Source-refresh
# retry must still reject it when a concurrent head passes its logical timestamp.
statement ok
CREATE DATABASE first_clone_transaction

# Keep the ordinary-table object timestamp delta at zero, regardless of CI config.
statement ok
SET max_execute_time_in_seconds = 0

statement ok
SET data_retention_time_in_days = 0

statement ok
SET data_retention_num_snapshots_to_keep = 1

statement ok
SET auto_compaction_imperfect_blocks_threshold = 0

statement ok
SET enable_auto_analyze = 0

connection writer
statement ok
SET enable_experimental_clone_table = 1

connection writer
statement ok
SET max_execute_time_in_seconds = 0

connection writer
statement ok
SET data_retention_time_in_days = 0

connection writer
statement ok
SET data_retention_num_snapshots_to_keep = 1

connection writer
statement ok
SET auto_compaction_imperfect_blocks_threshold = 0

connection writer
statement ok
SET enable_auto_analyze = 0

# First isolate the logical-timestamp guard, without GC obscuring its error.
statement ok
CREATE TABLE first_clone_transaction.guard_source(id INT)

statement ok
INSERT INTO first_clone_transaction.guard_source VALUES (1)

statement ok
BEGIN

statement ok
INSERT INTO first_clone_transaction.guard_source VALUES (2)

connection writer
statement ok
CREATE TABLE first_clone_transaction.guard_clone CLONE first_clone_transaction.guard_source

# Two commits ensure a strictly later snapshot even at millisecond precision,
# without coordinating this test using a sleep.
connection writer
statement ok
INSERT INTO first_clone_transaction.guard_source VALUES (3)

connection writer
statement ok
INSERT INTO first_clone_transaction.guard_source VALUES (4)

statement error .*4001.*txn started with logical timestamp.*
COMMIT

query I
SELECT id FROM first_clone_transaction.guard_source ORDER BY id
----
1
3
4

query I
SELECT id FROM first_clone_transaction.guard_clone
----
1

# Repeat from a fresh, ordinary source; this time VACUUM advances the fence and
# may delete the still-unpublished transaction objects before COMMIT retries.
statement ok
CREATE TABLE first_clone_transaction.vacuum_source(id INT)

statement ok
INSERT INTO first_clone_transaction.vacuum_source VALUES (1)

statement ok
BEGIN

statement ok
INSERT INTO first_clone_transaction.vacuum_source VALUES (2)

connection writer
statement ok
CREATE TABLE first_clone_transaction.vacuum_clone CLONE first_clone_transaction.vacuum_source

connection writer
statement ok
INSERT INTO first_clone_transaction.vacuum_source VALUES (3)

connection writer
statement ok
INSERT INTO first_clone_transaction.vacuum_source VALUES (4)

connection writer
statement ok
VACUUM TABLE first_clone_transaction.vacuum_source

# Check GC was not a no-op through the non-transactional writer connection.
connection writer
query I
SELECT count(*) FROM fuse_snapshot('first_clone_transaction', 'vacuum_source')
----
1

# GC can make the pending snapshot unreadable before the timestamp guard runs.
# Either the guard (4001) or unavailable-history read (3001/2013) must abort;
# COMMIT must never publish references to its reclaimed objects.
statement error .*(4001|3001|2013).*
COMMIT

query I
SELECT id FROM first_clone_transaction.vacuum_source ORDER BY id
----
1
3
4

query I
SELECT id FROM first_clone_transaction.vacuum_clone
----
1

statement ok
DROP DATABASE first_clone_transaction
