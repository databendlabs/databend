statement ok
SET enable_experimental_clone_table = 1

statement ok
DROP DATABASE IF EXISTS db_03_vacuum_clone

statement ok
CREATE DATABASE db_03_vacuum_clone

statement ok
USE db_03_vacuum_clone

statement ok
SET data_retention_time_in_days = 0

statement ok
CREATE TABLE source(id INT)

statement ok
INSERT INTO source VALUES (1)

statement ok
CREATE TABLE clone CLONE source

statement ok
CREATE TABLE chained CLONE clone

# The feature gate controls new clones, not protection of existing bindings.
statement ok
SET enable_experimental_clone_table = 0

# The source head no longer references the cloned data.
statement ok
TRUNCATE TABLE source

statement ok
INSERT INTO source VALUES (2)

statement ok
VACUUM TABLE source

query I
SELECT id FROM clone ORDER BY id
----
1

query I
SELECT id FROM chained ORDER BY id
----
1

statement ok
SET enable_experimental_clone_table = 1

# Vacuuming a newer group member must not expire an older live member's current head.
statement ok
CREATE TABLE post_vacuum_child CLONE clone

query I
SELECT id FROM post_vacuum_child ORDER BY id
----
1

# Vacuuming a middle clone must preserve data retained only by its child.
statement ok
TRUNCATE TABLE clone

statement ok
INSERT INTO clone VALUES (3)

statement ok
VACUUM TABLE clone

query I
SELECT id FROM clone ORDER BY id
----
3

query I
SELECT id FROM chained ORDER BY id
----
1

# OPTIMIZE ... PURGE must preserve source-owned data referenced by sibling clones.
statement ok
SET data_retention_num_snapshots_to_keep = 1

statement ok
CREATE TABLE purge_source(id INT)

statement ok
INSERT INTO purge_source VALUES (1)

statement ok
CREATE TABLE left_clone CLONE purge_source

statement ok
CREATE TABLE right_clone CLONE purge_source

statement ok
CREATE TABLE left_child CLONE left_clone

statement ok
TRUNCATE TABLE purge_source

statement ok
INSERT INTO purge_source VALUES (4)

statement ok
OPTIMIZE TABLE purge_source PURGE

query I
SELECT id FROM left_clone ORDER BY id
----
1

query I
SELECT id FROM right_clone ORDER BY id
----
1

# Purging a middle clone must preserve data retained only by its child.
statement ok
TRUNCATE TABLE left_clone

statement ok
INSERT INTO left_clone VALUES (5)

statement ok
OPTIMIZE TABLE left_clone PURGE

query I
SELECT id FROM left_child ORDER BY id
----
1

query I
SELECT id FROM left_clone ORDER BY id
----
5

query I
SELECT id FROM right_clone ORDER BY id
----
1

query I
SELECT id FROM purge_source ORDER BY id
----
4

# Dropped-index cleanup must not remove a source index version still used by a clone.
statement ok
CREATE TABLE index_source(content STRING)

statement ok
INSERT INTO index_source VALUES ('clone token')

statement ok
CREATE INVERTED INDEX clone_idx ON index_source(content)

statement ok
REFRESH INVERTED INDEX clone_idx ON index_source

statement ok
CREATE TABLE index_clone CLONE index_source

statement ok
CREATE TABLE index_grandchild CLONE index_clone

# Ordinary vacuum on the owner and a child must preserve clone-only index files too.
statement ok
TRUNCATE TABLE index_source

statement ok
INSERT INTO index_source VALUES ('replacement')

statement ok
VACUUM TABLE index_source

statement ok
VACUUM TABLE index_clone

statement ok
DROP INVERTED INDEX clone_idx ON index_source

# Replacing the child's same-name index releases the old version only on that child.
statement ok
CREATE OR REPLACE INVERTED INDEX clone_idx ON index_clone(content) index_record = 'basic'

statement ok
REFRESH INVERTED INDEX clone_idx ON index_clone

# The grandchild still uses the old version; checking only direct children would delete it.
query I
SELECT count() FROM fuse_vacuum_drop_inverted_index('db_03_vacuum_clone', 'index_source')
----
0

query I
SELECT count() FROM index_grandchild WHERE match(content, 'clone')
----
1

# Removing the last inherited definition allows cleanup while both descendants remain alive.
statement ok
DROP INVERTED INDEX clone_idx ON index_grandchild

query I
SELECT count() FROM fuse_vacuum_drop_inverted_index('db_03_vacuum_clone', 'index_source')
----
1

# The child's replacement version must remain usable after the old version is removed.
query I
SELECT count() FROM index_clone WHERE match(content, 'token')
----
1

query I
SELECT count() FROM index_grandchild
----
1

# Ancestor session retention must not shorten the descendant's default history.
statement ok
CREATE TABLE retention_source(id INT)

statement ok
INSERT INTO retention_source VALUES (1)

statement ok
CREATE TABLE retention_clone CLONE retention_source

statement ok
SET VARIABLE retention_anchor = (
    SELECT snapshot_id FROM fuse_snapshot('db_03_vacuum_clone', 'retention_clone')
    ORDER BY timestamp LIMIT 1
)

statement ok
INSERT INTO retention_clone VALUES (2)

statement ok
TRUNCATE TABLE retention_source

statement ok
INSERT INTO retention_source VALUES (3)

statement ok
VACUUM TABLE retention_source

statement ok
ALTER TABLE retention_clone FLASHBACK TO (SNAPSHOT => $retention_anchor)

# An explicit descendant table policy, unlike the ancestor session setting, advances its fence.
statement ok
INSERT INTO retention_clone VALUES (4)

statement ok
ALTER TABLE retention_clone SET OPTIONS(data_retention_num_snapshots_to_keep = 1)

statement ok
INSERT INTO retention_source VALUES (5)

statement ok
VACUUM TABLE retention_source

statement error 2327
ALTER TABLE retention_clone FLASHBACK TO (SNAPSHOT => $retention_anchor)

statement ok
UNSET VARIABLE retention_anchor

# Only clone-group members gain the historical-publication fence. Add the TAG after earlier GC
# assertions so its pin cannot mask a failure to protect clone references.
statement ok
SET enable_experimental_table_ref = 1

statement ok
ALTER TABLE source CREATE TAG saved

statement ok
INSERT INTO source VALUES (5)

statement ok
VACUUM TABLE source

query I
SELECT count(*) FROM source AT (TAG => saved)
----
1

statement error (?s).*Cannot FLASHBACK to TAG 'saved'.*clone group.*below.*LVT.*preserves historical reads.*
ALTER TABLE source FLASHBACK TO (TAG => saved)

# A rejected FLASHBACK leaves the source head unchanged.
query I
SELECT count(*) FROM source
----
2

statement ok
DROP DATABASE db_03_vacuum_clone
