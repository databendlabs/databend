## ATTACH preserves source string-statistics settings and rewrites aggregates
## only when their bounds are provably exact.
## The safety marker is internal metadata, not a user-settable table option.
statement error table option attach_stats_truncate_len_known reserved
CREATE TABLE attach_stats_invalid(s STRING) attach_stats_truncate_len_known='true';

statement ok
DROP TABLE IF EXISTS attach_stats_target;

statement ok
DROP TABLE IF EXISTS attach_stats_source;

statement ok
CREATE TABLE attach_stats_source(id INT, s STRING STATS_TRUNCATE_LEN 4)
'fs:///tmp/attach_string_statistics/' row_per_block=100;

statement ok
INSERT INTO attach_stats_source VALUES (1, repeat('👍', 17));

## The stored min/max contain four characters, not the original 17.
query II
SELECT char_length(statistics:min::string), char_length(statistics:max::string)
FROM fuse_block_statistics('default', 'attach_stats_source')
WHERE column_name = 's';
----
4 4

## Derive the table's generated storage prefix instead of assuming table IDs.
statement ok
SET VARIABLE attach_stats_sql = (
    SELECT 'ATTACH TABLE attach_stats_target ''fs:///tmp/attach_string_statistics/'
           || split_part(snapshot_location, '/_ss/', 1) || ''''
    FROM fuse_snapshot('default', 'attach_stats_source')
);

statement ok
EXECUTE IMMEDIATE $attach_stats_sql;

## Aggregates on the attached table must return the complete string, not a
## prefix or the synthetic upper bound used for pruning.
query BB
SELECT MIN(s) = repeat('👍', 17), MAX(s) = repeat('👍', 17)
FROM attach_stats_target;
----
1 1

## Numeric statistics must remain eligible for aggregate rewriting.
query T
EXPLAIN SELECT MIN(id), MAX(id) FROM attach_stats_target;
----
EvalScalar
├── output columns: [MIN(id) (#2), MAX(id) (#3)]
├── expressions: [1, 1]
├── estimated rows: 1.00
└── DummyTableScan

statement ok
DROP TABLE attach_stats_target;

statement ok
DROP TABLE attach_stats_source;

## Bounds shorter than an explicit limit (including limits above the default
## 16) and short bounds using default settings can safely answer aggregates.
statement ok
CREATE TABLE attach_stats_source(s STRING STATS_TRUNCATE_LEN 4,
    unused STRING STATS_TRUNCATE_LEN 8, wide STRING STATS_TRUNCATE_LEN 40, plain STRING)
'fs:///tmp/attach_string_statistics/' row_per_block=100;

statement ok
INSERT INTO attach_stats_source VALUES ('ab', 'unused', 'abcdefghijklmnopqrst', 'abc');

## Omit one configured column and reorder the others: settings must follow
## stable column IDs, not positions in the attached schema.
statement ok
SET VARIABLE attach_stats_sql = (
    SELECT 'ATTACH TABLE attach_stats_target(wide, s, plain) ''fs:///tmp/attach_string_statistics/'
           || split_part(snapshot_location, '/_ss/', 1) || ''''
    FROM fuse_snapshot('default', 'attach_stats_source')
);

statement ok
EXECUTE IMMEDIATE $attach_stats_sql;

query T
EXPLAIN SELECT MIN(wide), MAX(wide), MIN(s), MAX(s), MIN(plain), MAX(plain)
FROM attach_stats_target;
----
EvalScalar
├── output columns: [MIN(wide) (#3), MAX(wide) (#4), MIN(s) (#5), MAX(s) (#6), MIN(plain) (#7), MAX(plain) (#8)]
├── expressions: ['abcdefghijklmnopqrst', 'abcdefghijklmnopqrst', 'ab', 'ab', 'abc', 'abc']
├── estimated rows: 1.00
└── DummyTableScan

## The existing attached table must follow a newly published snapshot without
## treating its truncated bounds as exact.
statement ok
INSERT INTO attach_stats_source VALUES (repeat('z', 20), 'unused', 'abcdefghijklmnopqrst', 'abc');

query BB
SELECT MIN(s) = 'ab', MAX(s) = repeat('z', 20) FROM attach_stats_target;
----
1 1

statement ok
DROP TABLE attach_stats_target;

statement ok
DROP TABLE attach_stats_source;

## An explicitly empty settings map means defaults, not unknown historical
## metadata: short string statistics should still be eligible for rewriting.
statement ok
CREATE TABLE attach_stats_source(s STRING)
'fs:///tmp/attach_string_statistics/' row_per_block=100;

statement ok
INSERT INTO attach_stats_source VALUES ('ab');

statement ok
SET VARIABLE attach_stats_sql = (
    SELECT 'ATTACH TABLE attach_stats_target ''fs:///tmp/attach_string_statistics/'
           || split_part(snapshot_location, '/_ss/', 1) || ''''
    FROM fuse_snapshot('default', 'attach_stats_source')
);

statement ok
EXECUTE IMMEDIATE $attach_stats_sql;

query T
EXPLAIN SELECT MIN(s), MAX(s) FROM attach_stats_target;
----
EvalScalar
├── output columns: [MIN(s) (#1), MAX(s) (#2)]
├── expressions: ['ab', 'ab']
├── estimated rows: 1.00
└── DummyTableScan

## Internal provenance must not leak into user-visible table options.
query I
SELECT count(*) FROM system.tables
WHERE database = 'default' AND name = 'attach_stats_target'
  AND upper(table_option) NOT LIKE '%ATTACH_STATS_TRUNCATE_LEN_KNOWN%';
----
1

statement ok
DROP TABLE attach_stats_target;

statement ok
DROP TABLE attach_stats_source;

statement ok
UNSET VARIABLE attach_stats_sql;
