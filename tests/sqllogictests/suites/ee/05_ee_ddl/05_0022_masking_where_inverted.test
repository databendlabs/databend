# MATCH/QUERY require original indexed columns, not arbitrary masked expressions.
# Without explicit authorization, both search syntaxes must reject the masked
# field instead of silently searching the original index.
statement error field must be a column
SELECT id, content FROM masking_where_inverted WHERE match(content, 'secretneedle')

statement error field must be a column
SELECT id, content FROM masking_where_inverted WHERE query('content:secretneedle')

statement ok
ALTER TABLE masking_where_inverted MODIFY COLUMN content SET MASKING POLICY masking_where_inverted_policy OPTIONS (where_use_unmasked_value = true)

