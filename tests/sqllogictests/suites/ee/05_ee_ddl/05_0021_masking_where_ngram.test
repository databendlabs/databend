# Compare identical raw predicates with and without the index. LIKE remains
# executable without Ngram and must yield the same masked output.
statement ok
DROP NGRAM INDEX masking_ngram_idx ON masking_where_ngram

query IT
SELECT id, content FROM masking_where_ngram WHERE content LIKE '%secretneedle%'
----
1 [redacted]

statement ok
CREATE NGRAM INDEX masking_ngram_idx ON masking_where_ngram(content) gram_size = 3 bloom_size = 1048576

statement ok
REFRESH NGRAM INDEX masking_ngram_idx ON masking_where_ngram

query IT
SELECT id, content FROM masking_where_ngram WHERE content LIKE '%secretneedle%'
