# The default pass uses lazy pruning in the pipeline; this pass prunes eagerly in read_partitions.
# run-with-settings: enable_distributed_pruning=0, enable_prune_pipeline=0

statement ok
SET GLOBAL enable_experimental_row_access_policy = 1

statement ok
DROP TABLE IF EXISTS fts_topk_rap

statement ok
DROP ROW ACCESS POLICY IF EXISTS fts_topk_visible

statement ok
CREATE ROW ACCESS POLICY fts_topk_visible AS (tenant INT) RETURNS BOOLEAN -> tenant = 1

statement ok
CREATE TABLE fts_topk_rap (
    id INT NOT NULL,
    tenant INT NOT NULL,
    content STRING NOT NULL,
    INVERTED INDEX fts (content) tokenizer = 'english'
) ROW_PER_BLOCK = 64 STORAGE_FORMAT = 'parquet'

# The two highest-scoring documents are hidden. TopK before policy filtering
# would underfill the result, even though two visible matches exist.
statement ok
INSERT INTO fts_topk_rap VALUES
    (1, 1, concat('needle ', repeat('filler ', 31))),
    (2, 1, concat(repeat('needle ', 2), repeat('filler ', 30))),
    (3, 2, concat(repeat('needle ', 8), repeat('filler ', 24))),
    (4, 2, concat(repeat('needle ', 16), repeat('filler ', 16)))

statement ok
ALTER TABLE fts_topk_rap ADD ROW ACCESS POLICY fts_topk_visible ON (tenant)

query I
SELECT id FROM fts_topk_rap WHERE match(content, 'needle') ORDER BY score() DESC LIMIT 2
----
2
1

query I
SELECT id FROM fts_topk_rap WHERE match(content, 'needle') ORDER BY score() DESC LIMIT 1 OFFSET 1
----
1

query I
SELECT id FROM fts_topk_rap WHERE query('content:needle') ORDER BY score() DESC LIMIT 2
----
2
1

statement ok
DROP TABLE fts_topk_rap

statement ok
DROP ROW ACCESS POLICY fts_topk_visible
