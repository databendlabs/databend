query TT
SHOW CREATE MATERIALIZED VIEW mv_guard
----
mv_guard CREATE MATERIALIZED VIEW `test_mv_ddl`.`mv_guard` (`a`, `b`) AS SELECT a, b FROM test_mv_ddl.mv_guard_source WHERE 1 = 1

# CREATE observes the nonzero generation produced by RENAME and can publish a new binding.
statement ok
CREATE MATERIALIZED VIEW mv_guard_recreated AS SELECT renamed_a, b, c FROM mv_guard_source WHERE 1 = 1

statement ok
ALTER TABLE mv_guard_source MODIFY COLUMN renamed_a BIGINT

statement error 2328
REFRESH MATERIALIZED VIEW mv_guard_recreated

statement error 2328
SELECT * FROM mv_guard_recreated

statement ok
ALTER TABLE mv_guard_source DROP COLUMN b

statement ok
DROP MATERIALIZED VIEW mv_guard

statement ok
