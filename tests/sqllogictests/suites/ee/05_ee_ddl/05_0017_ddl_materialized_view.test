statement ok
ALTER TABLE mv_base_t SET OPTIONS (change_tracking = true)

# EXPLAIN prints the metadata-only CREATE operation, not the stored definition query plan.
query T
EXPLAIN CREATE MATERIALIZED VIEW test_mv_explain AS SELECT id FROM mv_base_t WHERE 1 = 1
----
CreateMaterializedView

# CREATE leaves storage empty, but reads use the live definition until the first refresh.
statement ok
CREATE MATERIALIZED VIEW test_mv AS SELECT id, val, amount FROM mv_base_t WHERE id <= 2

query I
SELECT count(*) FROM test_mv
----
2

