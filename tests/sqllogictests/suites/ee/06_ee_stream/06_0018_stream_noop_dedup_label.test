# A no-op DML still changes the stream offset. Its deduplication label must be
# committed with that offset, so retrying the same request cannot consume the
# next batch. Separate source INSERTs make max_batch_size = 1 deterministic.
# Generate labels once per case to avoid collisions across handlers and reruns.

statement ok
create or replace database test_stream_noop_dedup_label;

statement ok
use test_stream_noop_dedup_label;

statement ok
create table target(a int, b string);

statement ok
insert into target values(0, 'init');

statement ok
create table src_insert(a int, b string);

statement ok
create stream s_insert on table src_insert;

statement ok
insert into src_insert values(1, 'x');

statement ok
insert into src_insert values(2, 'y');

statement ok
set variable noop_insert_label = (select uuid());

# Autocommit INSERT: the first request consumes one batch without a new snapshot.
statement ok
insert /*+ SET_VAR(deduplicate_label=$noop_insert_label) */ into target select a, b from s_insert with (max_batch_size = 1) where b = 'none';

query IT
select a, b from s_insert order by a;
----
2 y

query I
select count(*) from fuse_snapshot('test_stream_noop_dedup_label', 'target');
----
1

# Retrying the identical labeled request must leave the second batch untouched.
statement ok
insert /*+ SET_VAR(deduplicate_label=$noop_insert_label) */ into target select a, b from s_insert with (max_batch_size = 1) where b = 'none';

query IT
select a, b from s_insert order by a;
----
2 y

query IT
select a, b from target;
----
0 init

# Explicit transaction MERGE: COMMIT must persist the offset and its label.
statement ok
create table src_merge(a int, b string);

statement ok
create stream s_merge on table src_merge;

statement ok
insert into src_merge values(3, 'z');

statement ok
insert into src_merge values(4, 'w');

statement ok
set variable noop_merge_label = (select uuid());

statement ok
begin;

statement ok
merge /*+ SET_VAR(deduplicate_label=$noop_merge_label) */ into target using (select a, b from s_merge with (max_batch_size = 1) where b = 'none') as t on target.a = t.a when matched then update * when not matched then insert *;

statement ok
commit;

query IT
select a, b from s_merge order by a;
----
4 w

query I
select count(*) from fuse_snapshot('test_stream_noop_dedup_label', 'target');
----
1

# Retry after COMMIT in autocommit mode, which checks the persisted label.
statement ok
merge /*+ SET_VAR(deduplicate_label=$noop_merge_label) */ into target using (select a, b from s_merge with (max_batch_size = 1) where b = 'none') as t on target.a = t.a when matched then update * when not matched then insert *;

query IT
select a, b from s_merge order by a;
----
4 w

query IT
select a, b from target;
----
0 init

statement ok
unset variable (noop_insert_label, noop_merge_label);

statement ok
drop stream s_insert;

statement ok
drop stream s_merge;

statement ok
drop database test_stream_noop_dedup_label;
