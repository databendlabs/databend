# Cover Databend Cloud tutorial: webapi/tutorial/data/*/007-streams.sql

statement ok
CREATE OR REPLACE DATABASE citydrive_demo

statement ok
USE citydrive_demo

statement ok
CREATE OR REPLACE TABLE frame_events (
    frame_id STRING,
    video_id STRING,
    frame_index INT,
    collected_at TIMESTAMP,
    event_tag STRING,
    risk_score DOUBLE
)

statement ok
CREATE OR REPLACE STREAM frame_events_stream
    ON TABLE frame_events

statement ok
INSERT INTO frame_events VALUES
                             ('FRAME-0901','VID-009',210,'2025-01-05 10:42:00','hard_brake',0.72),
                             ('FRAME-0902','VID-009',330,'2025-01-05 10:55:00','pedestrian',0.61)

query TTTTB
SELECT frame_id,
       video_id,
       event_tag,
       change$action,
       change$is_update
FROM frame_events_stream
ORDER BY frame_id
----
FRAME-0901 VID-009 hard_brake INSERT 0
FRAME-0902 VID-009 pedestrian INSERT 0

statement ok
CREATE OR REPLACE TABLE frame_events_history (
    frame_id STRING,
    video_id STRING,
    event_tag STRING,
    processed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
)

statement ok
INSERT INTO frame_events_history (frame_id, video_id, event_tag)
SELECT frame_id, video_id, event_tag
FROM frame_events_stream

query TTT
SELECT frame_id, video_id, event_tag FROM frame_events_history ORDER BY frame_id
----
FRAME-0901 VID-009 hard_brake
FRAME-0902 VID-009 pedestrian

query TTTTB
SELECT frame_id,
       video_id,
       event_tag,
       change$action,
       change$is_update
FROM frame_events_stream
----

# Execute the stream-backed body of task_parse_logs from
# suites/task/tutorial_etl_tasks.test. CREATE TASK only parses that body, so
# neither the WHEN STREAM_STATUS(...) predicate nor the INSERT ... FROM
# raw_logs_stream is validated there. The task suite also runs without an EE
# license, so the stream itself can only be created here.

statement ok
CREATE OR REPLACE TABLE raw_logs (
    doc_id    STRING,
    doc_body  VARIANT,
    loaded_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
)

statement ok
CREATE OR REPLACE STREAM raw_logs_stream
    ON TABLE raw_logs

statement ok
CREATE OR REPLACE TABLE parsed_logs (
    doc_id      STRING,
    event_tag   STRING,
    speed_kmh   DOUBLE,
    processed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
)

statement ok
INSERT INTO raw_logs (doc_id, doc_body) VALUES
    ('FRAME-0000', parse_json('{"doc_id":"FRAME-0000","event_tag":"hard_brake","speed_kmh":40.0}')),
    ('FRAME-0001', parse_json('{"doc_id":"FRAME-0001","event_tag":"pedestrian","speed_kmh":40.0}')),
    ('FRAME-0002', parse_json('{"doc_id":"FRAME-0002","event_tag":"lane_merge","speed_kmh":40.0}'))

# task_parse_logs guards its body with WHEN STREAM_STATUS(...) = TRUE.
query B
SELECT * FROM stream_status('citydrive_demo.raw_logs_stream')
----
1

# Body of task_parse_logs, executed verbatim against the real stream.
statement ok
INSERT INTO parsed_logs (doc_id, event_tag, speed_kmh)
SELECT doc_id,
       doc_body['event_tag']::STRING AS event_tag,
       doc_body['speed_kmh']::DOUBLE AS speed_kmh
FROM raw_logs_stream

query TTR
SELECT doc_id, event_tag, speed_kmh
FROM parsed_logs
ORDER BY doc_id
----
FRAME-0000 hard_brake 40.0
FRAME-0001 pedestrian 40.0
FRAME-0002 lane_merge 40.0

# The stream has been consumed, so the WHEN predicate would now be FALSE.
query B
SELECT * FROM stream_status('citydrive_demo.raw_logs_stream')
----
0

statement ok
DROP DATABASE IF EXISTS citydrive_demo
