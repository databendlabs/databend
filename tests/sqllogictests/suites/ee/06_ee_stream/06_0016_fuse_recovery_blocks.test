statement ok
CREATE OR REPLACE DATABASE test_fuse_recovery_stream

statement ok
USE test_fuse_recovery_stream

statement ok
CREATE OR REPLACE TABLE base(id INT, value INT) CHANGE_TRACKING = true ENABLE_AUTO_ANALYZE = 0

statement ok
INSERT INTO base VALUES (1, 0)

# UPDATE adds change-tracking fields to the source block. Recovery must discard
# them so the stream reports a new INSERT.
statement ok
UPDATE base SET value = 1 WHERE id = 1

# FILES accepts literals, so build the statement after reading the block basename.
statement ok
SET VARIABLE recovery_file = (SELECT split_part(_block_name, '/', -1) FROM base LIMIT 1)

statement ok
SET VARIABLE recovery_sql = concat(
    'COPY INTO base FROM FUSE_RECOVERY_BLOCKS(FILES => (''',
    $recovery_file,
    '''))'
)

statement ok
TRUNCATE TABLE base

statement ok
CREATE STREAM stream_recovered_data ON TABLE base APPEND_ONLY = true

statement ok
CREATE OR REPLACE TABLE sink(id INT)

statement ok
EXECUTE IMMEDIATE $recovery_sql

query IITB
SELECT id, value, change$action, change$is_update FROM stream_recovered_data
----
1 1 INSERT 0

statement ok
INSERT INTO sink SELECT id FROM stream_recovered_data

query I
SELECT id FROM sink
----
1

query I
SELECT count() FROM stream_recovered_data
----
0

statement ok
UNSET VARIABLE (recovery_file, recovery_sql)

statement ok
DROP DATABASE test_fuse_recovery_stream
