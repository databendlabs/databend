statement ok
DROP TABLE stream_provider.renamed

statement ok
CREATE TABLE stream_provider.renamed(id INT, value INT) change_tracking = true

statement ok
GRANT SELECT ON TABLE stream_provider.renamed TO SHARE stream_share

statement ok
set sandbox_tenant = 'share_stream_consumer_e2e'

statement error (?s).*(dropped|Unknown table|not granted).*
