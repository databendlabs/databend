# Creating another stream at the old offset must also reject the tracking gap.
statement error (?s).*Change tracking has been missing.*
CREATE STREAM stream_local.invalid_at ON TABLE stream_shared.renamed AT(STREAM => stream_local.s)

statement ok
CREATE OR REPLACE STREAM stream_local.s ON TABLE stream_shared.renamed

statement ok
set sandbox_tenant = 'share_stream_provider_e2e'

statement ok
