# The EE suite's configured license is environment-provided, so assert the
# stable schema here instead of environment-specific timestamp values.
query TTT
SELECT typeof(issued_at), typeof(valid_from), typeof(expire_at) FROM license_info()
----
TIMESTAMP TIMESTAMP NULL TIMESTAMP

# Repeated reads must also work through the license cache.
query I
SELECT count(*) FROM license_info()
----
1
