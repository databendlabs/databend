# MV storage does not follow source row access or masking policies, so a table cannot be both a
# policy target and an MV source, in either DDL order.

statement ok
set enable_experimental_row_access_policy = 1

statement ok
create or replace database test_mv_security_policy

statement ok
use test_mv_security_policy

statement ok
drop masking policy if exists mv_security_mask

statement ok
create masking policy mv_security_mask as (v string) returns string -> '***'

statement ok
drop row access policy if exists mv_security_rap

statement ok
create row access policy mv_security_rap as (r string) returns boolean -> r = 'us'

statement ok
create table source (id int, email string, region string)

# A source policy blocks CREATE, even on columns the MV does not reference.
statement ok
alter table source modify column email set masking policy mv_security_mask

statement error 2328.*source table has a row access or masking policy
create materialized view mv as select id, region from source where id > 0

statement ok
alter table source modify column email unset masking policy

statement ok
alter table source add row access policy mv_security_rap on (region)

statement error 2328.*source table has a row access or masking policy
create materialized view mv as select id from source where id > 0

statement ok
alter table source drop row access policy mv_security_rap

# An MV blocks attaching either policy, also after it becomes invalid.
statement ok
create materialized view mv as select id, region from source where id > 0

statement error 1132.*materialized views depend on it
alter table source modify column email set masking policy mv_security_mask

statement error 1132.*materialized views depend on it
alter table source add row access policy mv_security_rap on (region)

statement ok
alter table source rename column region to area

statement error 1132.*materialized views depend on it
alter table source modify column email set masking policy mv_security_mask

statement ok
show create materialized view mv

statement ok
drop materialized view mv

# Without MVs the policy can be attached again.
statement ok
alter table source modify column email set masking policy mv_security_mask

statement ok
alter table source modify column email unset masking policy

statement ok
drop table source

statement ok
drop masking policy mv_security_mask

statement ok
drop row access policy mv_security_rap

statement ok
drop database test_mv_security_policy
