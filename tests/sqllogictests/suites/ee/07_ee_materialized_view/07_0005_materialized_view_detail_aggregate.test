# Aggregates over detail MVs must retain aggregation, including for Hybrid reads.
statement ok
drop database if exists mv_detail_aggregate

statement ok
create database mv_detail_aggregate

statement ok
use mv_detail_aggregate

statement ok
create table base_table (id int, user_id string, amount int null, note string) cluster by (id)

statement ok
insert into base_table values
    (1, '2088822517322514', 10, 'first'),
    (2, '2088822517322514', 20, 'second'),
    (3, '2088822517322514', NULL, 'third'),
    (4, 'other', 50, 'fourth')

statement ok
create materialized view mv_by_user (id, user_id, amount) cluster by (user_id) as
select id, user_id, amount from base_table

statement ok
refresh materialized view mv_by_user

# Keep the bound and optimized logical plans as regression evidence.
query T
explain raw select count(*) from base_table where user_id = '2088822517322514'
----
EvalScalar
├── scalars: [COUNT(*) (#7) AS (#7)]
└── Aggregate(Initial)
    ├── group items: []
    ├── aggregate functions: [count() AS (#7)]
    └── Filter
        ├── filters: [eq(base_table.user_id (#1), '2088822517322514')]
        └── Scan
            ├── table: mv_detail_aggregate.base_table (#0)
            ├── filters: []
            ├── order by: []
            └── limit: NONE

query T
explain optimized select count(*) from base_table where user_id = '2088822517322514'
----
Aggregate(Final)
├── group items: []
├── aggregate functions: [count() AS (#7)]
└── Aggregate(Partial)
    ├── group items: []
    ├── aggregate functions: [count() AS (#7)]
    └── EvalScalar
        ├── scalars: [mv_by_user.id (#15) AS (#19), mv_by_user.user_id (#16) AS (#20), mv_by_user.amount (#17) AS (#21)]
        └── Scan
            ├── table: mv_detail_aggregate.mv_by_user (#2)
            ├── filters: [eq(mv_by_user.user_id (#16), '2088822517322514')]
            ├── order by: []
            └── limit: NONE

# The reported case: count rows through a differently clustered detail MV.
query T
explain select count(*) from base_table where user_id = '2088822517322514'
----
<slt:ignore>AggregateFinal<slt:ignore>table: default.mv_detail_aggregate.mv_by_user<slt:ignore>

query I
select count(*) from base_table where user_id = '2088822517322514'
----
3

# NULLs, DISTINCT aggregate arguments, and expressions above/below aggregation.
query IIII
select count(*), count(amount), count(distinct amount), sum(amount * 2) + 1
from base_table where user_id = '2088822517322514'
----
3 2 2 61

query III
select count(*), count(amount), sum(amount)
from base_table where user_id = 'missing'
----
0 0 NULL

# GROUP BY, HAVING and final expressions must stay above the replacement input.
query T
explain select user_id, sum(amount * 2) + 1 as total
from base_table group by user_id having count(*) > 1 order by total
----
<slt:ignore>table: default.mv_detail_aggregate.mv_by_user<slt:ignore>

query TI
select user_id, sum(amount * 2) + 1 as total
from base_table group by user_id having count(*) > 1 order by total
----
2088822517322514 61

query T
explain select distinct user_id from base_table
----
<slt:ignore>table: default.mv_detail_aggregate.mv_by_user<slt:ignore>

query T rowsort
select distinct user_id from base_table
----
2088822517322514
other

# Computed grouping keys and aggregate arguments use remapped input symbols.
query T
explain raw select id % 2, sum(amount + 1) from base_table group by id % 2
----
EvalScalar
├── scalars: [id % 2 (#7) AS (#10), plus(sum(amount) (#8), multiply(1, count(amount) (#9))) AS (#11)]
└── Aggregate(Initial)
    ├── group items: [modulo(base_table.id (#0), 2) AS (#7)]
    ├── aggregate functions: [sum(base_table.amount (#2)) AS (#8), count(base_table.amount (#2)) AS (#9)]
    └── EvalScalar
        ├── scalars: [base_table.amount (#2) AS (#2), modulo(base_table.id (#0), 2) AS (#7)]
        └── Scan
            ├── table: mv_detail_aggregate.base_table (#0)
            ├── filters: []
            ├── order by: []
            └── limit: NONE

query T
explain optimized select id % 2, sum(amount + 1) from base_table group by id % 2
----
EvalScalar
├── scalars: [id % 2 (#7) AS (#10), plus(sum(amount) (#8), multiply(1, count(amount) (#9))) AS (#11)]
└── Aggregate(Final)
    ├── group items: [modulo(base_table.id (#0), 2) AS (#7)]
    ├── aggregate functions: [sum(base_table.amount (#2)) AS (#8), count(base_table.amount (#2)) AS (#9)]
    └── Aggregate(Partial)
        ├── group items: [modulo(base_table.id (#0), 2) AS (#7)]
        ├── aggregate functions: [sum(base_table.amount (#2)) AS (#8), count(base_table.amount (#2)) AS (#9)]
        └── EvalScalar
            ├── scalars: [mv_by_user.id (#19) AS (#0), mv_by_user.amount (#21) AS (#2), modulo(mv_by_user.id (#19), 2) AS (#7), mv_by_user.id (#19) AS (#23), mv_by_user.user_id (#20) AS (#24), mv_by_user.amount (#21) AS (#25)]
            └── Scan
                ├── table: mv_detail_aggregate.mv_by_user (#2)
                ├── filters: []
                ├── order by: []
                └── limit: NONE

query II rowsort
select id % 2, sum(amount + 1) from base_table group by id % 2
----
0 72
1 11

query T
select user_id from base_table group by user_id having sum(amount) = 30
----
2088822517322514

# Missing aggregate inputs and compensating predicate columns reject the MV.
query T
explain select user_id, count(distinct note) from base_table group by user_id
----
<slt:ignore>table: default.mv_detail_aggregate.base_table<slt:ignore>

query T
explain select count(*) from base_table where note = 'first'
----
<slt:ignore>table: default.mv_detail_aggregate.base_table<slt:ignore>

# Hybrid rows must be combined before aggregating, so duplicate values across
# the checkpoint are counted once by COUNT(DISTINCT), but twice by COUNT(*).
statement ok
insert into base_table values (5, '2088822517322514', 10, 'fifth')

query T
explain select count(*) from base_table where user_id = '2088822517322514'
----
<slt:ignore>AggregateFinal<slt:ignore>UnionAll<slt:ignore>table: default.mv_detail_aggregate.mv_by_user<slt:ignore>table: default.mv_detail_aggregate.base_table<slt:ignore>

query IIII
select count(*), count(amount), count(distinct amount), sum(amount * 2) + 1
from base_table where user_id = '2088822517322514'
----
4 3 2 81

query T rowsort
select distinct user_id from base_table
----
2088822517322514
other

# A filtered detail MV cannot supply rows outside its defining predicate.
statement ok
drop materialized view mv_by_user

statement ok
create materialized view mv_positive (user_id, amount) as
select user_id, amount from base_table where amount > 0

statement ok
refresh materialized view mv_positive

query T
explain select count(*) from base_table where user_id = '2088822517322514'
----
<slt:ignore>table: default.mv_detail_aggregate.base_table<slt:ignore>

query I
select count(*) from base_table where user_id = '2088822517322514'
----
4

query T
explain select count(*) from base_table where amount > 10
----
<slt:ignore>table: default.mv_detail_aggregate.mv_positive<slt:ignore>

query I
select count(*) from base_table where amount > 10
----
2

statement ok
drop database mv_detail_aggregate
