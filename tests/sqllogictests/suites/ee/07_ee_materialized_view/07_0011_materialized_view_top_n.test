# Top-N materialized views keep the first rows of `ORDER BY ... LIMIT n`. A query
# reads them when it needs no more rows, orders by a prefix of the MV keys, and
# has exactly the MV predicate. INSERT refreshes merge the appended rows into the
# stored rows; UPDATE and DELETE rebuild the MV from the source.

statement ok
create or replace database test_mv_top_n

statement ok
use test_mv_top_n

statement ok
create table events (id int, ts timestamp, payload string)

statement ok
insert into events
select number, to_timestamp(1700000000 + number), concat('p', number::string)
from numbers(20)

statement ok
create materialized view mv_latest as select * from events order by ts desc limit 5

# SELECT * is persisted as the source columns, and the order is persisted with
# explicit direction and NULLS placement.
query TT
show create materialized view mv_latest
----
mv_latest CREATE MATERIALIZED VIEW `test_mv_top_n`.`mv_latest` (`id`, `ts`, `payload`) AS SELECT id, ts, payload FROM test_mv_top_n.events ORDER BY ts DESC NULLS LAST LIMIT 5

statement error 1065
create materialized view mv_order_only as select id from events order by id

statement error 1065
create materialized view mv_limit_only as select id from events limit 3

statement error 1065
create materialized view mv_offset as select id from events order by id limit 3 offset 1

statement error 1065
create materialized view mv_limit_zero as select id from events order by id limit 0

statement error 1065
create materialized view mv_aggregate_top_n as select id, count(*) as n from events group by id order by id limit 3

statement error 1065
create materialized view mv_star_exclude as select * exclude payload from events

statement error 2328
create materialized view mv_hidden_key as select id from events order by ts limit 3

statement ok
refresh materialized view mv_latest

query ITT
select * from mv_latest order by ts desc
----
19 2023-11-14 22:13:39.000000 p19
18 2023-11-14 22:13:38.000000 p18
17 2023-11-14 22:13:37.000000 p17
16 2023-11-14 22:13:36.000000 p16
15 2023-11-14 22:13:35.000000 p15

# A smaller LIMIT, with or without OFFSET, reads the MV.
query T
explain select * from events order by ts desc limit 3
----
<slt:ignore>table: default.test_mv_top_n.mv_latest<slt:ignore>

query ITT
select * from events order by ts desc limit 3
----
19 2023-11-14 22:13:39.000000 p19
18 2023-11-14 22:13:38.000000 p18
17 2023-11-14 22:13:37.000000 p17

query T
explain select id from events order by ts desc limit 2 offset 3
----
<slt:ignore>table: default.test_mv_top_n.mv_latest<slt:ignore>

query I
select id from events order by ts desc limit 2 offset 3
----
16
15

# Any first rows answer a LIMIT without ORDER BY.
query T
explain select * from events limit 3
----
<slt:ignore>table: default.test_mv_top_n.mv_latest<slt:ignore>

# More rows than stored, another order, or a stricter predicate need rows the MV
# dropped. A query without LIMIT needs every row.
query T
explain select * from events order by ts desc limit 6
----
<slt:ignore>table: default.test_mv_top_n.events<slt:ignore>

query T
explain select * from events order by ts limit 3
----
<slt:ignore>table: default.test_mv_top_n.events<slt:ignore>

query T
explain select * from events where id > 3 order by ts desc limit 3
----
<slt:ignore>table: default.test_mv_top_n.events<slt:ignore>

query T
explain select * from events where id > 3
----
<slt:ignore>table: default.test_mv_top_n.events<slt:ignore>

# Before refresh, a read combines the stored rows with the appended rows and
# keeps the first rows of both.
statement ok
insert into events values (100, '2030-01-01 00:00:00', 'newest'), (101, '2000-01-01 00:00:00', 'oldest')

query ITT
select * from mv_latest order by ts desc
----
100 2030-01-01 00:00:00.000000 newest
19 2023-11-14 22:13:39.000000 p19
18 2023-11-14 22:13:38.000000 p18
17 2023-11-14 22:13:37.000000 p17
16 2023-11-14 22:13:36.000000 p16

query T
explain select * from events order by ts desc limit 3
----
<slt:ignore>table: default.test_mv_top_n.mv_latest<slt:ignore>table: default.test_mv_top_n.events<slt:ignore>

query ITT
select * from events order by ts desc limit 3
----
100 2030-01-01 00:00:00.000000 newest
19 2023-11-14 22:13:39.000000 p19
18 2023-11-14 22:13:38.000000 p18

# An INSERT-only refresh keeps storage at the LIMIT.
statement ok
refresh materialized view mv_latest

query ITT
select * from mv_latest order by ts desc
----
100 2030-01-01 00:00:00.000000 newest
19 2023-11-14 22:13:39.000000 p19
18 2023-11-14 22:13:38.000000 p18
17 2023-11-14 22:13:37.000000 p17
16 2023-11-14 22:13:36.000000 p16

query I
select sum(row_count) from fuse_block('test_mv_top_n', 'mv_latest')
----
5

query T
explain select * from events order by ts desc limit 3
----
<slt:ignore>table: default.test_mv_top_n.mv_latest<slt:ignore>

# An UPDATE can move a row into the first rows, and a DELETE can remove one that
# a dropped row must replace. Stale reads recompute from the source, and REFRESH
# rebuilds the MV.
statement ok
update events set ts = '2040-01-01 00:00:00' where id = 3

query ITT
select * from mv_latest order by ts desc
----
3 2040-01-01 00:00:00.000000 p3
100 2030-01-01 00:00:00.000000 newest
19 2023-11-14 22:13:39.000000 p19
18 2023-11-14 22:13:38.000000 p18
17 2023-11-14 22:13:37.000000 p17

statement ok
delete from events where id in (3, 100)

statement ok
refresh materialized view mv_latest

query ITT
select * from mv_latest order by ts desc
----
19 2023-11-14 22:13:39.000000 p19
18 2023-11-14 22:13:38.000000 p18
17 2023-11-14 22:13:37.000000 p17
16 2023-11-14 22:13:36.000000 p16
15 2023-11-14 22:13:35.000000 p15

