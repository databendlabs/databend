# Renamed columns, a predicate, and several keys. A query may order by a prefix
# of the keys and compute expressions from the stored columns.
statement ok
create table scores (a int, b int null, c string)

statement ok
insert into scores
select number % 4, if(number % 3 = 0, null, number), concat('c', number::string)
from numbers(40)

statement ok
create materialized view mv_scores (x, y, z) as
select a, b, c from scores where a > 0 order by a desc, b limit 6

statement ok
refresh materialized view mv_scores

query IIT
select * from mv_scores order by x desc, y
----
3 7 c7
3 11 c11
3 19 c19
3 23 c23
3 31 c31
3 35 c35

query T
explain select a, b, c from scores where 0 < a order by a desc limit 4
----
<slt:ignore>table: default.test_mv_top_n.mv_scores<slt:ignore>

query IT
select a + 1 as p, c from scores where a > 0 order by a desc, b limit 4
----
4 c7
4 c11
4 c19
4 c23

query T
explain select a + 1 as p, c from scores where a > 0 order by a desc, b limit 4
----
<slt:ignore>table: default.test_mv_top_n.mv_scores<slt:ignore>

# NULLS placement is part of the order.
query T
explain select a, b from scores where a > 0 order by a desc, b nulls first limit 4
----
<slt:ignore>table: default.test_mv_top_n.scores<slt:ignore>

# A plain projection MV also accepts SELECT *.
statement ok
create materialized view mv_all_events as select * from events where id >= 10

statement ok
refresh materialized view mv_all_events

query ITT
select * from mv_all_events order by id limit 2
----
10 2023-11-14 22:13:30.000000 p10
11 2023-11-14 22:13:31.000000 p11

statement ok
drop database test_mv_top_n
