# Materialized-view rewrite can filter an MV grouping key and answer a query
# whose GROUP BY becomes coarser after the equality predicate is applied.

statement ok
drop database if exists test_materialized_view_rewrite

statement ok
create database test_materialized_view_rewrite

statement ok
use test_materialized_view_rewrite

statement ok
create table source (
    a int,
    b int,
    c string,
    t int
)

statement ok
insert into source values
    (1, 10, 'xxxxxxx', 5),
    (1, 10, 'xxxxxxx', 9),
    (1, 10, 'other', 100),
    (2, 20, 'xxxxxxx', 7),
    (2, 20, 'other', 70)

statement ok
create materialized view mv_by_abc (
    a,
    b,
    c,
    min_t,
    max_t,
    sum_t,
    count_t,
    avg_t,
    approx_count_distinct_t
) as
select a, b, c, min(t), max(t), sum(t), count(t), avg(t), approx_count_distinct(t)
from source
group by a, b, c

statement ok
refresh materialized view mv_by_abc

# Repeated SELECTs exercise the planner cache for an MV-rewritten plan. The
# same query is executed again after a source append below to verify that the
# source endpoint change invalidates the cached plan.
statement ok
set enable_planner_cache = 1

# The equality predicate fixes c to a single value, so the query's (a, b)
# groups correspond one-to-one with the MV's (a, b, c) groups. The rewrite
# should filter the MV by c and read the precomputed max_t value.
query T
explain select
    a,
    b,
    min(t),
    max(t),
    sum(t),
    count(t),
    avg(t),
    approx_count_distinct(t)
from source
where c = 'xxxxxxx'
group by a, b
----
<slt:ignore>table: default.test_materialized_view_rewrite.mv_by_abc<slt:ignore>

query IIIIIIRI rowsort
select
    a,
    b,
    min(t),
    max(t),
    sum(t),
    count(t),
    avg(t),
    approx_count_distinct(t)
from source
where c = 'xxxxxxx'
group by a, b
----
1 10 5 9 14 2 7.0 2
2 20 7 7 7 1 7.0 1

# The same SELECT should be served by the planner cache on the second bind.
query IIIIIIRI rowsort
select
    a,
    b,
    min(t),
    max(t),
    sum(t),
    count(t),
    avg(t),
    approx_count_distinct(t)
from source
where c = 'xxxxxxx'
group by a, b
----
1 10 5 9 14 2 7.0 2
2 20 7 7 7 1 7.0 1

# Multiple values on the MV's extra group key require a roll-up aggregate.
# MIN, MAX, SUM, and COUNT are rolled up directly from stored aggregate states.
query T
explain select
    a,
    b,
    min(t),
    max(t),
    sum(t),
    count(t)
from source
where c in ('xxxxxxx', 'other')
group by a, b
----
<slt:ignore>aggregate functions: [min_merge(min_t), max_merge(max_t), sum_merge(sum_t), count_merge(count_t)]<slt:ignore>table: default.test_materialized_view_rewrite.mv_by_abc<slt:ignore>

query IIIIII rowsort
select
    a,
    b,
    min(t),
    max(t),
    sum(t),
    count(t)
from source
where c in ('xxxxxxx', 'other')
group by a, b
----
1 10 5 100 114 3
2 20 7 70 77 2

# AVG and approximate distinct values cannot be accurately rolled up from
# their finalized MV outputs, so this query must keep scanning the source.
query T
explain select
    a,
    b,
    min(t),
    max(t),
    sum(t),
    count(t),
    avg(t),
    approx_count_distinct(t)
from source
where c in ('xxxxxxx', 'other')
group by a, b
----
<slt:ignore>table: default.test_materialized_view_rewrite.source<slt:ignore>

query IIIIIIRI rowsort
select
    a,
    b,
    min(t),
    max(t),
    sum(t),
    count(t),
    avg(t),
    approx_count_distinct(t)
from source
where c in ('xxxxxxx', 'other')
group by a, b
----
1 10 5 100 114 3 38.0 3
2 20 7 70 77 2 38.5 2

# ORDER BY and LIMIT remain above the MV roll-up, and HAVING filters the merged
# aggregate rather than being treated as a source-table predicate.
query T
explain select a, b, sum(t) as total
from source
where c in ('xxxxxxx', 'other')
group by a, b
having sum(t) > 80
order by total desc
limit 1
----
<slt:ignore>table: default.test_materialized_view_rewrite.mv_by_abc<slt:ignore>

query III
select a, b, sum(t) as total
from source
where c in ('xxxxxxx', 'other')
group by a, b
having sum(t) > 80
order by total desc
limit 1
----
1 10 114

# Appends after the checkpoint use a hybrid candidate: persisted MV rows are
# combined with source CHANGE_TRACKING rows before the rewrite is applied.
statement ok
insert into source values
    (1, 10, 'xxxxxxx', 13),
    (1, 10, 'other', 200),
    (3, 30, 'xxxxxxx', 8)

# Roll-up also works when the MV read is hybrid: persisted MV states and source
# change states are merged directly at the query grouping granularity.
query T
explain select
    a,
    b,
    min(t),
    max(t),
    sum(t),
    count(t)
from source
where c in ('xxxxxxx', 'other')
group by a, b
----
<slt:ignore>aggregate functions: [min_merge(min_t), max_merge(max_t), sum_merge(sum_t), count_merge(count_t)]<slt:ignore>table: default.test_materialized_view_rewrite.mv_by_abc<slt:ignore>table: default.test_materialized_view_rewrite.source<slt:ignore>

query IIIIII rowsort
select
    a,
    b,
    min(t),
    max(t),
    sum(t),
    count(t)
from source
where c in ('xxxxxxx', 'other')
group by a, b
----
1 10 5 200 327 5
2 20 7 70 77 2
3 30 8 8 8 1

query T
explain select
    a,
    b,
    min(t),
    max(t),
    sum(t),
    count(t),
    avg(t),
    approx_count_distinct(t)
from source
where c = 'xxxxxxx'
group by a, b
----
<slt:ignore>table: default.test_materialized_view_rewrite.mv_by_abc<slt:ignore>table: default.test_materialized_view_rewrite.source<slt:ignore>

query IIIIIIRI rowsort
select
    a,
    b,
    min(t),
    max(t),
    sum(t),
    count(t),
    avg(t),
    approx_count_distinct(t)
from source
where c = 'xxxxxxx'
group by a, b
----
1 10 5 13 27 3 9.0 3
2 20 7 7 7 1 7.0 1
3 30 8 8 8 1 8.0 1

# A physical source rewrite changes the snapshot endpoint without adding logical
# rows. The empty append delta is removed, so the rewritten query reads only MV
# storage instead of building a hybrid UNION with the source changes scan.
statement ok
refresh materialized view mv_by_abc

statement ok
optimize table source compact

query T
explain select a, b, c, sum(t), count(t)
from source
group by a, b, c
----
<slt:ignore>table: default.test_materialized_view_rewrite.mv_by_abc<slt:ignore>

query IITII rowsort
select a, b, c, sum(t), count(t)
from source
group by a, b, c
----
1 10 other 300 2
1 10 xxxxxxx 27 3
2 20 other 70 1
2 20 xxxxxxx 7 1
3 30 xxxxxxx 8 1

# Queries with hidden ORDER BY columns keep their TopN/source plan rather than
# replacing the whole subtree and losing ordering. Aggregate queries are also
# kept on the source until detail-to-aggregate rebuilding is supported.
statement ok
create table detail_source (
    id int,
    amount int,
    active boolean
)

statement ok
insert into detail_source values
    (1, 10, true),
    (1, 15, true),
    (2, 20, true),
    (3, 30, false)

statement ok
create materialized view mv_active_detail (id, amount) as
select id, amount
from detail_source
where active

statement ok
refresh materialized view mv_active_detail

query I
select id
from detail_source
where active
order by amount desc
limit 1
----
2

query I rowsort
select distinct id
from detail_source
where active
----
1
2

# Open and closed endpoints at the same value have different containment rules.
statement ok
create table range_source (id int, amount int)

statement ok
insert into range_source values (1, 10), (2, 11), (3, 20), (4, 30)

statement ok
create materialized view mv_amount_gt_10 (id, amount) as
select id, amount from range_source where amount > 10

statement ok
refresh materialized view mv_amount_gt_10

query II rowsort
select id, amount from range_source where amount >= 10
----
1 10
2 11
3 20
4 30

query II rowsort
select id, amount from range_source where amount > 10
----
2 11
3 20
4 30

statement ok
drop materialized view mv_amount_gt_10

statement ok
create materialized view mv_amount_gte_10 (id, amount) as
select id, amount from range_source where amount >= 10

statement ok
refresh materialized view mv_amount_gte_10

query II rowsort
select id, amount from range_source where amount > 10
----
2 11
3 20
4 30

statement ok
drop materialized view mv_amount_gte_10

statement ok
create materialized view mv_amount_lt_30 (id, amount) as
select id, amount from range_source where amount < 30

statement ok
refresh materialized view mv_amount_lt_30

query II rowsort
select id, amount from range_source where amount <= 30
----
1 10
2 11
3 20
4 30

statement ok
drop materialized view mv_amount_lt_30

statement ok
create materialized view mv_amount_lte_30 (id, amount) as
select id, amount from range_source where amount <= 30

statement ok
refresh materialized view mv_amount_lte_30

query II rowsort
select id, amount from range_source where amount < 30
----
1 10
2 11
3 20

# Disabling the rewrite setting keeps the query on the source table.
statement ok
set enable_materialized_view_rewrite = 0

query T
explain select a, b, c, sum(t), count(t)
from source
group by a, b, c
----
<slt:ignore>table: default.test_materialized_view_rewrite.source<slt:ignore>

