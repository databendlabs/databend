# Names with uppercase letters or characters outside an unquoted identifier must
# keep their quotes when an MV definition or refresh statement is written as SQL
# and planned again. Each refresh below covers INSERT-only and UPDATE changes.

statement ok
create or replace database test_mv_quoted_ident

statement ok
use test_mv_quoted_ident

statement ok
create table source ("Id" int, "Amount" int)

statement ok
insert into source select number, number from numbers(10)

# Top-N MV over SELECT *, with an uppercase order key.
statement ok
create materialized view mv_top as select * from source order by "Amount" desc limit 3

query TT
show create materialized view mv_top
----
mv_top CREATE MATERIALIZED VIEW `test_mv_quoted_ident`.`mv_top` (`Id`, `Amount`) AS SELECT "Id", "Amount" FROM test_mv_quoted_ident.source ORDER BY "Amount" DESC NULLS LAST LIMIT 3

# Top-N MV with uppercase output names.
statement ok
create materialized view mv_top_renamed ("Key", "Value") as
select "Id", "Amount" from source order by "Id" limit 2

# Detail MV with an output name that needs a quote even in lowercase.
statement ok
create materialized view mv_detail ("Key", "my value") as
select "Id", "Amount" from source where "Id" > 7

# Aggregate MV whose AVG stores two physical states under an uppercase name, and
# whose repeated GROUP BY output references the first one.
statement ok
create materialized view mv_aggregate ("Group", "Same Group", "Avg") as
select "Id" % 2, "Id" % 2, avg("Amount") from source group by "Id" % 2

# An uppercase MV name.
statement ok
create materialized view "MvTotal" as select sum("Amount") as "Total" from source

# Unquoted output names follow the default rule and are lowercased, so they are
# read back with any case. A quoted name keeps its case.
statement ok
create materialized view mv_unquoted ("Key", Val) as
select "Id", "Amount" as Ignored from source order by "Id" desc limit 2

query TT
show create materialized view mv_unquoted
----
mv_unquoted CREATE MATERIALIZED VIEW `test_mv_quoted_ident`.`mv_unquoted` (`Key`, `val`) AS SELECT "Id", "Amount" AS Ignored FROM test_mv_quoted_ident.source ORDER BY "Id" DESC NULLS LAST LIMIT 2

statement ok
create materialized view mv_unquoted_alias as
select "Id" as MyId, avg("Amount") as MyAvg from source group by "Id"

statement ok
refresh materialized view mv_top

statement ok
refresh materialized view mv_top_renamed

statement ok
refresh materialized view mv_detail

statement ok
refresh materialized view mv_aggregate

statement ok
refresh materialized view "MvTotal"

statement ok
refresh materialized view mv_unquoted

statement ok
refresh materialized view mv_unquoted_alias

statement ok
insert into source values (100, 100), (-1, -1)

statement ok
refresh materialized view mv_unquoted

statement ok
refresh materialized view mv_unquoted_alias

query II
select "Key", VAL from mv_unquoted order by "Key" desc
----
100 100
9 9

query IF
select myid, MYAVG from mv_unquoted_alias where MyId in (-1, 100) order by MyId
----
-1 -1.0
100 100.0

statement error 1065
select key from mv_unquoted

statement ok
refresh materialized view mv_top

statement ok
refresh materialized view mv_top_renamed

statement ok
refresh materialized view mv_detail

statement ok
refresh materialized view mv_aggregate

statement ok
refresh materialized view "MvTotal"

query II
select * from mv_top order by "Amount" desc
----
100 100
9 9
8 8

query II
select * from mv_top_renamed order by "Key"
----
-1 -1
0 0

query II
select * from mv_detail order by "Key"
----
8 8
9 9
100 100

query IIF
select * from mv_aggregate order by "Group"
----
-1 -1 -1.0
0 0 20.0
1 1 5.0

query I
select * from "MvTotal"
----
144

statement ok
update source set "Amount" = 200 where "Id" = 9

statement ok
refresh materialized view mv_top

statement ok
refresh materialized view mv_top_renamed

statement ok
refresh materialized view mv_detail

statement ok
refresh materialized view mv_aggregate

statement ok
refresh materialized view "MvTotal"

query II
select * from mv_top order by "Amount" desc
----
9 200
100 100
8 8

query II
select * from mv_detail order by "Key"
----
8 8
9 200
100 100

query IIF
select * from mv_aggregate order by "Group"
----
-1 -1 -1.0
0 0 20.0
1 1 43.2

query I
select * from "MvTotal"
----
335

statement ok
drop database test_mv_quoted_ident
