# Materialized views currently use internal storage. They must not inherit the
# database's storage-class default or accept an explicit user class.
statement ok
CREATE OR REPLACE DATABASE test_mv_storage_class OPTIONS(DEFAULT_S3_STORAGE_CLASS = 'INTELLIGENT_TIERING')

statement ok
USE test_mv_storage_class

statement ok
CREATE TABLE source(id INT)

statement ok
INSERT INTO source VALUES (1)

statement ok
CREATE MATERIALIZED VIEW inherited_mv AS SELECT id FROM source

statement error 1301
CREATE MATERIALIZED VIEW invalid_mv S3_STORAGE_CLASS = 'STANDARD' AS SELECT id FROM source

statement ok
ALTER DATABASE test_mv_storage_class SET OPTIONS(DEFAULT_S3_STORAGE_CLASS = 'STANDARD')

statement ok
CREATE MATERIALIZED VIEW after_alter_mv AS SELECT id FROM source

query TB rowsort
SELECT name, table_option LIKE '%S3_STORAGE_CLASS=%'
FROM system.tables WHERE database = 'test_mv_storage_class'
----
after_alter_mv 0
inherited_mv 0
source 0

statement ok
SET experimental_s3_storage_class = 'intelligent_tiering'

statement ok
REFRESH MATERIALIZED VIEW inherited_mv

query I
SELECT id FROM inherited_mv
----
1

statement error 1301
ALTER MATERIALIZED VIEW inherited_mv SET OPTIONS(s3_storage_class = 'STANDARD')

statement ok
ALTER MATERIALIZED VIEW inherited_mv UNSET OPTIONS(s3_storage_class)

statement ok
UNSET experimental_s3_storage_class

statement ok
DROP DATABASE test_mv_storage_class
