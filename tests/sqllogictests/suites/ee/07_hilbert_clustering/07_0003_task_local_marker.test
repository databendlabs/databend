statement ok
CREATE OR REPLACE DATABASE test_hilbert_marker

statement ok
USE test_hilbert_marker

statement ok
CREATE OR REPLACE TABLE t_marker(a int, b int, c int) CLUSTER BY (a, hilbert(b, c)) row_per_block=2 block_per_segment=2

statement ok
CREATE OR REPLACE TABLE t_marker_expr(a int, b string, c int) CLUSTER BY (a, hilbert(substring(b, 1, 2), c + 1)) row_per_block=2 block_per_segment=2

query TT
SELECT cluster_key, type FROM clustering_information('test_hilbert_marker', 't_marker')
----
(a, hilbert(b, c)) linear

query TT
SELECT cluster_key, type FROM clustering_information('test_hilbert_marker', 't_marker_expr')
----
(a, hilbert(substring(b, 1, 2), c + 1)) linear

statement ok
INSERT INTO t_marker VALUES (1, 10, 10), (1, 20, 20), (2, 30, 30), (2, 40, 40)

statement ok
INSERT INTO t_marker_expr VALUES (1, 'aa', 10), (1, 'ab', 20), (2, 'ba', 30), (2, 'bb', 40)

query II
SELECT count(), sum(a) FROM t_marker
----
4 6

query II
SELECT count(), sum(a) FROM t_marker_expr
----
4 6

