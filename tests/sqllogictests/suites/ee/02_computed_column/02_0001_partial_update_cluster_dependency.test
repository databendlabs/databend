statement ok
create or replace database partial_update_computed_column

statement ok
use partial_update_computed_column

# The incompatibility is enforced in both directions when table metadata is changed.
statement error 2322
create table invalid_create(
    id int,
    value int,
    computed_value bigint as (value + 1) virtual
) enable_partial_update = true

statement ok
create table computed_first(
    id int,
    value int,
    computed_value bigint as (value + 1) virtual
)

statement error
alter table computed_first set options(enable_partial_update = true)

statement ok
create table partial_update_first(id int, value int) enable_partial_update = true

statement error
alter table partial_update_first
    add column computed_value bigint as (value + 1) virtual

statement ok
drop database partial_update_computed_column
