# Written by an old query, before the segment zone map existed. The table carries
# the types that have min/max statistics, including decimals that old writers
# stored as 128-bit values regardless of precision, and NULLs; the current reader
# reclusters it and builds a zone map over the result. No 256-bit decimal: the
# current reader misreads the BINARY encoding old writers used for them (a
# value's low byte is dropped), which is a reader bug independent of zone maps.

statement ok
set global timezone = 'UTC';

statement ok
DROP TABLE IF EXISTS compat_segment_zone_map_old;

statement ok
CREATE TABLE compat_segment_zone_map_old (
        id INT,
        label VARCHAR,
        d64 DECIMAL(8, 4),
        d128 DECIMAL(28, 4),
        ts TIMESTAMP,
        dt DATE,
        n INT NULL
) Engine = Fuse CLUSTER BY (id) block_per_segment = 1;

statement ok
INSERT INTO compat_segment_zone_map_old VALUES (1, 'alpha', 1.5, 1000.25, '2024-01-01 00:00:00', '2024-01-01', 10);

statement ok
INSERT INTO compat_segment_zone_map_old VALUES (2, 'bravo', 2.5, 2000.25, '2024-02-01 00:00:00', '2024-02-01', NULL);

statement ok
INSERT INTO compat_segment_zone_map_old VALUES (3, 'charlie', 3.5, 3000.25, '2024-03-01 00:00:00', '2024-03-01', 30);

statement ok
INSERT INTO compat_segment_zone_map_old VALUES (4, 'delta', 4.5, 4000.25, '2024-04-01 00:00:00', '2024-04-01', NULL);

query I
SELECT count(*) FROM compat_segment_zone_map_old;
----
4
