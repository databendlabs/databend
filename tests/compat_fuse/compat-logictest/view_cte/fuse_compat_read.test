# Preserve the old view's result even when a same-named real table exists.
# Ordinary SQL, new views, and rebuilt views use the corrected qualified-name rule.

statement ok
create database compat_view_cte_other

statement ok
use compat_view_cte_other

statement ok
set enable_auto_materialize_cte = 1

query I
select * from compat_view_cte.v_shadow
----
99

query I
select * from compat_view_cte.v_missing
----
98

query I
select * from compat_view_cte.v_chain
----
6

query I
select * from compat_view_cte.v_scalar
----
97

query II
select * from compat_view_cte.v_repeated
----
99 99

query I
select * from compat_view_cte.v_recursive order by n
----
1
2
3

# Direct definition readers also need the old mode, not only SELECT from a view.
query I
select count(*) from system.columns where database = 'compat_view_cte' and table = 'v_missing'
----
1

statement ok
create table copied like compat_view_cte.v_missing

# The legacy scope cannot capture qualified references outside the view.
query III
with t as (select 77::int as n) select v.n, r.n, (select n from compat_view_cte.t) from compat_view_cte.v_shadow v, compat_view_cte.t r
----
99 1 1

query II
with t as (select 77::int as n) select r.n, v.n from compat_view_cte.t r, compat_view_cte.v_shadow v
----
1 99

query I
with t as (select 99::int as n) select * from compat_view_cte.t
----
1

statement ok
create view v_new as with t as (select 99::int as n) select * from compat_view_cte.t

query I
select * from v_new
----
1

statement ok
create view v_mixed as with t as (select 77::int as n) select v.n as x, r.n as y from compat_view_cte.v_shadow v, compat_view_cte.t r

query II
select * from v_mixed
----
99 1

# Recreate explicitly qualified SQL to opt into the corrected table semantics.
statement ok
create or replace view compat_view_cte.v_shadow as with t as (select 99::int as n) select * from compat_view_cte.t

query I
select * from compat_view_cte.v_shadow
----
1

# To retain CTE semantics, recreate from original unqualified CTE SQL, not from
# old SHOW CREATE text in which the system may already have added a database.
statement ok
create or replace view compat_view_cte.v_missing as with missing as (select 98::int as n) select * from missing

query I
select * from compat_view_cte.v_missing
----
98

query II
select * from v_mixed
----
1 1

statement ok
unset enable_auto_materialize_cte

statement ok
use default

statement ok
drop database compat_view_cte_other

statement ok
drop database compat_view_cte
