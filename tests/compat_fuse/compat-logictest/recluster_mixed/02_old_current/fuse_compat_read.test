statement ok
CREATE TABLE merge_source(id int, value int, source string, action string)

statement ok
INSERT INTO merge_source VALUES (0,5,'new-merge-insert','insert'),(3,330,'new-merge-update','update'),(4,0,'new-merge-delete','delete'),(13,130,'new-merge-insert','insert')

statement ok
MERGE INTO mixed_t AS t USING merge_source AS s ON t.id = s.id WHEN MATCHED AND s.action = 'delete' THEN DELETE WHEN MATCHED THEN UPDATE SET t.value = s.value, t.source = s.source WHEN NOT MATCHED THEN INSERT (id,value,source) VALUES (s.id,s.value,s.source)

statement ok
SET recluster_method = 'vertical'

statement ok
