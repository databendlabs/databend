statement ok
DROP DATABASE IF EXISTS compat_granule_rollout

statement ok
CREATE DATABASE compat_granule_rollout

statement ok
USE compat_granule_rollout

statement ok
CREATE TABLE rollout_t(k int, payload bigint, source string) CLUSTER BY(k) row_per_block=16 block_per_segment=2

statement ok
INSERT INTO rollout_t SELECT 7-number,1000+number,'old-before-low-a' FROM numbers(8)

